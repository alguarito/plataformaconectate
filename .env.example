# Plataforma Conéctate · variables de entorno
#
# Copia este archivo como .env.local y rellena los valores reales.
# .env.local está gitignored — NUNCA se sube al repo.
#
# Cómo obtener los valores de Supabase:
#   1. Entra al dashboard del proyecto ConcienciA.
#   2. Settings (⚙️) → API.
#   3. Copia Project URL y los API keys que se piden abajo.

# ----------------------------------------------------------------------------
# Cliente público (expuesto al navegador) · solo claves seguras
# ----------------------------------------------------------------------------

# URL pública del proyecto Supabase.
PUBLIC_SUPABASE_URL=https://zvvylehmgfrggpghrskd.supabase.co

# Anon key (publishable) — segura para exponer en el cliente porque las
# políticas RLS limitan lo que puede hacer.
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ----------------------------------------------------------------------------
# Feature flags · controlan qué partes del sitio se activan
# ----------------------------------------------------------------------------

# Si es 'false', el sitio se comporta exactamente como hoy (sin auth, sin BD).
# Si es 'true', se habilitan las rutas /cuenta/* y el sync de progreso.
PUBLIC_AUTH_ENABLED=false

# ----------------------------------------------------------------------------
# Solo servidor (NUNCA expuesto al cliente) · scripts admin y migraciones
# ----------------------------------------------------------------------------

# Service role key — llave maestra. Solo se usa en scripts locales o
# en GitHub Actions con secret. NUNCA va al bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# Notas
# ----------------------------------------------------------------------------
#
# - Las variables que empiezan con PUBLIC_ son expuestas por Astro al cliente.
# - Las que no, viven solo en el servidor / scripts.
# - Si cambias estos valores, reinicia el dev server (npm run dev).

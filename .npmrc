# Necesario porque @astrojs/tailwind@6 declara peer astro<=5 pero
# usamos astro@6. La incompatibilidad de peer es por listas
# desactualizadas en @astrojs/tailwind — el adapter funciona bien con
# Astro 6 en la práctica. Quitar este flag cuando migremos a Tailwind 4
# (que usa @tailwindcss/vite, no @astrojs/tailwind).
legacy-peer-deps=true

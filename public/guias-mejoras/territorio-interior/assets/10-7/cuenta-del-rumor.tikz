% La cuenta que desarma el rumor «échale media taza de cloro al tanque».
% Sin dar dosis: se calcula cuánta agua trataría esa cantidad y se compara
% con el tanque real. Bases declaradas (OPS/OMS y INS).
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily\footnotesize,
  caja/.style={rounded corners=2mm, inner sep=2.4mm, align=center,
               text width=3.05cm, minimum height=1.35cm},
  op/.style={font=\sffamily\bfseries\scriptsize, text=milcNegro!70}]

  \node[caja, fill=milcNegro!8, text=milcNegro] (a) at (0,0)
    {\textbf{Media taza}\\[.4mm]\scriptsize 120 mL de blanqueador al 5 \%};
  \node[caja, fill=milcTurquesa, text=white] (b) at (4.05,0)
    {\textbf{6.000 mg}\\[.4mm]\scriptsize de cloro disponible};
  \node[caja, fill=milcGradePrimary, text=white] (c) at (8.10,0)
    {\textbf{2.400 litros}\\[.4mm]\scriptsize es el agua que trataría};

  \draw[milcNegro!45,line width=.9pt,->] (a) -- (b);
  \draw[milcNegro!45,line width=.9pt,->] (b) -- (c);
  \node[op] at (2.02,.98) {$\times\,50$ mg/mL};
  \node[op] at (6.07,.98) {$\div\,2{,}5$ mg/L};

  % ── La comparación ──────────────────────────────────────────────────
  \node[anchor=north west, text=milcNegro, font=\sffamily\bfseries] at (0,-1.35)
    {¿Y cuánta agua hay de verdad en el tanque?};

  \fill[milcGradePrimary] (0,-3.35) rectangle (10.6,-2.85);
  \node[anchor=west, text=white, font=\sffamily\bfseries\scriptsize] at (.15,-3.10) {2.400 L};
  \node[anchor=west, text=milcNegro!70, font=\sffamily\scriptsize] at (10.75,-3.10)
    {lo que alcanzaría a tratar};

  \fill[milcVino] (0,-4.15) rectangle (2.21,-3.65);
  \node[anchor=west, text=white, font=\sffamily\bfseries\scriptsize] at (.15,-3.90) {500 L};
  \node[anchor=west, text=milcNegro!70, font=\sffamily\scriptsize] at (2.36,-3.90)
    {un tanque doméstico corriente};

  \node[anchor=north west, text width=13.2cm, align=left, inner sep=2.4mm,
        rounded corners=2mm, draw=milcVino!55, font=\sffamily\scriptsize,
        text=milcNegro!85] at (0,-4.55)
    {\textbf{Lo que el rumor no dice.} Echar media taza en un tanque de 500 L
     es aplicar la dosis de \textbf{2.400 litros} a \textbf{500}. Y fíjate en lo
     esencial: el mensaje \textbf{nunca dice el volumen del tanque}, y sin
     volumen no hay concentración. Un dato que omite el denominador no es un
     dato: es una orden disfrazada de dato.\\[1mm]
     \scriptsize\itshape Bases: blanqueador comercial al 5 \% = 50 mg de cloro por mL (INS, 2022);
     dosis de referencia domiciliaria de OPS/OMS $\approx$ 2,5 mg/L. Esta guía no te dice
     cuánto cloro echar: para eso está tu autoridad sanitaria.};

\end{tikzpicture}

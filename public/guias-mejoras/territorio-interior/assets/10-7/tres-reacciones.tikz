% Tres reacciones del regreso a la normalidad, con su tipo y su ecuación.
% Fuentes: fichas IPCS/OIT/OMS; Fair et al. (1948) para la eficacia del HOCl.
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily\footnotesize,
  tipo/.style={rounded corners=1.6mm, inner sep=1.8mm, anchor=north west,
               font=\sffamily\bfseries\scriptsize, text=white},
  cuerpo/.style={rounded corners=2mm, inner sep=2.6mm, anchor=north west,
                 align=left, text width=13.1cm, draw=milcNegro!22}]

  % ── 1 · Combustión ──────────────────────────────────────────────────
  \node[tipo, fill=milcVino] at (0,0) {1 · COMBUSTIÓN — el rumor del gas};
  \node[cuerpo] at (0,-.72)
    {$\mathrm{CH_4 + 2\,O_2 \;\rightarrow\; CO_2 + 2\,H_2O}$ \hfill (metano, red domiciliaria)\\[1.2mm]
     $\mathrm{C_3H_8 + 5\,O_2 \;\rightarrow\; 3\,CO_2 + 4\,H_2O}$ \hfill (propano, cilindro de GLP)\\[1.8mm]
     \scriptsize Arde solo dentro de un rango de mezcla con aire: metano \textbf{5–15 \%},
     propano \textbf{2,1–9,5 \%}. El metano \textbf{se acumula arriba}; el propano es más
     pesado y \textbf{repta por el suelo}, así que puede encenderse lejos de la fuga. Por
     eso: \textbf{ninguna llama, ninguna chispa, ningún interruptor}.};

  % ── 2 · Descomposición ──────────────────────────────────────────────
  \node[tipo, fill=milcTurquesa] at (0,-3.75) {2 · DESCOMPOSICIÓN — por qué el cloro viejo no sirve};
  \node[cuerpo] at (0,-4.47)
    {$\mathrm{3\,NaOCl \;\rightarrow\; NaClO_3 + 2\,NaCl}$ \hfill (ruta dominante)\\[1.8mm]
     \scriptsize Se descompone con el calor, con los ácidos y \textbf{bajo la luz}. El
     cloro entra con número de oxidación $+1$ y sale a la vez como $+5$ y como $-1$:
     eso es una \textbf{desproporción}, un caso de óxido-reducción donde el mismo
     elemento se oxida y se reduce. Un frasco guardado meses al calor ya no tiene la
     fuerza que dice la etiqueta.};

  % ── 3 · Redox ───────────────────────────────────────────────────────
  \node[tipo, fill=milcGradePrimary] at (0,-7.35) {3 · ÓXIDO-REDUCCIÓN — la que de verdad desinfecta};
  \node[cuerpo] at (0,-8.07)
    {$\mathrm{HOCl \;\rightleftharpoons\; H^{+} + OCl^{-}}$ \hfill ($\mathrm{p}K_a \approx 7{,}5$)\\[1.8mm]
     \scriptsize Conviven \textbf{dos reacciones} que casi toda la divulgación mezcla:
     el equilibrio de arriba es \textbf{ácido-base} y depende del pH; la desinfección es
     \textbf{redox}, y la especie que trabaja es el \textbf{HOCl}, 70 a 80 veces más
     eficaz que el $\mathrm{OCl^{-}}$. Como la norma admite pH hasta 9,0, \textbf{un agua
     alcalina desinfecta peor con la misma cantidad de cloro}.};

\end{tikzpicture}

% Los once ángulos de la vulnerabilidad global (Wilches-Chaux, 1993, pp. 12-31).
% La numeración es la del autor; el agrupamiento en tres familias es de esta guía.
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily\footnotesize,
  fam/.style={rounded corners=2mm, inner sep=2.4mm, align=left,
              text width=4.15cm, anchor=north west},
  ang/.style={rounded corners=1.4mm, inner sep=1.7mm, align=left,
              text width=3.75cm, anchor=north west, font=\sffamily\scriptsize}]

  % ── Familia 1 · lo que se ve ────────────────────────────────────────
  \node[fam, fill=milcGradePrimary, text=white] at (0,0)
    {\textbf{Lo que se ve en el terreno}\\[.3mm]\scriptsize Dónde y con qué está construido};
  \node[ang, fill=milcGradePrimary!12, text=milcNegro] at (.2,-1.62)
    {\textbf{1. Natural}\\ Lo que todo ser vivo necesita para existir: aire, agua, temperatura.};
  \node[ang, fill=milcGradePrimary!12, text=milcNegro] at (.2,-3.42)
    {\textbf{2. Física}\\ La localización y la calidad de lo construido. El bahareque centenario está aquí.};
  \node[ang, fill=milcGradePrimary!12, text=milcNegro] at (.2,-5.22)
    {\textbf{10. Ecológica}\\ Cómo se ha tratado el entorno: la ladera pelada, el cauce ocupado.};

  % ── Familia 2 · quién puede responder ───────────────────────────────
  \node[fam, fill=milcTurquesa, text=white] at (4.75,0)
    {\textbf{Quién puede responder}\\[.3mm]\scriptsize Con qué recursos y con qué organización};
  \node[ang, fill=milcTurquesa!12, text=milcNegro] at (4.95,-1.62)
    {\textbf{3. Económica}\\ Quién tiene con qué reforzar su casa y quién no. La pobreza es el factor más pesado.};
  \node[ang, fill=milcTurquesa!12, text=milcNegro] at (4.95,-3.42)
    {\textbf{4. Social}\\ Qué tan organizada está la comunidad para actuar por sí misma.};
  \node[ang, fill=milcTurquesa!12, text=milcNegro] at (4.95,-5.22)
    {\textbf{5. Política}\\ Cuánta capacidad real tiene la gente de decidir sobre lo que le afecta.};
  \node[ang, fill=milcTurquesa!12, text=milcNegro] at (4.95,-7.02)
    {\textbf{11. Institucional}\\ Si las entidades responden o se estorban entre ellas.};

  % ── Familia 3 · lo que se sabe y se cree ────────────────────────────
  \node[fam, fill=milcVino, text=white] at (9.5,0)
    {\textbf{Lo que se sabe y se cree}\\[.3mm]\scriptsize Lo que nadie ve y todo lo condiciona};
  \node[ang, fill=milcVino!10, text=milcNegro] at (9.7,-1.62)
    {\textbf{6. Técnica}\\ Si existen o no las técnicas adecuadas para construir seguro.};
  \node[ang, fill=milcVino!10, text=milcNegro] at (9.7,-3.42)
    {\textbf{7. Ideológica}\\ Lo que se cree sobre por qué ocurren las cosas. «Aquí nunca ha pasado nada» vive aquí.};
  \node[ang, fill=milcVino!10, text=milcNegro] at (9.7,-5.22)
    {\textbf{8. Cultural}\\ Cómo la comunidad se ve a sí misma y qué le cuentan los medios.};
  \node[ang, fill=milcVino!10, text=milcNegro] at (9.7,-7.02)
    {\textbf{9. Educativa}\\ Si la escuela enseña o no lo que hace falta para habitar este territorio.};

  % ── Pie ─────────────────────────────────────────────────────────────
  \node[anchor=north west, text width=13.45cm, align=left, inner sep=2.4mm,
        rounded corners=2mm, draw=milcNegro!25, font=\sffamily\scriptsize,
        text=milcNegro!85] at (0,-8.92)
    {\textbf{Son once, no uno.} La numeración es la de Wilches-Chaux (1993); el
     reparto en tres familias es de esta guía, para leerlos más fácil. El propio
     autor advierte que la división vale «únicamente para efectos de estudio», y
     que cada ángulo «constituye apenas un ángulo particular para analizar el
     fenómeno global» (p. 11). \textbf{Ninguno actúa solo: por eso la mitigación
     tampoco puede ser de un solo tipo.}};

\end{tikzpicture}

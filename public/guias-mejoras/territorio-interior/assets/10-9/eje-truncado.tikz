% El mismo dato diario (47, 49, 34), dibujado dos veces.
% Izquierda: eje desde 0. Derecha: eje desde 30 (truncado).
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily\footnotesize]

  % ── Honesto: eje desde cero ─────────────────────────────────────────
  \begin{scope}
    \draw[milcNegro!45,line width=.6pt] (0,0) -- (4.6,0);
    \draw[milcNegro!45,line width=.6pt] (0,0) -- (0,3.9);
    \foreach \v in {0,20,40,60}{
      \draw[milcNegro!45] (-.09,\v*0.06) -- (0,\v*0.06);
      \node[anchor=east,text=milcNegro!75] at (-.16,\v*0.06) {\v};
    }
    \fill[milcGradePrimary] (0.5,0) rectangle (1.55,2.82);
    \fill[milcGradePrimary] (1.65,0) rectangle (2.70,2.94);
    \fill[milcGradePrimary] (2.80,0) rectangle (3.85,2.04);
    \foreach \x/\d in {1.02/10,2.17/11,3.32/12}
      \node[anchor=north,text=milcNegro!75] at (\x,-.12) {\d};
    \node[anchor=south west,text=milcNegro,font=\sffamily\bfseries] at (0,3.95) {Eje desde 0};
    \node[anchor=north,text=milcNegro!60,font=\sffamily\scriptsize,align=center] at (2.1,-.7) {baja un poco:\\ de 47 a 34};
  \end{scope}

  % ── Truncado: eje desde 30 ──────────────────────────────────────────
  \begin{scope}[xshift=7.2cm]
    \draw[milcNegro!45,line width=.6pt] (0,0) -- (4.6,0);
    \draw[milcNegro!45,line width=.6pt] (0,0) -- (0,3.9);
    \foreach \v/\p in {30/0,35/0.9,40/1.8,45/2.7,50/3.6}{
      \draw[milcNegro!45] (-.09,\p) -- (0,\p);
      \node[anchor=east,text=milcNegro!75] at (-.16,\p) {\v};
    }
    \fill[milcVino] (0.5,0) rectangle (1.55,3.06);
    \fill[milcVino] (1.65,0) rectangle (2.70,3.42);
    \fill[milcVino] (2.80,0) rectangle (3.85,0.72);
    \foreach \x/\d in {1.02/10,2.17/11,3.32/12}
      \node[anchor=north,text=milcNegro!75] at (\x,-.12) {\d};
    \node[anchor=south west,text=milcNegro,font=\sffamily\bfseries] at (0,3.95) {Eje desde 30};
    \node[anchor=north,text=milcVino,font=\sffamily\bfseries\scriptsize,align=center] at (2.1,-.7) {¡parece un desplome!\\ son los mismos datos};
    \draw[milcVino,line width=.7pt] (-.28,-.16) -- (-.05,-.02);
    \draw[milcVino,line width=.7pt] (-.28,-.05) -- (-.05,.09);
  \end{scope}

\end{tikzpicture}

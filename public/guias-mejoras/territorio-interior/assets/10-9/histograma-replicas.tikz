% Réplicas del sismo del 10 de agosto de 2026, según el SGC.
% Izquierda: por día (47, 49, ≥34). Derecha: acumuladas (47, 96, >130).
% Mismos datos, dos lecturas: la de la izquierda baja, la de la derecha sube.
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily\footnotesize]

  % ── Panel A · por día ───────────────────────────────────────────────
  \begin{scope}
    \draw[milcNegro!45,line width=.6pt] (0,0) -- (5.2,0);
    \draw[milcNegro!45,line width=.6pt] (0,0) -- (0,4.3);
    \foreach \v in {20,40,60}
      {\draw[milcNegro!25,line width=.3pt] (0,\v*0.06667) -- (5.2,\v*0.06667);}
    \foreach \v in {0,20,40,60}{
      \draw[milcNegro!45] (-.09,\v*0.06667) -- (0,\v*0.06667);
      \node[anchor=east,text=milcNegro!75] at (-.16,\v*0.06667) {\v};
    }
    \fill[milcGradePrimary] (0.55,0) rectangle (1.75,3.133);
    \fill[milcGradePrimary] (1.85,0) rectangle (3.05,3.267);
    \fill[milcGradePrimary] (3.15,0) rectangle (4.35,2.267);
    \node[anchor=south,text=white,font=\sffamily\bfseries\footnotesize] at (1.15,2.55) {47};
    \node[anchor=south,text=white,font=\sffamily\bfseries\footnotesize] at (2.45,2.68) {49};
    \node[anchor=south,text=white,font=\sffamily\bfseries\footnotesize] at (3.75,1.68) {34+};
    \foreach \x/\d in {1.15/10,2.45/11,3.75/12}
      \node[anchor=north,text=milcNegro!75] at (\x,-.12) {\d\,ago};
    \node[anchor=south west,text=milcNegro,font=\sffamily\bfseries] at (0,4.35) {A. Réplicas por día};
    \node[anchor=north,text=milcNegro!60,font=\sffamily\scriptsize] at (2.6,-.75) {la tendencia \textbf{baja}};
    \node[rotate=90,anchor=south,text=milcNegro!75,font=\sffamily\scriptsize] at (-.95,2.1) {número de réplicas};
  \end{scope}

  % ── Panel B · acumuladas ────────────────────────────────────────────
  \begin{scope}[xshift=7.6cm]
    \draw[milcNegro!45,line width=.6pt] (0,0) -- (5.2,0);
    \draw[milcNegro!45,line width=.6pt] (0,0) -- (0,4.3);
    \foreach \v in {50,100,150}
      {\draw[milcNegro!25,line width=.3pt] (0,\v*0.02667) -- (5.2,\v*0.02667);}
    \foreach \v in {0,50,100,150}{
      \draw[milcNegro!45] (-.09,\v*0.02667) -- (0,\v*0.02667);
      \node[anchor=east,text=milcNegro!75] at (-.16,\v*0.02667) {\v};
    }
    \fill[milcNegro!35] (0.55,0) rectangle (1.75,1.253);
    \fill[milcNegro!35] (1.85,0) rectangle (3.05,2.560);
    \fill[milcNegro!35] (3.15,0) rectangle (4.35,3.467);
    \node[anchor=south,text=milcNegro,font=\sffamily\bfseries\footnotesize] at (1.15,1.30) {47};
    \node[anchor=south,text=milcNegro,font=\sffamily\bfseries\footnotesize] at (2.45,2.61) {96};
    \node[anchor=south,text=milcNegro,font=\sffamily\bfseries\footnotesize] at (3.75,3.52) {130+};
    \foreach \x/\d in {1.15/10,2.45/11,3.75/12}
      \node[anchor=north,text=milcNegro!75] at (\x,-.12) {\d\,ago};
    \node[anchor=south west,text=milcNegro,font=\sffamily\bfseries] at (0,4.35) {B. Réplicas acumuladas};
    \node[anchor=north,text=milcNegro!60,font=\sffamily\scriptsize] at (2.6,-.75) {la misma realidad \textbf{parece subir}};
  \end{scope}

\end{tikzpicture}

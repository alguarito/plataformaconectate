---
/**
 * Bloque de actividad — la unidad de trabajo de la sesión.
 *
 * Antes: seis emoji sueltos como iconos (✏️ 🧑 👯 🤝 📋 📓 ⏱ ✅) y un borde
 * naranja fijo. Ahora los iconos son trazos, el número de actividad va en un
 * círculo —como las tarjetas de paso del PDF— y las tres partes (qué hacer,
 * qué va al cuaderno, cómo sabes que terminaste) se distinguen por jerarquía,
 * no por color.
 */
import type { Actividad } from '../data/guiasContenido/_schema';
import IconoMILC from './IconoMILC.astro';

interface Props {
  data: Actividad;
}

const { data } = Astro.props;

const modalidadLabel =
  data.modalidad === 'individual'
    ? 'individual'
    : data.modalidad === 'parejas'
      ? 'parejas'
      : `equipo${data.equipoTamano ? ` de ${data.equipoTamano}` : ''}`;

const modalidadIcono =
  data.modalidad === 'individual' ? 'individual' : data.modalidad === 'parejas' ? 'parejas' : 'equipo';

const ACENTO = '#E6007E';
---

<section
  class="bento-card mb-6"
  style={`border-left: 6px solid ${ACENTO};`}
  aria-labelledby={`actividad-${data.numero}-titulo`}
>
  <div class="flex items-center gap-3 mb-3 flex-wrap">
    <span
      class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-black shrink-0"
      style={`background: ${ACENTO}; color: #FFFFFF;`}
    >
      {data.numero}
    </span>
    <span class="text-[11px] font-black uppercase tracking-[0.14em]" style="color: var(--fg-muted);">
      Actividad {data.numero} · {data.verbo}
    </span>
  </div>

  <h3
    id={`actividad-${data.numero}-titulo`}
    class="text-xl md:text-2xl font-black tracking-tight leading-tight mb-3"
  >
    {data.titulo}
  </h3>

  <div class="flex flex-wrap gap-2 mb-5" style="color: var(--fg-muted);">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold"
          style="background: var(--bg); border: 1px solid var(--border);">
      <IconoMILC nombre="reloj" size={14} /> {data.tiempoMin} min
    </span>
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold"
          style="background: var(--bg); border: 1px solid var(--border);">
      <IconoMILC nombre={modalidadIcono} size={14} /> {modalidadLabel}
    </span>
  </div>

  <div class="mb-5">
    <span class="inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.14em] mb-2"
          style="color: var(--fg-muted);">
      <IconoMILC nombre="lista" size={15} /> Qué vas a hacer
    </span>
    <ol class="space-y-1.5 list-decimal list-inside text-sm md:text-base leading-relaxed mt-1">
      {data.pasos.map((p) => <li>{p}</li>)}
    </ol>
  </div>

  <div class="mb-5 p-4 rounded-bento-sm" style="background: var(--bg); border: 1px solid var(--border);">
    <span class="inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.14em] mb-2"
          style="color: var(--fg);">
      <IconoMILC nombre="cuaderno" size={15} /> Esto va en tu cuaderno
    </span>
    <dl class="text-sm md:text-base leading-relaxed mt-1 space-y-1">
      <div class="flex gap-2">
        <dt class="font-bold shrink-0">Título:</dt>
        <dd>«Actividad {data.numero} — {data.cuaderno.titulo}»</dd>
      </div>
      <div class="flex gap-2">
        <dt class="font-bold shrink-0">Formato:</dt>
        <dd>{data.cuaderno.formato}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="font-bold shrink-0">Extensión:</dt>
        <dd>{data.cuaderno.extension}</dd>
      </div>
    </dl>
  </div>

  <div>
    <span class="inline-flex items-center gap-2 text-[11px] font-black uppercase tracking-[0.14em] mb-2"
          style="color: var(--fg-muted);">
      <IconoMILC nombre="✅" size={15} /> Sabes que terminaste cuando
    </span>
    <ul class="space-y-1.5 text-sm md:text-base leading-relaxed mt-1">
      {data.criterios.map((c) => (
        <li class="flex gap-2.5 items-start">
          <span class="shrink-0 mt-0.5" style={`color: ${ACENTO};`}>
            <IconoMILC nombre="✅" size={15} />
          </span>
          <span>{c}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

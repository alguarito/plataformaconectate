---
/**
 * Reproductor de audio (pódcast) · offline-first amable con datos limitados.
 *
 * Usa el elemento <audio> nativo con preload="none": el archivo NO se descarga
 * hasta que el estudiante le da play. Por eso conviene que el Service Worker NO
 * lo precachee (ver public/sw.js). Muestra duración/peso y un enlace de descarga.
 */
interface Props {
  /** Ruta al audio (en public/). */
  src: string;
  /** Tipo MIME (por defecto audio/mp4 para .m4a). */
  tipo?: string;
  titulo?: string;
  descripcion?: string;
  /** Texto de peso/duración, ej. "~8 min · 32 MB". */
  meta?: string;
}

const { src, tipo = 'audio/mp4', titulo = 'Audio', descripcion, meta } = Astro.props;
---

<div class="bento-card">
  <div class="flex items-start gap-3 mb-4">
    <span class="text-3xl shrink-0" aria-hidden="true">🎧</span>
    <div class="min-w-0">
      <div class="font-black text-base md:text-lg leading-tight">{titulo}</div>
      {descripcion && <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">{descripcion}</p>}
    </div>
  </div>

  <audio controls preload="none" class="w-full" style="height: 44px;" aria-label={titulo}>
    <source src={src} type={tipo} />
    Tu navegador no reproduce este audio. <a href={src} download>Descárgalo aquí</a>.
  </audio>

  <p class="text-xs leading-relaxed mt-3" style="color: var(--fg-muted);">
    {meta && <>{meta} · </>}Se descarga solo al darle play. También puedes
    <a href={src} download class="underline hover:opacity-70">descargarlo</a> para escucharlo sin conexión.
  </p>
</div>

---
/**
 * Badge de densidad pedagógica de una guía (modelo v2 · absoluto).
 *
 * Dos señales independientes:
 *  - ⭐ Estrellas: completitud del contrato MILC v3 (5 = pro · 4 = bloques · 3 = legacy · 2 = solo PDF).
 *  - 🎨 Color: densidad informativa (palabras reales del YAML) — verde / mostaza / ocre.
 *
 * Variantes:
 *  - compact: para cards de listado (estrellas + KB)
 *  - full:    para página de guía (estrellas + nivel + palabras + KB)
 *
 * Si no hay datos de densidad, no renderiza nada.
 */
import { getDensidadPeriodo, NIVEL_LABEL, NIVEL_COLOR } from '../data/densidad';
import { getMilcLevel, type NivelMilc } from '../data/guiasContenido/_index';

interface Props {
  grado: number;
  periodo: number;
  /** Sesión local dentro del período (1-10). */
  sesion: number;
  variant?: 'compact' | 'full';
  class?: string;
}

const { grado, periodo, sesion, variant = 'compact', class: className = '' } = Astro.props;
const dRaw = getDensidadPeriodo(grado, periodo, sesion);

// Estrellas absolutas según completitud del contrato MILC v3.
const STARS_BY_MILC: Record<NivelMilc, number> = {
  pro: 5,
  bloques: 4,
  legacy: 3,
  none: 2,
};
const milcLevel = getMilcLevel(grado, periodo, sesion);
const stars = STARS_BY_MILC[milcLevel];

const d = dRaw ? { ...dRaw, stars } : undefined;
---

{
  d && variant === 'compact' && (
    <span
      class:list={['inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wider', className]}
      style={`color: ${NIVEL_COLOR[d.nivel]};`}
      title={`Densidad ${NIVEL_LABEL[d.nivel].toLowerCase()} · ${d.palabras} palabras estimadas · ${d.kb} KB`}
      aria-label={`Densidad ${d.nivel}, ${d.stars} de 5 estrellas`}
    >
      <span class="tracking-tight">{'★'.repeat(d.stars)}{'☆'.repeat(5 - d.stars)}</span>
      <span style="opacity: 0.85;">{d.kb}KB</span>
    </span>
  )
}

{
  d && variant === 'full' && (
    <div
      class:list={['flex flex-wrap items-center gap-3 text-xs font-bold p-3 rounded-xl', className]}
      style={`background: ${NIVEL_COLOR[d.nivel]}1A; border: 1px solid ${NIVEL_COLOR[d.nivel]}40;`}
      role="note"
      aria-label="Densidad pedagógica de la guía"
    >
      <span class="flex items-center gap-1.5">
        <span class="text-[11px] uppercase tracking-widest" style="opacity: 0.7;">Densidad</span>
        <span style={`color: ${NIVEL_COLOR[d.nivel]};`}>
          {NIVEL_LABEL[d.nivel]}
        </span>
      </span>
      <span class="text-base tracking-tight" style={`color: ${NIVEL_COLOR[d.nivel]};`}>
        {'★'.repeat(d.stars)}{'☆'.repeat(5 - d.stars)}
      </span>
      <span style="opacity: 0.7;">·</span>
      <span style="opacity: 0.85;">~{d.palabras.toLocaleString('es-CO')} palabras</span>
      <span style="opacity: 0.7;">·</span>
      <span style="opacity: 0.85;">{d.kb} KB</span>
      <span style="opacity: 0.7;">·</span>
      <span style="opacity: 0.6;" title={`Contrato MILC v3: ${milcLevel}`}>
        MILC {milcLevel}
      </span>
    </div>
  )
}

---
/**
 * Buscador global de ConectaTE (MILC v3).
 *
 * El índice (guías, conceptos clave, proyectos, exámenes, anclajes ancestrales)
 * se construye al BUILD en src/data/indiceBuscador.ts y se sirve como JSON
 * estático en `${base}/data/buscador.json` (src/pages/data/buscador.json.ts).
 * Este overlay NO embebe el índice en el HTML: lo descarga UNA sola vez al
 * abrir el diálogo (o al primer foco del input). Antes, el índice inyectado
 * con define:vars sumaba ~1,4 MB a cada página del sitio.
 *
 * Al HTML solo llegan el `base` y los totales por tipo (números) para los chips.
 *
 * UX:
 *   - Búsqueda en vivo (≥ 2 chars), insensible a tildes y mayúsculas.
 *   - 5 tipos de resultado con badge propio: guía · proyecto · examen · concepto · anclaje.
 *   - Filtros sticky por tipo (chips).
 *   - Hasta 100 resultados visibles + botón "Cargar más".
 *   - Navegación con ↑ ↓ + Enter; cerrar con Esc; abrir con ⌘ K / Ctrl K / /.
 *   - Marca ✓ las guías y proyectos ya completados (localStorage).
 *   - Estado visible «Cargando índice…» y error con reintento si falla la red.
 */
import { construirIndice, contarIndice } from '../data/indiceBuscador';

const base = import.meta.env.BASE_URL;

// Solo los totales (números) van al HTML; el índice completo vive en el JSON.
const totales = contarIndice(construirIndice(base));
const totalItems = totales.total;
const totalGuias = totales.guias;
const totalProyectos = totales.proyectos;
const totalConceptos = totales.conceptos;
const totalExamenes = totales.examenes;
const totalAnclajes = totales.anclajes;
---

<dialog
  id="buscador-overlay"
  class="bg-transparent p-0 m-0 max-w-none w-full max-h-none h-full backdrop:bg-black/70 backdrop:backdrop-blur-sm"
>
  <div class="fixed inset-0 flex items-start md:items-center justify-center p-0 md:p-6 md:pt-20">
    <div
      class="w-full md:max-w-3xl h-full md:h-auto md:max-h-[85vh] flex flex-col rounded-none md:rounded-bento-lg shadow-2xl overflow-hidden"
      style="background: var(--bg);"
    >
      {/* Caja de búsqueda */}
      <div class="flex items-center gap-3 px-5 md:px-6 py-4 border-b" style="border-color: var(--border);">
        <svg class="w-5 h-5 shrink-0" style="color: var(--fg-muted);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          id="buscador-input"
          type="search"
          placeholder="Busca tema, saber ancestral, concepto, proyecto…"
          aria-label="Buscar en el corpus de la plataforma"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          class="flex-1 bg-transparent border-none outline-none text-base md:text-lg font-semibold placeholder:font-normal"
          style="color: var(--fg);"
        />
        <kbd class="hidden md:inline-flex text-xs font-bold px-2 py-1 rounded-md border" style="border-color: var(--border); color: var(--fg-muted);">
          Esc
        </kbd>
        <button
          type="button"
          data-cerrar-buscador
          aria-label="Cerrar buscador"
          class="w-8 h-8 rounded-full flex items-center justify-center hover:opacity-70 transition-opacity md:hidden"
          style="background: var(--border);"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      {/* Filtros por tipo */}
      <div
        class="flex items-center gap-2 px-5 md:px-6 py-3 border-b overflow-x-auto"
        style="border-color: var(--border);"
        role="tablist"
        aria-label="Filtrar por tipo de resultado"
      >
        <button
          type="button"
          class="buscador-filtro shrink-0 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-widest border-2 transition-all"
          data-filtro="todo"
          aria-pressed="true"
          style="border-color: var(--fg); background: var(--fg); color: var(--bg);"
        >
          Todo · {totalItems}
        </button>
        <button type="button" class="buscador-filtro shrink-0 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-widest border-2 transition-all" data-filtro="guia" aria-pressed="false" style="border-color: var(--border); color: var(--fg-muted);">
          📄 Guías · {totalGuias}
        </button>
        <button type="button" class="buscador-filtro shrink-0 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-widest border-2 transition-all" data-filtro="proyecto" aria-pressed="false" style="border-color: var(--border); color: var(--fg-muted);">
          🎯 Proyectos · {totalProyectos}
        </button>
        <button type="button" class="buscador-filtro shrink-0 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-widest border-2 transition-all" data-filtro="examen" aria-pressed="false" style="border-color: var(--border); color: var(--fg-muted);">
          📝 Exámenes · {totalExamenes}
        </button>
        <button type="button" class="buscador-filtro shrink-0 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-widest border-2 transition-all" data-filtro="concepto" aria-pressed="false" style="border-color: var(--border); color: var(--fg-muted);">
          🔑 Conceptos · {totalConceptos}
        </button>
        <button type="button" class="buscador-filtro shrink-0 px-3 py-1.5 rounded-full text-xs font-black uppercase tracking-widest border-2 transition-all" data-filtro="anclaje" aria-pressed="false" style="border-color: var(--border); color: var(--fg-muted);">
          🌱 Anclajes · {totalAnclajes}
        </button>
      </div>

      {/* Estado de carga del índice (oculto salvo cargando/error) */}
      <div
        id="buscador-estado"
        hidden
        role="status"
        aria-live="polite"
        class="flex items-center justify-center gap-3 px-5 md:px-6 py-2 border-b text-xs font-bold"
        style="border-color: var(--border); color: var(--fg-muted);"
      >
        <span id="buscador-estado-texto"></span>
        <button
          type="button"
          id="buscador-reintentar"
          hidden
          class="px-3 py-1 rounded-full border-2 font-black uppercase tracking-widest hover:opacity-80 transition-opacity"
          style="border-color: var(--fg); color: var(--fg);"
        >
          Reintentar
        </button>
      </div>

      {/* Resultados */}
      <div
        id="buscador-resultados"
        class="flex-1 overflow-y-auto p-3 md:p-4"
        role="listbox"
        aria-label="Resultados de búsqueda"
      >
        <div id="buscador-vacio" class="text-center py-12 px-6">
          <div class="text-5xl mb-3" aria-hidden="true">🔎</div>
          <div class="font-bold text-lg mb-1">Empieza a escribir</div>
          <div class="text-sm" style="color: var(--fg-muted);">
            Busca por <strong>tema</strong> (ej. "phishing"), <strong>saber ancestral</strong> (ej. "minga"), <strong>concepto</strong> (ej. "huella digital") o <strong>proyecto</strong>.
          </div>
        </div>
      </div>

      {/* Footer con tips de teclado (desktop) */}
      <div class="hidden md:flex items-center gap-4 px-5 py-3 border-t text-xs font-semibold" style="border-color: var(--border); color: var(--fg-muted);">
        <span class="flex items-center gap-1.5">
          <kbd class="px-1.5 py-0.5 rounded border" style="border-color: var(--border);">↑</kbd>
          <kbd class="px-1.5 py-0.5 rounded border" style="border-color: var(--border);">↓</kbd>
          navegar
        </span>
        <span class="flex items-center gap-1.5">
          <kbd class="px-1.5 py-0.5 rounded border" style="border-color: var(--border);">Enter</kbd>
          abrir
        </span>
        <span class="flex items-center gap-1.5">
          <kbd class="px-1.5 py-0.5 rounded border" style="border-color: var(--border);">/</kbd>
          o
          <kbd class="px-1.5 py-0.5 rounded border" style="border-color: var(--border);">⌘ K</kbd>
          abrir
        </span>
        <span class="ml-auto" aria-live="polite" id="buscador-contador"></span>
      </div>
    </div>
  </div>
</dialog>

<script define:vars={{ base }}>
  const dialog = document.getElementById('buscador-overlay');
  const input = document.getElementById('buscador-input');
  const out = document.getElementById('buscador-resultados');
  const vacio = document.getElementById('buscador-vacio');
  const contador = document.getElementById('buscador-contador');
  const estado = document.getElementById('buscador-estado');
  const estadoTexto = document.getElementById('buscador-estado-texto');
  const reintentar = document.getElementById('buscador-reintentar');

  if (!dialog || !input || !out) {
    // SSR — no continuamos
  } else {
    // ─── Helpers ──────────────────────────────────────────────────────────

    function normalizar(s) {
      return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
    }

    function escapeHtml(s) {
      return s
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function resaltar(text, queryNorm) {
      if (!queryNorm) return escapeHtml(text);
      const tNorm = normalizar(text);
      const idx = tNorm.indexOf(queryNorm);
      if (idx < 0) return escapeHtml(text);
      let visible = '';
      let normCount = 0;
      let highlighted = false;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        const chNorm = normalizar(ch);
        if (!highlighted && normCount === idx) visible += '<mark>';
        visible += escapeHtml(ch);
        if (chNorm.length > 0) {
          normCount += chNorm.length;
          if (!highlighted && normCount >= idx + queryNorm.length) {
            visible += '</mark>';
            highlighted = true;
          }
        }
      }
      if (!highlighted) visible += '</mark>';
      return visible;
    }

    // Se lee UNA vez por render (no por resultado): ver render().
    function leerCompletadas() {
      try {
        const raw = localStorage.getItem('conectate.progreso.v1');
        if (!raw) return { guias: {}, proyectos: {} };
        const p = JSON.parse(raw);
        return { guias: p?.guias ?? {}, proyectos: p?.proyectos ?? {} };
      } catch {
        return { guias: {}, proyectos: {} };
      }
    }

    function estaCompletado(item, completadas) {
      if (item.tipo === 'guia') {
        return `g${item.grado}-p${item.periodo}-s${item.sesion}` in completadas.guias;
      }
      if (item.tipo === 'proyecto') {
        return `g${item.grado}-p${item.periodo}` in completadas.proyectos;
      }
      return false;
    }

    const ICONOS = {
      guia: '📄',
      proyecto: '🎯',
      examen: '📝',
      concepto: '🔑',
      anclaje: '🌱',
    };
    const ETIQUETAS = {
      guia: 'Guía',
      proyecto: 'Proyecto',
      examen: 'Examen',
      concepto: 'Concepto',
      anclaje: 'Anclaje ancestral',
    };

    // ─── Estado ───────────────────────────────────────────────────────────

    let queryNorm = '';
    let filtroActivo = 'todo';
    let resultadosVisibles = [];
    let cursor = -1;
    let limite = 100;
    const PAGINA = 100;

    // ─── Índice: carga diferida, una sola vez ─────────────────────────────

    const URL_INDICE = `${String(base).replace(/\/$/, '')}/data/buscador.json`;
    let indice = null;        // ItemIndice[] una vez descargado
    let cargaEnCurso = null;  // Promise mientras se descarga
    let errorCarga = false;

    function mostrarEstado(texto, conReintento) {
      if (!estado || !estadoTexto) return;
      if (!texto) {
        estado.hidden = true;
        return;
      }
      estadoTexto.textContent = texto;
      if (reintentar) reintentar.hidden = !conReintento;
      estado.hidden = false;
    }

    function cargarIndice() {
      if (indice) return Promise.resolve(indice);
      if (cargaEnCurso) return cargaEnCurso;
      errorCarga = false;
      mostrarEstado('Cargando índice…', false);
      cargaEnCurso = fetch(URL_INDICE, { credentials: 'same-origin' })
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json();
        })
        .then((data) => {
          if (!Array.isArray(data)) throw new Error('Índice inválido');
          indice = data;
          mostrarEstado('');
          render();
          return indice;
        })
        .catch(() => {
          cargaEnCurso = null;
          errorCarga = true;
          mostrarEstado('No se pudo cargar el buscador; revisa tu conexión.', true);
          render();
          return null;
        });
      return cargaEnCurso;
    }

    if (reintentar) {
      reintentar.addEventListener('click', () => {
        cargarIndice();
        input.focus();
      });
    }

    // ─── Render ───────────────────────────────────────────────────────────

    function calcularMatches() {
      if (!indice || queryNorm.length < 2) return [];
      let base = indice;
      if (filtroActivo !== 'todo') {
        base = indice.filter((i) => i.tipo === filtroActivo);
      }
      return base.filter((i) => i.k.includes(queryNorm));
    }

    function render() {
      if (queryNorm.length < 2) {
        resultadosVisibles = [];
        cursor = -1;
        out.innerHTML = '';
        out.appendChild(vacio);
        if (contador) contador.textContent = '';
        return;
      }

      // Hay consulta pero el índice aún no está: placeholder (o error).
      if (!indice) {
        resultadosVisibles = [];
        cursor = -1;
        if (contador) contador.textContent = '';
        out.innerHTML = errorCarga
          ? `
          <div class="text-center py-12 px-6">
            <div class="text-5xl mb-3" aria-hidden="true">📡</div>
            <div class="font-bold text-lg mb-1">Sin índice de búsqueda</div>
            <div class="text-sm" style="color: var(--fg-muted);">
              No se pudo cargar el buscador; revisa tu conexión y pulsa «Reintentar».
            </div>
          </div>`
          : `
          <div class="text-center py-12 px-6">
            <div class="text-5xl mb-3" aria-hidden="true">⏳</div>
            <div class="font-bold text-lg mb-1">Cargando índice…</div>
            <div class="text-sm" style="color: var(--fg-muted);">
              Solo se descarga una vez; los resultados aparecerán enseguida.
            </div>
          </div>`;
        if (!errorCarga) cargarIndice();
        return;
      }

      const matches = calcularMatches();
      resultadosVisibles = matches.slice(0, limite);
      cursor = resultadosVisibles.length > 0 ? 0 : -1;
      if (contador) {
        contador.textContent = `${matches.length} ${matches.length === 1 ? 'resultado' : 'resultados'}`;
      }

      if (matches.length === 0) {
        out.innerHTML = `
          <div class="text-center py-12 px-6">
            <div class="text-5xl mb-3" aria-hidden="true">🤔</div>
            <div class="font-bold text-lg mb-1">Sin resultados</div>
            <div class="text-sm" style="color: var(--fg-muted);">
              Prueba con otra palabra clave o cambia el filtro de tipo.
            </div>
          </div>`;
        return;
      }

      // Progreso: una sola lectura de localStorage por render
      const completadas = leerCompletadas();

      // Agrupar por grado
      const porGrado = new Map();
      for (const m of resultadosVisibles) {
        if (!porGrado.has(m.grado)) porGrado.set(m.grado, []);
        porGrado.get(m.grado).push(m);
      }

      const partes = [];
      partes.push(`
        <div class="text-xs font-bold uppercase tracking-widest mb-3 px-2" style="color: var(--fg-muted);">
          Mostrando ${resultadosVisibles.length} de ${matches.length} ${matches.length === 1 ? 'resultado' : 'resultados'}
        </div>`);

      let idxGlobal = 0;
      for (const [grado, items] of [...porGrado.entries()].sort((a, b) => a[0] - b[0])) {
        partes.push(`
          <div class="text-xs font-black uppercase tracking-widest mt-3 mb-2 px-2 opacity-60">
            Grado ${grado}°
          </div>`);
        for (const it of items) {
          const completado = estaCompletado(it, completadas);
          const icono = ICONOS[it.tipo] ?? '📄';
          const etiqueta = ETIQUETAS[it.tipo] ?? 'Resultado';
          const subtitulo = it.subtitulo
            ? `<div class="text-xs mt-1 line-clamp-2" style="color: var(--fg-muted);">${resaltar(it.subtitulo, queryNorm)}</div>`
            : '';
          partes.push(`
            <a
              href="${escapeHtml(it.href)}"
              data-resultado-idx="${idxGlobal}"
              role="option"
              class="buscador-resultado flex items-start gap-3 p-3 rounded-bento-sm hover:opacity-90 transition-opacity"
            >
              <span class="text-2xl shrink-0" aria-hidden="true">${icono}</span>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap mb-1">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-widest ${escapeHtml(it.bgClass)}">
                    ${escapeHtml(it.contexto)}
                  </span>
                  <span class="text-[10px] font-bold uppercase tracking-widest" style="color: var(--fg-muted);">
                    ${escapeHtml(etiqueta)}
                  </span>
                  ${completado ? '<span class="text-xs font-bold text-bento-lime">✓ Completada</span>' : ''}
                </div>
                <div class="font-bold leading-snug">${resaltar(it.titulo, queryNorm)}</div>
                ${subtitulo}
              </div>
              <svg class="w-5 h-5 shrink-0 mt-1 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </a>`);
          idxGlobal++;
        }
      }

      // Botón "Cargar más" si hay más
      if (matches.length > resultadosVisibles.length) {
        partes.push(`
          <button
            type="button"
            id="buscador-cargar-mas"
            class="w-full mt-4 py-3 rounded-bento-sm font-bold text-sm border-2 hover:opacity-80 transition-opacity"
            style="border-color: var(--border); color: var(--fg);"
          >
            Cargar ${Math.min(PAGINA, matches.length - resultadosVisibles.length)} resultados más
            (${matches.length - resultadosVisibles.length} restantes)
          </button>`);
      }

      out.innerHTML = partes.join('');
      const cargarMas = document.getElementById('buscador-cargar-mas');
      if (cargarMas) {
        cargarMas.addEventListener('click', () => {
          limite += PAGINA;
          render();
        });
      }
      pintarCursor();
    }

    function pintarCursor() {
      out.querySelectorAll('.buscador-resultado').forEach((el, i) => {
        if (i === cursor) {
          el.classList.add('bg-bento-blue', 'text-white');
          el.setAttribute('aria-selected', 'true');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('bg-bento-blue', 'text-white');
          el.removeAttribute('aria-selected');
        }
      });
    }

    // ─── Filtros ──────────────────────────────────────────────────────────

    document.querySelectorAll('.buscador-filtro').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filtro = btn.dataset.filtro;
        if (!filtro) return;
        filtroActivo = filtro;
        limite = PAGINA;
        // Actualizar estado visual
        document.querySelectorAll('.buscador-filtro').forEach((b) => {
          const activo = b.dataset.filtro === filtro;
          b.setAttribute('aria-pressed', activo ? 'true' : 'false');
          if (activo) {
            b.style.background = 'var(--fg)';
            b.style.color = 'var(--bg)';
            b.style.borderColor = 'var(--fg)';
          } else {
            b.style.background = '';
            b.style.color = 'var(--fg-muted)';
            b.style.borderColor = 'var(--border)';
          }
        });
        render();
      });
    });

    // ─── Eventos de input/teclado ─────────────────────────────────────────

    // Primer foco del input: dispara la descarga (idempotente).
    input.addEventListener('focus', () => {
      cargarIndice();
    });

    input.addEventListener('input', (e) => {
      queryNorm = normalizar(e.target.value);
      limite = PAGINA;
      render();
    });

    input.addEventListener('keydown', (e) => {
      if (resultadosVisibles.length === 0) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        cursor = (cursor + 1) % resultadosVisibles.length;
        pintarCursor();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        cursor = (cursor - 1 + resultadosVisibles.length) % resultadosVisibles.length;
        pintarCursor();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const item = resultadosVisibles[cursor];
        if (item) window.location.href = item.href;
      }
    });

    document.querySelectorAll('[data-cerrar-buscador]').forEach((b) => {
      b.addEventListener('click', () => dialog.close());
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // ─── Apertura ─────────────────────────────────────────────────────────

    function abrir() {
      if (typeof dialog.showModal === 'function') dialog.showModal();
      // Descarga el índice al abrir (una sola vez; no bloquea el foco).
      cargarIndice();
      requestAnimationFrame(() => input.focus());
    }

    document.querySelectorAll('[data-abrir-buscador]').forEach((b) => {
      b.addEventListener('click', abrir);
    });

    // Atajos globales: ⌘K / Ctrl+K / "/"
    document.addEventListener('keydown', (e) => {
      const enInput =
        e.target instanceof HTMLInputElement ||
        e.target instanceof HTMLTextAreaElement ||
        (e.target instanceof HTMLElement && e.target.isContentEditable);

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        abrir();
        return;
      }
      if (e.key === '/' && !enInput && !dialog.open) {
        e.preventDefault();
        abrir();
      }
    });
  }
</script>

<style>
  /* Resaltado de coincidencias */
  #buscador-resultados mark {
    background: var(--bento-yellow, #FFD60A);
    color: black;
    padding: 0 2px;
    border-radius: 3px;
    font-weight: 800;
  }

  /* Animación de entrada del overlay */
  #buscador-overlay[open] > div > div {
    animation: buscador-pop 0.2s ease-out;
  }
  @keyframes buscador-pop {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.98);
    }
    to {
      opacity: 1;

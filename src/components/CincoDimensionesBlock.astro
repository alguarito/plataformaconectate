---
/**
 * Cinco dimensiones de la evaluación liberadora.
 *
 * Antes: cinco tarjetas de color saturado, cada una con un emoji de 30 px
 * (🧭 💙 🏛 🌎 🧓). Ahora el color queda en un riel y una etiqueta, el fondo es
 * la tarjeta neutra de la plataforma y el icono es un trazo — el texto, que es
 * lo que se lee, gana contraste.
 */
import type { CincoDimensiones } from '../data/guiasContenido/_schema';
import IconoMILC from './IconoMILC.astro';

interface Props {
  data: CincoDimensiones;
}

const { data } = Astro.props;

const dimensiones = [
  { icono: 'brujula', nombre: 'Personal',          texto: data.personal,          color: '#0066FF' },
  { icono: 'corazon',  nombre: 'Emocional',        texto: data.emocional,         color: '#7C3AED' },
  { icono: 'ciudad',   nombre: 'Ciudadana',        texto: data.ciudadana,         color: '#B86600' },
  { icono: 'mundo',    nombre: 'Local',            texto: data.local,             color: '#58A923' },
  { icono: 'mayor',    nombre: 'Intergeneracional', texto: data.intergeneracional, color: '#5A0038' },
];
---

<section class="mb-10" aria-labelledby="dimensiones-titulo">
  <div class="flex items-center gap-2.5 mb-3" style="color: var(--fg-muted);">
    <IconoMILC nombre="✅" size={18} />
    <span class="text-[11px] font-black uppercase tracking-[0.14em]">
      Evaluación liberadora
    </span>
  </div>

  <h2 id="dimensiones-titulo" class="text-2xl md:text-3xl font-black tracking-tight leading-[1.1] mb-3">
    Cinco dimensiones que te llevas.
  </h2>

  <p class="text-base leading-relaxed max-w-2xl mb-6" style="color: var(--fg-muted);">
    No solo aprendiste un tema. Mira en cinco direcciones lo que esta sesión dejó en ti.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    {dimensiones.map((d) => (
      <article
        class="rounded-bento-lg p-5"
        style={`background: var(--bg-card); border: 1px solid var(--border); border-left: 5px solid ${d.color};`}
      >
        <div class="flex items-center gap-2 mb-2" style={`color: ${d.color};`}>
          <IconoMILC nombre={d.icono} size={17} />
          <h3 class="text-[11px] font-black uppercase tracking-[0.14em]">{d.nombre}</h3>
        </div>
        <p class="text-sm md:text-base leading-relaxed" style="color: var(--fg);">{d.texto}</p>
      </article>
    ))}
  </div>
</section>

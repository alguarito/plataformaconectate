---
import type { CincoDimensiones } from '../data/guiasContenido/_schema';

interface Props {
  data: CincoDimensiones;
}

const { data } = Astro.props;

const dimensiones = [
  { icono: '🧭', nombre: 'Personal',          texto: data.personal,          color: 'bg-bento-blue',   fg: 'text-white' },
  { icono: '💙', nombre: 'Emocional',         texto: data.emocional,         color: 'bg-bento-purple', fg: 'text-white' },
  { icono: '🏛',  nombre: 'Ciudadana',         texto: data.ciudadana,         color: 'bg-bento-orange', fg: 'text-white' },
  { icono: '🌎', nombre: 'Local',             texto: data.local,             color: 'bg-bento-lime',   fg: 'text-neutral-950' },
  { icono: '🧓', nombre: 'Intergeneracional', texto: data.intergeneracional, color: 'bg-bento-pink',   fg: 'text-white' },
];
---

<section class="mb-10" aria-labelledby="dimensiones-titulo">
  <div class="text-center mb-6">
    <span class="chip-bento mb-3">🌱 Evaluación liberadora</span>
    <h2 id="dimensiones-titulo" class="heading-huge leading-tight mt-2">
      Cinco dimensiones que te llevas.
    </h2>
    <p class="text-sm md:text-base leading-relaxed max-w-2xl mx-auto mt-3" style="color: var(--fg-muted);">
      No solo aprendiste un tema. Mira en cinco direcciones lo que esta sesión
      dejó en ti.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">
    {dimensiones.map((d) => (
      <article class:list={['rounded-bento-lg p-5', d.color, d.fg, 'flex flex-col']}>
        <div class="text-3xl mb-3" aria-hidden="true">{d.icono}</div>
        <h3 class="text-xs font-black uppercase tracking-widest opacity-90 mb-2">
          {d.nombre}
        </h3>
        <p class="text-sm leading-relaxed">
          {d.texto}
        </p>
      </article>
    ))}
  </div>
</section>

---
/**
 * Muestra el código de acceso de un aula con botón "Copiar" al portapapeles.
 *
 * Pensado para que el docente lo proyecte en clase o lo dicte fácilmente.
 * Visualmente: chip grande, tipografía monospace, alto contraste.
 */

interface Props {
  /** Código de acceso (ej "AULA-6A-2026-K3X7") */
  codigo: string;
  /** Tamaño visual: 'sm' para listas, 'lg' para vistas de detalle */
  size?: 'sm' | 'lg';
}

const { codigo, size = 'sm' } = Astro.props;

const sizeClasses = {
  sm: 'text-sm px-3 py-1.5 gap-2',
  lg: 'text-2xl md:text-3xl px-5 py-3 gap-3 tracking-wider',
}[size];
---

<div
  class:list={[
    'inline-flex items-center rounded-bento-sm',
    'bg-bento-blue/10 text-bento-blue dark:bg-bento-blue/20',
    'border border-bento-blue/30',
    'font-mono font-bold',
    sizeClasses,
  ]}
>
  <span data-codigo>{codigo}</span>
  <button
    type="button"
    data-copiar-codigo={codigo}
    class:list={[
      'inline-flex items-center justify-center',
      size === 'lg' ? 'w-10 h-10' : 'w-7 h-7',
      'rounded-full hover:bg-bento-blue/20 transition-colors motion-reduce:transition-none',
      'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bento-blue',
    ]}
    aria-label={`Copiar código ${codigo} al portapapeles`}
    title="Copiar al portapapeles"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size === 'lg' ? '20' : '14'}
      height={size === 'lg' ? '20' : '14'}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
    </svg>
  </button>
</div>

<script>
  document.querySelectorAll('[data-copiar-codigo]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const target = btn as HTMLButtonElement;
      const codigo = target.dataset.copiarCodigo ?? '';
      try {
        await navigator.clipboard.writeText(codigo);
        const original = target.innerHTML;
        target.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="${target.offsetWidth >= 32 ? '20' : '14'}" height="${target.offsetWidth >= 32 ? '20' : '14'}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>`;
        setTimeout(() => {
          target.innerHTML = original;
        }, 1500);
      } catch (err) {
        console.error('[CodigoAcceso] No se pudo copiar:', err);
        alert('No se pudo copiar el código. Verifica que tu navegador permita acceso al portapapeles.');
      }
    });
  });
</script>

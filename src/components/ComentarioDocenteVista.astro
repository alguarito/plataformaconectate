---
/**
 * ComentarioDocenteVista — muestra al estudiante el comentario que su docente
 * dejó en esta guía específica. Solo visible si hay sesión y existe el comentario.
 */
interface Props {
  grado: number;
  periodo: number;
  sesion: number;
}
const { grado, periodo, sesion } = Astro.props;
const guiaClave = `${grado}-${periodo}-${sesion}`;
---

<div
  data-comentario-docente-vista
  data-guia-clave={guiaClave}
  class="hidden bg-bento-blue/5 border border-bento-blue/20 rounded-bento-sm p-4"
  aria-live="polite"
>
  <p class="text-xs font-bold text-bento-blue mb-1.5">Retroalimentación de tu docente</p>
  <p data-cmt-vista-texto class="text-sm leading-relaxed whitespace-pre-wrap"></p>
  <p data-cmt-vista-fecha class="text-xs mt-2" style="color: var(--fg-muted);"></p>
</div>

<script>
  import { supabase } from '../lib/supabase';

  async function cargarComentario() {
    const wrapper = document.querySelector<HTMLElement>('[data-comentario-docente-vista]');
    if (!wrapper) return;
    const guiaClave = wrapper.dataset.guiaClave;
    if (!guiaClave) return;

    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;

    const { data } = await supabase
      .from('comentarios_docente')
      .select('texto, actualizado_en')
      .eq('estudiante_id', user.id)
      .eq('guia_clave', guiaClave)
      .order('actualizado_en', { ascending: false })
      .limit(1)
      .maybeSingle();

    if (!data?.texto) return;

    const textoEl = wrapper.querySelector('[data-cmt-vista-texto]');
    const fechaEl = wrapper.querySelector('[data-cmt-vista-fecha]');
    if (textoEl) textoEl.textContent = data.texto;
    if (fechaEl) {
      fechaEl.textContent = 'Actualizado el ' + new Date(data.actualizado_en).toLocaleDateString('es-CO', {
        day: '2-digit', month: 'short', year: 'numeric',
      });
    }
    wrapper.classList.remove('hidden');
  }

  cargarComentario().catch(() => {});
</script>

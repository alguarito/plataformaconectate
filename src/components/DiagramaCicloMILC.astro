---
/**
 * Diagrama SVG inline: ciclo MILC + triángulo + 5 dimensiones.
 * Vista circular con las 4 fases conectadas + triángulo de pensamiento al cierre.
 */
---

<figure class="w-full" aria-labelledby="diagrama-ciclo-titulo">
  <figcaption id="diagrama-ciclo-titulo" class="sr-only">
    Ciclo MILC de cuatro fases y cierre filosófico del triángulo de pensamiento.
  </figcaption>
  <svg
    viewBox="0 0 720 480"
    role="img"
    aria-label="Ciclo MILC: 4 fases circulares (Escuta, Sistematización, Praxis, Evaluación liberadora) y triángulo de pensamiento de cierre"
    class="w-full h-auto"
  >
    <!-- Conectores curvos entre fases -->
    <g fill="none" stroke="currentColor" stroke-width="2" opacity="0.3" stroke-dasharray="5 5">
      <!-- 1→2 -->
      <path d="M 220 110 Q 270 90 320 110" />
      <!-- 2→3 -->
      <path d="M 470 190 Q 490 240 470 290" />
      <!-- 3→4 -->
      <path d="M 320 370 Q 270 390 220 370" />
      <!-- 4→1 -->
      <path d="M 110 290 Q 90 240 110 190" />
    </g>
    <g fill="currentColor" opacity="0.5">
      <polygon points="318,105 328,110 318,118" />
      <polygon points="475,290 480,300 466,295" />
      <polygon points="220,375 210,370 220,365" transform="rotate(0)" />
      <polygon points="105,195 110,185 115,195" />
    </g>

    <!-- Fase 1: Escuta (arriba-izquierda) -->
    <g>
      <circle cx="160" cy="150" r="60" fill="#58A923" />
      <text x="160" y="142" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="32">1</text>
      <text x="160" y="170" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="700" font-size="14">Escuta</text>
      <text x="160" y="190" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.9">👂 escuchar</text>
    </g>

    <!-- Fase 2: Sistematización (arriba-derecha) -->
    <g>
      <circle cx="420" cy="150" r="60" fill="#00D4FF" />
      <text x="420" y="142" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="900" font-size="32">2</text>
      <text x="420" y="170" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="700" font-size="13">Sistematización</text>
      <text x="420" y="190" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.8">🗂 ordenar</text>
    </g>

    <!-- Fase 3: Praxis (abajo-derecha) -->
    <g>
      <circle cx="420" cy="330" r="60" fill="#FF2D87" />
      <text x="420" y="322" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="32">3</text>
      <text x="420" y="350" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="700" font-size="14">Praxis</text>
      <text x="420" y="370" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.9">🛠 hacer</text>
    </g>

    <!-- Fase 4: Evaluación liberadora (abajo-izquierda) -->
    <g>
      <circle cx="160" cy="330" r="60" fill="#7C3AED" />
      <text x="160" y="318" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="32">4</text>
      <text x="160" y="340" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="700" font-size="12">Evaluación</text>
      <text x="160" y="356" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="700" font-size="12">liberadora</text>
      <text x="160" y="375" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.9">🔄 reflexionar</text>
    </g>

    <!-- Centro: triángulo de pensamiento -->
    <g transform="translate(290, 240)">
      <polygon points="0,-60 52,30 -52,30" fill="#E5B400" opacity="0.95" />
      <text x="0" y="-8" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="900" font-size="14">Triángulo</text>
      <text x="0" y="12" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="700" font-size="12">de pensamiento</text>
      <!-- Vértices etiquetados -->
      <text x="0" y="-72" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="700" font-size="11">Dussel</text>
      <text x="62" y="46" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="700" font-size="11">Floridi</text>
      <text x="-62" y="46" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="700" font-size="11">Estoico</text>
    </g>

    <!-- Pie: 5 dimensiones -->
    <g transform="translate(0, 440)">
      <text x="360" y="0" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="700" font-size="12" opacity="0.7">
        Cierre: 5 dimensiones · personal · emocional · ciudadana · local · intergeneracional
      </text>
    </g>
  </svg>
</figure>

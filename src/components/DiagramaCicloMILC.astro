---
/**
 * Diagrama SVG inline: ciclo MILC + triángulo de pensamiento al centro.
 *
 * El triángulo no es una quinta etapa: es la lente filosófica que ilumina
 * las 4 fases desde el centro. Las 3 líneas amber tenues lo expresan.
 */
---

<figure class="w-full" aria-labelledby="diagrama-ciclo-titulo">
  <figcaption id="diagrama-ciclo-titulo" class="sr-only">
    Ciclo MILC de cuatro fases (Escucha, Sistematización, Praxis, Evaluación liberadora) iluminado desde el centro por el triángulo de pensamiento (Dussel, Floridi, Estoico).
  </figcaption>
  <svg
    viewBox="0 0 880 600"
    role="img"
    aria-label="Ciclo MILC: 4 fases en círculo con triángulo de pensamiento de Dussel, Floridi y Estoico al centro"
    class="w-full h-auto font-sans"
  >
    <defs>
      <marker id="arrow-lime" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 Z" fill="#4D7C0F" />
      </marker>
      <marker id="arrow-cyan" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 Z" fill="#00D4FF" />
      </marker>
      <marker id="arrow-pink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 Z" fill="#FF2D87" />
      </marker>
      <marker id="arrow-purple" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 Z" fill="#7C3AED" />
      </marker>
    </defs>

    <!-- Líneas amber tenues: el triángulo irradia a las 4 fases -->
    <g stroke="#F59E0B" stroke-width="1.5" opacity="0.22" stroke-dasharray="3 4">
      <line x1="440" y1="290" x2="240" y2="155" />
      <line x1="440" y1="290" x2="640" y2="155" />
      <line x1="440" y1="290" x2="640" y2="425" />
      <line x1="440" y1="290" x2="240" y2="425" />
    </g>

    <!-- Flechas del ciclo, sólidas, con color del nodo origen -->
    <path d="M 315 130 Q 440 50 565 130" fill="none" stroke="#4D7C0F" stroke-width="3" marker-end="url(#arrow-lime)" />
    <text x="440" y="70" text-anchor="middle" fill="currentColor" font-size="13" font-weight="600" font-style="italic" opacity="0.75">
      lo oído emerge en orden
    </text>

    <path d="M 715 205 Q 800 290 715 375" fill="none" stroke="#00D4FF" stroke-width="3" marker-end="url(#arrow-cyan)" />
    <text x="820" y="294" text-anchor="middle" fill="currentColor" font-size="13" font-weight="600" font-style="italic" opacity="0.75" transform="rotate(90, 820, 294)">
      ordenar abre la acción
    </text>

    <path d="M 565 450 Q 440 530 315 450" fill="none" stroke="#FF2D87" stroke-width="3" marker-end="url(#arrow-pink)" />
    <text x="440" y="528" text-anchor="middle" fill="currentColor" font-size="13" font-weight="600" font-style="italic" opacity="0.75">
      actuar revela criterios
    </text>

    <path d="M 165 375 Q 80 290 165 205" fill="none" stroke="#7C3AED" stroke-width="3" marker-end="url(#arrow-purple)" />
    <text x="60" y="294" text-anchor="middle" fill="currentColor" font-size="13" font-weight="600" font-style="italic" opacity="0.75" transform="rotate(-90, 60, 294)">
      evaluar afina la escucha
    </text>

    <!-- Fase 1 · Escucha -->
    <g>
      <circle cx="240" cy="155" r="75" fill="#4D7C0F" />
      <text x="240" y="142" text-anchor="middle" fill="white" font-size="36" font-weight="900">1</text>
      <text x="240" y="172" text-anchor="middle" fill="white" font-size="16" font-weight="700">Escucha</text>
      <text x="240" y="192" text-anchor="middle" fill="white" font-size="11" font-weight="500" opacity="0.92">oír al otro</text>
    </g>

    <!-- Fase 2 · Sistematización -->
    <g>
      <circle cx="640" cy="155" r="75" fill="#00D4FF" />
      <text x="640" y="140" text-anchor="middle" fill="#18181B" font-size="36" font-weight="900">2</text>
      <text x="640" y="170" text-anchor="middle" fill="#18181B" font-size="15" font-weight="700">Sistematización</text>
      <text x="640" y="190" text-anchor="middle" fill="#18181B" font-size="11" font-weight="500" opacity="0.8">ordenar lo escuchado</text>
    </g>

    <!-- Fase 3 · Praxis -->
    <g>
      <circle cx="640" cy="425" r="75" fill="#FF2D87" />
      <text x="640" y="412" text-anchor="middle" fill="white" font-size="36" font-weight="900">3</text>
      <text x="640" y="442" text-anchor="middle" fill="white" font-size="16" font-weight="700">Praxis</text>
      <text x="640" y="462" text-anchor="middle" fill="white" font-size="11" font-weight="500" opacity="0.92">hacer con sentido</text>
    </g>

    <!-- Fase 4 · Evaluación liberadora -->
    <g>
      <circle cx="240" cy="425" r="75" fill="#7C3AED" />
      <text x="240" y="408" text-anchor="middle" fill="white" font-size="36" font-weight="900">4</text>
      <text x="240" y="432" text-anchor="middle" fill="white" font-size="14" font-weight="700">Evaluación</text>
      <text x="240" y="448" text-anchor="middle" fill="white" font-size="14" font-weight="700">liberadora</text>
      <text x="240" y="468" text-anchor="middle" fill="white" font-size="11" font-weight="500" opacity="0.92">reflexionar y volver</text>
    </g>

    <!-- Triángulo central · alma filosófica -->
    <g>
      <text x="440" y="195" text-anchor="middle" fill="currentColor" font-size="13" font-weight="700">Dussel</text>
      <text x="515" y="343" text-anchor="middle" fill="currentColor" font-size="13" font-weight="700">Floridi</text>
      <text x="365" y="343" text-anchor="middle" fill="currentColor" font-size="13" font-weight="700">Estoico</text>

      <polygon points="440,220 503,326 377,326" fill="#F59E0B" opacity="0.95" />

      <text x="440" y="292" text-anchor="middle" fill="#18181B" font-size="12" font-weight="800" letter-spacing="-0.01em">Triángulo</text>
      <text x="440" y="308" text-anchor="middle" fill="#18181B" font-size="9" font-weight="600" opacity="0.78">de pensamiento</text>
    </g>

    <!-- Cierre · 5 dimensiones -->
    <text x="440" y="576" text-anchor="middle" fill="currentColor" font-size="12" font-weight="600" opacity="0.7">
      Cierre transversal · 5 dimensiones · personal · emocional · ciudadana · local · intergeneracional
    </text>
  </svg>
</figure>

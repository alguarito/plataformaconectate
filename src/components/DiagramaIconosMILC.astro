---
/**
 * Diagrama SVG inline: los 7 íconos del vocabulario MILC.
 * 🌱 📖 ✏️ 👁 ✅ 🔎 💭 + qué significa cada uno + qué va al cuaderno.
 * Layout: grilla 4×2 con casillas coloreadas.
 */

const ICONOS = [
  { emoji: '🌱', label: 'SABER ANCESTRAL', desc: 'Apertura · anclaje a saberes locales', color: '#58A923', textColor: 'white', cuaderno: true },
  { emoji: '📖', label: 'LEE',             desc: 'Contenido para comprender, no copiar', color: '#E5B400', textColor: 'black', cuaderno: false },
  { emoji: '✏️', label: 'ACTIVIDAD',       desc: 'Produce escritura en el cuaderno',     color: '#0066FF', textColor: 'white', cuaderno: true },
  { emoji: '👁', label: 'OBSERVA',         desc: 'Atención dirigida sin escritura',      color: '#7C3AED', textColor: 'white', cuaderno: false },
  { emoji: '✅', label: 'VERIFICA',        desc: 'Mini-quiz mental, no al cuaderno',     color: '#A3FF12', textColor: 'black', cuaderno: false },
  { emoji: '🔎', label: 'EXPLORA',         desc: 'Acción en el computador',              color: '#00D4FF', textColor: 'black', cuaderno: false },
  { emoji: '💭', label: 'REFLEXIONA',      desc: 'Cierre filosófico · va al cuaderno',   color: '#5A0038', textColor: 'white', cuaderno: true },
];
---

<figure class="w-full" aria-labelledby="diagrama-iconos-titulo">
  <figcaption id="diagrama-iconos-titulo" class="sr-only">
    Los 7 íconos del vocabulario visual MILC y qué significa cada uno.
  </figcaption>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
    {ICONOS.map((it) => (
      <div
        class="rounded-bento-sm p-4 flex flex-col gap-2 transition-transform hover:scale-[1.02]"
        style={`background: ${it.color}; color: ${it.textColor};`}
      >
        <div class="text-4xl leading-none">{it.emoji}</div>
        <div class="text-xs font-black tracking-widest uppercase opacity-90">{it.label}</div>
        <div class="text-xs font-semibold leading-snug" style="opacity: 0.85;">{it.desc}</div>
        {it.cuaderno && (
          <div class="text-[10px] font-bold uppercase mt-auto px-2 py-0.5 rounded-full bg-black/15 self-start">
            📓 al cuaderno
          </div>
        )}
      </div>
    ))}
  </div>
</figure>

---
/**
 * Diagrama SVG inline: ruta de navegación de ConectaTE.
 * 4 niveles en horizontal con flechas: Inicio → Grado → Período → Guía/Proyecto/Examen.
 * Dark-mode-aware vía currentColor + variables CSS.
 */
---

<figure class="w-full" aria-labelledby="diagrama-navegacion-titulo">
  <figcaption id="diagrama-navegacion-titulo" class="sr-only">
    Ruta de navegación: del inicio al recurso final en 4 pasos.
  </figcaption>
  <svg
    viewBox="0 0 920 220"
    role="img"
    aria-label="Diagrama de navegación: Inicio, Grado, Período, Recurso (guía, proyecto o examen)"
    class="w-full h-auto"
  >
    <!-- Conectores -->
    <g stroke="currentColor" stroke-width="2" fill="none" opacity="0.35">
      <line x1="175" y1="110" x2="245" y2="110" stroke-dasharray="4 4" />
      <line x1="395" y1="110" x2="465" y2="110" stroke-dasharray="4 4" />
      <line x1="615" y1="110" x2="685" y2="110" stroke-dasharray="4 4" />
    </g>
    <!-- Flechas -->
    <g fill="currentColor" opacity="0.6">
      <polygon points="245,105 255,110 245,115" />
      <polygon points="465,105 475,110 465,115" />
      <polygon points="685,105 695,110 685,115" />
    </g>

    <!-- Paso 1 · Inicio -->
    <g>
      <rect x="35" y="60" width="140" height="100" rx="16" fill="#0066FF" />
      <text x="105" y="100" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="32">1</text>
      <text x="105" y="135" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="700" font-size="16">Inicio</text>
      <text x="105" y="180" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.7">Home · conectate</text>
    </g>

    <!-- Paso 2 · Grado -->
    <g>
      <rect x="255" y="60" width="140" height="100" rx="16" fill="#A3FF12" />
      <text x="325" y="100" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="900" font-size="32">2</text>
      <text x="325" y="135" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="700" font-size="16">Grado 6°–11°</text>
      <text x="325" y="180" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.7">6 grados activos</text>
    </g>

    <!-- Paso 3 · Período -->
    <g>
      <rect x="475" y="60" width="140" height="100" rx="16" fill="#FF2D87" />
      <text x="545" y="100" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="32">3</text>
      <text x="545" y="135" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="700" font-size="16">Período 1, 2 o 3</text>
      <text x="545" y="180" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.7">10 sesiones c/u</text>
    </g>

    <!-- Paso 4 · Recurso -->
    <g>
      <rect x="695" y="60" width="195" height="100" rx="16" fill="#7C3AED" />
      <text x="792" y="98" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="32">4</text>
      <text x="792" y="125" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="700" font-size="14">Guía · Proyecto</text>
      <text x="792" y="143" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="700" font-size="14">Examen</text>
      <text x="792" y="180" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.7">226 piezas curriculares</text>
    </g>
  </svg>
</figure>

---
/**
 * Diagrama SVG inline: pipeline editorial MILC v3.
 * 1 YAML como single source of truth → builder Python → 2 salidas (PDF + TS web).
 */
---

<figure class="w-full" aria-labelledby="diagrama-pipeline-titulo">
  <figcaption id="diagrama-pipeline-titulo" class="sr-only">
    Pipeline editorial MILC v3: un YAML genera el PDF imprimible y el TS de la web.
  </figcaption>
  <svg
    viewBox="0 0 920 320"
    role="img"
    aria-label="Pipeline editorial MILC v3: un archivo YAML único alimenta el builder Python que produce el PDF imprimible y el TypeScript de la web"
    class="w-full h-auto"
  >
    <!-- Conectores: YAML → builder → 2 salidas -->
    <g stroke="currentColor" stroke-width="2" fill="none" opacity="0.35">
      <line x1="265" y1="160" x2="345" y2="160" stroke-dasharray="4 4" />
      <line x1="575" y1="120" x2="660" y2="80" stroke-dasharray="4 4" />
      <line x1="575" y1="200" x2="660" y2="240" stroke-dasharray="4 4" />
    </g>
    <g fill="currentColor" opacity="0.6">
      <polygon points="345,155 355,160 345,165" />
      <polygon points="660,75 670,80 657,85" />
      <polygon points="660,235 670,240 657,245" />
    </g>

    <!-- YAML (entrada) -->
    <g>
      <rect x="40" y="100" width="225" height="120" rx="16" fill="#5A0038" />
      <text x="152" y="135" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="14" letter-spacing="2">SINGLE SOURCE OF TRUTH</text>
      <text x="152" y="172" text-anchor="middle" fill="#FFD60A" font-family="Helvetica, sans-serif" font-weight="900" font-size="28">YAML</text>
      <text x="152" y="200" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="500" font-size="12" opacity="0.85">content/guias/*.yaml</text>
    </g>

    <!-- Builder (centro) -->
    <g>
      <rect x="355" y="100" width="220" height="120" rx="16" fill="#0066FF" />
      <text x="465" y="135" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="14" letter-spacing="2">BUILDER PYTHON</text>
      <text x="465" y="170" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="24">make guia-build</text>
      <text x="465" y="200" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.85">linter + xelatex + tsgen</text>
    </g>

    <!-- Salida 1: PDF (arriba derecha) -->
    <g>
      <rect x="670" y="30" width="220" height="100" rx="16" fill="#FF2D87" />
      <text x="780" y="62" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="13" letter-spacing="2">SALIDA 1</text>
      <text x="780" y="92" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="900" font-size="20">📄 PDF imprimible</text>
      <text x="780" y="115" text-anchor="middle" fill="white" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.9">vía xelatex · sin proyector</text>
    </g>

    <!-- Salida 2: TS web (abajo derecha) -->
    <g>
      <rect x="670" y="190" width="220" height="100" rx="16" fill="#00D4FF" />
      <text x="780" y="222" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="900" font-size="13" letter-spacing="2">SALIDA 2</text>
      <text x="780" y="252" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="900" font-size="20">⚡ TS para web</text>
      <text x="780" y="275" text-anchor="middle" fill="black" font-family="Helvetica, sans-serif" font-weight="500" font-size="11" opacity="0.85">Astro · interactivo · offline</text>
    </g>

    <!-- Pie: regla -->
    <text x="460" y="305" text-anchor="middle" fill="currentColor" font-family="Helvetica, sans-serif" font-weight="700" font-size="12" opacity="0.7">
      Editas el YAML · jamás el .pdf o el .ts · validación automática del contrato editorial
    </text>
  </svg>
</figure>

---
/**
 * DocenteTabs · navegación de la zona docente (Aulas / Informes).
 * Marca la pestaña activa según la ruta actual. Mobile-first (chips).
 */
const base = (import.meta.env?.BASE_URL ?? '/').replace(/\/$/, '');
const path = Astro.url.pathname;
const enInformes = path.includes('/docente/informes');
const tabs = [
  { href: `${base}/docente`, label: 'Aulas', activa: !enInformes },
  { href: `${base}/docente/informes`, label: 'Informes', activa: enInformes },
];
---

<nav class="flex gap-2 mb-6" aria-label="Secciones del panel docente">
  {
    tabs.map((t) => (
      <a
        href={t.href}
        aria-current={t.activa ? 'page' : undefined}
        class:list={[
          'px-4 py-2 rounded-bento-sm text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bento-blue',
          t.activa
            ? 'bg-bento-blue text-white'
            : 'bg-white dark:bg-neutral-900 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-50 dark:hover:bg-neutral-800 shadow-bento',
        ]}
      >
        {t.label}
      </a>
    ))
  }
</nav>

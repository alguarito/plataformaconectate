---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

// WhatsApp del docente (formato internacional sin "+", para wa.me)
const whatsappNumero = '573206324740';
const whatsappVisible = '+57 320 632 4740';
const whatsappMensaje =
  'Hola Dr. Cárdenas, le escribo desde la plataforma ConectaTE.';
const whatsappHref = `https://wa.me/${whatsappNumero}?text=${encodeURIComponent(whatsappMensaje)}`;
---

<footer class="footer relative mt-24 border-t" style="border-color: var(--border);">
  <div class="bento-container pt-16 pb-8">

    <!-- ═══════════════ HERO BAND · brand + stats ═══════════════ -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-8 items-center pb-12 mb-12 border-b" style="border-color: var(--border);">
      <a href={base || '/'} class="flex items-center gap-3.5 group hover:opacity-90 transition-opacity">
        <img
          src={`${base}/LOGO.png`}
          alt="ConectaTE — Dr. Álvaro Cárdenas"
          class="w-16 h-16 rounded-full object-cover bg-white shrink-0 transition-transform duration-300 group-hover:rotate-6"
          style="box-shadow: 0 8px 24px rgba(0, 102, 255, 0.22);"
          loading="lazy"
        />
        <div class="flex flex-col gap-1 min-w-0">
          <span class="text-[28px] font-black tracking-tighter leading-none">
            Conecta<span class="text-bento-blue">TE</span>
          </span>
          <span class="text-sm leading-snug" style="color: var(--fg-muted);">
            Plataforma de Tecnología e Informática para grados 6° a 11°.
          </span>
        </div>
      </a>

      <div
        class="stats-grid grid grid-cols-4 rounded-bento overflow-hidden border"
        style="border-color: var(--border); background: var(--bg-card);"
        aria-label="Recursos publicados en la plataforma"
      >
        <div class="px-4 py-4 text-center border-r" style="border-color: var(--border);">
          <div class="text-[26px] md:text-[28px] font-black tracking-tight leading-none mb-1 text-bento-blue">190</div>
          <div class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.12em]" style="color: var(--fg-muted);">Guías</div>
        </div>
        <div class="px-4 py-4 text-center border-r" style="border-color: var(--border);">
          <div class="text-[26px] md:text-[28px] font-black tracking-tight leading-none mb-1 text-bento-pink">18</div>
          <div class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.12em]" style="color: var(--fg-muted);">Proyectos</div>
        </div>
        <div class="px-4 py-4 text-center border-r" style="border-color: var(--border);">
          <div class="text-[26px] md:text-[28px] font-black tracking-tight leading-none mb-1 text-bento-cyan">18</div>
          <div class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.12em]" style="color: var(--fg-muted);">Exámenes</div>
        </div>
        <div class="px-4 py-4 text-center">
          <div class="text-[26px] md:text-[28px] font-black tracking-tight leading-none mb-1">6</div>
          <div class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.12em]" style="color: var(--fg-muted);">Grados</div>
        </div>
      </div>
    </div>

    <!-- ═══════════════ MID GRID · 3 COLUMNAS · institución + docente + contacto ═══════════════ -->
    <div
      class="mid-grid grid grid-cols-1 gap-10 pb-10 mb-6 border-b"
      style="border-color: var(--border);"
    >

      <!-- ─── COL 1 · Institución (limpia, sin botón) ─── -->
      <div>
        <span class="col-label">Institución</span>
        <div class="text-lg font-extrabold tracking-tight leading-tight mb-2">
          I.E. Sor María Juliana
        </div>
        <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">
          Cartago, Valle del Cauca<br />
          Colombia
        </p>
      </div>

      <!-- ─── COL 2 · Docente (avatar + nombre + Plan de Área al fondo) ─── -->
      <div class="col-docente">
        <span class="col-label">Docente</span>

        <div class="flex items-center gap-4 mb-5">
          <img
            src={`${base}/LOGO.png`}
            alt="Dr. Álvaro Cárdenas Orozco"
            class="w-[72px] h-[72px] rounded-full object-cover bg-bento-blue shrink-0"
            style="box-shadow: 0 8px 22px rgba(0, 102, 255, 0.32); border: 3px solid var(--bg-card);"
            loading="lazy"
          />
          <div class="min-w-0">
            <div class="text-lg font-extrabold tracking-tight leading-tight mb-1">
              Dr. Álvaro Cárdenas Orozco
            </div>
            <div class="text-xs leading-snug" style="color: var(--fg-muted);">
              Tecnología e Informática · Grados 6° a 11°
            </div>
          </div>
        </div>

        <a
          href={`${base}/plan-de-area`}
          class="plan-btn flex items-center justify-between gap-3 px-[18px] py-[13px] rounded-2xl font-bold transition-all"
          aria-label={`Plan de Área ${year} · documento rector institucional`}
        >
          <span class="flex items-center gap-2.5">
            <svg class="w-[22px] h-[22px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="8" y1="13" x2="16" y2="13"></line>
              <line x1="8" y1="17" x2="16" y2="17"></line>
            </svg>
            <span class="flex flex-col leading-tight min-w-0">
              <span class="text-sm">Plan de Área {year}</span>
              <span class="text-[10.5px] font-medium opacity-78 tracking-wide">39 páginas · documento rector institucional</span>
            </span>
          </span>
          <svg class="w-5 h-5 opacity-78 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>

      <!-- ─── COL 3 · Contacto (WhatsApp + Conóceme) ─── -->
      <div>
        <span class="col-label">Contacto</span>

        <div class="flex flex-col gap-2.5">
          <!-- WhatsApp primario -->
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener"
            class="wa-btn flex items-center justify-between gap-3 px-[18px] py-[13px] bg-[#25D366] text-white rounded-2xl font-bold transition-all"
            aria-label={`Escribir al docente por WhatsApp ${whatsappVisible}`}
          >
            <span class="flex items-center gap-2.5">
              <svg class="w-[22px] h-[22px] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.91 9.91 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.02ZM12.04 20.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.21 8.21 0 0 1-1.26-4.39c0-4.54 3.7-8.24 8.25-8.24a8.18 8.18 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.42 5.83c0 4.54-3.7 8.24-8.25 8.24Zm4.52-6.16c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.79.96-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31s-.86.85-.86 2.06c0 1.21.88 2.39 1 2.55.12.17 1.74 2.66 4.21 3.74.59.26 1.05.41 1.4.52.59.19 1.13.16 1.55.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.15-1.17-.06-.1-.22-.16-.46-.28Z"/>
              </svg>
              <span class="flex flex-col leading-tight min-w-0">
                <span class="text-sm">Escríbeme por WhatsApp</span>
                <span class="text-[10.5px] font-medium opacity-90 tracking-wide">{whatsappVisible}</span>
              </span>
            </span>
            <svg class="w-5 h-5 opacity-85 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7" />
              <polyline points="7 7 17 7 17 17" />
            </svg>
          </a>

          <!-- Conóceme secundario -->
          <a
            href={`${base}/acerca`}
            class="conoceme-btn flex items-center justify-between gap-3 px-[18px] py-[13px] rounded-2xl font-bold transition-all"
            aria-label="Conoce al Dr. Álvaro Cárdenas — trayectoria completa"
          >
            <span class="flex items-center gap-2.5">
              <svg class="w-[22px] h-[22px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span class="flex flex-col leading-tight min-w-0">
                <span class="text-sm">Conóceme</span>
                <span class="text-[10.5px] font-medium opacity-78 tracking-wide">Trayectoria · publicaciones · experiencia</span>
              </span>
            </span>
            <svg class="w-5 h-5 opacity-78 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- ═══════════════ BOTTOM BAR · legal + licencia ═══════════════ -->
    <div class="flex flex-col gap-5 text-xs" style="color: var(--fg-muted);">
      <!-- fila 1 · crédito + dedicatoria -->
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <p>© {year} ConectaTE · PhD. Álvaro Cárdenas Orozco</p>
        <p>Hecho con <span class="text-bento-pink">❤</span> para los estudiantes de Sor María Juliana</p>
      </div>

      <!-- fila 2 · licencia Creative Commons BY-NC-SA 4.0 -->
      <div class="flex flex-col sm:flex-row sm:items-start gap-3 pt-5 border-t" style="border-color: var(--border);">
        <a
          href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es"
          target="_blank"
          rel="noopener license"
          class="cc-badge inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border font-bold shrink-0 self-start whitespace-nowrap transition-colors"
          style="border-color: var(--border);"
          aria-label="Licencia Creative Commons Atribución-NoComercial-CompartirIgual 4.0 Internacional (se abre en una pestaña nueva)"
        >
          <span class="inline-flex items-center justify-center w-[18px] h-[18px] rounded-full border-[1.5px] border-current text-[9px] font-black leading-none">cc</span>
          <span>BY-NC-SA 4.0</span>
        </a>
        <p class="leading-relaxed">
          Contenido propio bajo
          <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.es" target="_blank" rel="noopener license" class="font-bold underline decoration-dotted underline-offset-2 hover:opacity-70 transition-opacity" style="color: var(--fg);">Creative Commons BY-NC-SA 4.0</a>:
          puedes compartirlo y adaptarlo citando al autor, sin fines comerciales y bajo la misma licencia. Los materiales de terceros (p. ej.
          <a href={`${base}/explora/salome`} class="underline underline-offset-2 hover:opacity-70 transition-opacity">Salomé · RECA</a>) conservan su propia licencia.
        </p>
      </div>
    </div>

  </div>
</footer>

<style>
  /* Gradiente sutil de fondo del footer */
  .footer {
    background: linear-gradient(180deg, transparent 0%, var(--bg-card) 100%);
  }

  /* Etiqueta de columna · línea del ancho del texto, no del contenedor */
  .col-label {
    display: block;
    width: fit-content;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--fg-muted);
    padding-bottom: 10px;
    margin-bottom: 14px;
    border-bottom: 2px solid var(--fg);
  }

  /* Desktop · 3 columnas equilibradas con buen aire entre col 2 y col 3 */
  @media (min-width: 1024px) {
    .mid-grid {
      grid-template-columns: 1.2fr 1.7fr 1.4fr;
      gap: 56px;
      align-items: start;
    }

    /* Col 2 · flex column para empujar el botón Plan al fondo · alinea con Conóceme */
    .col-docente {
      display: flex;
      flex-direction: column;
      height: 100%;
    }
    .col-docente .plan-btn {
      margin-top: auto;
      margin-left: 88px; /* avatar 72px + gap 16px · alinea con "Dr. Álvaro..." */
    }
  }

  /* Botón Plan de Área · outline bento-blue */
  .plan-btn {
    border: 2px solid var(--bento-blue);
    color: var(--bento-blue);
    background: transparent;
  }
  .plan-btn:hover {
    transform: translateY(-2px);
    background: var(--bento-blue);
    color: white;
    box-shadow: 0 14px 32px rgba(0, 102, 255, 0.28);
  }

  /* WhatsApp · hover con elevación y sombra verde */
  .wa-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(37, 211, 102, 0.32);
  }

  /* Conóceme · outline que se invierte */
  .conoceme-btn {
    border: 2px solid var(--fg);
    color: var(--fg);
    background: transparent;
  }
  .conoceme-btn:hover {
    transform: translateY(-2px);
    background: var(--fg);
    color: var(--bg-card);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.18);
  }

  /* Badge de licencia Creative Commons · mismo lenguaje que los botones */
  .cc-badge {
    color: var(--fg-muted);
  }
  .cc-badge:hover {
    color: var(--fg);
    border-color: var(--fg) !important;
  }
</style>

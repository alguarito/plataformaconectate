---
interface Props {
  numero: number;
  titulo: string;
  descripcion: string;
  bgClass: string;
  icono: string;
  href: string;
  size?: 'normal' | 'large';
  totalGuias?: number;
  totalPeriodos?: number;
  enConstruccion?: boolean;
}

const {
  numero,
  titulo,
  descripcion,
  bgClass,
  icono,
  href,
  size = 'normal',
  totalGuias,
  totalPeriodos,
  enConstruccion = false,
} = Astro.props;

const sizeClasses =
  size === 'large'
    ? 'md:col-span-8 md:row-span-2 min-h-[420px]'
    : 'md:col-span-4 min-h-[280px]';

// Contraste WCAG AA: fondos claros (lime/yellow/cyan) usan texto negro,
// fondos saturados usan texto blanco.
const fondosClaros = ['bg-bento-lime', 'bg-bento-yellow', 'bg-bento-cyan'];
const textOnBg = fondosClaros.includes(bgClass) ? 'text-neutral-950' : 'text-white';
const subtleOnBg = fondosClaros.includes(bgClass)
  ? 'text-neutral-950/70'
  : 'text-white/80';
const chipBg = fondosClaros.includes(bgClass)
  ? 'bg-neutral-950/10 text-neutral-950 ring-neutral-950/15'
  : 'bg-white/15 text-white ring-white/25';
const ringFocus = fondosClaros.includes(bgClass)
  ? 'focus-visible:ring-neutral-950'
  : 'focus-visible:ring-white';
---

{enConstruccion ? (
  <div
    data-grado-card={numero}
    data-en-construccion="true"
    aria-label={`Grado ${numero}°: ${titulo}. En construcción.`}
    aria-disabled="true"
    class:list={[
      'bento-card-color group relative flex flex-col cursor-not-allowed',
      bgClass,
      textOnBg,
      sizeClasses,
      'opacity-70',
    ]}
  >
    <div class="flex items-start justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <span
          class:list={[
            'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold tracking-wide ring-1',
            chipBg,
          ]}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 9v4" />
            <path d="M12 17h.01" />
            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
          </svg>
          En construcción
        </span>
      </div>
      <div
        class:list={[
          size === 'large' ? 'text-4xl md:text-5xl' : 'text-3xl md:text-4xl',
          'opacity-90',
        ]}
        aria-hidden="true"
      >
        {icono}
      </div>
    </div>

    <div
      class:list={[
        'font-black tracking-tighter leading-none select-none mt-3',
        size === 'large' ? 'text-7xl md:text-8xl' : 'text-7xl md:text-8xl',
      ]}
      aria-hidden="true"
    >
      {numero}°
    </div>

    <div class:list={[size === 'large' ? 'pt-6' : 'mt-auto pt-6']}>
      <h3
        class:list={[
          'font-black tracking-tight leading-tight mb-3',
          size === 'large' ? 'text-3xl md:text-5xl' : 'text-2xl md:text-3xl',
        ]}
      >
        {titulo}
      </h3>
      <p
        class:list={[
          'leading-relaxed mb-6 max-w-md',
          subtleOnBg,
          size === 'large' ? 'text-base md:text-lg' : 'text-sm md:text-base',
        ]}
      >
        {descripcion}
      </p>

      <div class="flex items-center gap-2 font-bold opacity-90">
        <span>Próximamente</span>
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10" />
          <polyline points="12 6 12 12 16 14" />
        </svg>
      </div>
    </div>
  </div>
) : (
  <a
    href={href}
    data-grado-card={numero}
    aria-label={`Grado ${numero}°: ${titulo}${totalGuias ? `. ${totalGuias} guías.` : ''}`}
    class:list={[
      'bento-card-color group relative flex flex-col',
      bgClass,
      textOnBg,
      sizeClasses,
      'transition-transform duration-300 motion-reduce:transition-none',
      'hover:scale-[1.01] active:scale-[0.99] motion-reduce:hover:scale-100 motion-reduce:active:scale-100',
      'focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-offset-4 focus-visible:ring-offset-transparent',
      ringFocus,
    ]}
  >
    <!-- Cabecera: chip de densidad + ícono temático discreto -->
    <div class="flex items-start justify-between gap-4">
      <div class="flex flex-wrap items-center gap-2">
        {totalGuias !== undefined && (
          <span
            class:list={[
              'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold tracking-wide ring-1',
              chipBg,
            ]}
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
            {totalGuias} guías
          </span>
        )}
        {totalPeriodos !== undefined && (
          <span
            class:list={[
              'inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold tracking-wide ring-1',
              chipBg,
            ]}
          >
            {totalPeriodos} periodos
          </span>
        )}
      </div>
      <div
        class:list={[
          size === 'large' ? 'text-4xl md:text-5xl' : 'text-3xl md:text-4xl',
          'opacity-90',
        ]}
        aria-hidden="true"
      >
        {icono}
      </div>
    </div>

    <!-- Número de grado: anchor visual en Inter black -->
    <div
      class:list={[
        'font-black tracking-tighter leading-none select-none mt-3',
        size === 'large' ? 'text-7xl md:text-8xl' : 'text-7xl md:text-8xl',
      ]}
      aria-hidden="true"
    >
      {numero}°
    </div>

    <!-- Cuerpo de texto + CTA. En normales se empuja al fondo; en large fluye junto al número. -->
    <div class:list={[size === 'large' ? 'pt-6' : 'mt-auto pt-6']}>
      <h3
        class:list={[
          'font-black tracking-tight leading-tight mb-3',
          size === 'large' ? 'text-3xl md:text-5xl' : 'text-2xl md:text-3xl',
        ]}
      >
        {titulo}
      </h3>
      <p
        class:list={[
          'leading-relaxed mb-6 max-w-md',
          subtleOnBg,
          size === 'large' ? 'text-base md:text-lg' : 'text-sm md:text-base',
        ]}
      >
        {descripcion}
      </p>

      <div class="flex items-center gap-2 font-bold">
        <span>Abrir grado {numero}°</span>
        <svg
          class="w-5 h-5 transition-transform duration-300 motion-reduce:transition-none group-hover:translate-x-1.5 motion-reduce:group-hover:translate-x-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </a>
)}

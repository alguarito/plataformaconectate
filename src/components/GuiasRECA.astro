---
/**
 * Bloque · Guías oficiales de RECA por módulo del programa Salomé.
 *
 * Tras ver el video, el estudiante accede a los dos materiales oficiales de
 * RECA del módulo, en orden: 1) la GUÍA RESUMEN (documento de síntesis, para
 * leer primero) y 2) la FICHA DE TRABAJO (el cuadernillo del cómic, para
 * desarrollar). Solo enlaza (no re-aloja) los PDF de RECA, con crédito.
 */
const GUIAS: Record<number, { resumen: string; ficha: string; fichaTitulo: string }> = {
  1: {
    resumen: 'https://drive.google.com/file/d/1n3_0wkHvDLSmJx9WpfnX4oBPq_-c1RI1/view?usp=sharing',
    ficha: 'https://drive.google.com/file/d/1ZOfcLeFmDp5aN1SPvSG4QcrKsrqVXHaV/view?usp=sharing',
    fichaTitulo: 'Con la cabeza en las estrellas · págs. 1-16',
  },
  2: {
    resumen: 'https://drive.google.com/file/d/1d2-Lp8OLdZJC428F5XWsz_XQJFidF6D0/view?usp=sharing',
    ficha: 'https://drive.google.com/file/d/1OgzjV8TnJ49DVi-cBqPdvCncD7RNTvIq/view?usp=sharing',
    fichaTitulo: 'Descubramos otros mundos · págs. 17-34',
  },
  3: {
    resumen: 'https://drive.google.com/file/d/1bJC5D89t_bAUa8wwNx0ImH82xaVV20LM/view?usp=sharing',
    ficha: 'https://drive.google.com/file/d/1oWoYLW8HZBWy3yxDqhsG94cRhfAxgyDi/view?usp=sharing',
    fichaTitulo: 'El descubrimiento del primer exoplaneta · págs. 35-49',
  },
  4: {
    resumen: 'https://drive.google.com/file/d/1jVAH1faGdnlXdW0ytwn9TEOHF-wUwQKP/view?usp=sharing',
    ficha: 'https://drive.google.com/file/d/1fy7bS8ZMEEWncMwIYgP313Z0eWk2L8wf/view?usp=sharing',
    fichaTitulo: '¿Qué pasaría si existiera otra Tierra? · pág. 50 al final',
  },
};

interface Props {
  /** Número de módulo del Tomo 1 (1-4). */
  modulo: number;
}

const { modulo } = Astro.props;
const g = GUIAS[modulo];
---

{g && (
  <section class="bento-card mb-6" aria-label="Guías oficiales de RECA">
    <div class="flex items-center gap-3 mb-3 flex-wrap">
      <span class="chip-bento">📚 Guías oficiales · RECA</span>
      <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Después del video, sigue estos dos pasos</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <a href={g.resumen} target="_blank" rel="noopener" class="bento-card-hover flex items-start gap-3">
        <span class="w-8 h-8 rounded-full bg-bento-blue text-white flex items-center justify-center text-sm font-black shrink-0">1</span>
        <div class="flex-1 min-w-0">
          <div class="font-black text-sm leading-tight">📄 Lee el resumen</div>
          <div class="text-xs mt-0.5" style="color: var(--fg-muted);">Documento de síntesis del módulo · abre en Drive</div>
        </div>
        <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-muted);">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
      <a href={g.ficha} target="_blank" rel="noopener" class="bento-card-hover flex items-start gap-3">
        <span class="w-8 h-8 rounded-full bg-bento-lime text-neutral-950 flex items-center justify-center text-sm font-black shrink-0">2</span>
        <div class="flex-1 min-w-0">
          <div class="font-black text-sm leading-tight">✏️ Desarrolla la guía</div>
          <div class="text-xs mt-0.5" style="color: var(--fg-muted);">{g.fichaTitulo} · abre en Drive</div>
        </div>
        <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-muted);">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
    <p class="text-xs leading-relaxed mt-3" style="color: var(--fg-muted);">
      Material oficial de <strong style="color: var(--fg);">RECA</strong> y la Association Ágora de Hipatia. Se abre en una pestaña nueva.
    </p>
  </section>
)}

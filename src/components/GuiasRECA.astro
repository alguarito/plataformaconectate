---
/**
 * Bloque · Guías oficiales de RECA por módulo del programa Salomé.
 *
 * Tras el video, el estudiante accede a los materiales oficiales de RECA del
 * módulo, en orden pedagógico: 1) la GUÍA RESUMEN (síntesis, para leer primero)
 * y 2) la FICHA DE TRABAJO (el cuadernillo del cómic, para desarrollar).
 *
 * Soporta Tomo 1 (4 módulos, todos con resumen) y Tomo 2 (5 módulos; por ahora
 * solo el módulo 1 tiene resumen separado — el render se adapta y muestra solo
 * la ficha cuando no hay resumen). Solo enlaza (no re-aloja) los PDF de RECA.
 */
const D = 'https://drive.google.com/file/d/';
const V = '/view?usp=sharing';

type Guia = { resumen?: string; ficha: string; fichaTitulo: string };

const GUIAS: Record<number, Record<number, Guia>> = {
  1: {
    1: { resumen: `${D}1n3_0wkHvDLSmJx9WpfnX4oBPq_-c1RI1${V}`, ficha: `${D}1ZOfcLeFmDp5aN1SPvSG4QcrKsrqVXHaV${V}`, fichaTitulo: 'Con la cabeza en las estrellas · págs. 1-16' },
    2: { resumen: `${D}1d2-Lp8OLdZJC428F5XWsz_XQJFidF6D0${V}`, ficha: `${D}1OgzjV8TnJ49DVi-cBqPdvCncD7RNTvIq${V}`, fichaTitulo: 'Descubramos otros mundos · págs. 17-34' },
    3: { resumen: `${D}1bJC5D89t_bAUa8wwNx0ImH82xaVV20LM${V}`, ficha: `${D}1oWoYLW8HZBWy3yxDqhsG94cRhfAxgyDi${V}`, fichaTitulo: 'El descubrimiento del primer exoplaneta · págs. 35-49' },
    4: { resumen: `${D}1jVAH1faGdnlXdW0ytwn9TEOHF-wUwQKP${V}`, ficha: `${D}1fy7bS8ZMEEWncMwIYgP313Z0eWk2L8wf${V}`, fichaTitulo: '¿Qué pasaría si existiera otra Tierra? · pág. 50 al final' },
  },
  2: {
    1: { resumen: `${D}1mwDrA5R88iQYwYbl1ffo17bX_B1HN53D${V}`, ficha: `${D}1BUvBldmO9AYaVqvSV_EujX7MJwWZX09r${V}`, fichaTitulo: 'Una perspectiva diferente sobre la luz · págs. 1-23' },
    2: { ficha: `${D}1jnP2AfXw3LjM2RpONlkKrTuOXcxcsdpR${V}`, fichaTitulo: 'Los colores del arcoíris · págs. 24-33' },
    3: { ficha: `${D}1pW-fHcCatRk80djYmR7ufvTfh1WRl4in${V}`, fichaTitulo: 'Señales de vida en la atmósfera · págs. 34-48' },
    4: { ficha: `${D}1x2dOUTmUKQmAiPV3b8jRbu5C14XPZKwQ${V}`, fichaTitulo: 'El viaje de un rayo de luz · págs. 49-61' },
    5: { ficha: `${D}1uCswtvUPLxC5szCFAvDoTKnT0PmwI9xO${V}`, fichaTitulo: '#YoSoyPegasus · pág. 62 al final' },
  },
};

interface Props {
  /** Número de tomo (1 o 2). Por defecto 1. */
  tomo?: number;
  /** Número de módulo dentro del tomo. */
  modulo: number;
}

const { tomo = 1, modulo } = Astro.props;
const g = GUIAS[tomo]?.[modulo];
const tieneResumen = !!g?.resumen;
---

{g && (
  <section class="bento-card mb-6" aria-label="Guías oficiales de RECA">
    <div class="flex items-center gap-3 mb-3 flex-wrap">
      <span class="chip-bento">📚 Guías oficiales · RECA</span>
      <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">
        {tieneResumen ? 'Después del video, sigue estos dos pasos' : 'Descarga la guía oficial del cómic'}
      </span>
    </div>
    <div class:list={['grid grid-cols-1 gap-3', tieneResumen && 'sm:grid-cols-2']}>
      {tieneResumen && (
        <a href={g.resumen} target="_blank" rel="noopener" class="bento-card-hover flex items-start gap-3">
          <span class="w-8 h-8 rounded-full bg-bento-blue text-white flex items-center justify-center text-sm font-black shrink-0">1</span>
          <div class="flex-1 min-w-0">
            <div class="font-black text-sm leading-tight">📄 Lee el resumen</div>
            <div class="text-xs mt-0.5" style="color: var(--fg-muted);">Documento de síntesis del módulo · abre en Drive</div>
          </div>
          <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-muted);">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      )}
      <a href={g.ficha} target="_blank" rel="noopener" class="bento-card-hover flex items-start gap-3">
        <span class="w-8 h-8 rounded-full bg-bento-lime text-neutral-950 flex items-center justify-center text-sm font-black shrink-0">{tieneResumen ? '2' : '✏️'}</span>
        <div class="flex-1 min-w-0">
          <div class="font-black text-sm leading-tight">✏️ Desarrolla la guía</div>
          <div class="text-xs mt-0.5" style="color: var(--fg-muted);">{g.fichaTitulo} · abre en Drive</div>
        </div>
        <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--fg-muted);">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>
    <p class="text-xs leading-relaxed mt-3" style="color: var(--fg-muted);">
      Material oficial de <strong style="color: var(--fg);">RECA</strong> y la Association Ágora de Hipatia. Se abre en una pestaña nueva.
    </p>
  </section>
)}

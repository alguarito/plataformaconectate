---
/**
 * Laboratorio · Simulador de curva de luz (método de tránsito).
 *
 * El estudiante mueve dos controles —tamaño del planeta y distancia a la
 * estrella— y la curva de luz se redibuja EN VIVO. Un panel de lecturas (sin
 * tapar la gráfica) muestra la profundidad, el período, el tamaño y el tipo de
 * planeta que va creando. Incluye una curva objetivo (gris) y un reto: replicar
 * la "estrella misteriosa".
 *
 * El SVG de ejes/grid se renderiza en el servidor; las curvas se calculan en el
 * cliente con JavaScript (interactividad). Tipo propio, reutilizable.
 */
export interface DataCurvaLuz {
  titulo: string;
  instrucciones: string;
  /** Nombre del objeto del ejemplo (decorativo). */
  objeto?: string;
}

interface Props {
  data: DataCurvaLuz;
  id: string;
}

const { data, id } = Astro.props;

// Geometría del SVG
const W = 680;
const H = 300;
const ml = 58;
const mr = 20;
const mt = 24;
const mb = 48;
const tMax = 32;
const yMin = 97.3;
const yMax = 100.4;
const x0 = ml;
const x1 = W - mr;
const y0 = mt;
const y1 = H - mb;
const xScale = (t: number) => x0 + (t / tMax) * (x1 - x0);
const yScale = (b: number) => y1 - ((b - yMin) / (yMax - yMin)) * (y1 - y0);

// Objetivo del reto: un "Júpiter caliente" (grande y cercano)
const targetR = 12; // radios terrestres → profundidad ≈ 1,44 %
const targetDist = 0.08; // UA → período ≈ 8 días

const ticksX = [0, 8, 16, 24, 32];
const ticksY = [98, 99, 100];
---

<div class="bento-card" data-lab-curva={id}>
  <span class="chip-bento mb-2">🔭 Laboratorio · Simulador de tránsito</span>
  <h3 class="text-xl md:text-2xl font-black tracking-tight leading-tight">{data.titulo}</h3>
  <p class="text-sm leading-relaxed mt-2 mb-4" style="color: var(--fg-muted);">{data.instrucciones}</p>

  <!-- Leyenda -->
  <div class="flex flex-wrap gap-4 mb-2 text-xs font-bold">
    <span class="flex items-center gap-2"><span style="display:inline-block;width:18px;height:0;border-top:3px solid #0066FF;"></span> Tu planeta</span>
    <span class="flex items-center gap-2" style="color: var(--fg-muted);"><span style="display:inline-block;width:18px;height:0;border-top:3px dashed #9aa0a6;"></span> Estrella misteriosa (reto)</span>
  </div>

  <!-- Gráfica -->
  <div class="rounded-bento-sm overflow-hidden" style="line-height:0;">
    <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" style="min-width: 460px;" role="img"
      aria-label="Simulador de curva de luz: mueve los controles de tamaño del planeta y distancia para cambiar la profundidad y el período de los tránsitos.">
      <defs>
        <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0b1030" />
          <stop offset="100%" stop-color="#161038" />
        </linearGradient>
        <filter id={`${id}-glow`} x="-10%" y="-60%" width="120%" height="220%">
          <feGaussianBlur stdDeviation="2" />
        </filter>
      </defs>
      <rect x="0" y="0" width={W} height={H} fill={`url(#${id}-sky)`} />
      {ticksY.map((b) => (
        <g>
          <line x1={x0} y1={yScale(b)} x2={x1} y2={yScale(b)} stroke="#3a4170" stroke-width="1" stroke-dasharray="3 4" />
          <text x={x0 - 8} y={yScale(b) + 4} text-anchor="end" font-size="12" font-weight="700" fill="#9aa2c8">{b}%</text>
        </g>
      ))}
      <line x1={x0} y1={y1} x2={x1} y2={y1} stroke="#6b74a0" stroke-width="1.5" />
      {ticksX.map((t) => (
        <g>
          <line x1={xScale(t)} y1={y1} x2={xScale(t)} y2={y1 + 5} stroke="#6b74a0" stroke-width="1.5" />
          <text x={xScale(t)} y={y1 + 22} text-anchor="middle" font-size="12" font-weight="700" fill="#9aa2c8">{t}</text>
        </g>
      ))}
      <text x={(x0 + x1) / 2} y={H - 6} text-anchor="middle" font-size="12" font-weight="800" fill="#e3e7f6">Tiempo (días)</text>
      <text transform={`rotate(-90 15 ${(y0 + y1) / 2})`} x="15" y={(y0 + y1) / 2} text-anchor="middle" font-size="12" font-weight="800" fill="#e3e7f6">Brillo</text>

      <!-- Guía 100% -->
      <line x1={x0} y1={yScale(100)} x2={x1} y2={yScale(100)} stroke="#5b6cff" stroke-width="1" stroke-dasharray="1 4" opacity="0.6" />

      <!-- Curvas (las llena el JS) -->
      <polyline data-curva-objetivo points="" fill="none" stroke="#aab2d5" stroke-width="2" stroke-dasharray="5 4" stroke-linejoin="round" opacity="0.7" />
      <polyline data-curva-estudiante points="" fill="none" stroke="#5aa0ff" stroke-width="2.5" stroke-linejoin="round" filter={`url(#${id}-glow)`} />
    </svg>
  </div>

  <!-- Controles -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-5">
    <div>
      <label class="flex items-center justify-between text-sm font-black mb-1" for={`${id}-r`}>
        <span>🪐 Tamaño del planeta</span>
        <span data-out-tamano style="color: var(--fg-muted);">4 × Tierra</span>
      </label>
      <input id={`${id}-r`} data-slider-radio type="range" min="1" max="14" step="0.5" value="4" class="w-full" style="accent-color:#0066FF;" />
      <div class="flex justify-between text-[10px] font-bold mt-0.5" style="color: var(--fg-muted);"><span>pequeño</span><span>gigante</span></div>
    </div>
    <div>
      <label class="flex items-center justify-between text-sm font-black mb-1" for={`${id}-d`}>
        <span>📏 Distancia a la estrella</span>
        <span data-out-periodo style="color: var(--fg-muted);">— días</span>
      </label>
      <input id={`${id}-d`} data-slider-dist type="range" min="0.04" max="0.16" step="0.005" value="0.13" class="w-full" style="accent-color:#FF6B35;" />
      <div class="flex justify-between text-[10px] font-bold mt-0.5" style="color: var(--fg-muted);"><span>cerca</span><span>lejos</span></div>
    </div>
  </div>

  <!-- Panel de lecturas -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mt-5">
    <div class="p-3 rounded-bento-sm text-center" style="background: var(--bg);">
      <div class="text-[10px] font-black uppercase tracking-widest" style="color: var(--fg-muted);">Profundidad</div>
      <div data-out-prof class="font-black text-lg mt-1">—</div>
    </div>
    <div class="p-3 rounded-bento-sm text-center" style="background: var(--bg);">
      <div class="text-[10px] font-black uppercase tracking-widest" style="color: var(--fg-muted);">Período</div>
      <div data-out-periodo2 class="font-black text-lg mt-1">—</div>
    </div>
    <div class="p-3 rounded-bento-sm text-center" style="background: var(--bg);">
      <div class="text-[10px] font-black uppercase tracking-widest" style="color: var(--fg-muted);">Tamaño</div>
      <div data-out-tamano2 class="font-black text-lg mt-1">—</div>
    </div>
    <div class="p-3 rounded-bento-sm text-center" style="background: var(--bg);">
      <div class="text-[10px] font-black uppercase tracking-widest" style="color: var(--fg-muted);">Tipo</div>
      <div data-out-tipo class="font-black text-sm mt-1 leading-tight">—</div>
    </div>
  </div>

  <!-- Reto -->
  <div class="mt-4 p-4 rounded-bento-sm flex items-start gap-3" style="background: var(--bg); border: 2px solid var(--border);">
    <span class="text-2xl shrink-0" aria-hidden="true">🎯</span>
    <div>
      <div class="font-black text-sm">Reto: descubre la estrella misteriosa</div>
      <p data-out-reto class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
        Ajusta los controles para que tu curva (azul) coincida con la misteriosa (gris).
      </p>
    </div>
  </div>
</div>

<script define:vars={{ id, W, H, ml, mr, mt, mb, tMax, yMin, yMax, targetR, targetDist }}>
  const root = document.querySelector(`[data-lab-curva="${id}"]`);
  if (root) {
    const xS = (t) => ml + (t / tMax) * (W - mr - ml);
    const yS = (b) => (H - mb) - ((b - yMin) / (yMax - yMin)) * ((H - mb) - mt);

    const periodoDe = (dist) => Math.max(2, Math.round(365.25 * Math.pow(dist, 1.5)));
    const profDe = (r) => (r * r) / 100; // %

    function genPoints(r, dist) {
      const prof = profDe(r);
      const periodo = periodoDe(dist);
      const centros = [];
      for (let k = 0; ; k++) { const c = periodo * (k + 0.5); if (c > tMax) break; centros.push(c); }
      const pts = [];
      const step = tMax / 220;
      for (let t = 0; t <= tMax + 1e-9; t += step) {
        let b = 100;
        for (const c of centros) {
          const d = Math.abs(t - c);
          if (d <= 0.45) { b = 100 - prof; break; }
          if (d <= 0.7) { b = 100 - prof * (1 - (d - 0.45) / 0.25); break; }
        }
        pts.push(xS(t).toFixed(1) + ',' + yS(b).toFixed(1));
      }
      return { points: pts.join(' '), prof, periodo };
    }

    function tipoPlaneta(r) {
      if (r < 1.6) return 'como la Tierra 🌍';
      if (r < 4) return 'super-Tierra';
      if (r < 8) return 'tipo Neptuno';
      return 'gigante gaseoso 🪐';
    }

    const polyEst = root.querySelector('[data-curva-estudiante]');
    const polyObj = root.querySelector('[data-curva-objetivo]');
    const sliderR = root.querySelector('[data-slider-radio]');
    const sliderD = root.querySelector('[data-slider-dist]');
    const outProf = root.querySelector('[data-out-prof]');
    const outPer2 = root.querySelector('[data-out-periodo2]');
    const outPerLabel = root.querySelector('[data-out-periodo]');
    const outTam2 = root.querySelector('[data-out-tamano2]');
    const outTamLabel = root.querySelector('[data-out-tamano]');
    const outTipo = root.querySelector('[data-out-tipo]');
    const outReto = root.querySelector('[data-out-reto]');

    // Curva objetivo (fija)
    polyObj?.setAttribute('points', genPoints(targetR, targetDist).points);
    const objPer = periodoDe(targetDist);

    function redibujar() {
      const r = parseFloat(sliderR.value);
      const dist = parseFloat(sliderD.value);
      const { points, prof, periodo } = genPoints(r, dist);
      polyEst.setAttribute('points', points);
      if (outProf) outProf.textContent = prof.toFixed(2) + ' %';
      if (outPer2) outPer2.textContent = periodo + ' días';
      if (outPerLabel) outPerLabel.textContent = periodo + ' días';
      if (outTam2) outTam2.textContent = r.toFixed(1) + '×';
      if (outTamLabel) outTamLabel.textContent = r.toFixed(1) + ' × Tierra';
      if (outTipo) outTipo.textContent = tipoPlaneta(r);

      const logrado = Math.abs(r - targetR) <= 1.5 && Math.abs(periodo - objPer) <= 1.5;
      if (outReto) {
        outReto.innerHTML = logrado
          ? '<strong>🎉 ¡Lo lograste!</strong> Es un planeta gigante muy cerca de su estrella: un «Júpiter caliente».'
          : 'Ajusta los controles para que tu curva (azul) coincida con la misteriosa (gris).';
        outReto.style.color = logrado ? '#1a8f00' : 'var(--fg-muted)';
      }
    }

    sliderR?.addEventListener('input', redibujar);
    sliderD?.addEventListener('input', redibujar);
    redibujar();
  }
</script>

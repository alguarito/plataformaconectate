---
import type { EstacionMapa } from '../data/guiasContenido/_schema';

interface Props {
  estaciones: EstacionMapa[];
}

const { estaciones } = Astro.props;
const totalMin = estaciones.reduce((sum, e) => sum + e.duracionMin, 0);
---

<section
  class="bento-card mb-6"
  aria-labelledby="mapa-ruta-titulo"
>
  <div class="flex items-center gap-3 mb-3">
    <span class="chip-bento">🗺 Tu ruta hoy</span>
    <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">
      {estaciones.length} estaciones · ~{totalMin} min
    </span>
  </div>

  <h2 id="mapa-ruta-titulo" class="heading-huge leading-tight mb-5">
    Esto vas a recorrer hoy.
  </h2>

  <ol class="space-y-3">
    {estaciones.map((e) => (
      <li class="flex items-start gap-4 p-4 rounded-bento-sm border-2" style="border-color: var(--border);">
        <div class="w-10 h-10 rounded-full bg-bento-blue text-white flex items-center justify-center text-base font-black shrink-0">
          {e.numero}
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex items-baseline gap-2 flex-wrap mb-1">
            <span class="text-2xl leading-none" aria-hidden="true">
              {e.iconos.join(' ')}
            </span>
            <h3 class="font-black text-base md:text-lg leading-tight">
              {e.titulo}
            </h3>
          </div>
        </div>
        <span class="text-sm font-bold shrink-0 px-3 py-1 rounded-full" style="background: var(--bg); color: var(--fg-muted);">
          {e.duracionMin} min
        </span>
      </li>
    ))}
  </ol>

  <p class="text-xs mt-5 leading-relaxed" style="color: var(--fg-muted);">
    📓 <strong style="color: var(--fg);">Cuaderno:</strong>
    Empieza en página nueva con este encabezado: Guía · Tema · Fecha. Solo lo que aparezca
    en bloques ✏️ <strong>ACTIVIDAD</strong> y los apartados 🌱 y 💭 va al cuaderno —
    el resto es para leer y entender.
  </p>
</section>

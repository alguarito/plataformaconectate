---
/**
 * «Materiales para el aula» de un tomo: los complementos del libro (cuaderno, fichas en Carta
 * y A4, guía docente, kit de pilotaje y, en el Tomo III, láminas de la práctica), con su nombre
 * exacto, peso y descripción. Todo sale de src/data/coleccion.json. Lo demás del paquete (lectura
 * adaptable, lectura etiquetada, aula digital, registros y fuentes editables) se descarga del
 * registro de Zenodo; `enZenodo` lo nombra cuando el paquete de un tomo trae otra cosa.
 */
import { tomo, peso, type Romano } from '../data/coleccion';

interface Props {
  romano: Romano;
  /** Lo que solo está en Zenodo, hasta «… están en»; detrás va el enlace «el registro de Zenodo». */
  enZenodo?: string;
}

const {
  romano,
  enZenodo = 'La lectura adaptable, la lectura etiquetada para lectores de pantalla, el aula digital y las fuentes editables están en',
} = Astro.props;
const t = tomo(romano);
const materiales = t.archivos
  .filter((a) => a.rol !== 'libro')
  .map((a) => ({
    ...a,
    detalle: [a.paginas ? `${a.paginas} págs.` : '', a.formato ?? '', peso(a.bytes)].filter(Boolean).join(' · '),
  }));
---

{materiales.length > 0 && (
  <section id="materiales" class="mb-10 scroll-mt-24" aria-labelledby="materiales-titulo">
    <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
      <h2 id="materiales-titulo" class="heading-huge">Materiales para el aula.</h2>
      <span class="chip-bento">Versión {t.version} · mismo DOI</span>
    </div>
    <p class="text-sm leading-relaxed mb-6 max-w-2xl" style="color: var(--fg-muted);">
      Los complementos para imprimir y usar en clase; comparten el DOI del libro. {enZenodo}{' '}
      <a href={t.doiUrl} target="_blank" rel="noopener" class="font-bold underline underline-offset-2" style="color: var(--fg);">el registro de Zenodo</a>.
    </p>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4" role="list">
      {materiales.map((a) => (
        <li>
          <a href={a.url} download={a.nombre} type="application/pdf" class="bento-card-hover flex items-start justify-between gap-4 h-full">
            <span class="flex flex-col">
              <span class="font-black text-base leading-tight"><span class="sr-only">Descargar </span>{a.etiqueta}</span>
              {a.descripcion && (
                <span class="text-sm leading-relaxed mt-1.5" style="color: var(--fg-muted);">{a.descripcion}</span>
              )}
              <span class="text-xs font-bold uppercase tracking-widest mt-3" style="color: var(--fg-muted);">{a.detalle}<span class="sr-only"> (PDF)</span></span>
            </span>
            <svg class="w-5 h-5 shrink-0 mt-0.5 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

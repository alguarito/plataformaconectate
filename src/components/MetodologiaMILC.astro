---
/**
 * Metodología MILC · capa para el docente.
 *
 * Bloque colapsable (cerrado por defecto) que explica CÓMO llevar el momento a
 * clase: objetivos didácticos, secuencia sugerida con tiempos, evaluación y
 * diferenciación por grado/nivel. Es la cuarta pieza del molde Bebras, dirigida
 * al docente — no al estudiante. Usa <details>/<summary> nativo: accesible por
 * teclado y sin JavaScript.
 */

export interface PasoSecuencia {
  /** Qué hace el docente / la clase en este tramo */
  paso: string;
  /** Tiempo estimado, p. ej. "10 min" */
  tiempo: string;
}

export interface MetodologiaMILCData {
  /** Encuadre breve del momento para el docente (1 párrafo) */
  resumen: string;
  /** Objetivos didácticos observables */
  objetivos: string[];
  /** Secuencia sugerida de clase, con tiempos */
  secuencia: PasoSecuencia[];
  /** Cómo evaluar (formativa + evidencia) */
  evaluacion: string;
  /** Cómo adaptar por grado / nivel Bebras A·B·C */
  diferenciacion: string;
}

interface Props {
  data: MetodologiaMILCData;
}

const { data } = Astro.props;
---

<details class="metodologia bento-card mb-6 border-l-4 border-bento-cyan">
  <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
    <div>
      <span class="chip-bento mb-2">🧭 Metodología MILC · para el docente</span>
      <h2 class="text-lg md:text-xl font-black tracking-tight leading-tight">
        Cómo llevar este momento a clase
      </h2>
    </div>
    <span class="chevron text-2xl shrink-0" aria-hidden="true">⌄</span>
  </summary>

  <div class="mt-5 space-y-5">
    <p class="text-sm md:text-base leading-relaxed">{data.resumen}</p>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Objetivos didácticos</h3>
      <ul class="space-y-2">
        {data.objetivos.map((o) => (
          <li class="flex items-start gap-2 text-sm leading-relaxed">
            <span class="text-bento-cyan font-black shrink-0" aria-hidden="true">→</span>
            <span>{o}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Secuencia sugerida</h3>
      <ol class="space-y-2">
        {data.secuencia.map((s, i) => (
          <li class="flex items-start gap-3 p-3 rounded-bento-sm" style="background: var(--bg);">
            <span class="w-6 h-6 rounded-full bg-bento-cyan text-neutral-950 flex items-center justify-center text-xs font-black shrink-0" aria-hidden="true">{i + 1}</span>
            <span class="flex-1 text-sm leading-relaxed">{s.paso}</span>
            <span class="text-xs font-bold uppercase tracking-widest shrink-0 mt-0.5" style="color: var(--fg-muted);">{s.tiempo}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-4 rounded-bento-sm" style="background: var(--bg);">
        <h3 class="text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Evaluación</h3>
        <p class="text-sm leading-relaxed">{data.evaluacion}</p>
      </div>
      <div class="p-4 rounded-bento-sm" style="background: var(--bg);">
        <h3 class="text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Diferenciación por nivel (A·B·C)</h3>
        <p class="text-sm leading-relaxed">{data.diferenciacion}</p>
      </div>
    </div>
  </div>
</details>

<style>
  .metodologia > summary::-webkit-details-marker { display: none; }
  .metodologia summary:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .metodologia .chevron {
    color: var(--fg-muted);
  }
  .metodologia[open] .chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .metodologia .chevron {
      transition: transform 0.2s ease;
    }
  }
</style>

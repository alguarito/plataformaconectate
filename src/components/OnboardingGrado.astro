---
/**
 * OnboardingGrado — modal de bienvenida en el primer acceso a un grado.
 * Se muestra UNA sola vez por grado (localStorage). 4 pasos.
 */
interface Props {
  grado: number;
  periodoHref: string; // href del periodo 1
}
const { grado, periodoHref } = Astro.props;
---

<!-- El modal está oculto por defecto; el script lo muestra si corresponde -->
<div
  id="onboarding-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  aria-modal="true"
  role="dialog"
  aria-labelledby="onboarding-titulo"
>
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-onb-backdrop></div>

  <!-- Panel -->
  <div class="relative w-full max-w-md bg-white dark:bg-neutral-900 rounded-bento shadow-bento-hover overflow-hidden">
    <!-- Barra de progreso de pasos -->
    <div class="flex h-1.5 bg-neutral-100 dark:bg-neutral-800">
      {[0,1,2,3].map((i) => (
        <div
          data-onb-paso-barra={i}
          class="flex-1 transition-all duration-300"
          style="background:transparent"
        ></div>
      ))}
    </div>

    <!-- Pasos -->
    <div class="relative overflow-hidden">
      <!-- Paso 1 -->
      <div data-onb-paso={0} class="p-6 md:p-8">
        <div class="text-5xl mb-4">👋</div>
        <h2 id="onboarding-titulo" class="text-xl font-black mb-2">
          Bienvenido a Grado {grado}°
        </h2>
        <p class="text-sm leading-relaxed" style="color:var(--fg-muted);">
          Esta es tu plataforma de Tecnología e Informática para todo el año.
          Aquí encuentras tus <strong>guías, actividades y proyectos</strong>.
          En un minuto te explico cómo funciona todo.
        </p>
      </div>

      <!-- Paso 2 -->
      <div data-onb-paso={1} class="hidden p-6 md:p-8">
        <div class="text-5xl mb-4">🌱 → 🏆</div>
        <h2 class="text-xl font-black mb-2">Tu nivel crece con cada guía</h2>
        <p class="text-sm leading-relaxed" style="color:var(--fg-muted);">
          Empiezas como <strong>Novato</strong> y puedes llegar a <strong>Maestro</strong>.
          Cada guía completada vale 100 XP. Los proyectos dan 500 XP.
          Tu progreso se guarda automáticamente.
        </p>
        <div class="mt-4 flex gap-2 flex-wrap text-xs font-bold">
          {['🌱 Novato','🌿 Aprendiz','🌳 Experto','🎯 Casi Maestro','🏆 Maestro'].map((n) => (
            <span class="px-3 py-1.5 rounded-full bg-neutral-100 dark:bg-neutral-800">{n}</span>
          ))}
        </div>
      </div>

      <!-- Paso 3 -->
      <div data-onb-paso={2} class="hidden p-6 md:p-8">
        <div class="text-5xl mb-4">🗂️</div>
        <h2 class="text-xl font-black mb-2">El reto del periodo ya te espera</h2>
        <p class="text-sm leading-relaxed" style="color:var(--fg-muted);">
          Cada periodo tiene un <strong>Proyecto integrador</strong>. No es para el final:
          empiézalo desde la primera semana. Léelo ahora para saber qué vas a construir.
        </p>
      </div>

      <!-- Paso 4 -->
      <div data-onb-paso={3} class="hidden p-6 md:p-8">
        <div class="text-5xl mb-4">🚀</div>
        <h2 class="text-xl font-black mb-2">¡Empieza por la Sesión 1!</h2>
        <p class="text-sm leading-relaxed mb-4" style="color:var(--fg-muted);">
          El orden importa. La Sesión 1 abre el periodo con un saber ancestral y
          te conecta con todo lo que viene. <strong>Ve ahí primero.</strong>
        </p>
      </div>
    </div>

    <!-- Controles -->
    <div class="flex items-center justify-between gap-3 px-6 pb-6">
      <button
        type="button"
        data-onb-saltar
        class="text-xs font-semibold underline underline-offset-4 hover:opacity-60 transition-opacity"
        style="color:var(--fg-muted);"
      >
        Saltar
      </button>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-onb-anterior
          class="hidden px-4 py-2 rounded-bento-sm text-sm font-bold border-2 hover:opacity-70 transition-opacity"
          style="border-color:var(--border);color:var(--fg);"
        >
          ← Anterior
        </button>
        <button
          type="button"
          data-onb-siguiente
          class="px-5 py-2 rounded-bento-sm text-sm font-black bg-bento-blue text-white hover:opacity-90 transition-opacity"
        >
          Siguiente →
        </button>
        <a
          href={periodoHref}
          data-onb-empezar
          class="hidden px-5 py-2 rounded-bento-sm text-sm font-black bg-bento-lime text-black hover:opacity-90 transition-opacity"
        >
          ¡Empezar! 🚀
        </a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ grado }}>
  (function () {
    const CLAVE = `conectate_onboarding_g${grado}`;
    if (localStorage.getItem(CLAVE)) return;

    const TOTAL = 4;
    let paso = 0;

    const modal    = document.getElementById('onboarding-modal');
    const pasos    = Array.from(document.querySelectorAll('[data-onb-paso]'));
    const barras   = Array.from(document.querySelectorAll('[data-onb-paso-barra]'));
    const btnAnt   = document.querySelector('[data-onb-anterior]');
    const btnSig   = document.querySelector('[data-onb-siguiente]');
    const btnEmp   = document.querySelector('[data-onb-empezar]');
    const btnSalt  = document.querySelector('[data-onb-saltar]');
    const backdrop = document.querySelector('[data-onb-backdrop]');

    const COLOR_ACTIVO = '#0066FF';

    function actualizar() {
      pasos.forEach((p, i) => p.classList.toggle('hidden', i !== paso));
      barras.forEach((b, i) => {
        b.style.background = i <= paso ? COLOR_ACTIVO : 'transparent';
      });
      btnAnt?.classList.toggle('hidden', paso === 0);
      btnSig?.classList.toggle('hidden', paso === TOTAL - 1);
      btnEmp?.classList.toggle('hidden', paso !== TOTAL - 1);
    }

    function cerrar() {
      localStorage.setItem(CLAVE, '1');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    actualizar();

    btnSig?.addEventListener('click', () => { if (paso < TOTAL - 1) { paso++; actualizar(); } });
    btnAnt?.addEventListener('click', () => { if (paso > 0) { paso--; actualizar(); } });
    btnSalt?.addEventListener('click', cerrar);
    btnEmp?.addEventListener('click', cerrar);
    backdrop?.addEventListener('click', cerrar);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
  })();
</script>

---
/**
 * ReflexionGuia — captura digital del bloque 💭 (reflexión/cierre filosófico).
 *
 * Muestra un textarea con autosave debounced (800 ms).
 * Si no hay sesión activa, muestra un CTA de inicio de sesión.
 * Persiste en la tabla `reflexiones_estudiante` (guia_clave = 'grado-periodo-sesion').
 *
 * Depende de la capa de cuentas: con PUBLIC_AUTH_ENABLED distinto de 'true'
 * (desactivada desde 2026-10-22) no se renderiza ni carga el cliente Supabase.
 * La reflexión de cada guía sigue yendo al cuaderno, como indica la guía.
 */
interface Props {
  grado: number;
  periodo: number;
  sesion: number;
}

const { grado, periodo, sesion } = Astro.props;
const guiaClave = `${grado}-${periodo}-${sesion}`;
const MAX = 800;
const base = import.meta.env.BASE_URL;
const cuentasActivas = import.meta.env.PUBLIC_AUTH_ENABLED === 'true';
---

{cuentasActivas && (
  <div class="bento-card mb-6" data-reflexion-wrap data-guia-clave={guiaClave} data-max={MAX}>
    <span class="chip-bento mb-3">💭 Tu reflexión personal</span>
    <h3 class="text-lg font-black mb-1 leading-tight">¿Qué te llevás de esta guía?</h3>
    <p class="text-sm leading-relaxed mb-4" style="color:var(--fg-muted);">
      Escribe en tus propias palabras: qué aprendiste, qué te sorprendió, o cómo conecta con tu vida.
      Máximo {MAX} caracteres. No se califica — es para ti.
    </p>

    <!-- Estado: sin sesión -->
    <div data-reflexion-sin-sesion class="hidden text-center py-4">
      <p class="text-sm mb-3" style="color:var(--fg-muted);">
        Inicia sesión para guardar tu reflexión y que quede en tu historial.
      </p>
      <a
        href={`${base}/cuenta/login`}
        class="inline-block px-4 py-2 rounded-bento-sm bg-bento-blue text-white text-sm font-bold"
      >
        Iniciar sesión
      </a>
    </div>

    <!-- Estado: editor -->
    <div data-reflexion-editor class="hidden">
      <div class="relative">
        <textarea
          data-reflexion-textarea
          maxlength={MAX}
          rows="4"
          placeholder="Escribe aquí tu reflexión…"
          class="w-full resize-none p-3 rounded-bento-sm border-2 text-sm leading-relaxed focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bento-blue transition-colors"
          style="border-color:var(--border);background:var(--bg);color:var(--fg);"
        ></textarea>
        <span
          data-reflexion-contador
          class="absolute bottom-2 right-3 text-xs font-semibold select-none"
          style="color:var(--fg-muted);"
        >0 / {MAX}</span>
      </div>

      <div class="flex items-center justify-between mt-2 min-h-[20px]">
        <span data-reflexion-estado class="text-xs font-semibold" style="color:var(--fg-muted);"></span>
      </div>
    </div>
  </div>
)}

<script>
  // Script empaquetado (no inline): así Vite resuelve el import del cliente.
  // Con la bandera apagada, todo el bloque se elimina del bundle.
  if (import.meta.env.PUBLIC_AUTH_ENABLED === 'true') {
    const wrap = document.querySelector<HTMLElement>('[data-reflexion-wrap]');
    if (wrap) iniciar(wrap);
  }

  function iniciar(wrap: HTMLElement) {
    const guiaClave = wrap.dataset.guiaClave ?? '';
    const MAX = Number(wrap.dataset.max ?? 800);

    const sinSesion = wrap.querySelector<HTMLElement>('[data-reflexion-sin-sesion]');
    const editor    = wrap.querySelector<HTMLElement>('[data-reflexion-editor]');
    const textarea  = wrap.querySelector<HTMLTextAreaElement>('[data-reflexion-textarea]');
    const contador  = wrap.querySelector<HTMLElement>('[data-reflexion-contador]');
    const estado    = wrap.querySelector<HTMLElement>('[data-reflexion-estado]');

    let debounceTimer: ReturnType<typeof setTimeout> | undefined;
    let ultimoTexto = '';
    let editorListo = false;

    function setEstado(msg: string, color = 'var(--fg-muted)') {
      if (estado) { estado.textContent = msg; estado.style.color = color; }
    }

    function actualizarContador() {
      const len = textarea?.value?.length ?? 0;
      if (contador) {
        contador.textContent = `${len} / ${MAX}`;
        contador.style.color = len > MAX * 0.9 ? '#FF6B35' : 'var(--fg-muted)';
      }
    }

    import('../lib/supabase').then(({ supabase }) => {
      async function cargarReflexion(userId: string) {
        const { data } = await supabase
          .from('reflexiones_estudiante')
          .select('texto')
          .eq('estudiante_id', userId)
          .eq('guia_clave', guiaClave)
          .maybeSingle();
        if (data?.texto && textarea) {
          textarea.value = data.texto;
          ultimoTexto = data.texto;
          actualizarContador();
          setEstado('Reflexión guardada anteriormente.');
        }
      }

      async function guardarReflexion(userId: string, texto: string) {
        setEstado('Guardando…');
        const { error } = await supabase
          .from('reflexiones_estudiante')
          .upsert(
            { estudiante_id: userId, guia_clave: guiaClave, texto },
            { onConflict: 'estudiante_id,guia_clave' }
          );
        if (error) {
          setEstado('No se pudo guardar.', '#FF2D87');
        } else {
          ultimoTexto = texto;
          setEstado('Guardado ✓', '#58A923');
          setTimeout(() => { if (estado) estado.textContent = ''; }, 3000);
        }
      }

      function mostrarEditor(userId: string) {
        if (editorListo) return;
        editorListo = true;
        sinSesion?.classList.add('hidden');
        editor?.classList.remove('hidden');
        cargarReflexion(userId);
        textarea?.addEventListener('input', () => {
          actualizarContador();
          const texto = textarea.value.trim();
          if (texto === ultimoTexto) return;
          clearTimeout(debounceTimer);
          setEstado('');
          if (!texto) return;
          debounceTimer = setTimeout(() => guardarReflexion(userId, texto), 800);
        });
      }

      supabase.auth.getSession().then(({ data: { session } }) => {
        if (session) mostrarEditor(session.user.id);
        else sinSesion?.classList.remove('hidden');
      });

      // Si el usuario inicia sesión en esta misma pestaña, mostrar el editor
      supabase.auth.onAuthStateChange((_event, session) => {
        if (session) mostrarEditor(session.user.id);
      });
    });
  }
</script>

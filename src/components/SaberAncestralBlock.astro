---
import type { SaberAncestral } from '../data/guiasContenido/_schema';

interface Props {
  data: SaberAncestral;
}

const { data } = Astro.props;
---

<section
  class="bento-card-color bg-bento-purple text-white mb-6"
  aria-labelledby="saber-ancestral-titulo"
>
  <div class="flex items-start gap-4">
    <div class="text-5xl shrink-0" aria-hidden="true">🌱</div>
    <div class="flex-1">
      <span class="text-xs font-bold uppercase tracking-widest opacity-80">
        Estación 1 · Saber ancestral
      </span>
      <h2 id="saber-ancestral-titulo" class="text-2xl md:text-3xl font-black tracking-tight leading-tight mt-1 mb-4">
        Antes de la tecnología, este saber.
      </h2>

      <p class="text-base md:text-lg leading-relaxed mb-3">
        {data.saber}
      </p>

      {data.fuente && (
        <p class="text-xs font-semibold uppercase tracking-widest opacity-75 mb-5">
          Origen del saber: {data.fuente}
        </p>
      )}

      <div class="border-t border-white/20 pt-4 mt-4">
        <span class="text-xs font-bold uppercase tracking-widest opacity-80">
          Pregunta-puente
        </span>
        <p class="font-black text-lg md:text-xl mt-1 leading-snug">
          "{data.preguntaPuente}"
        </p>
      </div>
    </div>
  </div>
</section>

---
/**
 * Triángulo de pensamiento — cierre filosófico de la guía.
 *
 * Dos cambios respecto de la versión anterior:
 *  · Las tres formulaciones ya NO van entre comillas. En los YAML no están
 *    verificadas contra fuente, así que presentarlas como cita textual
 *    atribuía a Dussel, Marco Aurelio y Floridi frases que quizá no
 *    escribieron. Van como síntesis, con una nota al docente.
 *  · Riel de color a la izquierda en lugar de tres tarjetas macizas, para que
 *    la página respire igual que la página 8 del PDF.
 */
import type { Triangulo, VozTriangulo } from '../data/guiasContenido/_schema';
import IconoMILC from './IconoMILC.astro';

interface Props {
  data: Triangulo;
}

const { data } = Astro.props;

/**
 * Quita las comillas que rodean la frase en los datos.
 *
 * 60 archivos de contenido guardan la formulación ya entrecomillada, así que
 * aunque este componente no añada comillas, la frase seguía leyéndose como
 * cita textual — justo lo que la nota al docente dice que NO es. Se quitan
 * aquí, en la presentación: el dato queda intacto.
 */
function sinComillas(t: string): string {
  return t.trim().replace(/^["\u201C\u00AB\u2018']+/, '').replace(/["\u201D\u00BB\u2019']+$/, '').trim();
}

const COLORES = {
  dussel:  { color: '#5A0038', texto: '#5A0038' },
  estoico: { color: '#E5B400', texto: '#8A6A00' },
  floridi: { color: '#0093A5', texto: '#00707E' },
} as const;

type VozKey = keyof typeof COLORES;
const voces: Array<{ key: VozKey; voz: VozTriangulo }> = [
  { key: 'dussel', voz: data.dussel },
  { key: 'estoico', voz: data.estoico },
  { key: 'floridi', voz: data.floridi },
];
---

<section class="mb-10" aria-labelledby="triangulo-titulo">
  <div class="flex items-center gap-2.5 mb-3" style="color: var(--fg-muted);">
    <IconoMILC nombre="💭" size={18} />
    <span class="text-[11px] font-black uppercase tracking-[0.14em]">
      Triángulo de pensamiento
    </span>
  </div>

  <h2 id="triangulo-titulo" class="text-2xl md:text-3xl font-black tracking-tight leading-[1.1] mb-3">
    Tres voces para cerrar.
  </h2>

  <p class="text-base leading-relaxed max-w-2xl mb-7" style="color: var(--fg-muted);">
    No es decoración: son tres lentes que te acompañan toda la secundaria. Lee con calma
    y responde la pregunta-espejo en tu cuaderno.
  </p>

  <div class="flex flex-col gap-6">
    {voces.map(({ key, voz }) => {
      const c = COLORES[key];
      return (
        <article class="pl-5 md:pl-6" style={`border-left: 6px solid ${c.color};`}>
          <div class="flex items-baseline gap-3 flex-wrap mb-2.5">
            <h3 class="text-xl md:text-2xl font-black tracking-tight" style={`color: ${c.texto};`}>
              {voz.autor}
            </h3>
            <span class="text-xs font-bold" style="color: var(--fg-muted);">
              {voz.lente}
            </span>
          </div>

          <p class="text-base leading-relaxed mb-3" style="color: var(--fg);">
            {sinComillas(voz.cita)}
          </p>

          <p class="text-sm md:text-base leading-relaxed mb-3" style="color: var(--fg-muted);">
            {voz.aplicacion}
          </p>

          <p class="font-bold text-base md:text-lg leading-snug" style={`color: ${c.texto};`}>
            Pregunta-espejo: {voz.preguntaEspejo}
          </p>
        </article>
      );
    })}
  </div>

  <p
    class="text-sm leading-relaxed mt-7 p-4 rounded-bento-sm"
    style="background: var(--bg); color: var(--fg-muted);"
  >
    <strong style="color: var(--fg);">Nota para el docente.</strong>
    Estas tres formulaciones son la síntesis del autor de la guía, no citas textuales
    de los pensadores. Si vas a citarlos en clase, remite a la obra original.
  </p>
</section>

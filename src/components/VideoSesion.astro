---
/**
 * Bloque 👁 OBSERVA · Video de sesión (enlace a YouTube).
 *
 * Muchos videos educativos llevan música licenciada que BLOQUEA la
 * reproducción incrustada fuera de YouTube (p. ej. "contenido de
 * LatinAutor-UMPG"). Para que el video SIEMPRE funcione, este bloque no
 * incrusta el reproductor: muestra una miniatura atractiva que abre el video
 * en YouTube (pestaña nueva), con los subtítulos en español activados.
 *
 * Ventaja extra: cero peso de terceros en la carga y nada que rompa el
 * offline-first (solo se carga la miniatura, con lazy-load).
 *
 * Tipo propio (no depende del schema de guías); reutilizable en cualquier
 * página Astro: Explora, guías, etc.
 */
export interface DataVideo {
  /** ID del video de YouTube (la parte v= de la URL) */
  youtubeId: string;
  /** Título del video */
  titulo: string;
  /** Descripción corta · qué vas a ver */
  descripcion?: string;
  /** Atribución (ej. "Video de RECA · Proyecto Salomé") */
  credito?: string;
  /** Enlace a la guía resumen oficial (PDF), opcional */
  resumenUrl?: string;
}

interface Props {
  data: DataVideo;
}

const { data } = Astro.props;

// Miniatura de YouTube (no requiere API key).
const thumb = `https://i.ytimg.com/vi/${data.youtubeId}/hqdefault.jpg`;
// Abrir en YouTube con subtítulos activados (cc_load_policy=1) e interfaz en español.
const watchUrl = `https://www.youtube.com/watch?v=${data.youtubeId}&cc_load_policy=1&hl=es`;
---

<section class="bento-card mb-6" aria-labelledby={`video-${data.youtubeId}-titulo`}>
  <div class="flex items-center gap-3 mb-3 flex-wrap">
    <span class="chip-bento">👁 Observa</span>
    {data.credito && (
      <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">{data.credito}</span>
    )}
  </div>

  <h3 id={`video-${data.youtubeId}-titulo`} class="text-xl md:text-2xl font-black tracking-tight leading-tight mb-2">
    {data.titulo}
  </h3>
  {data.descripcion && (
    <p class="text-sm leading-relaxed mb-4" style="color: var(--fg-muted);">{data.descripcion}</p>
  )}

  <!-- Tarjeta-enlace: miniatura + play; abre el video en YouTube -->
  <a
    href={watchUrl}
    target="_blank"
    rel="noopener"
    class="group relative block w-full rounded-bento-sm overflow-hidden bg-black"
    style="aspect-ratio: 16 / 9;"
    aria-label={`Ver en YouTube: ${data.titulo} (se abre en una pestaña nueva)`}
  >
    <img
      src={thumb}
      alt=""
      loading="lazy"
      class="absolute inset-0 w-full h-full object-cover opacity-85 group-hover:opacity-60 transition-opacity"
    />
    <span class="relative z-10 flex items-center justify-center w-full h-full">
      <span class="w-16 h-16 rounded-full bg-bento-pink text-white flex items-center justify-center shadow-bento group-hover:scale-110 transition-transform">
        <svg class="w-7 h-7 ml-1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
      </span>
    </span>
    <span class="absolute bottom-0 left-0 right-0 flex items-center gap-2 px-4 py-2.5 bg-black/65 text-white text-xs font-bold backdrop-blur-sm">
      <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.5 15.5v-7l6.3 3.5-6.3 3.5z"></path></svg>
      Ver en YouTube · subtítulos en español
    </span>
  </a>

  <div class="flex items-center gap-4 mt-3 flex-wrap">
    <span class="text-xs leading-relaxed" style="color: var(--fg-muted);">
      Se abre en YouTube, en una pestaña nueva.
    </span>
    {data.resumenUrl && (
      <a
        href={data.resumenUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 text-xs font-black text-bento-blue hover:opacity-70 transition-opacity sm:ml-auto"
      >
        📄 Descargar resumen oficial (RECA)
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    )}
  </div>
</section>

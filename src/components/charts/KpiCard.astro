---
/**
 * KpiCard · tarjeta de indicador para el dashboard de informes.
 *
 * Valor grande + etiqueta + sublabel opcional. El color del número se pasa
 * como hex (paleta bento) por estilo en línea para evitar la purga de Tailwind
 * de clases dinámicas. Mobile-first.
 */
interface Props {
  etiqueta: string;
  valor?: string | number;
  sub?: string;
  /** hex de la paleta bento, p.ej. '#0066FF'. Default azul. */
  color?: string;
  /** emoji opcional como acento visual. */
  icono?: string;
  /** clave para que un script de cliente rellene el valor (data-kpi). */
  clave?: string;
}
const { etiqueta, valor = '—', sub, color = '#0066FF', icono, clave } = Astro.props;
---

<div role="figure" aria-label={`${etiqueta}: ${String(valor)}${sub ? ` (${sub})` : ''}`} class="bg-white dark:bg-neutral-900 rounded-bento-sm shadow-bento p-4 evitar-corte">
  <p class="text-xs uppercase tracking-wide md:tracking-widest font-bold text-neutral-500 mb-1 flex items-center gap-1.5">
    {icono && <span aria-hidden="true">{icono}</span>}
    {etiqueta}
  </p>
  <p class="text-3xl md:text-4xl font-black tracking-tight tabular-nums" style={`color:${color}`} data-kpi={clave}>
    {valor}
  </p>
  {sub && <p class="text-xs text-neutral-500 mt-1">{sub}</p>}
</div>

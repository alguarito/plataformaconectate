---
/**
 * Botón "Imprimir / PDF" que llama a window.print().
 * Se oculta automáticamente en impresión (print:hidden vía print.css [data-no-print]).
 */
---

<button
  onclick="window.print()"
  data-no-print
  class="inline-flex items-center gap-2 px-4 py-2 rounded-bento-sm bg-white/15 border border-white/30 text-white hover:bg-white/25 text-sm font-bold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"
  aria-label="Imprimir o guardar como PDF"
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <polyline points="6 9 6 2 18 2 18 9"/>
    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
    <rect x="6" y="14" width="12" height="8"/>
  </svg>
  Imprimir / PDF
</button>

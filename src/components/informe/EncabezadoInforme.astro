---
/**
 * Encabezado institucional que aparece SOLO en impresión.
 * Coloca datos de la I.E. arriba del informe al generar PDF.
 */
interface Props {
  filtros?: string;
}
const { filtros } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---

<div data-solo-print class="hidden mb-6 pb-4 border-b-2 border-neutral-300">
  <div class="flex items-center justify-between gap-4">
    <img
      src={`${base}/LOGO.png`}
      alt="I.E. Sor María Juliana"
      style="height:48px;width:auto;object-fit:contain"
    />
    <div class="text-right">
      <p class="font-black text-sm leading-tight">I.E. Sor María Juliana</p>
      <p class="text-xs text-neutral-600 leading-tight">Cartago, Valle del Cauca</p>
      <p class="text-xs text-neutral-600 leading-tight">PhD. Álvaro Cárdenas Orozco</p>
      <p class="text-xs text-neutral-500 leading-tight">Área de Tecnología e Informática</p>
    </div>
  </div>
  {filtros && (
    <p class="text-xs text-neutral-500 mt-2 border-t border-neutral-200 pt-2">{filtros}</p>
  )}
  <p class="text-xs text-neutral-400 mt-1" data-encabezado-filtros-dinamicos></p>
</div>

---
/**
 * Espacio en blanco con líneas para que el docente anote observaciones
 * adicionales a mano en el informe impreso. Solo aparece en impresión.
 */
---

<div data-solo-print class="hidden" style="margin-top:8mm;padding:4mm 0">
  <p style="font-size:9.5pt;font-weight:700;border-bottom:2px solid #0066FF;padding-bottom:2mm;margin:0 0 4mm;color:#1F2937">
    Observaciones del docente
  </p>
  <div style="border:1px solid #E5E7EB;border-radius:4px;padding:3mm 4mm">
    <div style="border-bottom:1px solid #F3F4F6;height:8mm"></div>
    <div style="border-bottom:1px solid #F3F4F6;height:8mm"></div>
    <div style="border-bottom:1px solid #F3F4F6;height:8mm"></div>
    <div style="border-bottom:1px solid #F3F4F6;height:8mm"></div>
    <div style="height:8mm"></div>
  </div>
  <p style="margin:2.5mm 0 0;font-size:7.5pt;color:#9CA3AF">
    Firma: ___________________________&nbsp;&nbsp;&nbsp;&nbsp;Fecha: _______________
  </p>
</div>

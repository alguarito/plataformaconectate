---
/**
 * Pie de página institucional que aparece SOLO en impresión.
 * Muestra la fecha de generación del informe en formato es-CO.
 */
---

<div data-solo-print class="hidden mt-6 pt-3 border-t border-neutral-200">
  <div class="flex justify-between items-center text-xs text-neutral-400">
    <span>Plataforma Conéctate · I.E. Sor María Juliana</span>
    <span data-pie-fecha></span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pie-fecha]').forEach((el) => {
    el.textContent = new Date().toLocaleDateString('es-CO', {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    });
  });
</script>

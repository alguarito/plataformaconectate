---
/**
 * Portada institucional A4 que aparece SOLO en impresión (página 1).
 * El JS del script del padre debe llenar [data-portada-filtros]
 * con la información dinámica del informe (año, grado, estudiantes, etc.)
 * una vez que los datos se hayan cargado.
 */
interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
---

<div data-solo-print data-portada class="hidden">
  <!-- Franja institucional azul -->
  <div style="background:#0066FF;height:7mm;margin:-1px;border-radius:3px 3px 0 0"></div>

  <!-- Cuerpo central -->
  <div style="flex:1;display:flex;flex-direction:column;align-items:center;text-align:center;padding:14mm 0 10mm">
    <img
      src={`${base}/LOGO.png`}
      alt="I.E. Sor María Juliana"
      style="height:80px;width:auto;object-fit:contain;margin-bottom:7mm"
    />
    <p style="font-size:18pt;font-weight:900;letter-spacing:-0.01em;color:#111827;margin:0 0 2mm">
      I.E. Sor María Juliana
    </p>
    <p style="font-size:9pt;color:#6B7280;margin:0 0 12mm">
      Cartago, Valle del Cauca &middot; Área de Tecnología e Informática
    </p>

    <div style="width:100%;border-top:2px solid #E5E7EB;border-bottom:2px solid #E5E7EB;padding:9mm 0;margin-bottom:8mm">
      <p style="font-size:7.5pt;text-transform:uppercase;letter-spacing:0.15em;color:#9CA3AF;font-weight:700;margin:0 0 4mm">
        Informe de Analítica Académica
      </p>
      <p style="font-size:22pt;font-weight:900;line-height:1.05;letter-spacing:-0.02em;color:#111827;margin:0 0 3mm">
        {titulo}
      </p>
      <p style="font-size:10pt;color:#4B5563;min-height:1.4em;margin:0" data-portada-filtros></p>
    </div>

    {descripcion && (
      <div style="width:100%;border-left:4px solid #0066FF;background:#EFF6FF;padding:5mm 7mm;text-align:left">
        <p style="font-size:9pt;line-height:1.7;color:#1E40AF;margin:0">{descripcion}</p>
      </div>
    )}
  </div>

  <!-- Pie de portada -->
  <div style="border-top:1px solid #E5E7EB;padding:4mm 0 0">
    <div style="display:flex;justify-content:space-between;font-size:8.5pt;color:#374151;margin-bottom:1.5mm">
      <span><strong>Docente:</strong> PhD. Álvaro Cárdenas Orozco</span>
      <span><strong>Área:</strong> Tecnología e Informática</span>
    </div>
    <div style="display:flex;justify-content:space-between;font-size:8pt;color:#6B7280">
      <span>Plataforma Conéctate &middot; I.E. Sor María Juliana</span>
      <span data-portada-fecha></span>
    </div>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('[data-portada-fecha]').forEach(function (el) {
    el.textContent = new Date().toLocaleDateString('es-CO', {
      day: '2-digit', month: 'long', year: 'numeric',
    });
  });
</script>

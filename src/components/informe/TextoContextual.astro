---
/**
 * Bloque de texto pedagógico/institucional que aparece SOLO en impresión.
 * Coloca párrafos de contexto antes de cada sección para dar sustento
 * argumental al informe impreso (justificación de indicadores, marco legal, etc.)
 */
interface Props {
  titulo?: string;
}
const { titulo } = Astro.props;
---

<div data-solo-print class="hidden" style="margin:3mm 0 5mm;font-size:9pt;line-height:1.7;color:#374151">
  {titulo && (
    <p style="font-size:9pt;font-weight:700;color:#1F2937;margin:0 0 2mm;padding-bottom:1.5mm;border-bottom:1px solid #E5E7EB">
      {titulo}
    </p>
  )}
  <slot />
</div>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  perfil,
  hojaDeVida,
  formacion,
  experiencia,
  reconocimientosDestacados,
  reconocimientos,
  ponencias,
  competencias,
  formacionComplementaria,
  membresias,
  stats,
  plataformaConectate,
  articuloArbitrado,
  tesisLibro,
  type Publicacion,
} from '../../data/perfil';
import { libros } from '../../data/coleccion';
import { planArea } from '../../data/planArea';

const base = import.meta.env.BASE_URL;

// Mensaje pre-llenado para WhatsApp del docente
const whatsappTexto = `Hola Dr. Cardenas, le escribo desde la página "Acerca de" de la plataforma ConectaTE.`;
const whatsappHref = `https://wa.me/${perfil.whatsappE164}?text=${encodeURIComponent(whatsappTexto)}`;
const mailtoHref = `mailto:${perfil.email}?subject=Saludos desde ConectaTE`;

// Cargos actuales / pasados
const cargosActuales = experiencia.filter((e) => e.hasta === 'actualidad');
const cargosPasados = experiencia.filter((e) => e.hasta !== 'actualidad');

// Formación formal: los totales salen de los datos
const institucionesFormacion = new Set(formacion.map((f) => f.institucion)).size;
const paisesFormacion = new Set(formacion.map((f) => f.pais)).size;

// Publicaciones 2026: artículo, los seis libros de la colección (de coleccion.json), la tesis
// como libro y el Plan de Área. Los libros se citan por DOI de concepto.
// `url` ya lleva BASE_URL.
type PublicacionWeb = Publicacion & { url?: string };
const conBase = (p: Publicacion): PublicacionWeb => ({ ...p, url: p.href ? `${base}${p.href}` : undefined });
const publicaciones: PublicacionWeb[] = [
  conBase(articuloArbitrado),
  ...libros.map((l) => ({
    tipo: l.romano === '0' ? 'Colección MILC · Tomo 0, obra matriz' : `Colección MILC · Tomo ${l.romano}`,
    titulo: l.titulo,
    subtitulo: l.subtitulo,
    detalle: `${l.edicion} · ${l.paginas} págs.`,
    ano: Number(l.fecha.slice(0, 4)),
    doi: l.doi,
    url: l.ficha,
    hrefTexto: 'Ver ficha',
    emoji: l.emoji,
  })),
  conBase(tesisLibro),
  conBase({
    tipo: 'Documento institucional · Autor',
    titulo: `Plan de Área ${planArea.ano} · ${planArea.area}`,
    subtitulo: 'Grados 6.º a 11.º, con sus guías, proyectos y exámenes',
    detalle: `${planArea.paginas} págs.`,
    ano: planArea.ano,
    href: `/plan-de-area/${planArea.pdf}`,
    hrefTexto: 'Abrir PDF',
    emoji: '📚',
  }),
];

const pill =
  'inline-flex items-center gap-2 min-h-[44px] max-w-full px-3 sm:px-4 py-2 rounded-full text-xs sm:text-sm font-bold border-2 hover:bg-[var(--border)] transition-colors break-words';
---

<BaseLayout
  title={`Acerca de ${perfil.prefijo} ${perfil.nombre} — ConectaTE`}
  description={`${perfil.prefijo} ${perfil.nombre}, ${perfil.cargo} en ${perfil.institucion}. Doctor en Ciencias de la Educación con más de ${stats.anosDocencia} años en docencia básica, media y de posgrado, autor del Modelo MILC y líder de semilleros con ${stats.proyectosSamsung} proyectos en etapas nacionales de Samsung Solve for Tomorrow.`}
  ogType="article"
  imagen="/og/acerca.png"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <span style="color: var(--fg);">Acerca del docente</span>
      </nav>

      <!-- HERO -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
        <div class="bento-card-color bg-bento-blue md:col-span-7 min-h-[420px] flex flex-col justify-between">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              👨‍🏫 Docente · Investigador
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              🇨🇴 Cartago, Valle del Cauca
            </span>
          </div>

          <div>
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">{perfil.prefijo}</span>
            <h1 class="heading-giant text-balance leading-[0.95] mt-1 mb-3">
              {perfil.nombre}
            </h1>
            <p class="text-lg md:text-2xl font-semibold opacity-90 leading-tight">
              {perfil.cargo}
            </p>
            <p class="text-sm md:text-base opacity-80 mt-2">
              {perfil.institucion}
            </p>
          </div>
        </div>

        <!-- Cifras de la hoja de vida -->
        <div class="md:col-span-5 grid grid-cols-2 gap-4 md:gap-6">
          <div class="bento-card-color bg-bento-lime flex flex-col justify-between min-h-[200px]">
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Docencia</span>
            <div>
              <div class="text-5xl sm:text-6xl font-black tracking-tighter leading-none">{stats.anosDocencia}+</div>
              <div class="text-sm font-bold mt-1">años en básica, media y posgrado</div>
            </div>
          </div>
          <div class="bento-card-color bg-bento-pink flex flex-col justify-between min-h-[200px]">
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Samsung Solve for Tomorrow</span>
            <div>
              <div class="text-5xl sm:text-6xl font-black tracking-tighter leading-none">{stats.proyectosSamsung}</div>
              <div class="text-sm font-bold mt-1">proyectos en etapas nacionales (2024–2026)</div>
            </div>
          </div>
          <div class="bento-card-color bg-bento-cyan flex flex-col justify-between min-h-[200px]">
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Formación docente</span>
            <div>
              <div class="text-5xl sm:text-6xl font-black tracking-tighter leading-none">{stats.docentesFormados}+</div>
              <div class="text-sm font-bold mt-1">docentes formados en IA y tecnología educativa</div>
            </div>
          </div>
          <div class="bento-card-color bg-bento-yellow flex flex-col justify-between min-h-[200px]">
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Colección MILC</span>
            <div>
              <div class="text-5xl sm:text-6xl font-black tracking-tighter leading-none">{libros.length}</div>
              <div class="text-sm font-bold mt-1">libros con DOI, autor único</div>
            </div>
          </div>
        </div>
      </div>

      <!-- PERFIL PROFESIONAL + HOJA DE VIDA -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
        <div class="bento-card md:col-span-8">
          <span class="chip-bento mb-4">Perfil profesional</span>
          <p class="text-base md:text-lg leading-relaxed mt-4">
            {perfil.resumen}
          </p>
        </div>

        <div class="bento-card-color bg-bento-purple md:col-span-4 flex flex-col justify-between min-h-[220px]">
          <div class="text-7xl">📄</div>
          <div>
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Versión vigente</span>
            <h3 class="text-2xl md:text-3xl font-black tracking-tight leading-tight mt-2 mb-2">
              Hoja de vida
            </h3>
            <p class="text-sm opacity-80 mb-4 leading-relaxed">
              Publicada en alvarocardenasorozco.com. Soportes y datos de contacto de referencias a solicitud.
            </p>
            <div class="flex flex-wrap gap-2">
              <a
                href={hojaDeVida.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-full text-sm font-bold bg-white text-black hover:scale-105 transition-transform"
              >
                Ver hoja de vida
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
              <a
                href={hojaDeVida.pdf}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-full text-sm font-bold border-2 border-white/40 hover:border-white transition-colors"
              >
                Descargar PDF
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- PLATAFORMA CONÉCTATE -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Plataforma educativa propia · 2026</span>
        <h2 class="heading-huge mb-2 leading-tight">ConectaTE.</h2>
        <p class="text-sm md:text-base mb-6 leading-relaxed" style="color: var(--fg-muted);">
          Plataforma educativa de Tecnología e Informática para grados 6° a 11°, desarrollada
          y mantenida por el docente. Funciona offline, sin licencias institucionales y con
          pipeline editorial reproducible. Reúne {plataformaConectate.totalPiezas} piezas
          publicadas bajo el modelo <strong style="color: var(--fg);">{plataformaConectate.modelo}</strong>:
          {plataformaConectate.guias} guías, {plataformaConectate.proyectos} proyectos,
          {plataformaConectate.examenes} exámenes, {plataformaConectate.territorioInterior} de
          Territorio Interior, {plataformaConectate.semillero} del Semillero y
          {plataformaConectate.bebras} retos Bebras.
        </p>

        <!-- Stats grandes -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
          <div class="bento-card-color bg-bento-blue text-center">
            <div class="text-3xl md:text-4xl font-black tracking-tighter">{plataformaConectate.guias}</div>
            <div class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1">guías</div>
          </div>
          <div class="bento-card-color bg-bento-pink text-center">
            <div class="text-3xl md:text-4xl font-black tracking-tighter">{plataformaConectate.proyectos}</div>
            <div class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1">proyectos</div>
          </div>
          <div class="bento-card-color bg-bento-cyan text-center">
            <div class="text-3xl md:text-4xl font-black tracking-tighter">{plataformaConectate.examenes}</div>
            <div class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1">exámenes</div>
          </div>
          <div class="bento-card-color bg-bento-lime text-center">
            <div class="text-3xl md:text-4xl font-black tracking-tighter">{plataformaConectate.totalPiezas}</div>
            <div class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1">total piezas</div>
          </div>
        </div>

        <!-- Bullets distintivos -->
        <div class="mb-6">
          <h3 class="text-sm font-black uppercase tracking-widest mb-3" style="color: var(--fg-muted);">
            Diferenciadores del modelo
          </h3>
          <ul class="space-y-2">
            {plataformaConectate.destacados.map((d) => (
              <li class="flex items-start gap-3 text-sm md:text-base leading-relaxed">
                <span class="w-5 h-5 rounded-md bg-bento-blue/15 flex items-center justify-center shrink-0 mt-0.5">
                  <span class="text-[10px] font-black text-bento-blue">✓</span>
                </span>
                <span>{d}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- CTAs explorar -->
        <div class="flex flex-wrap gap-3">
          <a
            href={`${base}/modelo-milc`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold bg-bento-purple text-white hover:scale-105 transition-transform"
          >
            🌱 Explorar Modelo MILC
          </a>
          <a
            href={`${base}/comenzar`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold border-2 hover:bg-[var(--border)] transition-colors"
            style="border-color: var(--border);"
          >
            🧭 Cómo usar la plataforma
          </a>
          <a
            href={`${base}/plan-de-area`}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-bold border-2 hover:bg-[var(--border)] transition-colors"
            style="border-color: var(--border);"
          >
            📚 Plan de Área 2026
          </a>
        </div>
      </div>

      <!-- PUBLICACIONES 2026 -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Publicaciones 2026</span>
        <h2 class="heading-huge mb-2 leading-tight">Artículo, libros y plan de área.</h2>
        <p class="text-sm md:text-base mb-8" style="color: var(--fg-muted);">
          Un artículo arbitrado, los seis libros de la Colección MILC (autor único, Sor María
          Juliana Ediciones, acceso abierto en Zenodo), la tesis doctoral publicada como libro y
          el Plan de Área. Los libros se citan por su DOI de concepto.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {publicaciones.map((p) => (
            <div class="bento-card flex items-start gap-4">
              <div class="hidden sm:block text-4xl shrink-0">{p.emoji}</div>
              <div class="flex-1 min-w-0">
                <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">
                  {p.tipo} · {p.ano}
                </span>
                <h3 class="font-black text-base md:text-lg leading-tight mt-1">{p.titulo}</h3>
                {p.subtitulo && (
                  <p class="text-sm mt-1" style="color: var(--fg-muted);">{p.subtitulo}</p>
                )}
                <p class="text-xs mt-2 leading-relaxed" style="color: var(--fg-muted);">{p.detalle}</p>
                <div class="flex flex-wrap gap-2 mt-3">
                  {p.url && (
                    <a href={p.url} class={pill} style="border-color: var(--border);">
                      {p.hrefTexto ?? 'Ver ficha'}
                    </a>
                  )}
                  {p.doi && (
                    <a
                      href={`https://doi.org/${p.doi}`}
                      target="_blank"
                      rel="noopener"
                      class={pill}
                      style="border-color: var(--border);"
                    >
                      DOI {p.doi}
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- FORMACIÓN ACADÉMICA FORMAL -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Formación académica formal</span>
        <h2 class="heading-huge mb-2 leading-tight">{formacion.length} títulos · {institucionesFormacion} instituciones · {paisesFormacion} países.</h2>
        <p class="text-sm md:text-base mb-8" style="color: var(--fg-muted);">
          Trayectoria que va desde la ingeniería de sistemas hasta el doctorado en
          ciencias de la educación, pasando por gestión de tecnología educativa.
        </p>

        <div class="space-y-4">
          {formacion.map((f, i) => (
            <div class="flex items-start gap-4 pb-4 border-b last:border-b-0 last:pb-0" style="border-color: var(--border);">
              <div class="text-2xl md:text-3xl font-black tracking-tighter shrink-0 w-24" style="color: var(--fg-muted);">
                {f.desde}
              </div>
              <div class="flex-1">
                <h3 class="text-lg md:text-xl font-black leading-tight mb-1">
                  {f.titulo}
                </h3>
                <p class="text-sm md:text-base" style="color: var(--fg-muted);">
                  {f.institucion} · {f.pais} · <strong>{f.desde}–{f.hasta}</strong>
                </p>
                {f.nota && (
                  <p class="text-sm mt-1" style="color: var(--fg-muted);">{f.nota}</p>
                )}
                {f.enlace && (
                  <a
                    href={`${base}${f.enlace.href}`}
                    class="inline-flex items-center min-h-[44px] text-sm font-bold underline decoration-2 underline-offset-2"
                  >
                    {f.enlace.texto}
                  </a>
                )}
              </div>
              {i === 0 && (
                <span class="px-2 py-1 rounded-full text-xs font-black uppercase tracking-widest bg-bento-pink text-white shrink-0">
                  PhD
                </span>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- TRAYECTORIA PROFESIONAL -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Trayectoria profesional</span>
        <h2 class="heading-huge mb-2 leading-tight">De la escuela al posgrado.</h2>
        <p class="text-sm md:text-base mb-8" style="color: var(--fg-muted);">
          Docencia en básica y media en la I.E. Sor María Juliana y de posgrado en la Maestría y
          la Especialización en Enseñanza de la Física de la UTP, después de una trayectoria en
          dirección de proyectos y docencia desde 2011.
        </p>

        <h4 class="text-xs font-black uppercase tracking-widest mb-4" style="color: var(--fg-muted);">
          Cargos actuales
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          {cargosActuales.map((e) => (
            <div class="bento-card-color bg-bento-lime flex flex-col justify-between gap-4 min-h-[160px]">
              <span class="text-xs font-bold uppercase tracking-widest opacity-80">
                Desde {e.desde} · activo
              </span>
              <div>
                <h3 class="text-lg md:text-xl font-black leading-tight mb-1">
                  {e.cargo}
                </h3>
                <p class="text-sm font-bold opacity-90">{e.organizacion}</p>
                {e.detalle && (
                  <p class="text-sm opacity-90 mt-3 leading-relaxed">{e.detalle}</p>
                )}
              </div>
            </div>
          ))}
        </div>

        <h4 class="text-xs font-black uppercase tracking-widest mb-4" style="color: var(--fg-muted);">
          Trayectoria previa
        </h4>
        <div class="space-y-3">
          {cargosPasados.map((e) => (
            <div class="flex items-start gap-4 pb-3 border-b last:border-b-0 last:pb-0" style="border-color: var(--border);">
              <div class="text-sm font-black tracking-tight shrink-0 w-24 md:w-28" style="color: var(--fg-muted);">
                {e.desde}–{e.hasta}
              </div>
              <div class="flex-1">
                <h4 class="font-black leading-tight mb-0.5">{e.cargo}</h4>
                {e.organizacion && (
                  <p class="text-sm" style="color: var(--fg-muted);">{e.organizacion}</p>
                )}
                {e.items && (
                  <ul class="space-y-1 mt-1">
                    {e.items.map((it) => (
                      <li class="flex items-start gap-2 text-sm leading-snug" style="color: var(--fg-muted);">
                        <span class="opacity-70">·</span>
                        <span>{it}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- RECONOCIMIENTOS DESTACADOS -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
        {reconocimientosDestacados.map((r, i) => (
          <div class={`bento-card-color ${i === 0 ? 'bg-bento-blue' : 'bg-bento-pink'} md:col-span-6 min-h-[280px] flex flex-col justify-between gap-6`}>
            <div class="flex items-start justify-between gap-4">
              <div>
                <span class="text-xs font-bold uppercase tracking-widest opacity-80">
                  {r.ambito}
                </span>
                <div class="mt-1 text-2xl font-black tracking-tighter leading-none">
                  {r.resumen}
                </div>
              </div>
              <span class="text-6xl">{r.emoji}</span>
            </div>
            <div>
              <h3 class="text-2xl md:text-3xl font-black tracking-tight leading-tight mb-2">
                {r.titulo}
              </h3>
              <p class="text-sm md:text-base opacity-90 mb-3 leading-relaxed">
                {r.texto}
              </p>
              {r.anos.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {r.anos.map((a) => (
                    <span class="px-2.5 py-1 rounded-full text-xs font-black bg-black/15 tracking-widest">
                      {a}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- RECONOCIMIENTOS, PROGRAMAS Y JURADOS -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-4">Reconocimientos, programas, mentoría y jurado</span>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
          {reconocimientos.map((r) => (
            <div class="flex items-start gap-3">
              <div class="text-3xl shrink-0">{r.emoji}</div>
              <div class="flex-1">
                <h3 class="font-black leading-tight">
                  {r.titulo}
                </h3>
                <p class="text-sm" style="color: var(--fg-muted);">
                  {r.detalle}
                  {r.fecha && ` · ${r.fecha}`}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- PONENCIAS -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Ponencias</span>
        <h2 class="heading-huge mb-8 leading-tight">En congresos y encuentros.</h2>
        <div class="space-y-3">
          {ponencias.map((p) => (
            <div class="flex items-start gap-4 pb-3 border-b last:border-b-0 last:pb-0" style="border-color: var(--border);">
              <div class="text-sm font-black tracking-tight shrink-0 w-24 md:w-28" style="color: var(--fg-muted);">
                {p.fecha}
              </div>
              <div class="flex-1">
                <h3 class="font-black leading-tight mb-0.5">{p.titulo}</h3>
                <p class="text-sm" style="color: var(--fg-muted);">{p.evento}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- COMPETENCIAS -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Competencias</span>
        <h2 class="heading-huge mb-8 leading-tight">Donde más impacto.</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5">
          {competencias.map((c) => (
            <div class="flex items-start gap-3">
              <span class="text-2xl shrink-0">{c.emoji}</span>
              <div>
                <h3 class="font-bold text-sm md:text-base leading-tight">{c.titulo}</h3>
                <p class="text-sm mt-0.5" style="color: var(--fg-muted);">{c.evidencia}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- FORMACIÓN COMPLEMENTARIA -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Formación complementaria</span>
        <h2 class="heading-huge mb-2 leading-tight">Diplomados y cursos.</h2>
        <p class="text-sm md:text-base mb-8" style="color: var(--fg-muted);">
          Diplomados y cursos que complementan la formación formal, agrupados por área.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {formacionComplementaria.map((g) => (
            <div class={`bento-card-color ${g.bgClass} flex flex-col`}>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-4xl">{g.emoji}</span>
                <h3 class="text-lg md:text-xl font-black tracking-tight leading-tight">
                  {g.categoria}
                </h3>
              </div>
              <ul class="space-y-2 mt-2">
                {g.items.map((it) => (
                  <li class="flex items-start gap-2 text-sm leading-snug">
                    <span class="opacity-70 mt-0.5">·</span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
              {g.nota && (
                <p class="text-xs font-bold opacity-80 uppercase tracking-widest mt-4">{g.nota}</p>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- MEMBRESÍAS -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Membresías y roles activos</span>
        <h2 class="heading-huge mb-8 leading-tight">Donde participo hoy.</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {membresias.map((m) => (
            <div class="flex items-start gap-3 p-4 rounded-bento-sm" style="background: var(--bg);">
              <div class="text-3xl shrink-0">{m.emoji}</div>
              <div>
                <h3 class="font-black leading-tight mb-1">{m.rol}</h3>
                <p class="text-sm" style="color: var(--fg-muted);">{m.organizacion}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- CONTACTO -->
      <div class="bento-card-color bg-bento-black grid-pattern py-12 md:py-16 px-6 md:px-10 mb-10">
        <div class="text-center max-w-2xl mx-auto">
          <span class="chip-bento mb-3 bg-white/10 text-white">Contacto</span>
          <h2 class="heading-huge mb-3 leading-tight">¿Hablamos?</h2>
          <p class="text-base md:text-lg opacity-80 mb-8 leading-relaxed">
            Estoy disponible para charlas, asesorías sobre IA en educación,
            formación docente, proyectos STEM+ y colaboraciones académicas.
          </p>

          <div class="flex flex-wrap gap-3 justify-center">
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full font-bold text-sm bg-[#25D366] text-white hover:scale-105 active:scale-95 transition-transform shadow-sm"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.91 9.91 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.02ZM12.04 20.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.21 8.21 0 0 1-1.26-4.39c0-4.54 3.7-8.24 8.25-8.24a8.18 8.18 0 0 1 5.83 2.42 8.2 8.2 0 0 1 2.42 5.83c0 4.54-3.7 8.24-8.25 8.24Zm4.52-6.16c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.56.12-.16.25-.64.8-.79.96-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.66.31s-.86.85-.86 2.06c0 1.21.88 2.39 1 2.55.12.17 1.74 2.66 4.21 3.74.59.26 1.05.41 1.4.52.59.19 1.13.16 1.55.1.47-.07 1.46-.6 1.66-1.17.21-.58.21-1.07.15-1.17-.06-.1-.22-.16-.46-.28Z"/>
              </svg>
              WhatsApp · {perfil.whatsapp}
            </a>
            <a
              href={mailtoHref}
              class="inline-flex items-center gap-2 px-5 py-3 rounded-full font-bold text-sm bg-bento-lime text-black hover:scale-105 active:scale-95 transition-transform"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              Correo
            </a>
            {[
              { texto: 'Sitio web', href: perfil.sitioWeb },
              { texto: 'LinkedIn', href: perfil.linkedin },
              { texto: 'ORCID', href: perfil.orcid },
            ].map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-5 py-3 rounded-full font-bold text-sm border-2 border-white/30 text-white hover:border-white transition-colors"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
                {l.texto}
              </a>
            ))}
          </div>

          <p class="text-xs opacity-60 mt-6">
            {perfil.email}
          </p>
        </div>
      </div>

      <!-- VOLVER -->
      <a
        href={base || '/'}
        class="bento-card-hover flex items-center gap-4"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al</div>
          <div class="font-black text-lg">Inicio de ConectaTE</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiagramaNavegacion from '../../components/DiagramaNavegacion.astro';
import DiagramaIconosMILC from '../../components/DiagramaIconosMILC.astro';
import DiagramaCicloMILC from '../../components/DiagramaCicloMILC.astro';

const base = import.meta.env.BASE_URL;
const origen = (Astro.site ?? new URL('https://alguarito.github.io')).toString().replace(/\/$/, '');
const inicio = `${origen}${base.replace(/\/$/, '')}`;

// Schema.org · LearningResource para esta página
const jsonLdExtra = [
  {
    '@type': 'LearningResource',
    '@id': `${inicio}/comenzar#guia`,
    name: 'Comenzar · Cómo usar ConectaTE',
    description:
      'Guía rápida para usar la Plataforma Conéctate: cómo navegar, qué hay en una guía, cómo usar el cuaderno, qué es un examen y un proyecto integrador, y cómo se cierra cada sesión con el triángulo de pensamiento MILC.',
    inLanguage: 'es-CO',
    learningResourceType: ['OnboardingGuide', 'Tutorial'],
    educationalLevel: ['Secundaria', 'Media'],
    audience: [
      { '@type': 'EducationalAudience', educationalRole: 'student' },
      { '@type': 'EducationalAudience', educationalRole: 'teacher' },
    ],
    isPartOf: { '@id': `${inicio}#website` },
    author: { '@id': `${inicio}/acerca#person` },
    image: `${inicio}/og/comenzar.png`,
  },
];
---

<BaseLayout
  title="Comenzar · Cómo usar ConectaTE — para docentes y estudiantes"
  description="Guía rápida para usar la Plataforma Conéctate: cómo navegar, qué hay en una guía, cómo usar el cuaderno, qué es un examen y un proyecto integrador, y cómo se cierra cada sesión con el triángulo de pensamiento MILC."
  ogType="article"
  imagen="/og/comenzar.png"
  jsonLd={jsonLdExtra}
>
  <article class="pt-8 md:pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-6 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <span style="color: var(--fg);">Comenzar</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-blue mb-8 min-h-[260px] flex flex-col justify-between">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
            🧭 Cómo usar la plataforma
          </span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
            Para docentes y estudiantes
          </span>
        </div>
        <div>
          <h1 class="heading-giant text-balance leading-[0.95] mt-2 mb-3">
            Comenzar.
          </h1>
          <p class="text-base md:text-lg font-semibold opacity-90 max-w-2xl leading-snug">
            En 5 minutos sabes cómo navegar la plataforma, qué hay en cada guía, cómo se conecta el cuaderno físico con la web, y cómo se cierra cada sesión con el triángulo de pensamiento MILC.
          </p>
        </div>
      </div>

      <!-- Toggle Docente / Estudiante -->
      <div
        id="rol-toggle"
        class="bento-card mb-10 flex items-center gap-3 flex-wrap"
        role="tablist"
        aria-label="Selecciona tu rol"
      >
        <span class="text-sm font-bold mr-2" style="color: var(--fg-muted);">Soy:</span>
        <button
          type="button"
          data-rol="estudiante"
          class="rol-btn px-5 py-2 rounded-full text-sm font-black uppercase tracking-widest bg-bento-yellow text-black hover:scale-105 transition-transform"
          aria-selected="true"
          role="tab"
        >
          🎒 Estudiante
        </button>
        <button
          type="button"
          data-rol="docente"
          class="rol-btn px-5 py-2 rounded-full text-sm font-black uppercase tracking-widest hover:scale-105 transition-transform"
          style="background: var(--border); color: var(--fg);"
          aria-selected="false"
          role="tab"
        >
          👨‍🏫 Docente
        </button>
        <span class="text-xs font-semibold ml-auto" style="color: var(--fg-muted);">
          Cambia el detalle en cada sección
        </span>
      </div>

      <!-- 1. Qué es ConectaTE -->
      <section class="bento-card mb-8" id="seccion-que-es">
        <span class="chip-bento mb-4">1 · Qué es ConectaTE</span>
        <h2 class="heading-huge mb-3 leading-tight">Una plataforma propia con 216 piezas vivas.</h2>
        <p class="text-base md:text-lg leading-relaxed mb-4">
          ConectaTE reúne las <strong>180 guías de aprendizaje, 18 proyectos integradores y 18 exámenes finales</strong> que vertebran el área de Tecnología e Informática para los grados 6° a 11°. Está hospedada en <code class="font-mono text-sm bg-bento-blue/10 px-1.5 py-0.5 rounded">alguarito.github.io/plataformaconectate</code>, funciona <strong>offline</strong> tras la primera visita y no requiere instalación ni cuenta.
        </p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6">
          <div class="bento-card-color bg-bento-blue text-center">
            <div class="text-3xl md:text-4xl font-black tracking-tighter">180</div>
            <div class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1">guías</div>
          </div>
          <div class="bento-card-color bg-bento-pink text-center">
            <div class="text-3xl md:text-4xl font-black tracking-tighter">18</div>
            <div class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1">proyectos</div>
          </div>
          <div class="bento-card-color bg-bento-cyan text-center">
            <div class="text-3xl md:text-4xl font-black tracking-tighter">18</div>
            <div class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1">exámenes</div>
          </div>
          <div class="bento-card-color bg-bento-lime text-center">
            <div class="text-3xl md:text-4xl font-black tracking-tighter">6</div>
            <div class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1">grados</div>
          </div>
        </div>

        <div class="rol-content rol-estudiante mt-6 p-4 rounded-bento-sm" style="background: var(--bg);">
          <div class="text-xs font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Tip para ti</div>
          <p class="text-sm leading-relaxed">Una vez la abres por primera vez en tu celular o tableta, queda disponible <strong>sin internet</strong>. Puedes consultarla en clase aunque la sala no tenga buena conexión.</p>
        </div>
        <div class="rol-content rol-docente mt-6 p-4 rounded-bento-sm hidden" style="background: var(--bg);">
          <div class="text-xs font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Para clase</div>
          <p class="text-sm leading-relaxed">Cada pieza tiene su <strong>PDF imprimible</strong> en paralelo (mismo contenido que la web). Útil cuando no haya proyector ni computadores: imprimes y trabajas a mano con la misma estructura MILC.</p>
        </div>
      </section>

      <!-- 2. Cómo navegar -->
      <section class="bento-card mb-8" id="seccion-navegar">
        <span class="chip-bento mb-4">2 · Cómo navegar</span>
        <h2 class="heading-huge mb-3 leading-tight">4 niveles · 4 clics.</h2>
        <p class="text-base mb-6 leading-relaxed" style="color: var(--fg-muted);">
          La estructura es siempre la misma: del inicio al recurso final en 4 niveles.
        </p>

        <DiagramaNavegacion />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
          <div class="rol-content rol-estudiante p-4 rounded-bento-sm" style="background: var(--bg);">
            <div class="text-xs font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Atajos útiles</div>
            <ul class="text-sm space-y-1.5">
              <li><kbd class="font-mono text-xs px-1.5 py-0.5 rounded bg-bento-yellow/30">⌘ K</kbd> o <kbd class="font-mono text-xs px-1.5 py-0.5 rounded bg-bento-yellow/30">/</kbd> buscador global</li>
              <li><kbd class="font-mono text-xs px-1.5 py-0.5 rounded bg-bento-yellow/30">✓</kbd> marca tu progreso (queda guardado en el navegador)</li>
              <li><kbd class="font-mono text-xs px-1.5 py-0.5 rounded bg-bento-yellow/30">📲</kbd> comparte una guía específica por WhatsApp</li>
              <li><kbd class="font-mono text-xs px-1.5 py-0.5 rounded bg-bento-yellow/30">⭐</kbd> badge de calidad MILC v3 visible en cada guía</li>
            </ul>
          </div>
          <div class="rol-content rol-docente p-4 rounded-bento-sm hidden" style="background: var(--bg);">
            <div class="text-xs font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Para preparar clase</div>
            <ul class="text-sm space-y-1.5">
              <li>Abre la página del grado para ver los <strong>3 periodos</strong> con sus tarjetas de progreso</li>
              <li>Cada periodo tiene <strong>10 sesiones + 1 examen + 1 proyecto integrador</strong></li>
              <li>El PDF imprimible está en el botón <em>"Descargar PDF"</em> de cada guía</li>
              <li>El <a href={`${base}/plan-de-area`} class="font-bold underline">Plan de Área 2026</a> (39 páginas) es el documento rector con mallas curriculares MEN</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- 3. Anatomía de una guía -->
      <section class="bento-card mb-8" id="seccion-anatomia">
        <span class="chip-bento mb-4">3 · Anatomía de una guía</span>
        <h2 class="heading-huge mb-3 leading-tight">7 íconos, 7 acciones distintas.</h2>
        <p class="text-base mb-6 leading-relaxed" style="color: var(--fg-muted);">
          Cada bloque de la guía tiene un ícono fijo. Tres de los siete piden producción al cuaderno; los demás son para leer, explorar o verificar.
        </p>

        <DiagramaIconosMILC />

        <div class="rol-content rol-estudiante mt-6 p-4 rounded-bento-sm bg-bento-yellow/15 border-l-4 border-bento-yellow">
          <div class="text-xs font-black uppercase tracking-widest mb-2">Regla del cuaderno</div>
          <p class="text-sm leading-relaxed">
            <strong>Solo lo que aparece en los bloques 🌱 SABER ANCESTRAL, ✏️ ACTIVIDAD y 💭 REFLEXIONA va al cuaderno físico.</strong> El resto (📖 leer, 👁 observar, ✅ verificar, 🔎 explorar) es para entender y practicar, pero no se transcribe.
          </p>
        </div>
        <div class="rol-content rol-docente mt-6 p-4 rounded-bento-sm hidden bg-bento-purple/10 border-l-4 border-bento-purple">
          <div class="text-xs font-black uppercase tracking-widest mb-2" style="color: var(--fg);">Para evaluar</div>
          <p class="text-sm leading-relaxed">
            El cuaderno se evalúa por <strong>presencia + cumplimiento de formato</strong> de los bloques al cuaderno. Cada actividad tiene su <code class="font-mono text-xs bg-black/10 px-1 rounded">CuadernoFormato</code> en el YAML SSOT con título, formato y extensión esperada (ej. <em>"tabla 2×6"</em>, <em>"párrafo de 5 renglones"</em>).
          </p>
        </div>
      </section>

      <!-- 4. Cuaderno físico -->
      <section class="bento-card mb-8" id="seccion-cuaderno">
        <span class="chip-bento mb-4">4 · Tu cuaderno físico</span>
        <h2 class="heading-huge mb-3 leading-tight">Encabezado fijo · una página por guía.</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
          <!-- Mock del encabezado -->
          <div class="bento-card-color bg-bento-yellow text-black p-6">
            <div class="text-xs font-black uppercase tracking-widest mb-3 opacity-70">Encabezado al iniciar cada guía</div>
            <div class="font-mono text-sm md:text-base leading-relaxed border-2 border-dashed border-black/40 p-4 rounded-bento-sm bg-white">
              <strong>Guía:</strong> 7° · Periodo 1 · Guía 4<br/>
              <strong>Tema:</strong> Word, Excel y PowerPoint en línea<br/>
              <strong>Fecha:</strong> __/__/____
            </div>
          </div>

          <div class="space-y-3">
            <div class="rol-content rol-estudiante">
              <h3 class="font-black text-base mb-2">Cómo escribirlo</h3>
              <ul class="text-sm space-y-1.5 leading-relaxed">
                <li>📓 Cada guía empieza en página nueva con este encabezado</li>
                <li>✏️ Las actividades se numeran igual que en la guía (Actividad 1, 2, 3…)</li>
                <li>🌱 El saber ancestral y 💭 la reflexión tienen apartados propios</li>
                <li>📅 La fecha la pones el día que trabajaste la guía en clase</li>
              </ul>
            </div>
            <div class="rol-content rol-docente hidden">
              <h3 class="font-black text-base mb-2">Qué revisas</h3>
              <ul class="text-sm space-y-1.5 leading-relaxed">
                <li>✅ Encabezado completo en cada guía</li>
                <li>✅ Actividades numeradas en orden (1–N)</li>
                <li>✅ Cumple el formato pedido (tabla/párrafo/lista/dibujo)</li>
                <li>✅ Cumple la extensión (renglones/filas/viñetas)</li>
                <li>✅ Reflexión del triángulo presente al cierre</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 5. Examen y proyecto -->
      <section class="bento-card mb-8" id="seccion-examen-proyecto">
        <span class="chip-bento mb-4">5 · Examen y proyecto integrador</span>
        <h2 class="heading-huge mb-3 leading-tight">Dos cierres distintos del periodo.</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
          <div class="bento-card-color bg-bento-cyan">
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">📝 Examen final</span>
            <h3 class="text-2xl font-black tracking-tight mt-2 leading-tight">5 preguntas · 45 min · 20%</h3>
            <p class="text-sm mt-3 leading-relaxed opacity-90">
              Una pregunta de cada tipo: concreta, contexto ancestral, dos prácticas y una reflexiva con el triángulo. Sumativo del periodo.
            </p>
            <div class="mt-4 p-3 rounded-bento-sm bg-black/10">
              <div class="text-xs font-black uppercase tracking-widest mb-1">Banco de práctica</div>
              <p class="text-xs leading-relaxed">Cada examen tiene 20–30 preguntas OM <strong>online</strong> para que practiques antes del día del examen. Repetible · feedback inmediato.</p>
            </div>
          </div>

          <div class="bento-card-color bg-bento-pink">
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">🎯 Proyecto integrador</span>
            <h3 class="text-2xl font-black tracking-tight mt-2 leading-tight">3–5 entregables · 4 sem · 30%</h3>
            <p class="text-sm mt-3 leading-relaxed opacity-90">
              Modelo entregable-céntrico: el proyecto es un brief con reto + insumos + entregables, cada uno con su reflexión del triángulo incrustada en el producto.
            </p>
            <div class="mt-4 p-3 rounded-bento-sm bg-black/10">
              <div class="text-xs font-black uppercase tracking-widest mb-1">Sustentación</div>
              <p class="text-xs leading-relaxed">5 minutos · los 3 integrantes hablan · autoevaluación honesta con rúbrica + declaración de uso de IA si aplica.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 6. Política de IA -->
      <section class="bento-card mb-8" id="seccion-ia">
        <span class="chip-bento mb-4">6 · Política de IA</span>
        <h2 class="heading-huge mb-3 leading-tight">Cada grado, su criterio.</h2>
        <p class="text-base mb-6 leading-relaxed" style="color: var(--fg-muted);">
          La IA generativa entra al aula con criterio progresivo. No es lo mismo para 6° que para 11°.
        </p>

        <div class="space-y-3">
          <div class="flex items-start gap-4 p-4 rounded-bento-sm bg-bento-blue/10 border-l-4 border-bento-blue">
            <div class="text-3xl">🚫</div>
            <div class="flex-1">
              <div class="font-black text-base mb-1">Grado 6° · Sin IA</div>
              <p class="text-sm leading-relaxed">Los entregables se producen a mano con criterio propio. La IA aún no se cubre como herramienta.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 rounded-bento-sm bg-bento-yellow/15 border-l-4 border-bento-yellow">
            <div class="text-3xl">📋</div>
            <div class="flex-1">
              <div class="font-black text-base mb-1">Grado 7° · IA con declaración</div>
              <p class="text-sm leading-relaxed">Se permite IA con declaración explícita: qué herramienta, en qué parte, cuánto editó el equipo a mano.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 rounded-bento-sm bg-bento-pink/10 border-l-4 border-bento-pink">
            <div class="text-3xl">🤖</div>
            <div class="flex-1">
              <div class="font-black text-base mb-1">Grados 8° a 11° · IA esperada con declaración obligatoria</div>
              <p class="text-sm leading-relaxed">La rúbrica penaliza la falta de declaración o el copy-paste sin edición. Voz humana + edición + verificación + declaración.</p>
            </div>
          </div>
        </div>

        <div class="rol-content rol-docente mt-6 p-4 rounded-bento-sm hidden bg-black/[0.03]">
          <div class="text-xs font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">5 principios transversales no negociables</div>
          <ol class="text-sm space-y-1 list-decimal list-inside leading-relaxed">
            <li>Declarar siempre el uso, así sea pequeño</li>
            <li>Verificar contra fuente externa los datos importantes</li>
            <li>Editar con voz propia: la IA puede borrador, no entrega final</li>
            <li>Respetar la privacidad: no datos personales de otros en prompts</li>
            <li>No usar IA en evaluaciones que valoran algo personal</li>
          </ol>
        </div>
      </section>

      <!-- 7. Cierre filosófico -->
      <section class="bento-card mb-10" id="seccion-cierre">
        <span class="chip-bento mb-4">7 · Cierre de cada guía</span>
        <h2 class="heading-huge mb-3 leading-tight">Triángulo de pensamiento + 5 dimensiones.</h2>
        <p class="text-base mb-6 leading-relaxed" style="color: var(--fg-muted);">
          Cada guía cierra con tres voces filosóficas dialogando y cinco preguntas que recorren del yo a lo intergeneracional.
        </p>

        <DiagramaCicloMILC />

        <div class="rol-content rol-estudiante mt-6 p-4 rounded-bento-sm" style="background: var(--bg);">
          <div class="text-xs font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Qué te pide</div>
          <p class="text-sm leading-relaxed">No es ensayo: son <strong>3 preguntas cortas</strong> que respondes en tu cuaderno desde la voz de Dussel (reconocer al otro), la voz estoica (dominio de sí) y la voz de Floridi (vivir bien en la infoesfera). Las 5 dimensiones se responden con una frase cada una.</p>
        </div>
        <div class="rol-content rol-docente mt-6 p-4 rounded-bento-sm hidden" style="background: var(--bg);">
          <div class="text-xs font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Por qué importa</div>
          <p class="text-sm leading-relaxed">Es el bloque que distingue MILC de un currículo técnico común: <strong>la técnica se piensa éticamente</strong>. Las tres voces y las cinco dimensiones recorren del fuero interior al impacto intergeneracional, articulando lo procedimental con lo crítico-social.</p>
        </div>
      </section>

      <!-- CTAs finales -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-10">
        <a
          href={`${base}/grado-6`}
          class="bento-card-color bg-bento-lime flex items-center gap-4 hover:scale-[1.01] transition-transform group"
        >
          <div class="text-5xl">🚀</div>
          <div class="flex-1">
            <div class="text-xs font-bold uppercase tracking-widest opacity-80">Empezar por</div>
            <div class="font-black text-xl mt-1">Grado 6°</div>
            <div class="text-sm opacity-80 mt-1">Comunicación e identidad digital</div>
          </div>
          <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
        <a
          href={`${base}/plan-de-area`}
          class="bento-card-hover flex items-center gap-4"
        >
          <div class="text-5xl">📚</div>
          <div class="flex-1">
            <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Para docentes</div>
            <div class="font-black text-xl mt-1">Plan de Área 2026</div>
            <div class="text-sm mt-1" style="color: var(--fg-muted);">39 páginas · mallas curriculares MEN + MILC v3</div>
          </div>
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"></path>
          </svg>
        </a>
      </div>
    </div>
  </article>

  <script>
    // Toggle Docente / Estudiante con persistencia en localStorage
    const STORAGE_KEY = 'conectate.comenzar.rol';
    const botones = document.querySelectorAll<HTMLButtonElement>('.rol-btn');
    const contenidos = document.querySelectorAll<HTMLElement>('.rol-content');

    function aplicar(rol: string) {
      // Pintar botones
      botones.forEach((b) => {
        const activo = b.dataset.rol === rol;
        b.setAttribute('aria-selected', activo ? 'true' : 'false');
        if (activo) {
          b.classList.add('bg-bento-yellow', 'text-black');
          b.classList.remove('hover:bg-[var(--border)]');
          b.style.background = '';
          b.style.color = '';
        } else {
          b.classList.remove('bg-bento-yellow', 'text-black');
          b.style.background = 'var(--border)';
          b.style.color = 'var(--fg)';
        }
      });
      // Mostrar/ocultar bloques
      contenidos.forEach((c) => {
        if (c.classList.contains(`rol-${rol}`)) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });
      try {
        localStorage.setItem(STORAGE_KEY, rol);
      } catch {}
    }

    botones.forEach((b) => {
      b.addEventListener('click', () => aplicar(b.dataset.rol ?? 'estudiante'));
    });

    // Estado inicial: lee de localStorage, default estudiante
    let rolInicial = 'estudiante';
    try {
      const guardado = localStorage.getItem(STORAGE_KEY);
      if (guardado === 'docente' || guardado === 'estudiante') {
        rolInicial = guardado;
      }
    } catch {}
    aplicar(rolInicial);
  </script>
</BaseLayout>

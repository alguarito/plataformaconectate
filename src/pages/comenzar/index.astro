  <script>
    // Toggle Docente / Estudiante con persistencia en localStorage
    const STORAGE_KEY = 'conectate.comenzar.rol';
    const botones = document.querySelectorAll<HTMLButtonElement>('.rol-btn');
    const contenidos = document.querySelectorAll<HTMLElement>('.rol-content');

    function aplicar(rol: string) {
      botones.forEach((b) => {
        const activo = b.dataset.rol === rol;
        b.setAttribute('aria-selected', activo ? 'true' : 'false');
        if (activo) {
          b.classList.add('bg-bento-yellow', 'text-black');
          b.classList.remove('hover:bg-[var(--border)]');
          b.style.background = '';
          b.style.color = '';
        } else {
          b.classList.remove('bg-bento-yellow', 'text-black');
          b.style.background = 'var(--border)';
          b.style.color = 'var(--fg)';
        }
      });
      contenidos.forEach((c) => {
        if (c.classList.contains(`rol-${rol}`)) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });
      try {
        localStorage.setItem(STORAGE_KEY, rol);
      } catch {}
    }

    botones.forEach((b) => {
      b.addEventListener('click', () => aplicar(b.dataset.rol ?? 'estudiante'));
    });

    let rolInicial = 'estudiante';
    try {
      const guardado = localStorage.getItem(STORAGE_KEY);
      if (guardado === 'docente' || guardado === 'estudiante') {
        rolInicial = guardado;
      }
    } catch {}
    aplicar(rolInicial);
  </script>

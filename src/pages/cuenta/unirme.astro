---
/**
 * /cuenta/unirme · página pública con flujo dual según edad del estudiante.
 *
 * Pasos:
 *   1. Ingresa código de aula → validar
 *   2. Diligencia nombre + fecha de nacimiento
 *   3. Calcular edad:
 *      - <14 años → pedir email del acudiente → email al acudiente → solicitud-enviada
 *      - ≥14 años → pedir email propio → OTP al estudiante → /cuenta/verificar-otp
 */
import CuentaLayout from '../../layouts/CuentaLayout.astro';
---

<CuentaLayout
  title="Unirme a un aula · Plataforma Conéctate"
  description="Únete al aula de tu docente usando el código que te entregó en clase."
  conHeader={false}
  publica={true}
>
  <div class="bg-white dark:bg-neutral-900 rounded-bento shadow-bento p-6 md:p-10">
    <header class="text-center mb-8">
      <h1 class="text-huge font-black tracking-tight mb-3 text-bento-blue">
        Únete a tu aula
      </h1>
      <p class="text-base text-neutral-700 dark:text-neutral-300 max-w-md mx-auto leading-relaxed">
        Tu docente te entregó un código (ej.
        <code class="bg-bento-blue/10 text-bento-blue px-2 py-0.5 rounded font-mono text-sm">
          AULA-6A-2026-K3X7
        </code>). Ingrésalo abajo para empezar.
      </p>
    </header>

    <!-- PASO 1 · Código de aula -->
    <section data-paso="codigo">
      <form data-form-codigo class="space-y-4">
        <div>
          <label for="codigo-input" class="block text-sm font-bold mb-2">Código de aula</label>
          <input
            id="codigo-input"
            name="codigo"
            type="text"
            required
            placeholder="AULA-6A-2026-XXXX"
            autocomplete="off"
            spellcheck="false"
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 font-mono font-bold text-center uppercase tracking-wider text-lg focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          />
        </div>
        <button
          type="submit"
          data-btn-validar
          class="w-full min-h-[48px] px-5 py-3 rounded-bento-sm bg-bento-blue text-white font-bold hover:scale-[1.01] transition-transform motion-reduce:transition-none disabled:opacity-60 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
        >
          Verificar código
        </button>
      </form>
      <div data-error-codigo class="hidden mt-4 bg-bento-pink/10 border border-bento-pink/30 rounded-bento-sm p-3">
        <p class="text-sm text-bento-pink font-semibold" data-error-codigo-msg></p>
      </div>
    </section>

    <!-- PASO 2 · Nombre + fecha nacimiento -->
    <section data-paso="datos" class="hidden">
      <div class="bg-bento-lime/15 border border-bento-lime rounded-bento-sm p-4 mb-6">
        <p class="text-sm font-bold text-neutral-950 dark:text-neutral-50 mb-1">✓ Aula encontrada</p>
        <p class="text-sm text-neutral-800 dark:text-neutral-200" data-aula-resumen></p>
      </div>

      <form data-form-datos class="space-y-5">
        <div>
          <label for="nombre-input" class="block text-sm font-bold mb-2">Tu nombre o seudónimo</label>
          <input
            id="nombre-input"
            name="estudiante_display_name"
            type="text"
            required
            minlength="2"
            maxlength="80"
            placeholder="Ej: Juan Pablo R."
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          />
          <p class="text-xs text-neutral-500 mt-1">Es lo que verá el docente.</p>
        </div>

        <div>
          <label for="fecha-nac-input" class="block text-sm font-bold mb-2">Tu fecha de nacimiento</label>
          <input
            id="fecha-nac-input"
            name="estudiante_fecha_nacimiento"
            type="date"
            required
            max="2018-12-31"
            min="2003-01-01"
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          />
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button
            type="submit"
            data-btn-continuar
            class="flex-1 min-h-[48px] px-5 py-3 rounded-bento-sm bg-bento-blue text-white font-bold hover:scale-[1.01] transition-transform motion-reduce:transition-none disabled:opacity-60 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          >
            Continuar
          </button>
          <button
            type="button"
            data-btn-volver-codigo
            class="px-5 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors"
          >
            Cambiar código
          </button>
        </div>
      </form>
    </section>

    <!-- PASO 3A · email del acudiente (estudiante <14) -->
    <section data-paso="email-acudiente" class="hidden">
      <div class="bg-bento-blue/10 border border-bento-blue/30 rounded-bento-sm p-4 mb-6">
        <p class="text-sm font-bold mb-1">Necesitamos la autorización de tu acudiente</p>
        <p class="text-xs text-neutral-700 dark:text-neutral-300 leading-relaxed">
          Como tienes menos de 14 años, la <strong>Ley 1581 de 2012</strong> requiere
          que tu padre, madre o tutor autorice el tratamiento de tus datos.
        </p>
      </div>

      <form data-form-acudiente class="space-y-5">
        <div>
          <label for="acudiente-email-input" class="block text-sm font-bold mb-2">
            Correo electrónico de tu acudiente
          </label>
          <input
            id="acudiente-email-input"
            name="acudiente_email"
            type="email"
            required
            placeholder="papa.juan@correo.com"
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          />
          <p class="text-xs text-neutral-500 mt-1">
            Le enviaremos un correo para que firme la autorización.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <button
            type="submit"
            data-btn-enviar-acudiente
            class="flex-1 min-h-[48px] px-5 py-3 rounded-bento-sm bg-bento-blue text-white font-bold hover:scale-[1.01] transition-transform motion-reduce:transition-none disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Solicitar autorización
          </button>
          <button
            type="button"
            data-btn-volver-datos
            class="px-5 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-800"
          >
            Volver
          </button>
        </div>
      </form>
    </section>

    <!-- PASO 3B · email propio (estudiante ≥14) -->
    <section data-paso="email-auto" class="hidden">
      <div class="bg-bento-lime/15 border border-bento-lime rounded-bento-sm p-4 mb-6">
        <p class="text-sm font-bold mb-1">Puedes registrarte tú mismo</p>
        <p class="text-xs text-neutral-700 dark:text-neutral-300 leading-relaxed">
          Como tienes 14 años o más, puedes autorizar el tratamiento de tus datos
          directamente. Te enviaremos un código de 6 dígitos a tu correo para
          verificar que es tuyo.
        </p>
      </div>

      <form data-form-auto class="space-y-5">
        <div>
          <label for="estudiante-email-input" class="block text-sm font-bold mb-2">
            Tu correo electrónico personal
          </label>
          <input
            id="estudiante-email-input"
            name="estudiante_email"
            type="email"
            required
            placeholder="tucorreo@gmail.com"
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          />
          <p class="text-xs text-neutral-500 mt-1">
            Importante: debe ser <strong>tuyo personal</strong>, al que solo tú accedes.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <button
            type="submit"
            data-btn-enviar-auto
            class="flex-1 min-h-[48px] px-5 py-3 rounded-bento-sm bg-bento-blue text-white font-bold hover:scale-[1.01] transition-transform motion-reduce:transition-none disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Enviarme el código
          </button>
          <button
            type="button"
            data-btn-volver-datos-2
            class="px-5 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-800"
          >
            Volver
          </button>
        </div>
      </form>
    </section>

    <!-- Error compartido -->
    <div data-error-global class="hidden mt-4 bg-bento-pink/10 border border-bento-pink/30 rounded-bento-sm p-3">
      <p class="text-sm text-bento-pink font-semibold" data-error-global-msg></p>
    </div>
  </div>
</CuentaLayout>

<script>
  import {
    validarCodigoAula,
    iniciarRegistroAcudiente,
    iniciarRegistroAuto,
    requiereAcudiente,
  } from '../../lib/registro';

  const base = (import.meta.env?.BASE_URL ?? '/').replace(/\/$/, '');

  // Estado del flujo en variables del closure
  let codigoActual = '';
  let nombreActual = '';
  let fechaNacActual = '';

  function mostrarPaso(paso: 'codigo' | 'datos' | 'email-acudiente' | 'email-auto') {
    document.querySelectorAll<HTMLElement>('[data-paso]').forEach((el) => {
      el.classList.toggle('hidden', el.dataset.paso !== paso);
    });
    document.querySelector('[data-error-global]')?.classList.add('hidden');
  }

  function mostrarErrorGlobal(msg: string) {
    const m = document.querySelector<HTMLElement>('[data-error-global-msg]');
    if (m) m.textContent = msg;
    document.querySelector('[data-error-global]')?.classList.remove('hidden');
  }

  // ─── Si la URL trae ?codigo=, pre-llena ───
  const params = new URLSearchParams(window.location.search);
  const codigoEnURL = params.get('codigo');
  if (codigoEnURL) {
    const input = document.querySelector<HTMLInputElement>('#codigo-input');
    if (input) input.value = codigoEnURL.toUpperCase();
  }

  // ─── PASO 1 · validar código ───
  document.querySelector<HTMLFormElement>('[data-form-codigo]')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.querySelector<HTMLButtonElement>('[data-btn-validar]')!;
    const errorEl = document.querySelector<HTMLElement>('[data-error-codigo]')!;
    const errorMsg = document.querySelector<HTMLElement>('[data-error-codigo-msg]')!;
    const input = document.querySelector<HTMLInputElement>('#codigo-input')!;

    errorEl.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Verificando…';

    const codigo = input.value.trim().toUpperCase();
    const info = await validarCodigoAula(codigo);

    if (!info) {
      errorMsg.textContent = 'No encontramos un aula con ese código. Verifica que esté igual al que te entregó tu docente.';
      errorEl.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Verificar código';
      return;
    }

    codigoActual = codigo;
    const periodos = ['Primer', 'Segundo', 'Tercer'];
    const resumen =
      `Grado ${info.grado}° · ${periodos[info.periodo - 1]} periodo · Año ${info.ano}` +
      (info.nombre ? ` · ${info.nombre}` : '');
    document.querySelector<HTMLElement>('[data-aula-resumen]')!.textContent = resumen;
    mostrarPaso('datos');
  });

  // ─── PASO 2 · nombre + fecha → continuar ───
  document.querySelector<HTMLFormElement>('[data-form-datos]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    nombreActual = String(data.get('estudiante_display_name') ?? '').trim();
    fechaNacActual = String(data.get('estudiante_fecha_nacimiento') ?? '').trim();

    if (!nombreActual || !fechaNacActual) {
      mostrarErrorGlobal('Faltan datos.');
      return;
    }

    if (requiereAcudiente(fechaNacActual)) {
      mostrarPaso('email-acudiente');
    } else {
      mostrarPaso('email-auto');
    }
  });

  document.querySelector('[data-btn-volver-codigo]')?.addEventListener('click', () => {
    mostrarPaso('codigo');
    codigoActual = '';
  });

  document.querySelectorAll('[data-btn-volver-datos], [data-btn-volver-datos-2]').forEach((b) => {
    b.addEventListener('click', () => mostrarPaso('datos'));
  });

  // ─── PASO 3A · flujo acudiente ───
  document.querySelector<HTMLFormElement>('[data-form-acudiente]')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.querySelector<HTMLButtonElement>('[data-btn-enviar-acudiente]')!;
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    const form = e.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    try {
      const { registro_id } = await iniciarRegistroAcudiente({
        codigoAula: codigoActual,
        estudianteDisplayName: nombreActual,
        estudianteFechaNacimiento: fechaNacActual,
        acudienteEmail: String(data.get('acudiente_email') ?? ''),
      });
      window.location.replace(`${base}/cuenta/solicitud-enviada?id=${registro_id}`);
    } catch (err: any) {
      console.error('[unirme] acudiente:', err);
      mostrarErrorGlobal(err.message ?? 'No se pudo enviar la solicitud.');
      btn.disabled = false;
      btn.textContent = 'Solicitar autorización';
    }
  });

  // ─── PASO 3B · flujo auto ─14 ───
  document.querySelector<HTMLFormElement>('[data-form-auto]')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.querySelector<HTMLButtonElement>('[data-btn-enviar-auto]')!;
    btn.disabled = true;
    btn.textContent = 'Enviando código…';
    const form = e.currentTarget as HTMLFormElement;
    const data = new FormData(form);
    try {
      const { registro_id } = await iniciarRegistroAuto({
        codigoAula: codigoActual,
        estudianteDisplayName: nombreActual,
        estudianteFechaNacimiento: fechaNacActual,
        estudianteEmail: String(data.get('estudiante_email') ?? ''),
      });
      window.location.replace(`${base}/cuenta/verificar-otp?id=${registro_id}`);
    } catch (err: any) {
      console.error('[unirme] auto:', err);
      mostrarErrorGlobal(err.message ?? 'No se pudo enviar el código.');
      btn.disabled = false;
      btn.textContent = 'Enviarme el código';
    }
  });
</script>

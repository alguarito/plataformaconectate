---
/**
 * /docente/aulas/nueva · formulario para crear un aula.
 */
import CuentaLayout from '../../../layouts/CuentaLayout.astro';

const anoActual = new Date().getFullYear();
const anoSiguiente = anoActual + 1;
---

<CuentaLayout title="Nueva aula · Panel del docente">
  <div class="space-y-6">
    <div>
      <a data-link-volver href="#" class="inline-flex items-center gap-1 text-sm font-semibold text-bento-blue hover:underline">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        Volver al panel
      </a>
    </div>

    <div class="bg-white dark:bg-neutral-900 rounded-bento shadow-bento p-6 md:p-8">
      <h1 class="text-huge font-black tracking-tight mb-3 text-bento-blue">
        Crear nueva aula
      </h1>
      <p class="text-sm text-neutral-700 dark:text-neutral-300 mb-6 leading-relaxed">
        Cada aula representa un grupo de estudiantes en un grado, periodo y año
        específicos. Al crearla se genera un código único que tus estudiantes
        usarán para que sus acudientes los registren.
      </p>

      <form data-form-aula class="space-y-5">
        <!-- Grado -->
        <div>
          <label for="grado" class="block text-sm font-bold mb-2">Grado</label>
          <select
            id="grado"
            name="grado"
            required
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 font-semibold focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          >
            <option value="" disabled selected>Selecciona un grado</option>
            <option value="6">6° — Alfabetización digital</option>
            <option value="7">7° — Trabajo colaborativo e IA</option>
            <option value="8">8° — Excel, lógica y multimedia</option>
            <option value="9">9° — Historia, diseño y datos</option>
            <option value="10">10° — IA y decisiones empresariales</option>
            <option value="11">11° — Transformación digital empresarial</option>
          </select>
        </div>

        <!-- Periodo -->
        <div>
          <label for="periodo" class="block text-sm font-bold mb-2">Periodo</label>
          <select
            id="periodo"
            name="periodo"
            required
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 font-semibold focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          >
            <option value="" disabled selected>Selecciona un periodo</option>
            <option value="1">Primer periodo</option>
            <option value="2">Segundo periodo</option>
            <option value="3">Tercer periodo</option>
          </select>
        </div>

        <!-- Año -->
        <div>
          <label for="ano" class="block text-sm font-bold mb-2">Año lectivo</label>
          <select
            id="ano"
            name="ano"
            required
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 font-semibold focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          >
            <option value={anoActual} selected>{anoActual}</option>
            <option value={anoSiguiente}>{anoSiguiente}</option>
          </select>
        </div>

        <!-- Letra (opcional) -->
        <div>
          <label for="letra" class="block text-sm font-bold mb-2">
            Letra del grupo
            <span class="font-normal text-neutral-500">(opcional · si tienes paralelos)</span>
          </label>
          <input
            id="letra"
            name="letra"
            type="text"
            maxlength="1"
            placeholder="A"
            class="w-24 px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 font-semibold uppercase focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
            pattern="[A-Za-z]"
          />
        </div>

        <!-- Nombre del aula (opcional) -->
        <div>
          <label for="nombre" class="block text-sm font-bold mb-2">
            Nombre descriptivo
            <span class="font-normal text-neutral-500">(opcional)</span>
          </label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            maxlength="80"
            placeholder="Ej: 6A mañana"
            class="w-full px-4 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 bg-white dark:bg-neutral-900 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          />
        </div>

        <!-- Botones -->
        <div class="flex flex-col sm:flex-row gap-3 pt-4">
          <button
            type="submit"
            data-submit
            class="flex-1 px-5 py-3 rounded-bento-sm bg-bento-blue text-white font-bold hover:scale-[1.02] transition-transform motion-reduce:transition-none disabled:opacity-60 disabled:cursor-not-allowed focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-bento-blue/40"
          >
            Crear aula y generar código
          </button>
          <a
            data-link-cancelar
            href="#"
            class="px-5 py-3 rounded-bento-sm border border-neutral-300 dark:border-neutral-700 text-center font-semibold hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors"
          >
            Cancelar
          </a>
        </div>
      </form>

      <!-- Mensaje de error -->
      <div data-error class="hidden mt-4 bg-bento-pink/10 border border-bento-pink/30 rounded-bento-sm p-4">
        <p class="text-sm text-bento-pink font-semibold" data-error-msg>Hubo un error.</p>
      </div>
    </div>
  </div>
</CuentaLayout>

<script>
  import { crearAula, type GradoValido, type PeriodoValido } from '../../../lib/aulas';

  const base = (import.meta.env?.BASE_URL ?? '/').replace(/\/$/, '');
  document.querySelectorAll<HTMLAnchorElement>('[data-link-volver], [data-link-cancelar]').forEach((a) => {
    a.href = base + '/docente';
  });

  const form = document.querySelector<HTMLFormElement>('[data-form-aula]');
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]');
  const errorEl = document.querySelector<HTMLElement>('[data-error]');
  const errorMsg = document.querySelector<HTMLElement>('[data-error-msg]');

  function mostrarError(msg: string) {
    if (errorMsg) errorMsg.textContent = msg;
    errorEl?.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl?.classList.add('hidden');
    if (submit) {
      submit.disabled = true;
      submit.textContent = 'Creando…';
    }
    try {
      const data = new FormData(form);
      const aula = await crearAula({
        grado: Number(data.get('grado')) as GradoValido,
        periodo: Number(data.get('periodo')) as PeriodoValido,
        ano: Number(data.get('ano')),
        letra: String(data.get('letra') ?? '').toUpperCase() || 'A',
        nombre: (data.get('nombre') as string)?.trim() || undefined,
      });
      window.location.replace(`${base}/docente/aulas/detalle?id=${aula.id}&nueva=1`);
    } catch (err: any) {
      console.error('[nueva aula] error:', err);
      mostrarError(err.message || 'No se pudo crear el aula. Intenta de nuevo.');
      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Crear aula y generar código';
      }
    }
  });
</script>

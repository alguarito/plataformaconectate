---
/**
 * /docente · panel del docente.
 *
 * Placeholder. En PR-2 listará aulas, generará códigos y mostrará progreso
 * agregado por aula.
 */
import CuentaLayout from '../../layouts/CuentaLayout.astro';
---

<CuentaLayout title="Panel del docente · Plataforma Conéctate">
  <div class="space-y-6">
    <div class="bg-bento-blue text-white rounded-bento shadow-bento p-6 md:p-8">
      <h1 class="text-huge font-black tracking-tight mb-2">
        Panel del docente
      </h1>
      <p class="text-base text-white/85 leading-relaxed max-w-2xl">
        Desde aquí podrás crear aulas, generar códigos de acceso para que tus
        estudiantes se registren, y ver el progreso agregado de cada grupo.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="bg-white dark:bg-neutral-900 rounded-bento shadow-bento p-6">
        <h2 class="text-2xl font-black mb-2">Aulas</h2>
        <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Aún no tienes aulas creadas.
        </p>
        <button
          type="button"
          disabled
          class="px-5 py-3 rounded-bento-sm bg-bento-blue text-white font-semibold opacity-60 cursor-not-allowed"
          title="Disponible en PR-2"
        >
          Crear primera aula
        </button>
      </div>

      <div class="bg-white dark:bg-neutral-900 rounded-bento shadow-bento p-6">
        <h2 class="text-2xl font-black mb-2">Resumen</h2>
        <dl class="text-sm space-y-2 text-neutral-700 dark:text-neutral-300">
          <div class="flex justify-between">
            <dt>Aulas activas</dt>
            <dd class="font-black">0</dd>
          </div>
          <div class="flex justify-between">
            <dt>Estudiantes registrados</dt>
            <dd class="font-black">0</dd>
          </div>
          <div class="flex justify-between">
            <dt>Guías con progreso</dt>
            <dd class="font-black">0</dd>
          </div>
        </dl>
      </div>
    </div>

    <p class="text-xs text-neutral-500 dark:text-neutral-400 text-center">
      Esta vista está en construcción · funcionalidad completa disponible en
      próximas entregas (PR-2 y PR-3).
    </p>
  </div>
</CuentaLayout>

---
/**
 * /docente/informes/grado · Corte por grado.
 * Query params: ?ano=2026&grado=9
 * Carga client-side: KPIs del grado, heatmap cobertura, comparativa periodos,
 * exámenes y tabla de riesgo filtrada.
 */
import CuentaLayout from '../../../layouts/CuentaLayout.astro';
import DocenteTabs from '../../../components/DocenteTabs.astro';
import KpiCard from '../../../components/charts/KpiCard.astro';
import EncabezadoInforme from '../../../components/informe/EncabezadoInforme.astro';
import PieInforme from '../../../components/informe/PieInforme.astro';
import BotonImprimir from '../../../components/informe/BotonImprimir.astro';
---

<CuentaLayout title="Informe por grado · Plataforma Conéctate">
  <DocenteTabs />

  <div data-loading class="text-center py-12">
    <span class="inline-block w-10 h-10 rounded-full border-4 border-bento-blue/30 border-t-bento-blue animate-spin motion-reduce:animate-none mb-3"></span>
    <p class="text-sm text-neutral-500">Cargando informe de grado…</p>
  </div>

  <div data-error class="hidden bg-bento-pink/10 border border-bento-pink/30 rounded-bento-sm p-4">
    <p class="text-sm text-bento-pink font-semibold" data-error-msg>No se pudieron cargar los datos.</p>
  </div>

  <div data-vacio class="hidden bg-neutral-50 dark:bg-neutral-800/50 rounded-bento-sm p-8 text-center border border-dashed border-neutral-300 dark:border-neutral-700">
    <div class="text-5xl mb-3" aria-hidden="true">📊</div>
    <h1 class="text-xl font-black mb-2">Sin datos para este grado</h1>
    <p class="text-sm text-neutral-600 dark:text-neutral-400 max-w-md mx-auto leading-relaxed">
      No hay aulas ni actividad registrada para el grado y año seleccionados.
    </p>
    <a data-link-volver href="#" class="inline-block mt-5 px-5 py-3 rounded-bento-sm bg-bento-blue text-white font-bold text-sm">
      Volver al panel general
    </a>
  </div>

  <article data-contenido class="hidden space-y-6">
    <EncabezadoInforme />

    <!-- Cabecera con selectores -->
    <header class="text-white rounded-bento shadow-bento p-6 md:p-8" data-header-bg style="background:#0066FF">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <a data-link-volver href="#" class="inline-flex items-center gap-1.5 text-xs font-bold text-white/70 hover:text-white mb-3 transition-colors">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            Panel general
          </a>
          <p class="text-xs uppercase tracking-wide font-bold opacity-80 mb-1">Informe por grado</p>
          <h1 class="text-huge font-black tracking-tight" data-titulo-grado>Grado —</h1>
          <p class="text-base text-white/85 mt-1" data-sub-grado>Selecciona un grado</p>
        </div>
        <div class="flex flex-wrap items-end gap-3">
          <label class="text-sm font-semibold">
            <span class="block text-xs uppercase tracking-wide opacity-80 mb-1">Año lectivo</span>
            <select data-select-ano class="bg-white/15 border border-white/30 rounded-bento-sm px-3 py-2 font-bold w-full sm:w-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"></select>
          </label>
          <label class="text-sm font-semibold">
            <span class="block text-xs uppercase tracking-wide opacity-80 mb-1">Grado</span>
            <select data-select-grado class="bg-white/15 border border-white/30 rounded-bento-sm px-3 py-2 font-bold w-full sm:w-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60"></select>
          </label>
          <BotonImprimir />
        </div>
      </div>
    </header>

    <!-- KPIs del grado -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <KpiCard etiqueta="Aulas del grado"    clave="g-aulas"      color="#0066FF" icono="🏫" />
      <KpiCard etiqueta="Estudiantes"         clave="g-estudiantes" color="#0066FF" icono="👥" />
      <KpiCard etiqueta="Progreso promedio"   clave="g-progreso"   color="#00D4FF" icono="📈" sub="guías trabajadas" />
      <KpiCard etiqueta="Activos 30 días"     clave="g-activos"    color="#A3FF12" icono="🔥" />
      <KpiCard etiqueta="Guías completadas"   clave="g-guias"      color="#A3FF12" icono="✅" />
      <KpiCard etiqueta="Intentos de examen"  clave="g-quiz-int"   color="#7C3AED" icono="📝" />
      <KpiCard etiqueta="Promedio exámenes"   clave="g-quiz-prom"  color="#7C3AED" icono="🎯" sub="puntaje 0–100" />
      <KpiCard etiqueta="En riesgo"           clave="g-riesgo"     color="#FF2D87" icono="⚠️" sub="< 25% progreso" />
    </section>

    <!-- Comparativa por periodo -->
    <section class="bg-white dark:bg-neutral-900 rounded-bento shadow-bento p-5 md:p-6 evitar-corte">
      <h2 class="text-base font-black mb-1">Comparativa por periodo</h2>
      <p class="text-xs text-neutral-500 mb-4">Progreso promedio de los estudiantes del grado en cada periodo.</p>
      <div data-periodos-chart></div>
      <p data-periodos-vacio class="hidden text-sm text-neutral-500 text-center py-6">Sin datos de periodos para este grado.</p>
    </section>

    <!-- Heatmap de cobertura de guías -->
    <section class="bg-white dark:bg-neutral-900 rounded-bento shadow-bento p-5 md:p-6 evitar-corte">
      <h2 class="text-base font-black mb-1">Cobertura de guías</h2>
      <p class="text-xs text-neutral-500 mb-4">
        Cuántos estudiantes del grado han trabajado cada guía (por sesión y periodo).
        Cada celda muestra el número de estudiantes que han completado la guía.
      </p>
      <div data-heatmap></div>
      <p data-heatmap-vacio class="hidden text-sm text-neutral-500 text-center py-6">Sin actividad de guías registrada.</p>
    </section>

    <!-- Desempeño en exámenes -->
    <section class="bg-white dark:bg-neutral-900 rounded-bento shadow-bento p-5 md:p-6 evitar-corte">
      <h2 class="text-base font-black mb-1">Desempeño en exámenes</h2>
      <p class="text-xs text-neutral-500 mb-4">Puntaje promedio, mediana y tasa de aprobación (≥ 60) por examen.</p>
      <div data-examenes></div>
      <p data-examenes-vacio class="hidden text-sm text-neutral-500 text-center py-6">Sin intentos de examen registrados.</p>
    </section>

    <!-- Estudiantes que necesitan atención -->
    <section class="bg-white dark:bg-neutral-900 rounded-bento shadow-bento p-5 md:p-6 evitar-corte">
      <h2 class="text-base font-black mb-1">Necesitan atención</h2>
      <p class="text-xs text-neutral-500 mb-4">Progreso menor al 25% o sin actividad en los últimos 14 días.</p>
      <div data-riesgo></div>
      <p data-riesgo-vacio class="hidden text-sm text-neutral-500 text-center py-6">Ningún estudiante del grado en riesgo. 🎉</p>
    </section>

    <PieInforme />
  </article>
</CuentaLayout>

<script>
  import { requireDocente } from '../../../lib/auth';
  import { getAnosDisponibles, getResumenPorGrado, getResumenPorPeriodo, getCoberturaGuias, getDesempenoExamenes, getEstudiantesEnRiesgo } from '../../../lib/informes';
  import { heatmapSVG, barComparativoSVG, escapeHtml, BENTO } from '../../../lib/charts';

  const base = (import.meta.env?.BASE_URL ?? '/').replace(/\/$/, '');

  document.querySelectorAll<HTMLAnchorElement>('[data-link-volver]').forEach((a) => {
    a.href = base + '/docente/informes';
  });

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);

  function mostrar(estado: 'loading' | 'error' | 'vacio' | 'contenido') {
    (['loading', 'error', 'vacio', 'contenido'] as const).forEach((e) => {
      const sel = e === 'contenido' ? '[data-contenido]' : `[data-${e}]`;
      $(sel)?.classList.toggle('hidden', e !== estado);
    });
  }

  function setKpi(clave: string, valor: string) {
    const el = document.querySelector(`[data-kpi="${clave}"]`);
    if (el) el.textContent = valor;
  }

  const COLORES_GRADO: Record<number, string> = {
    6: BENTO.blue, 7: BENTO.lime, 8: BENTO.orange,
    9: BENTO.purple, 10: BENTO.pink, 11: BENTO.cyan,
  };
  const PERIODO_LABEL: Record<number, string> = { 1: 'Periodo 1', 2: 'Periodo 2', 3: 'Periodo 3' };

  async function cargarGrado(ano: number, grado: number) {
    const color = COLORES_GRADO[grado] ?? BENTO.blue;
    const header = $('[data-header-bg]');
    if (header) (header as HTMLElement).style.background = color;

    const titulo = $('[data-titulo-grado]');
    if (titulo) titulo.textContent = `Grado ${grado}°`;

    const [gradosData, periodos, cobertura, examenes, riesgo] = await Promise.all([
      getResumenPorGrado(ano),
      getResumenPorPeriodo(ano, grado),
      getCoberturaGuias(ano, grado),
      getDesempenoExamenes(ano, grado),
      getEstudiantesEnRiesgo(ano, grado),
    ]);

    const gradoData = gradosData.find((g) => g.grado === grado);
    const sub = $('[data-sub-grado]');
    if (sub && gradoData)
      sub.textContent = `${gradoData.estudiantes} estudiantes · ${gradoData.aulas} aula${gradoData.aulas === 1 ? '' : 's'}`;

    if (gradoData) {
      setKpi('g-aulas',      String(gradoData.aulas));
      setKpi('g-estudiantes', String(gradoData.estudiantes));
      setKpi('g-progreso',   `${gradoData.progresoPromedio}%`);
      setKpi('g-activos',    String(gradoData.activos30d));
      setKpi('g-guias',      String(gradoData.guiasCompletadas));
      setKpi('g-quiz-int',   String(gradoData.quizIntentos));
      setKpi('g-quiz-prom',  gradoData.quizPromedio != null ? `${gradoData.quizPromedio}%` : '—');
      setKpi('g-riesgo',     String(riesgo.length));
    }

    // Comparativa por periodos
    const periodosChart = $('[data-periodos-chart]');
    const periodosVacio = $('[data-periodos-vacio]');
    if (periodos.length === 0) {
      periodosVacio?.classList.remove('hidden');
      if (periodosChart) periodosChart.innerHTML = '';
    } else {
      periodosVacio?.classList.add('hidden');
      if (periodosChart) periodosChart.innerHTML = barComparativoSVG(
        periodos.map((p) => ({
          label: PERIODO_LABEL[p.periodo] ?? `P${p.periodo}`,
          valor: p.progresoPromedio,
          color,
          sub: `${p.guiasCompletadas} completadas`,
        })),
        { max: 100, unidad: '%' }
      );
    }

    // Heatmap de cobertura
    const heatmapWrap = $('[data-heatmap]');
    const heatmapVacio = $('[data-heatmap-vacio]');
    if (cobertura.length === 0) {
      heatmapVacio?.classList.remove('hidden');
      if (heatmapWrap) heatmapWrap.innerHTML = '';
    } else {
      heatmapVacio?.classList.add('hidden');
      if (heatmapWrap) heatmapWrap.innerHTML = heatmapSVG(
        cobertura.map((c) => ({ periodo: c.periodo, sesion: c.sesion, valor: c.completadas })),
        { color, titulo: `Cobertura grado ${grado}°` }
      );
    }

    // Exámenes
    const examenesWrap = $('[data-examenes]');
    const examenesVacio = $('[data-examenes-vacio]');
    if (examenes.length === 0) {
      examenesVacio?.classList.remove('hidden');
      if (examenesWrap) examenesWrap.innerHTML = '';
    } else {
      examenesVacio?.classList.add('hidden');
      if (examenesWrap) {
        const filas = examenes.map((e) => {
          const aprobPct = e.totalIntentos > 0 ? Math.round((e.aprobados / e.totalIntentos) * 100) : 0;
          const col = aprobPct >= 60 ? BENTO.lime : aprobPct >= 40 ? BENTO.orange : BENTO.pink;
          return `<tr class="border-b border-neutral-100 dark:border-neutral-800">
            <td class="py-2 pr-3 text-xs font-mono text-neutral-600 dark:text-neutral-400 whitespace-nowrap">${escapeHtml(e.guiaClave)}</td>
            <td class="py-2 pr-3 text-sm font-semibold truncate max-w-[140px]">${escapeHtml(e.quizId)}</td>
            <td class="py-2 pr-3 text-sm tabular-nums text-right">${e.totalIntentos}</td>
            <td class="py-2 pr-3 text-sm tabular-nums text-right font-bold">${e.promedio ?? '—'}</td>
            <td class="py-2 pr-3 text-sm tabular-nums text-right text-neutral-500">${e.p50 ?? '—'}</td>
            <td class="py-2 text-sm tabular-nums text-right font-black" style="color:${col}">${aprobPct}%</td>
          </tr>`;
        }).join('');
        examenesWrap.innerHTML =
          `<div class="overflow-x-auto"><table class="w-full text-left min-w-[480px]">` +
          `<thead><tr class="border-b-2 border-neutral-200 dark:border-neutral-700">` +
          `<th class="pb-2 pr-3 text-xs uppercase tracking-widest text-neutral-500 font-bold">Guía</th>` +
          `<th class="pb-2 pr-3 text-xs uppercase tracking-widest text-neutral-500 font-bold">Quiz</th>` +
          `<th class="pb-2 pr-3 text-xs uppercase tracking-widest text-neutral-500 font-bold text-right">Intentos</th>` +
          `<th class="pb-2 pr-3 text-xs uppercase tracking-widest text-neutral-500 font-bold text-right">Promedio</th>` +
          `<th class="pb-2 pr-3 text-xs uppercase tracking-widest text-neutral-500 font-bold text-right">Mediana</th>` +
          `<th class="pb-2 text-xs uppercase tracking-widest text-neutral-500 font-bold text-right">Aprobaron</th>` +
          `</tr></thead><tbody>${filas}</tbody></table></div>`;
      }
    }

    // Estudiantes en riesgo
    const riesgoWrap = $('[data-riesgo]');
    const riesgoVacio = $('[data-riesgo-vacio]');
    if (riesgo.length === 0) {
      riesgoVacio?.classList.remove('hidden');
      if (riesgoWrap) riesgoWrap.innerHTML = '';
    } else {
      riesgoVacio?.classList.add('hidden');
      if (riesgoWrap) riesgoWrap.innerHTML =
        `<div class="space-y-2">` +
        riesgo.map((r) => {
          const ini = escapeHtml(r.displayName.trim().slice(0, 2).toUpperCase());
          const dias = r.diasInactivo == null ? 'sin actividad' : `${r.diasInactivo} días inactivo`;
          const col = r.progresoPromedio >= 25 ? BENTO.orange : BENTO.pink;
          const href = `${base}/docente/informes/estudiante?id=${r.estudianteId}`;
          return `<a href="${href}" class="flex items-center gap-3 hover:bg-neutral-50 dark:hover:bg-neutral-800/50 rounded-bento-sm p-1 -mx-1 transition-colors group">
            <div class="w-8 h-8 rounded-full bg-bento-pink/10 flex items-center justify-center font-black text-bento-pink text-xs flex-shrink-0">${ini}</div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-semibold truncate group-hover:text-bento-blue transition-colors">${escapeHtml(r.displayName)}</p>
              <p class="text-xs text-neutral-500">${dias}</p>
            </div>
            <span class="text-sm font-black tabular-nums" style="color:${col}">${r.progresoPromedio}%</span>
          </a>`;
        }).join('') +
        `</div>`;
    }
  }

  async function init() {
    const sp = new URLSearchParams(window.location.search);
    const anos = await getAnosDisponibles();
    if (anos.length === 0) { mostrar('vacio'); return; }

    const selAno = $<HTMLSelectElement>('[data-select-ano]');
    if (selAno) {
      selAno.innerHTML = anos.map((a) => `<option value="${a.ano}">${a.ano}</option>`).join('');
      const paramAno = parseInt(sp.get('ano') ?? '', 10);
      selAno.value = String(anos.find((a) => a.ano === paramAno)?.ano ?? anos[0].ano);
    }

    const gradosIniciales = await getResumenPorGrado(parseInt(selAno?.value ?? '', 10));
    if (gradosIniciales.length === 0) { mostrar('vacio'); return; }

    const selGrado = $<HTMLSelectElement>('[data-select-grado]');
    if (selGrado) {
      selGrado.innerHTML = gradosIniciales.map((g) => `<option value="${g.grado}">${g.grado}°</option>`).join('');
      const paramGrado = parseInt(sp.get('grado') ?? '', 10);
      selGrado.value = String(gradosIniciales.find((g) => g.grado === paramGrado)?.grado ?? gradosIniciales[0].grado);
    }

    const cargar = async () => {
      const ano = parseInt(selAno?.value ?? '', 10);
      const grado = parseInt(selGrado?.value ?? '', 10);
      const url = new URL(window.location.href);
      url.searchParams.set('ano', String(ano));
      url.searchParams.set('grado', String(grado));
      window.history.replaceState(null, '', url.toString());
      await cargarGrado(ano, grado);
    };

    selAno?.addEventListener('change', async () => {
      const ano = parseInt(selAno.value, 10);
      const gradosNuevos = await getResumenPorGrado(ano);
      if (selGrado) {
        selGrado.innerHTML = gradosNuevos.map((g) => `<option value="${g.grado}">${g.grado}°</option>`).join('');
      }
      await cargar();
    });
    selGrado?.addEventListener('change', cargar);

    await cargar();
    mostrar('contenido');
  }

  requireDocente().then((sesion) => {
    if (!sesion) return;
    init().catch((err) => {
      console.error('[informes/grado] init:', err);
      const m = $('[data-error-msg]');
      if (m) m.textContent = 'No se pudo cargar el informe: ' + (err?.message ?? err);
      mostrar('error');
    });
  });
</script>

  { numero: 4, iconos: ['🔎'], titulo: 'Ordena los sub-pasos de una tarea real', duracionMin: 6 },
  { numero: 5, iconos: ['✅'], titulo: 'Comprueba lo que entendiste', duracionMin: 6 },
  { numero: 6, iconos: ['✏️'], titulo: 'Descompón un problema y planea tu meta', duracionMin: 14 },
  { numero: 7, iconos: ['🔎'], titulo: 'Simulacro: tres retos de descomposición', duracionMin: 12 },

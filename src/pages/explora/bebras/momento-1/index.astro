// Simulación: 3 retos estilo Bebras (originales), de fácil a difícil (A·B·C).
const simulacro: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Simulacro · tres retos de descomposición',
  instrucciones:
    'Tres retos cortos, de fácil (A) a difícil (C), como en el concurso real. Lee con calma y parte cada problema en pedazos: la explicación te dice cómo descomponerlo.',
  preguntas: [
    {
      enunciado:
        'Nivel A · El curso debe pintar una pared muy grande del patio y se siente imposible. ¿Cuál es una buena forma de DESCOMPONER la tarea?',
      opciones: [
        'Que una sola persona pinte toda la pared de una vez',
        'Dividir la pared en franjas y pintar una franja a la vez',
        'Pintar un poco aquí y un poco allá, sin orden',
        'Esperar a que la pared se pinte sola',
      ],
      respuestaIndex: 1,
      feedbackCorrecto:
        'Correcto. Dividir la pared en franjas convierte una tarea enorme en varias pequeñas y completas: eso es descomponer.',

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabOrdenar from '../../../../components/LabOrdenar.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import MetodologiaMILC from '../../../../components/MetodologiaMILC.astro';
import type { MetodologiaMILCData } from '../../../../components/MetodologiaMILC.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataOrdenar } from '../../../../components/LabOrdenar.astro';
import { getMomento } from '../../../../data/bebras';

const base = import.meta.env.BASE_URL;
const momento = getMomento('momento-1')!;
const archivoOficial = 'https://www.bebras.org';

const saberAncestral: SaberAncestral = {
  saber:
    'En el Litoral Pacífico, las artesanas del pueblo Wounaan tejen canastos en werregue tan apretados que retienen agua sin gotear. Esa obra casi imposible no nace de un solo tirón: la maestra la parte en tareas pequeñas y completas. Primero corta y tiñe la fibra de la palma. Luego arma el fondo en espiral, vuelta sobre vuelta. Después levanta la pared, una hilera a la vez, sin saltarse ninguna. Y al final cierra el borde para que nada se deshaga. Cada vuelta es un trabajo terminado en sí mismo; nadie teje el canasto entero de golpe. Lo que de lejos parece magia, de cerca es paciencia ordenada: una obra enorme se vuelve posible cuando se parte en partes que sí caben en las manos.',
  fuente: 'Tejido en werregue · pueblo Wounaan, Pacífico colombiano',
  preguntaPuente:
    'La maestra wounaan no teje el canasto completo de un golpe: lo parte en vueltas pequeñas que sí puede tejer. ¿Y si te dijera que un computador —y tú frente a un examen difícil— resuelven sus retos exactamente así, partiéndolos en pedazos manejables?',
};


const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'Dar buenas señas para llegar a una vereda ya era abstraer: el saber campesino limpiaba el camino hasta dejar lo esencial, mucho antes de que llegaran los mapas digitales.',
    preguntaEspejo:
      'Nos hacen creer que «hacer modelos» es cosa de ingenieros con pantallas. ¿Qué saberes de mi familia o mi vereda ya abstraían lo esencial, aunque nadie los llamara abstracción?',
  },
  estoico: {
    autor: 'Marco Aurelio',
    lente: 'lente del cuidado interior',
    cita: 'En cada acto pregúntate: ¿es esto necesario? Suprime lo superfluo, y ganarás tiempo y serenidad.',
    preguntaEspejo:
      'Igual que abstraigo un problema quitándole el ruido, ¿qué «ruido» de mi vida —cosas que no importan pero me roban atención— podría empezar a ignorar para enfocarme en lo esencial?',
  },
  floridi: {
    autor: 'Luciano Floridi',
    lente: 'lente de la infoesfera',

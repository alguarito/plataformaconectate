const cincoDimensiones: CincoDimensiones = {
  personal:
    'Antes mirabas un problema entero y te abrumabas. Ahora distingues lo esencial del ruido y eliges en qué fijarte a propósito.',
  emocional:
    'Cuando todo parece importante a la vez, agobia. Ignorar el ruido y quedarte con lo esencial te da calma y foco para empezar.',

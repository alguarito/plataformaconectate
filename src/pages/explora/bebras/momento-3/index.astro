---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabEmparejar from '../../../../components/LabEmparejar.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import MetodologiaMILC from '../../../../components/MetodologiaMILC.astro';
import type { MetodologiaMILCData } from '../../../../components/MetodologiaMILC.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataEmparejar } from '../../../../components/LabEmparejar.astro';
import { getMomento } from '../../../../data/bebras';

const base = import.meta.env.BASE_URL;
const momento = getMomento('momento-3')!;
const archivoOficial = 'https://www.bebras.org';

const saberAncestral: SaberAncestral = {
  saber:
    'En el campo del Valle del Cauca, cuando un campesino te explica cómo llegar a su finca en la vereda, no te describe cada piedra del camino ni cada árbol del cafetal. Te da solo lo esencial: «pasas la tienda de doña Rosa, coges la trocha de la derecha, y en el guayacán grande volteas». Tres señas, y ya sabes llegar. No te menciona el color de la casa vecina, ni cuántos postes de luz hay, ni el perro que ladra en la curva, porque nada de eso te ayuda a no perderte. Ese campesino hace, sin nombrarlo, un trabajo finísimo: separa las pocas señas que de verdad importan del montón de detalles que solo serían ruido. Limpiar el camino hasta dejar lo justo —ni una seña de más, ni una de menos— es abstracción pura, heredada en la tradición oral mucho antes de que existieran los mapas digitales.',
  fuente: 'Saber campesino del Valle del Cauca · tradición oral',
  preguntaPuente:
    'El campesino abstrae el camino: ignora el ruido y conserva solo lo que importa. ¿Y si te dijera que un computador hace exactamente eso con un modelo — y que en muchas tareas Bebras lo más difícil no es calcular, sino saber CUÁLES datos importan?',
};

const mapaRuta: EstacionMapa[] = [
  { numero: 1, iconos: ['🌱'], titulo: 'Las señas de la vereda', duracionMin: 5 },
  { numero: 2, iconos: ['📖'], titulo: 'Qué es abstraer y por qué ayuda', duracionMin: 12 },
  { numero: 3, iconos: ['🔎'], titulo: 'Relaciona cada cosa con su abstracción', duracionMin: 6 },
  { numero: 4, iconos: ['✅'], titulo: 'Comprueba lo que entendiste', duracionMin: 6 },
  { numero: 5, iconos: ['✏️'], titulo: 'Modela algo complejo a lo esencial', duracionMin: 14 },
  { numero: 6, iconos: ['🔎'], titulo: 'Simulacro: ignora el ruido', duracionMin: 12 },
  { numero: 7, iconos: ['💭'], titulo: 'Tres voces para cerrar', duracionMin: 6 },
];

// Ejemplos cotidianos de abstracción, para el bloque de lectura (antes del ejercicio de relacionar).
const ejemplos = [
  {
    emoji: '🗺',
    nombre: 'El mapa del barrio',
    texto:
      'Un mapa de tu barrio en Cartago no dibuja cada ladrillo ni cada ventana: solo las calles, las esquinas y unos pocos puntos clave. Quitó todo lo que no te ayuda a llegar. Eso es un modelo: la realidad reducida a lo que importa para una tarea.',
  },
  {
    emoji: '🔤',
    nombre: 'Los íconos y emojis',
    texto:
      'Un ícono de batería, una señal de «pare» o un emoji guardan una idea entera en un solo símbolo. No muestran todos los detalles de la cosa real: muestran lo justo para que la entiendas de un vistazo.',
  },
  {
    emoji: '🚌',
    nombre: 'El plano de las rutas de bus',
    texto:
      'El plano de las rutas que cruzan Cartago no respeta las distancias reales ni cada curva de la vía: estira y endereza todo para que veas con claridad qué ruta te sirve. Sacrifica la exactitud del terreno a cambio de claridad.',
  },
  {
    emoji: '🎬',
    nombre: 'El resumen de una película',
    texto:
      'Cuando le cuentas una película a un amigo en tres frases, no narras escena por escena: te quedas con lo esencial de la historia. Abstraer es decidir qué se queda y qué se va.',
  },
];

const emparejarAbstracciones: DataEmparejar = {
  titulo: 'Relaciona cada cosa real con su buena abstracción',
  instrucciones:
    'Acabas de ver que abstraer es quedarse con lo esencial. Conecta cada cosa del mundo real con el símbolo o modelo que la representa bien para una tarea concreta.',
  etiquetaIzq: 'Cosa real',
  etiquetaDer: 'Su abstracción útil',
  pares: [
    { izquierda: 'Cómo llegar a la finca en la vereda', derecha: 'Tres señas: la tienda, la trocha y el guayacán' },
    { izquierda: 'Todas las calles y casas de Cartago', derecha: 'Un mapa con solo calles y puntos clave' },
    { izquierda: 'La carga que queda en tu celular', derecha: 'Un ícono de batería con su nivel' },
    { izquierda: 'Una película de dos horas', derecha: 'Un resumen de tres frases' },
  ],
};

const quiz: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Comprueba lo que entendiste',
  instrucciones: 'Cuatro preguntas sobre la abstracción. Cada una te deja una explicación.',
  preguntas: [
    {
      enunciado: 'Abstraer significa, sobre todo…',
      opciones: [
        'Guardar todos los detalles para no perder nada',
        'Quedarte con lo esencial e ignorar lo que no importa',
        'Hacer las cosas más complicadas',
        'Memorizar muchos datos de una vez',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto. Abstraer es limpiar el ruido y conservar solo lo esencial, como las señas del campesino.',
      feedbackIncorrecto: 'Abstraer es lo contrario de guardar todo: es quedarse con lo esencial e ignorar el resto.',
    },
    {
      enunciado: 'Un mapa del barrio con solo las calles y las esquinas es un ejemplo de…',
      opciones: ['Un modelo (abstracción de la realidad)', 'Una copia exacta de la realidad', 'Un dato irrelevante', 'Un cálculo'],

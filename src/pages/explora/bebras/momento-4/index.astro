// Los 3 ingredientes del algoritmo, para el bloque de lectura (antes del ejercicio de ordenar).
const ingredientes = [
  {
    emoji: '➡️',
    nombre: 'Secuencia',
    texto:
      'Un paso tras otro, en orden. Primero esto, luego aquello. En el sancocho: sofreir el hogao, después hervir la gallina, después echar las verduras. El orden no es un capricho: cambiarlo cambia el resultado.',

      'Si una máquina hace EXACTAMENTE lo que le digo, ¿qué pasa cuando una instrucción está mal escrita o fuera de orden? ¿De quién es la responsabilidad del error?',
  },
};

const cincoDimensiones: CincoDimensiones = {
  personal:
    'Antes dabas instrucciones a medias ("haz esto, ya sabes…"). Ahora puedes escribir pasos exactos, en orden, que cualquiera podría seguir sin preguntarte.',
  emocional:
    'Una tarea enorme asusta menos cuando la conviertes en una lista clara de pasos. Un buen algoritmo calma: sabes qué hacer primero y qué sigue.',

const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'El saber del pueblo también es ciencia: la receta de la abuela y los oficios heredados ya eran algoritmos, mucho antes de que existiera la palabra.',
    preguntaEspejo:
      'Nos dicen que "dar instrucciones a una máquina" es cosa de programadores lejanos. ¿Qué recetas, oficios o rutinas de mi familia ya eran algoritmos exactos, aunque nadie los llamara así?',
  },
  estoico: {
    autor: 'Marco Aurelio',
    lente: 'lente del cuidado interior',
    cita: 'Haz cada cosa de la vida como si fuera la última, con orden y sin precipitación.',
    preguntaEspejo:
      'Cuando hago las cosas con afán y salteo pasos, ¿qué se daña? ¿Puedo seguir mis propios pasos con calma y en su orden, como la abuela sigue la receta?',
  },
  floridi: {
    autor: 'Luciano Floridi',
    lente: 'lente de la infoesfera',
    cita: 'Los computadores no interpretan nuestras intenciones: ejecutan, literalmente, las instrucciones que reciben.',

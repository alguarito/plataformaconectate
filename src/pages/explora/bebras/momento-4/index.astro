  { numero: 3, iconos: ['🔎'], titulo: 'Ordena los pasos de un algoritmo', duracionMin: 6 },
  { numero: 4, iconos: ['✅'], titulo: 'Comprueba lo que entendiste', duracionMin: 6 },
  { numero: 5, iconos: ['✏️'], titulo: 'Escribe y crea tus propios algoritmos', duracionMin: 22 },
  { numero: 6, iconos: ['🔎'], titulo: 'Simulacro: sigue y corrige algoritmos', duracionMin: 12 },

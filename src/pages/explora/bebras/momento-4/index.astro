};

const actividadCrea: Actividad = {
  numero: 2,
  verbo: 'CREA',
  titulo: 'Inventa un algoritmo con un bucle para un juego o un baile',
  tiempoMin: 10,
  modalidad: 'parejas',
  pasos: [
    'Inventa una secuencia corta de movimientos para un juego de patio o un paso de baile (currulao, salsa, lo que prefieras).',
    'Escríbela como un algoritmo que use un BUCLE: por ejemplo, "repite 4 veces: aplaude y gira a la derecha".',
    'Pásale tus instrucciones a un compañero y deja que las ejecute EXACTAMENTE como están escritas, sin que tú le expliques de viva voz.',
  ],
  cuaderno: {
    titulo: 'Mi algoritmo con bucle',
    formato: 'instrucciones numeradas + una frase que diga qué bucle usaste',
    extensión: 'instrucciones de 4 a 6 líneas + 1 frase',
  },
  criterios: [
    'Tu algoritmo usa al menos un bucle ("repite N veces…" o "repite hasta que…").',
    'Tu compañero pudo ejecutarlo siguiendo solo lo escrito, sin tu ayuda hablada.',
    'Tu frase final dice cuál fue el bucle y cuántas veces se repite.',
  ],
};

// Simulación: 3 retos estilo Bebras (originales), de fácil a difícil (A·B·C).
const simulacro: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Simulacro · sigue y corrige algoritmos',
  instrucciones:
    'Tres retos cortos, de fácil (A) a difícil (C), como en el concurso real. Ejecuta cada algoritmo en tu cabeza, paso a paso: la explicación te dice cómo razonarlo.',
  preguntas: [
    {
      enunciado:
        'Nivel A · Empiezas con 2 fichas. Repite 3 veces: agrega 2 fichas. ¿Cuántas fichas tienes al final?',
      opciones: ['6', '8', '4', '2'],
      respuestaIndex: 1,
      feedbackCorrecto:
        'Correcto. El bucle repite "agrega 2 fichas" tres veces: 2 + 2 + 2 + 2 = 8. Empiezas con 2 y sumas 2 tres veces.',
      feedbackIncorrecto:
        'Ejecuta el bucle paso a paso: empiezas con 2, y "agrega 2" se repite 3 veces. 2 + 2 + 2 + 2 = 8.',
    },
    {
      enunciado:
        'Nivel B · Tienes $1.000. Cada día que ahorras DUPLICAS lo que tienes. Si empiezas con $1.000 y ahorras durante 4 días, ¿cuánto tienes al final?',
      opciones: ['$8.000', '$16.000', '$4.000', '$5.000'],
      respuestaIndex: 1,
      feedbackCorrecto:
        'Exacto. El bucle "duplica" se repite 4 veces: $1.000 → $2.000 → $4.000 → $8.000 → $16.000. Duplicar no es sumar: es multiplicar por 2 cada día.',
      feedbackIncorrecto:
        'Sigue el bucle de duplicar 4 veces: 1.000 ×2 = 2.000, ×2 = 4.000, ×2 = 8.000, ×2 = 16.000. Cuidado: duplicar multiplica por 2, no suma 1.000.',
    },
    {
      enunciado:
        'Nivel C · Un algoritmo dibuja una figura así: «repite 4 veces: avanza y gira 90° a la derecha» → dibuja un cuadrado. Por error, alguien cambió el 4 por un 3: «repite 3 veces…». ¿Qué figura dibuja ahora?',
      opciones: ['Un triángulo', 'Un cuadrado', 'Un círculo', 'Una línea recta'],
      respuestaIndex: 0,
      feedbackCorrecto:
        'Correcto. El número de repeticiones define cuántos lados tiene la figura: 4 repeticiones → 4 lados (cuadrado); 3 repeticiones → 3 lados (triángulo).',
      feedbackIncorrecto:
        'Mira el bucle: cada repetición dibuja un lado y un giro. 4 veces da 4 lados (cuadrado), así que 3 veces da 3 lados: un triángulo.',
    },
  ],
};

const metodologia: MetodologiaMILCData = {
  resumen:
    'Este momento trabaja la pieza de algoritmos: dar instrucciones exactas con secuencia, condición y repetición. La meta es que el grupo entienda que una máquina ejecuta literalmente —no adivina— y que sepa leer, escribir y corregir algoritmos sencillos. Apóyate en la receta del sancocho para activar saberes previos: todos en el salón ya siguen recetas y rutinas que son, sin saberlo, algoritmos con orden, condiciones y repeticiones.',
  objetivos: [
    'Activar el saber previo conectando el concepto de algoritmo con la receta del sancocho y las rutinas de la casa.',
    'Distinguir los 3 ingredientes de un algoritmo: secuencia, condición (SI… ENTONCES…) y repetición (bucle).',
    'Aplicar el pensamiento algorítmico para escribir, seguir y corregir algoritmos cortos al estilo Bebras.',
  ],

      feedbackIncorrecto: 'Una máquina no adivina ni corrige: ejecuta literalmente. Un paso ambiguo o fuera de orden hace que el resultado salga mal.',
    },
  ],
};

const actividadAplica: Actividad = {
  numero: 1,
  verbo: 'APLICA',
  titulo: 'Escribe el algoritmo de una tarea tuya, con una condición',
  tiempoMin: 12,
  modalidad: 'individual',
  pasos: [
    'Elige una tarea real que hagas tú: preparar una agua de panela, alistar el morral para el colegio o lavar la loza.',
    'Escribe sus pasos como una lista numerada, en el orden EXACTO en que deben hacerse (eso es la secuencia).',
    'Incluye al menos una condición escrita con "SI… ENTONCES…": por ejemplo, "SI el agua ya hierve, ENTONCES echa la panela".',
  ],
  cuaderno: {
    titulo: 'Mi algoritmo paso a paso',
    formato: 'lista numerada con una condición SI… ENTONCES… resaltada',
    extensión: '5 a 8 pasos',
  },
  criterios: [
    'Tus pasos están en un orden exacto: si alguien los sigue tal cual, logra la tarea.',

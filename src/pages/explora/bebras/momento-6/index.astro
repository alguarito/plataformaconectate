  { numero: 4, iconos: ['🔎'], titulo: 'Empareja cada pista con lo que descarta', duracionMin: 6 },
  { numero: 5, iconos: ['✅'], titulo: 'Comprueba lo que entendiste', duracionMin: 6 },
  { numero: 6, iconos: ['✏️'], titulo: 'Resuelve un acertijo de tres pistas', duracionMin: 12 },

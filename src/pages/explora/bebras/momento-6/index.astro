---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabEmparejar from '../../../../components/LabEmparejar.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import MetodologiaMILC from '../../../../components/MetodologiaMILC.astro';
import type { MetodologiaMILCData } from '../../../../components/MetodologiaMILC.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataEmparejar } from '../../../../components/LabEmparejar.astro';
import { getMomento } from '../../../../data/bebras';

const base = import.meta.env.BASE_URL;
const momento = getMomento('momento-6')!;
const archivoOficial = 'https://www.bebras.org';

const saberAncestral: SaberAncestral = {
  saber:
    'En los patios de Cartago, en las cocinas a leña del Valle y en las noches del Pacífico, los abuelos no enseñaban a pensar con cuadernos: enseñaban con adivinanzas. "Agua pasa por mi casa, cate de mi corazón": el que escucha no adivina al azar, deduce. Tiene pistas —"agua" al comienzo, "cate" al final— y, juntándolas con lógica, llega a la única respuesta que las cumple todas: el aguacate. Una buena adivinanza nunca tiene dos respuestas: da exactamente las señas necesarias para descartar lo imposible hasta que solo queda lo verdadero. Así los mayores afilaban la mente de los niños sin que pareciera estudio. El acertijo de "quién tiene qué", el de la liebre y la tortuga, el de las tres puertas: todos piden lo mismo, descartar lo falso, juntar lo que sabes y quedarte con la única salida posible.',
  fuente: 'Adivinanzas y acertijos de la tradición oral colombiana',
  preguntaPuente:
    'Cuando deduces el aguacate de una adivinanza, descartas lo falso hasta que solo queda lo verdadero. ¿Y si te dijera que eso —separar lo verdadero de lo falso para deducir con certeza— es exactamente lo que hace por dentro un computador, y lo que te van a pedir muchas tareas Bebras?',
};


  { numero: 3, iconos: ['🔎'], titulo: 'Situación ↔ mejor decisión estratégica', duracionMin: 6 },
  { numero: 4, iconos: ['✅'], titulo: 'Comprueba que entendiste la puntuación', duracionMin: 6 },
  { numero: 5, iconos: ['✏️'], titulo: 'Evalúa el escenario: ¿cuál es la mejor jugada?', duracionMin: 12 },
  { numero: 6, iconos: ['✏️'], titulo: 'Diseña tu plan de ataque de 45 minutos', duracionMin: 10 },
  { numero: 7, iconos: ['🔎'], titulo: 'Simulacro: tres retos con estrategia', duracionMin: 12 },

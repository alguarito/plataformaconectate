---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// Por qué vale la pena meterse: lo que el estudiante gana.
const razones = [
  { i: '🔧', t: 'Construyes algo que funciona', d: 'No es una cartelera: es un prototipo a escala que se puede ver, tocar y probar frente a la gente.' },
  { i: '👷', t: 'Te acompañan ingenieros', d: 'Durante varios meses, profesionales de Energía de Pereira asesoran a los equipos mientras diseñan su proyecto.' },
  { i: '🏙️', t: 'Tu proyecto sale a la ciudad', d: 'Los finalistas exponen en una muestra abierta al público, ante un jurado especializado.' },
  { i: '🏆', t: 'Premios para ti y para tu colegio', d: 'En ediciones anteriores hubo becas, portátiles y tabletas para los estudiantes, y laboratorios de ciencias para los colegios ganadores.' },
];

// Los ejes de la edición 2026.
const ejes = [
  {
    i: '🏙️',
    t: 'Ciudades inteligentes',
    d: 'Tecnología que ayuda a que la ciudad funcione mejor: movilidad, alumbrado, seguridad, servicios públicos e información útil para la gente.',
    ej: 'Un aviso temprano de crecientes del río La Vieja, un cruce peatonal accesible o un alumbrado que se enciende solo cuando hace falta.',
  },
  {
    i: '💻',
    t: 'Transformación digital',
    d: 'Llevar un proceso del papel o de la costumbre al mundo digital con software, datos o inteligencia artificial.',
    ej: 'Una app que reconozca la lengua de señas (como HandSpeak), un registro digital para la tienda del barrio o un mapa con datos abiertos de tu sector.',
  },
  {
    i: '🌱',
    t: 'Autosostenibilidad',
    d: 'Soluciones que se sostienen por sí mismas o ahorran recursos: energía solar, consumo eléctrico, agua, residuos y alimentos.',
    ej: 'Un medidor del consumo eléctrico del salón, un cargador solar para el colegio o una huerta con riego automático.',
  },
];

// Requisitos, en versión compacta (según las ediciones publicadas).
const requisitos = [
  { i: '🏫', t: 'Colegio público, rural o urbano' },
  { i: '🎓', t: 'Bachillerato, de 6.º a 11.º' },
  { i: '👥', t: 'Solo o en equipo, con un docente' },
  { i: '📍', t: 'Sede Cartago' },
];

const stats = [
  { n: '5.ª', l: 'edición en Cartago (2026)' },
  { n: '3', l: 'ejes temáticos' },
  { n: '39', l: 'proyectos en la muestra de Cartago 2023' },
  { n: '48', l: 'proyectos de la SMJ en 2025' },
];

// La ruta de la feria, tal como la describen las ediciones publicadas.
const etapas = [
  { n: 1, t: 'Forma tu equipo', d: 'En tu colegio, con un docente que lidera y acompaña.' },
  { n: 2, t: 'Escoge eje y problema', d: 'Un problema real de Cartago que puedas observar y medir.' },
  { n: 3, t: 'Diseña y construye', d: 'Un prototipo a escala, con la asesoría de los ingenieros de la empresa.' },
  { n: 4, t: 'Muestra en el colegio', d: 'Cada institución expone sus proyectos y escoge los mejores.' },
  { n: 5, t: 'Final en Cartago', d: 'Los finalistas exponen en público ante el jurado; luego viene la premiación.' },
];

// Recomendaciones de ConectaTE (no son los criterios oficiales).
const claves = [
  { i: '🎯', t: 'Un problema concreto, contado con datos', d: 'Di a quién afecta, dónde y cuánto. Una foto, una encuesta o una medición pesan más que un adjetivo.' },
  { i: '⚙️', t: 'Un prototipo que funcione en vivo', d: 'Pequeño y sencillo está bien; lo que importa es que el jurado lo vea hacer lo que prometes.' },
  { i: '📈', t: 'Impacto', d: 'Explica qué cambia en tu comunidad si tu solución se usa de verdad.' },
  { i: '💰', t: 'Viabilidad', d: 'Cuánto cuesta, con qué materiales se hace y quién podría mantenerlo.' },
  { i: '📓', t: 'Una bitácora del proceso', d: 'Anota las pruebas, las fallas y lo que mejoraste. Demuestra que investigaste, no que improvisaste.' },
  { i: '🗣️', t: 'Una explicación que cualquiera entienda', d: 'Ensaya hasta poder contar el proyecto en pocos minutos, sin leer y sin tecnicismos de más.' },
];

// Resultados de los equipos de la institución (dato del docente líder).
const trayectoria = [
  { a: '2023', t: 'Cuarto y quinto lugar.' },
  { a: '2024', t: 'Segundo lugar.' },
  { a: '2025', t: '48 proyectos de 6.º a 11.º y reconocimiento como la institución con más proyectos de valor presentados, con $2 millones en dotación.' },
  { a: '2026', t: 'Segundo lugar con HandSpeak, que reconoce con inteligencia artificial el alfabeto dactilológico de la Lengua de Señas Colombiana.' },
];

// Fuentes en APA 7.ª.
const fuentes = [
  {
    autor: 'Energía de Pereira',
    fecha: '(2023, 10 de noviembre)',
    titulo: 'Alegría, innovación y pasión en la Feria de la Ciencia Energética',
    url: 'https://www.eep.com.co/es/ieventos/ver/19/alegria-innovacion-y-pasion-en-la-feria-de-la-ciencia-energetica/',
  },
  {
    autor: 'Energía de Pereira',
    fecha: '(2024, 30 de octubre)',
    titulo: 'Energía de Pereira fomenta la ciencia y la sostenibilidad en jóvenes de secundaria',
    url: 'https://www.eep.com.co/es/energia-de-pereira-fomenta-la-ciencia-y-la-sostenibilidad-en-jovenes-de-secundaria-EV37',
  },
  {
    autor: 'Risaralda Hoy',
    fecha: '(2022, 27 de octubre)',
    titulo: 'Feria de la Ciencia Energética impulsa la innovación y la sostenibilidad',
    url: 'https://risaraldahoy.com/la-feria-de-la-ciencia-energetica-impulsala-innovacion-y-la-sostenibilidad/',
  },
];
---

<BaseLayout
  title="Feria de la Ciencia Energética · Ciencia e innovación — Explora · ConectaTE"
  description="La Feria de la Ciencia Energética de Energía de Pereira, en su sede de Cartago: estudiantes de bachillerato de colegios públicos construyen prototipos sobre ciudades inteligentes, transformación digital y autosostenibilidad. Qué es, cómo funciona y cómo prepararte con ConectaTE."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <span style="color: var(--fg);">Feria de la Ciencia Energética</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-yellow text-neutral-950 mb-10 min-h-[340px] flex flex-col justify-between">
        <div class="flex items-start justify-between flex-wrap gap-3">
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/10">⚡ Ciencia e innovación</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/10">Organiza: Energía de Pereira</span>
          </div>
          <span class="text-8xl md:text-9xl leading-none" aria-hidden="true">⚡</span>
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">Concurso · Explora</span>
          <h1 class="heading-giant text-balance mt-2 mb-3">Feria de la Ciencia Energética</h1>
          <p class="text-xl md:text-2xl font-black leading-tight mb-3">
            Tu ciudad tiene algo por mejorar. Tú puedes construir cómo.
          </p>
          <p class="text-base md:text-lg font-semibold opacity-90 max-w-3xl leading-relaxed">
            La feria de Energía de Pereira donde estudiantes de bachillerato de colegios
            públicos convierten un problema de su ciudad en un prototipo que funciona. En
            Cartago ya va por su quinta edición, y aquí te preparamos para llegar a la final.
          </p>
        </div>
      </div>

      <!-- ¿Por qué participar? -->
      <section class="mb-12">
        <h2 class="heading-huge mb-2">¿Por qué meterte en esto?</h2>
        <p class="text-base md:text-lg leading-relaxed mb-6" style="color: var(--fg-muted);">
          Porque te llevas mucho más que un puesto en una feria.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {razones.map((r) => (
            <div class="bento-card flex items-start gap-4">
              <span class="text-4xl shrink-0" aria-hidden="true">{r.i}</span>
              <div>
                <h3 class="font-black text-base md:text-lg leading-tight">{r.t}</h3>
                <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">{r.d}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Qué es (breve) -->
      <div class="bento-card-color bg-bento-cyan mb-12">
        <span class="chip-bento mb-3 bg-black/10 text-neutral-950">En una frase</span>
        <p class="text-lg md:text-xl font-black leading-snug">
          Mira tu ciudad, escoge uno de los tres ejes y construye un prototipo que la haga
          más inteligente, más digital o más sostenible.
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          Es el modelo <strong>MILC</strong> en acción: investigar tu territorio y crear
          tecnología con sentido para la gente que vive en él.
        </p>
      </div>

      <!-- Los ejes -->
      <section class="mb-12">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-3">
          <h2 class="heading-huge leading-tight">Los tres ejes</h2>
          <span class="chip-bento">Edición 2026</span>
        </div>
        <p class="text-base md:text-lg leading-relaxed mb-6" style="color: var(--fg-muted);">
          Tu proyecto debe responder a uno de ellos. Las ideas de Cartago son solo para
          arrancar: lo mejor es el problema que tú mismo encuentres.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {ejes.map((e) => (
            <div class="bento-card flex flex-col gap-3 border-t-4 border-bento-yellow">
              <span class="text-4xl" aria-hidden="true">{e.i}</span>
              <h3 class="font-black text-lg leading-tight">{e.t}</h3>
              <p class="text-sm leading-relaxed">{e.d}</p>
              <p class="text-sm leading-relaxed mt-auto" style="color: var(--fg-muted);">
                <strong style="color: var(--fg);">Por ejemplo, en Cartago:</strong> {e.ej}
              </p>
            </div>
          ))}
        </div>
        <p class="text-xs leading-relaxed mt-4" style="color: var(--fg-muted);">
          Los ejes cambian de un año a otro. Antes de empezar, confirma con tu docente los de
          la convocatoria vigente.
        </p>
      </section>

      <!-- ¿Es para ti? -->
      <section class="mb-12">
        <h2 class="heading-huge mb-3">¿Esto es para ti?</h2>
        <p class="text-base md:text-lg leading-relaxed mb-6">
          No necesitas un laboratorio ni piezas caras. Necesitas <strong>mirar tu ciudad con
          atención, medir lo que ves y atreverte a construir</strong>. Si te suena, esto es
          para ti:
        </p>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
          {requisitos.map((r) => (
            <div class="bento-card flex items-center gap-3 py-4">
              <span class="text-2xl shrink-0" aria-hidden="true">{r.i}</span>
              <span class="font-bold text-sm leading-tight">{r.t}</span>
            </div>
          ))}
        </div>
        <div class="bento-card border-l-4 border-bento-yellow">
          <p class="text-sm md:text-base leading-relaxed">
            <strong>Desde 2022 la feria tiene sede en Cartago.</strong> Los colegios de la ciudad
            compiten entre ellos y su final se hace aquí, cerca de los problemas que conoces mejor
            que nadie.
          </p>
        </div>
      </section>

      <!-- Cifras -->
      <section class="mb-12">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge leading-tight">No empiezas de cero.</h2>
          <span class="chip-bento">Desde 2022 en Cartago</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {stats.map((s) => (
            <div class="bento-card text-center">
              <div class="text-3xl md:text-4xl font-black tracking-tight">{s.n}</div>
              <div class="text-xs font-bold uppercase tracking-widest mt-1" style="color: var(--fg-muted);">{s.l}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- La ruta -->
      <section class="mb-12">
        <h2 class="heading-huge mb-3">La ruta, paso a paso</h2>
        <p class="text-base md:text-lg leading-relaxed mb-6" style="color: var(--fg-muted);">
          La feria dura varios meses. Así ha funcionado en las ediciones publicadas:
        </p>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          {etapas.map((e) => (
            <li class="bento-card p-4">
              <span class="w-7 h-7 rounded-full bg-bento-yellow text-neutral-950 flex items-center justify-center text-xs font-black mb-2">{e.n}</span>
              <h3 class="font-black text-sm leading-tight mb-1">{e.t}</h3>
              <p class="text-xs leading-relaxed" style="color: var(--fg-muted);">{e.d}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Prepárate con ConectaTE -->
      <section class="mb-12">
        <div class="bento-card-color bg-bento-black grid-pattern text-white py-10 px-6 md:px-10">
          <div class="text-center mb-8 max-w-2xl mx-auto">
            <span class="chip-bento mb-3 bg-white/10 text-white">Tu ventaja para la final</span>
            <h2 class="heading-huge mb-3 leading-tight">Prepárate con ConectaTE.</h2>
            <p class="text-base md:text-lg opacity-80 leading-relaxed">
              En 2024 el jurado destacó el <strong>impacto</strong> y la <strong>viabilidad</strong>
              de los proyectos ganadores. Estas seis claves te ayudan a mostrar las dos cosas.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-6">
            {claves.map((c) => (
              <div class="rounded-bento p-4 bg-white/10">
                <span class="text-2xl" aria-hidden="true">{c.i}</span>
                <h3 class="font-black text-sm leading-tight mt-2 mb-1">{c.t}</h3>
                <p class="text-xs leading-relaxed opacity-80">{c.d}</p>
              </div>
            ))}
          </div>

          <p class="text-xs opacity-70 text-center max-w-2xl mx-auto">
            Son recomendaciones de ConectaTE, no los criterios oficiales: esos los fija Energía de
            Pereira en la convocatoria de cada año.
          </p>
        </div>
      </section>

      <!-- Trayectoria de la institución -->
      <section class="mb-12">
        <h2 class="heading-huge mb-3">La Sor María Juliana en la feria</h2>
        <p class="text-base md:text-lg leading-relaxed mb-6" style="color: var(--fg-muted);">
          Resultados de los equipos de Tecnología e Informática en la sede Cartago.
        </p>
        <ol class="space-y-3">
          {trayectoria.map((r) => (
            <li class="bento-card flex items-start gap-4">
              <span class="px-3 py-1 rounded-full text-sm font-black bg-bento-yellow text-neutral-950 shrink-0">{r.a}</span>
              <p class="text-sm md:text-base leading-relaxed">{r.t}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- Cómo inscribirse -->
      <div class="bento-card-color bg-bento-yellow text-neutral-950 flex items-center gap-4 mb-10">
        <div class="text-5xl shrink-0" aria-hidden="true">🚀</div>
        <div class="flex-1">
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">¿Listos? Así te inscribes</span>
          <div class="font-black text-xl leading-tight mt-1">Habla con tu docente de Tecnología e Informática</div>
          <div class="text-sm opacity-90 mt-1">La inscripción la hace el colegio, en las fechas que abre Energía de Pereira cada año.</div>
        </div>
      </div>

      <!-- Fuentes -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-3">📚 Fuentes</span>
        <ul class="space-y-2 mt-2">
          {fuentes.map((f) => (
            <li class="text-sm leading-relaxed pl-6 -indent-6" style="color: var(--fg-muted);">
              {f.autor}. {f.fecha}. <em>{f.titulo}</em>.{' '}
              <a href={f.url} target="_blank" rel="noopener" class="underline break-all hover:opacity-70">{f.url}</a>
            </li>
          ))}
        </ul>
        <p class="text-xs leading-relaxed mt-3" style="color: var(--fg-muted);">
          Los ejes de 2026, la quinta edición en Cartago y los resultados de la institución son
          datos del docente líder.
        </p>
      </section>

      <!-- Créditos / aclaración -->
      <div class="bento-card mb-10 border-l-4 border-bento-yellow">
        <span class="chip-bento mb-3">🤝 Créditos y aclaración</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          La <strong style="color: var(--fg);">Feria de la Ciencia Energética</strong> es un programa de
          responsabilidad social de la <strong style="color: var(--fg);">Empresa de Energía de Pereira</strong>.
          Este espacio es material de <strong style="color: var(--fg);">preparación pedagógica
          independiente</strong> de la I.E. Sor María Juliana, en su plataforma ConectaTE,
          <strong style="color: var(--fg);">sin afiliación ni respaldo oficial</strong> de Energía de Pereira.
          Las bases, las fechas y los premios son exclusivamente los de la convocatoria oficial de
          cada año.
        </p>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver a</div>
          <div class="font-black text-lg">Explora</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

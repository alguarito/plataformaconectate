---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { programas, fgSobreBento } from '../../data/explora';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Explora · Programas, concursos y semilleros — ConectaTE"
  description="Programas, concursos y semilleros para ir más allá del aula: astronomía, pensamiento computacional e innovación STEM. Piloto 2026: Salomé, investigación de exoplanetas con RECA."
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <span style="color: var(--fg);">Explora</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-purple text-white mb-10 min-h-[300px] flex flex-col justify-between">
        <div class="flex items-start justify-between flex-wrap gap-3">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">
            🔭 Más allá del aula
          </span>
          <span class="text-8xl md:text-9xl leading-none" aria-hidden="true">🔭</span>
        </div>
        <div>
          <h1 class="heading-giant text-balance mt-2 mb-4">Explora</h1>
          <p class="text-base md:text-lg font-semibold opacity-95 max-w-2xl leading-relaxed">
            Programas, concursos y semilleros para llevar tu talento más lejos:
            astronomía, pensamiento computacional, innovación social y
            programación. Aquí la ciencia se vuelve aventura.
          </p>
        </div>
      </div>

      <!-- Grid de programas -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        {
          programas.map((p) => {
            if (p.estado === 'activo') {
              const fg = fgSobreBento(p.bgClass);
              return (
                <a
                  href={`${base}/explora/${p.slug}`}
                  class:list={[
                    'bento-card-color',
                    p.bgClass,
                    fg,
                    'flex flex-col justify-between min-h-[220px] hover:scale-[1.01] transition-transform group',
                  ]}
                  aria-label={`Abrir el programa ${p.nombre}`}
                >
                  <div class="flex items-start justify-between gap-3">
                    <span class="text-6xl leading-none" aria-hidden="true">{p.icono}</span>
                    <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest bg-black/15">
                      Disponible
                    </span>
                  </div>
                  <div class="mt-5">
                    <span class="text-xs font-bold uppercase tracking-widest opacity-80">
                      {p.categoria}
                    </span>
                    <h2 class="text-2xl font-black tracking-tight leading-tight mt-1 mb-2">
                      {p.nombre}
                    </h2>
                    <p class="text-sm leading-relaxed opacity-95">{p.descripcion}</p>
                    <div class="flex items-center justify-between gap-2 mt-4 flex-wrap">
                      {p.aliado && (
                        <span class="text-[11px] font-bold uppercase tracking-widest opacity-80">
                          Aliado: {p.aliado}
                        </span>
                      )}
                      <span class="inline-flex items-center gap-1 font-black text-sm">
                        Abrir
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M5 12h14"></path>
                          <path d="m12 5 7 7-7 7"></path>
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              );
            }
            return (
              <div class="bento-card flex flex-col justify-between min-h-[220px]" aria-label={`${p.nombre} — próximamente`}>
                <div class="flex items-start justify-between gap-3">
                  <span class:list={['w-14 h-14 rounded-bento-sm flex items-center justify-center text-3xl shrink-0', p.bgClass]} aria-hidden="true">
                    {p.icono}
                  </span>
                  <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest" style="background: var(--bg); color: var(--fg-muted); border: 1px solid var(--border);">
                    Próximamente
                  </span>
                </div>
                <div class="mt-5">
                  <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">
                    {p.categoria}
                  </span>
                  <h2 class="text-2xl font-black tracking-tight leading-tight mt-1 mb-2">
                    {p.nombre}
                  </h2>
                  <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{p.descripcion}</p>
                  {p.aliado && (
                    <span class="text-[11px] font-bold uppercase tracking-widest mt-4 inline-block" style="color: var(--fg-muted);">
                      Aliado: {p.aliado}
                    </span>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>

      <!-- Nota de contexto -->
      <p class="text-sm leading-relaxed mt-10 text-center max-w-2xl mx-auto" style="color: var(--fg-muted);">
        Estos espacios son opcionales y abiertos a estudiantes curiosos de
        cualquier grado. Empezamos en 2026 con <strong style="color: var(--fg);">Salomé</strong>;
        los demás se irán abriendo poco a poco.
      </p>
    </div>
  </article>
</BaseLayout>

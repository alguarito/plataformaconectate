// Mundos para el bloque de lectura comparada de atmósferas.
const planetas = [
  { nombre: 'La Tierra', emoji: '🌍', texto: 'Nitrógeno (78%) y oxígeno (21%). Es respirable, nos protege de la radiación y mantiene una temperatura templada. La única que conocemos con vida.' },
  { nombre: 'Venus', emoji: '🟠', texto: 'Casi todo CO₂, densísima. Atrapa tanto calor (efecto invernadero) que su superficie llega a ~465 °C: más caliente que un horno. Una advertencia.' },
  { nombre: 'Marte', emoji: '🔴', texto: 'También CO₂, pero tan tenue que casi no protege ni abriga. Frío y seco. Alguna vez tuvo más aire y agua líquida.' },
  { nombre: 'Júpiter', emoji: '🟤', texto: 'Hidrógeno y helio, como una estrella que no llegó a encender. Es un gigante gaseoso: no tiene superficie donde pararse.' },
];

// Pasos visuales de la espectroscopía de transmisión.
const pasosTransmision = [
  { emoji: '🌟', texto: 'La estrella emite su luz completa.' },
  { emoji: '🪐', texto: 'Al transitar, la atmósfera del planeta absorbe ciertos colores.' },
  { emoji: '🔭', texto: 'El telescopio ve el espectro con líneas: las huellas de esos gases.' },
];
---

<BaseLayout
  title="Tomo 2 · Estación 3 · Señales de vida en la atmósfera — Salomé · ConectaTE"
  description="Qué es una atmósfera, cómo se comparan las de la Tierra, Venus y Marte, y cómo la luz que atraviesa el aire de un exoplaneta revela sus gases y posibles señales de vida (biofirmas). Estación del programa Salomé (Tomo 2) adaptada al modelo MILC."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <div class="max-w-3xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <a href={`${base}/explora/salome`} class="hover:opacity-60 transition-opacity">Salomé</a>
        <span>/</span>
        <span style="color: var(--fg);">Tomo 2 · Estación 3</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-purple text-white mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">🌍 Estación 3 · Tomo 2</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Atmósferas y vida</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">~80 min</span>
        </div>
        <h1 class="heading-giant text-balance mb-3">Señales de vida en la atmósfera</h1>
        <p class="text-base md:text-lg font-semibold opacity-95 leading-relaxed">
          Qué es el aire de un planeta, por qué la Tierra es habitable y Venus un
          horno, y cómo la luz que atraviesa la atmósfera de un mundo lejano podría
          traernos la noticia más grande: que no estamos solos.
        </p>
      </div>

      <!-- 🌱 Saber ancestral -->
      <SaberAncestralBlock data={saberAncestral} />

      <!-- 🗺 Ruta -->
      <MapaRutaBlock estaciones={mapaRuta} />

      <!-- Propósito -->
      <div class="bento-card mb-6">
        <span class="chip-bento mb-4">🎯 Lo que vas a poder hacer</span>
        <ul class="space-y-3 mt-3">
          {[
            'IDENTIFICAR qué es una atmósfera y para qué sirve.',
            'EXPLICAR por qué la Tierra es habitable y Venus un horno.',
            'RELACIONAR cada planeta con su atmósfera y ORDENAR cómo se detecta la de un exoplaneta.',
            'APLICAR el criterio de biofirma para juzgar si un mundo podría tener vida.',
            'CREAR el diseño de una exo-Tierra y argumentar su habitabilidad.',
          ].map((d) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">✓</span>
              <span class="text-sm md:text-base leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Pregunta detonante -->
      <div class="bento-card-color bg-bento-cyan mb-10">
        <span class="chip-bento mb-3 bg-black/10">💡 La pregunta que abre todo</span>
        <p class="text-lg md:text-xl font-black leading-snug">
          ¿Cómo podríamos saber si en un planeta a billones de kilómetros hay vida, sin
          enviar a nadie, sin una sola foto de su superficie?
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          La respuesta está en su aire — y en la luz que lo atraviesa.
        </p>
      </div>

      <!-- 👁 Observa · video en proceso en RECA -->
      <div class="bento-card mb-6 flex items-start gap-3">
        <span class="text-2xl shrink-0" aria-hidden="true">🎬</span>
        <div>
          <div class="font-black text-sm">El video de este módulo está en camino</div>
          <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
            RECA aún está produciendo los videos del Tomo 2. Mientras llega, esta
            estación es autosuficiente: tienes toda la lectura que necesitas. Y aquí
            abajo está la guía oficial para profundizar.
          </p>
        </div>
      </div>
      <GuiasRECA tomo={2} modulo={3} />

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Ya sabes leer la luz (módulo anterior). Ahora la vas a usar para lo más
        ambicioso del tomo: oler el aire de otros mundos. Empecemos por el aire que ya conoces.
      </p>

      <!-- 📖 LEE 1 · Qué es una atmósfera -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · ¿Qué es una atmósfera y para qué sirve?</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            Una <strong>atmósfera</strong> es la capa de <strong>gases</strong> que envuelve un planeta,
            sostenida por su gravedad. La de la Tierra es una mezcla de <strong>nitrógeno</strong>
            (78%) y <strong>oxígeno</strong> (21%), con un 1% de otros gases. Ese delgado colchón
            de aire —comparado con el planeta, es más fino que la cáscara de una
            manzana— hace tres trabajos enormes.
          </p>
          <p>
            Primero, te da el <strong>oxígeno</strong> que respiras. Segundo, te <strong>protege</strong>:
            filtra la radiación dañina del Sol y desintegra la mayoría de meteoritos
            antes de que toquen el suelo. Tercero, <strong>regula la temperatura</strong>: atrapa
            algo de calor para que la noche no sea un congelador. Sin atmósfera, la
            Tierra sería un páramo muerto como la Luna.
          </p>
        </div>
      </section>

      <!-- 📖 LEE 2 · Cada planeta su aire -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · Cada planeta, su propio aire</span>
        <p class="text-sm md:text-base leading-relaxed mb-4">
          No hay dos atmósferas iguales, y de ellas depende que un mundo sea un hogar o
          un infierno. Compara estos cuatro:
        </p>
        <ul class="space-y-3">
          {planetas.map((p) => (
            <li class="flex items-start gap-3 p-3 rounded-bento-sm" style="background: var(--bg);">
              <span class="text-2xl shrink-0" aria-hidden="true">{p.emoji}</span>
              <span class="text-sm md:text-base leading-relaxed"><strong>{p.nombre}:</strong> {p.texto}</span>
            </li>
          ))}
        </ul>
        <p class="text-sm md:text-base leading-relaxed mt-4">
          Venus y la Tierra son casi del mismo tamaño y nacieron vecinas; sin embargo,
          su atmósfera las volvió mundos opuestos. <strong>El aire lo decide casi todo.</strong>
        </p>
      </section>

      <!-- 🔎 Relaciona planetas -->
      <div class="mb-6">
        <LabEmparejar data={emparejarPlanetas} id="empareja-planetas" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Conoces el aire de los vecinos. Pero, ¿cómo conocemos el aire de un planeta que
        ni siquiera podemos ver, alrededor de otra estrella?
      </p>

      <!-- 📖 LEE 3 · Cómo se lee el aire de otro mundo -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · Cómo se lee el aire de otro mundo</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            Aquí se unen las dos herramientas que ya tienes. Del Tomo 1: el
            <strong>tránsito</strong>, cuando un exoplaneta pasa por delante de su estrella. Del
            módulo anterior: la <strong>espectroscopía</strong>, leer la luz por sus colores. Júntalas
            y obtienes la <strong>espectroscopía de transmisión</strong>.
          </p>
          <p>
            Durante el tránsito, una pizca de la luz de la estrella <strong>atraviesa el borde
            de la atmósfera</strong> del planeta antes de llegarnos. Esos gases le roban colores
            muy precisos. Comparando la luz de la estrella <em>sola</em> con la luz <em>filtrada por
            el planeta</em>, vemos qué líneas nuevas aparecen — y esas líneas dicen exactamente
            qué gases hay en ese aire.
          </p>
        </div>

        <!-- Visualización: pasos de la transmisión -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mt-5">
          {pasosTransmision.map((s, i) => (
            <div class="p-4 rounded-bento-sm flex flex-col gap-2" style="background: var(--bg);">
              <div class="flex items-center gap-2">
                <span class="text-2xl" aria-hidden="true">{s.emoji}</span>
                <span class="w-6 h-6 rounded-full bg-bento-purple text-white flex items-center justify-center text-xs font-black shrink-0">{i + 1}</span>
              </div>
              <span class="text-xs leading-relaxed" style="color: var(--fg-muted);">{s.texto}</span>
            </div>
          ))}
        </div>

        <div class="space-y-4 text-sm md:text-base leading-relaxed mt-5">
          <p>
            ¿Y qué buscamos en ese aire? <strong>Biofirmas</strong>: gases que serían una señal de
            vida. El <strong>oxígeno</strong> en gran cantidad es difícil de mantener sin algo que lo
            produzca (en la Tierra lo fabrican las plantas y las algas). Y si junto al
            oxígeno aparece <strong>metano</strong> —dos gases que se destruyen entre sí—, la sospecha
            crece: si ambos siguen ahí, <strong>algo los está reponiendo</strong>. Quizá la vida.
          </p>
          <p>
            Esto no es ciencia ficción: el telescopio espacial <strong>James Webb</strong> ya analiza
            atmósferas de exoplanetas y ha detectado vapor de agua y CO₂. Pero la ciencia
            es <strong>prudente</strong>: una biofirma es un <em>indicio</em>, no una prueba. Antes de
            anunciar vida, hay que descartar toda causa que no la necesite.
          </p>
        </div>
      </section>

      <!-- 🔎 Ordena la detección -->
      <div class="mb-6">
        <LabOrdenar data={ordenarDeteccion} id="ordena-deteccion" />
      </div>

      <!-- 🔎 Relaciona conceptos (repaso integrador) -->
      <div class="mb-6">
        <LabEmparejar data={emparejarConceptos} id="empareja-conceptos-atmosfera" />
      </div>

      <!-- ✅ Quiz -->
      <div class="mb-6">
        <LabQuiz data={quiz} id="salome-atmosfera-quiz" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Tienes el método y el criterio. Ahora ponte en los zapatos de quien busca vida
        ahí afuera.
      </p>

      <!-- ✏️ Actividad APLICA -->
      <ActividadBlock data={actividadDetective} />

      <!-- ✏️ Actividad CREA -->
      <ActividadBlock data={actividadExoTierra} />

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Buscar aire con vida en otros mundos cambia cómo miras el de tu propio planeta.
        Cerremos pensando en eso.
      </p>
      </div>

      <!-- 💭 Triángulo (ancho completo) -->
      <TrianguloBlock data={triangulo} />

      <!-- 🌱 Cinco dimensiones (ancho completo) -->
      <CincoDimensionesBlock data={cincoDimensiones} />

      <div class="max-w-3xl mx-auto">
      <!-- Créditos -->
      <div class="bento-card mb-10 border-l-4 border-bento-purple">
        <span class="chip-bento mb-3">🛰 Créditos</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          Esta estación adapta al modelo MILC los conceptos del Módulo 3 («Señales de
          vida en la atmósfera») del <strong style="color: var(--fg);">Tomo 2</strong> del proyecto
          <strong style="color: var(--fg);">Salomé: investigación de exoplanetas</strong>, de la Association Ágora de
          Hipatia (Suiza), ejecutado en Colombia por <strong style="color: var(--fg);">RECA</strong>. El cómic y las
          fichas originales son de sus autores.
        </p>
        <a href={recursosOficiales} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 font-black text-sm text-bento-blue hover:opacity-70 transition-opacity">
          Leer el cómic y ver el material oficial
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora/salome`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al programa</div>
          <div class="font-black text-lg">Salomé</div>
        </div>
      </a>
      </div>
    </div>
  </article>
</BaseLayout>

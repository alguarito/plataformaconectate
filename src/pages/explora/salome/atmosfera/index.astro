import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabEmparejar from '../../../../components/LabEmparejar.astro';
import LabOrdenar from '../../../../components/LabOrdenar.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import GuiasRECA from '../../../../components/GuiasRECA.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataEmparejar } from '../../../../components/LabEmparejar.astro';
import type { DataOrdenar } from '../../../../components/LabOrdenar.astro';

const base = import.meta.env.BASE_URL;
const recursosOficiales = 'https://www.astroreca.org/educacion/salome-comic-exoplanetas/recursos';

const saberAncestral: SaberAncestral = {
  saber:
    'Pregúntale a un campesino del Valle si va a llover y muchas veces, antes de mirar el cielo, te dirá: «huele a agua». Los abuelos leen el aire. Saben que poco antes del aguacero la tierra suelta un olor particular —el olor a tierra mojada—, que el viento cambia de lado, que la humedad se pega a la piel y que los pájaros vuelan más bajo. Nada de eso se ve: el aire es invisible. Pero está lleno de señales para quien aprendió a leerlo. Ese aire que envuelve la vereda tiene un nombre científico: atmósfera. Y resulta que la forma en que el campesino interroga el aire de su tierra para anticipar la lluvia es, a otra escala, exactamente lo que hacen los astrónomos cuando interrogan el aire de un planeta lejano para anticipar algo mucho más grande: la vida.',
  fuente: 'Saber campesino del Valle del Cauca · leer el aire antes de la lluvia',
  preguntaPuente:
    'Si el aire invisible de tu vereda puede anunciar la lluvia, ¿qué crees que podría anunciar el aire de un planeta que está a billones de kilómetros?',

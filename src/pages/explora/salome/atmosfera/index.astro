const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'Buscamos otra Tierra mientras descuidamos la única que nos sostiene; mirar lejos no puede ser excusa para no mirar aquí.',

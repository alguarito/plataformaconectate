  },
];

const emparejarConceptos: DataEmparejar = {
  titulo: 'Relaciona cada concepto con su significado',
  instrucciones: 'Elige en cada fila el significado correcto. Pulsa «Comprobar» cuando termines.',
  etiquetaIzq: 'Concepto',
  etiquetaDer: 'Significado',
  pares: [
    { izquierda: 'Estrella', derecha: 'Esfera de gas que brilla por fusión nuclear' },
    { izquierda: 'Fusión nuclear', derecha: 'Unión de núcleos de hidrógeno que libera energía' },
    { izquierda: 'Diagrama HR', derecha: 'Mapa de estrellas por temperatura y luminosidad' },
    { izquierda: 'Año luz', derecha: 'Distancia que la luz recorre en un año' },
    { izquierda: 'Tipo espectral', derecha: 'Clasificación O-B-A-F-G-K-M según la temperatura' },

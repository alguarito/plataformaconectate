---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';

const base = import.meta.env.BASE_URL;
const recursosOficiales = 'https://www.astroreca.org/educacion/salome-comic-exoplanetas/recursos';

const saberAncestral: SaberAncestral = {
  saber:
    'Mucho antes de los telescopios, los abuelos y abuelas campesinas del norte del Valle del Cauca leían el cielo para vivir. Cuando «las Cabrillas» —el racimo de estrellas que la ciencia llama las Pléyades— aparecían al amanecer sobre el horizonte, sabían que llegaba el tiempo de preparar la tierra. La luna les decía cuándo sembrar y cuándo cosechar. El cielo no era un adorno: era calendario, reloj y mapa al mismo tiempo.',
  fuente: 'Saber campesino andino · tradición oral del Valle del Cauca',
  preguntaPuente:
    'Si nuestros abuelos leían el tiempo de siembra en un puñado de estrellas, ¿qué más esconde esa luz que viaja años para llegar a tus ojos?',
};

const mapaRuta: EstacionMapa[] = [
  { numero: 1, iconos: ['🌱'], titulo: 'El cielo de los abuelos', duracionMin: 5 },
  { numero: 2, iconos: ['📖'], titulo: '¿Qué es una estrella?', duracionMin: 12 },
  { numero: 3, iconos: ['📖', '👁'], titulo: 'Color, tamaño y el diagrama HR', duracionMin: 12 },
  { numero: 4, iconos: ['✏️'], titulo: 'Clasifica estrellas reales', duracionMin: 15 },
  { numero: 5, iconos: ['✅'], titulo: 'Pon a prueba lo que sabes', duracionMin: 8 },
  { numero: 6, iconos: ['💭'], titulo: 'Tres voces para mirar el cielo', duracionMin: 8 },
];

const conceptosQueEs = [
  {
    emoji: '🔥',
    termino: 'Una bola de gas que brilla',
    definicion:
      'Una estrella es una enorme esfera de gas, hecha sobre todo de hidrógeno y helio, que brilla porque está muy caliente.',
    ejemplo:
      'El universo es 92% hidrógeno, 7% helio y apenas 1% de todo lo demás (carbono, hierro, oxígeno…).',
  },
  {
    emoji: '⚛️',
    termino: 'Fusión nuclear',
    definicion:
      'En el núcleo, a millones de grados, los núcleos de hidrógeno se fusionan formando helio y liberan muchísima energía. Esa energía es la luz y el calor que ves.',
    ejemplo: 'Es el mismo proceso que hace brillar al Sol cada día.',
  },
  {
    emoji: '☀️',
    termino: 'El Sol, nuestra estrella',
    definicion:
      'El Sol es una estrella mediana de tipo G (amarilla). Mide cerca de 1.500.000 km de diámetro: ¡cuatro veces la distancia de la Tierra a la Luna!',
    ejemplo: 'Su brillo es la referencia: decimos que el Sol tiene luminosidad 1.',
  },
];

const conceptosColor = [
  {
    emoji: '🌈',
    termino: 'El color delata la temperatura',
    definicion:
      'Las estrellas más calientes se ven azules; las más frías, rojas; las intermedias, como el Sol, amarillas. Los astrónomos las ordenan en tipos: O, B, A, F, G, K, M.',
    ejemplo: 'Betelgeuse es roja y «fría»; Vega es blanca azulada y muy caliente.',
  },
  {
    emoji: '📊',
    termino: 'El diagrama HR',
    definicion:
      'Un mapa que clasifica las estrellas según su temperatura y su luminosidad. En él se distinguen la secuencia principal, las gigantes y supergigantes, y las enanas blancas.',
    ejemplo: 'Betelgeuse, fría pero enorme y brillante, vive arriba a la derecha como supergigante.',
  },
  {
    emoji: '🌌',
    termino: 'Tan lejos que ves el pasado',
    definicion:
      'La estrella más cercana al Sol, Próxima Centauri, está a 4,5 años luz: su luz tarda 4,5 años en llegar. Mirar una estrella es mirar cómo era hace años.',
    ejemplo: 'En la nave más rápida construida, tardarías 18.000 años en llegar.',
  },
];

const actividades: Actividad[] = [
  {
    numero: 1,
    verbo: 'ANALIZA',
    titulo: 'Ubica cuatro estrellas reales en el diagrama HR',
    tiempoMin: 15,
    modalidad: 'parejas',
    pasos: [
      'Dibuja en tu cuaderno los dos ejes del diagrama HR: la temperatura (de caliente/azul a fría/roja) y la luminosidad (de débil a brillante).',
      'Lee las pistas: el Sol (tipo G, amarillo, referencia), Betelgeuse (supergigante roja, fría pero muy brillante), Vega (blanca azulada, caliente y brillante) y Sirius B (enana blanca, caliente pero muy poco luminosa).',
      'Ubica cada estrella con un punto y su nombre en la región que le corresponde.',
      'Encierra a Betelgeuse y escribe en una frase por qué crees que el semillero de tu colegio lleva su nombre.',
    ],
    cuaderno: {
      titulo: 'El diagrama HR de mi clase',
      formato: 'diagrama de dos ejes + 4 puntos rotulados',
      extension: '1 página, con los 4 nombres y una frase de cierre',
    },
    criterios: [
      'Las 4 estrellas quedaron en regiones distintas y coherentes con su color y su brillo.',
      'Betelgeuse aparece arriba a la derecha (fría pero muy luminosa).',
      'Explicaste por qué Betelgeuse da nombre al semillero.',
    ],
  },
  {
    numero: 2,
    verbo: 'CREA',
    titulo: 'Rescata el saber estelar de tu familia',
    tiempoMin: 15,
    modalidad: 'individual',
    pasos: [
      'Pregúntale a un abuelo, abuela o vecino mayor cómo se guiaban por el cielo, la luna o «las Cabrillas» para sembrar, viajar o saber la hora.',
      'Anota el saber tal como te lo contaron, sin corregirlo.',
      'Conéctalo con un concepto de hoy: por qué esas estrellas aparecen en cierta época, qué es realmente la luna o por qué cambia el cielo según el mes.',
    ],
    cuaderno: {
      titulo: 'El cielo de mi familia',
      formato: 'relato corto + conexión científica',
      extension: '8 a 10 renglones',
    },
    criterios: [
      'Recogiste un saber real, contado por alguien mayor.',
      'Lo conectaste con al menos un concepto de esta estación.',
      'Escribiste con respeto, nombrando a quién te lo contó.',
    ],
  },
];

const quiz: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Pon a prueba lo que sabes',
  instrucciones: 'Elige una respuesta en cada pregunta. Recibirás retroalimentación al instante.',
  preguntas: [
    {
      enunciado: '¿De qué está hecha principalmente una estrella?',
      opciones: ['Hidrógeno y helio', 'Roca y metal', 'Hielo y polvo', 'Fuego y humo'],
      respuestaIndex: 0,
      feedbackCorrecto: 'Exacto: sobre todo hidrógeno y helio, los elementos más abundantes del universo.',
      feedbackIncorrecto: 'Repasa: una estrella es una bola de gas hecha sobre todo de hidrógeno y helio.',
    },
    {
      enunciado: '¿Por qué brilla una estrella?',
      opciones: [
        'Porque refleja la luz del Sol',
        'Porque la fusión nuclear de su núcleo libera energía',
        'Porque está hecha de fuego',
        'Porque gira muy rápido',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Sí: la fusión de hidrógeno en helio libera la energía que vemos como luz.',
      feedbackIncorrecto: 'No: una estrella brilla por la fusión nuclear de su núcleo, no por reflejo ni por girar.',
    },
    {
      enunciado: 'Una estrella que se ve azul, comparada con una roja, es…',
      opciones: ['Más fría', 'Más caliente', 'Siempre más pequeña', 'Más cercana'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto: el azul indica mayor temperatura; el rojo, menor.',
      feedbackIncorrecto: 'Recuerda: el color delata la temperatura — azul = más caliente, rojo = más fría.',
    },
    {
      enunciado: 'Próxima Centauri está a 4,5 años luz. Cuando la miras, ves…',
      opciones: [
        'Cómo es en este instante',
        'Cómo era hace 4,5 años',
        'Una estrella que ya no existe',
        'El futuro de esa estrella',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: '¡Eso es! Su luz tardó 4,5 años en llegar: estás viendo el pasado.',
      feedbackIncorrecto: 'Piensa: su luz tarda 4,5 años en llegar, así que la ves como era hace 4,5 años.',
    },
    {
      enunciado: 'En el diagrama HR, Betelgeuse (supergigante roja) está…',
      opciones: [
        'Entre las estrellas frías pero muy luminosas',
        'Entre las enanas blancas',
        'Justo donde está el Sol',
        'Entre las más calientes y azules',
      ],
      respuestaIndex: 0,
      feedbackCorrecto: 'Correcto: fría pero enorme y brillante, va arriba a la derecha.',
      feedbackIncorrecto: 'Betelgeuse es fría (roja) pero muy luminosa: va arriba a la derecha del diagrama.',
    },
  ],
};

const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'La ciencia también se piensa desde el Sur: nombrar el cielo desde nuestra tierra es un acto de dignidad.',
    preguntaEspejo:
      'La astronomía que aprendo casi siempre se cuenta desde Europa. ¿Qué cambiaría si también la contáramos desde Cartago?',
  },
  estoico: {
    autor: 'Marco Aurelio',
    lente: 'lente del cuidado interior',
    cita: 'Observa el curso de los astros como si giraras con ellos.',
    preguntaEspejo:
      'Cuando contemplo algo tan inmenso y antiguo como una estrella, ¿qué preocupaciones mías se vuelven más pequeñas?',
  },
  floridi: {
    autor: 'Luciano Floridi',
    lente: 'lente de la infoesfera',
    cita: 'Somos inforgs: organismos hechos de información que habitan la infoesfera.',
    preguntaEspejo:
      'La luz de una estrella es información que viajó años hasta mí. ¿Qué otra información del pasado uso sin darme cuenta?',
  },
};

const cincoDimensiones: CincoDimensiones = {
  personal:
    'Ahora sabes que cada punto del cielo es un sol gigante de gas que brilla por fusión nuclear. Ya no miras el cielo igual.',
  emocional:
    'Lo inmenso y lo lejano puede asombrar o intimidar. Ponerle nombre a lo que ves convierte el vértigo en curiosidad.',
  ciudadana:
    'Los datos de las estrellas son abiertos y se construyen entre muchos países. Compartir y cuidar el conocimiento también es ciudadanía.',
  local:
    'Desde Cartago también se hace astronomía. El Semillero Betelgeuse de tu colegio es parte de la red científica colombiana.',
  intergeneracional:
    'Tus abuelos leían «las Cabrillas» para sembrar; tú lees el diagrama HR. Es el mismo gesto humano de mirar arriba para entender, a través de las generaciones.',
};
---

<BaseLayout
  title="Estación 1 · Con la cabeza en las estrellas — Salomé · ConectaTE"
  description="Qué es una estrella, por qué brilla y cómo clasificamos las estrellas en el diagrama HR. Una estación del programa Salomé adaptada al modelo MILC, desde el cielo de nuestros abuelos."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-3xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <a href={`${base}/explora/salome`} class="hover:opacity-60 transition-opacity">Salomé</a>
        <span>/</span>
        <span style="color: var(--fg);">Estación 1</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-blue text-white mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Estación 1 · Tomo 1</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Estrellas</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">~60 min</span>
        </div>
        <h1 class="heading-giant text-balance mb-3">Con la cabeza en las estrellas</h1>
        <p class="text-base md:text-lg font-semibold opacity-95 leading-relaxed">
          Qué es una estrella, por qué brilla y cómo las clasificamos —
          empezando por el cielo que leían nuestros abuelos.
        </p>
      </div>

      <!-- 🌱 Saber ancestral -->
      <SaberAncestralBlock data={saberAncestral} />

      <!-- 🗺 Ruta -->
      <MapaRutaBlock estaciones={mapaRuta} />

      <!-- Propósito de aprendizaje -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-4">🎯 Lo que vas a poder hacer</span>
        <ul class="space-y-3 mt-3">
          {[
            'IDENTIFICAR de qué está hecha una estrella y por qué brilla.',
            'EXPLICAR cómo el color de una estrella revela su temperatura.',
            'ANALIZAR y ubicar estrellas reales en el diagrama HR.',
            'CREAR un puente entre la ciencia de hoy y el saber del cielo de tu familia.',
          ].map((d) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">✓</span>
              <span class="text-sm md:text-base leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
        <p class="text-sm leading-relaxed mt-5 pt-4 border-t" style="border-color: var(--border); color: var(--fg-muted);">
          <strong style="color: var(--fg);">Producto final:</strong> el «diagrama HR de mi clase» y el «cielo de mi familia», ambos en tu cuaderno.
        </p>
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Hasta aquí miraste el cielo como tus abuelos. Ahora vas a mirarlo como la
        ciencia: ¿qué es, en realidad, ese punto que brilla?
      </p>

      <!-- 📖 Marco conceptual · qué es una estrella -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · ¿Qué es una estrella?</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
          {conceptosQueEs.map((c) => (
            <article class="p-4 rounded-bento-sm" style="background: var(--bg);">
              <div class="text-3xl mb-2" aria-hidden="true">{c.emoji}</div>
              <h3 class="font-black text-base leading-tight mb-1">{c.termino}</h3>
              <p class="text-sm leading-relaxed">{c.definicion}</p>
              <p class="text-xs leading-relaxed mt-2 pt-2 border-t" style="border-color: var(--border); color: var(--fg-muted);">
                <strong>Ejemplo:</strong> {c.ejemplo}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- 📖 Marco conceptual · color, tamaño y distancia -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · Color, tamaño y distancia</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
          {conceptosColor.map((c) => (
            <article class="p-4 rounded-bento-sm" style="background: var(--bg);">
              <div class="text-3xl mb-2" aria-hidden="true">{c.emoji}</div>
              <h3 class="font-black text-base leading-tight mb-1">{c.termino}</h3>
              <p class="text-sm leading-relaxed">{c.definicion}</p>
              <p class="text-xs leading-relaxed mt-2 pt-2 border-t" style="border-color: var(--border); color: var(--fg-muted);">
                <strong>Ejemplo:</strong> {c.ejemplo}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Ya tienes los conceptos. Es hora de usarlos con estrellas de verdad.
      </p>

      <!-- ✏️ Actividades -->
      {actividades.map((a) => <ActividadBlock data={a} />)}

      <!-- ✅ Laboratorio -->
      <div class="mb-6">
        <LabQuiz data={quiz} id="salome-estrellas-quiz" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Aprendiste qué es una estrella. Cerremos pensando qué significa, para ti,
        mirar el cielo.
      </p>

      <!-- 💭 Triángulo -->
      <TrianguloBlock data={triangulo} />

      <!-- 🌱 Cinco dimensiones -->
      <CincoDimensionesBlock data={cincoDimensiones} />

      <!-- Créditos / atribución -->
      <div class="bento-card mb-10 border-l-4 border-bento-purple">
        <span class="chip-bento mb-3">🛰 Créditos</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          Esta estación adapta al modelo MILC los conceptos del Módulo 1 («¿Qué es una
          estrella?») del proyecto <strong style="color: var(--fg);">Salomé: investigación de exoplanetas</strong>, de la
          Association Ágora de Hipatia (Suiza), ejecutado en Colombia por
          <strong style="color: var(--fg);">RECA</strong>. El cómic y las fichas originales son de sus autores.
        </p>
        <a href={recursosOficiales} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 font-black text-sm text-bento-blue hover:opacity-70 transition-opacity">
          Leer el cómic y ver el material oficial
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora/salome`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al programa</div>
          <div class="font-black text-lg">Salomé</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

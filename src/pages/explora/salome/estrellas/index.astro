---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabEmparejar from '../../../../components/LabEmparejar.astro';
import LabOrdenar from '../../../../components/LabOrdenar.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataEmparejar } from '../../../../components/LabEmparejar.astro';
import type { DataOrdenar } from '../../../../components/LabOrdenar.astro';

const base = import.meta.env.BASE_URL;
const recursosOficiales = 'https://www.astroreca.org/educacion/salome-comic-exoplanetas/recursos';

const saberAncestral: SaberAncestral = {
  saber:
    'En las veredas del norte del Valle del Cauca, mucho antes de que existieran los pronósticos del clima o los telescopios, los campesinos sabían leer el cielo como quien lee un reloj. Las abuelas señalaban un pequeño racimo de estrellas apretadas —las que ellos llamaban «las Cabrillas» y la ciencia llama las Pléyades— y, por la época del año en que aparecían sobre el horizonte al amanecer, decidían cuándo preparar la tierra y cuándo sembrar el maíz. La luna completaba el calendario: por su forma sabían cuándo podar y cuándo cosechar para que el fruto durara. Nadie les había enseñado astrofísica; habían heredado, de generación en generación, una observación paciente del cielo. Para ellos las estrellas no eran adorno ni misterio lejano: eran calendario, reloj y mapa, todo a la vez.',
  fuente: 'Saber campesino andino · tradición oral del norte del Valle del Cauca',
  preguntaPuente:
    'Nuestros abuelos sabían CUÁNDO aparecían las estrellas y para qué servían. Hoy te toca una pregunta nueva: ¿QUÉ es, en realidad, cada uno de esos puntos, y por qué brilla?',
};

const mapaRuta: EstacionMapa[] = [
  { numero: 1, iconos: ['🌱'], titulo: 'El cielo de los abuelos', duracionMin: 5 },
  { numero: 2, iconos: ['📖'], titulo: '¿Qué es una estrella?', duracionMin: 10 },
  { numero: 3, iconos: ['🔎'], titulo: 'Relaciona conceptos y ordena la fusión', duracionMin: 12 },
  { numero: 4, iconos: ['📖', '👁'], titulo: 'Color, tamaño y distancia', duracionMin: 10 },
  { numero: 5, iconos: ['🔎'], titulo: 'Relaciona estrellas reales', duracionMin: 6 },
  { numero: 6, iconos: ['✏️'], titulo: 'Calcula el tamaño del Sol', duracionMin: 15 },
  { numero: 7, iconos: ['✅'], titulo: 'Pon a prueba lo que sabes', duracionMin: 8 },
  { numero: 8, iconos: ['✏️', '💭'], titulo: 'El cielo de tu familia + cierre', duracionMin: 14 },
];

const conceptosQueEs = [
  {
    emoji: '🔥',
    termino: 'Una bola de gas que brilla',
    definicion:
      'Una estrella es una esfera gigantesca de gas, hecha sobre todo de hidrógeno y helio, que brilla porque está extremadamente caliente.',

};

const actividadCalculo: Actividad = {
  numero: 1,
  verbo: 'APLICA',
  titulo: 'Calcula el verdadero tamaño del Sol',
  tiempoMin: 15,
  modalidad: 'individual',
  pasos: [
    'El Sol mide 1.500.000 km de diámetro. Calcula su perímetro con P = π × diámetro (usa π = 3,14).',
    'Imagina que caminas alrededor del Sol a 5 km/h sin parar. Calcula las horas: perímetro ÷ 5.',
    'Convierte esas horas a días (÷ 24) y luego a años (÷ 365). Redondea.',
    'Escribe una frase: ¿qué te dice ese número sobre por qué las estrellas se ven pequeñas?',
  ],
  cuaderno: {
    titulo: 'El tamaño del Sol',
    formato: 'tres operaciones + resultado + una frase de conclusión',
    extension: 'los 3 cálculos y la conclusión',
  },
  criterios: [
    'El perímetro te da aproximadamente 4.710.000 km.',
    'Caminando sin parar tardarías cerca de 107 años en darle la vuelta.',
    'Tu frase conecta ese tamaño enorme con la idea de que lo vemos pequeño porque está lejísimos.',
  ],
};

const actividadFamilia: Actividad = {
  numero: 2,
  verbo: 'CREA',
  titulo: 'Rescata el saber estelar de tu familia',
  tiempoMin: 14,
  modalidad: 'individual',
  pasos: [
    'Pregúntale a un abuelo, abuela o vecino mayor cómo se guiaban por el cielo, la luna o «las Cabrillas» para sembrar, viajar o saber la hora.',
    'Anota el saber tal como te lo contaron, sin corregirlo.',
    'Conéctalo con un concepto de esta estación: ¿por qué esas estrellas aparecen en cierta época?, ¿qué es realmente la luna?',
  ],
  cuaderno: {
    titulo: 'El cielo de mi familia',
    formato: 'relato corto + conexión científica',
    extension: '8 a 10 renglones',
  },
  criterios: [
    'Recogiste un saber real, contado por alguien mayor.',
    'Lo conectaste con al menos un concepto de esta estación.',
    'Escribiste con respeto, nombrando a quién te lo contó.',
  ],
};

const quiz: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Pon a prueba lo que sabes',
  instrucciones: 'Elige una respuesta en cada pregunta. Recibirás retroalimentación que te explica el porqué.',
  preguntas: [
    {
      enunciado: '¿Cuál es el elemento más abundante en el universo y principal componente de una estrella?',
      opciones: ['El oxígeno', 'El hidrógeno', 'El hierro', 'El carbono'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto. El universo es ~92% hidrógeno y ~7% helio; todo lo demás (carbono, hierro, oxígeno…) suma apenas el 1%.',
      feedbackIncorrecto: 'No: el más abundante es el hidrógeno (~92% del universo). El helio le sigue con ~7%.',
    },
    {
      enunciado: '¿Por qué brilla una estrella?',
      opciones: [
        'Porque refleja la luz del Sol',
        'Porque la fusión nuclear de su núcleo libera energía',
        'Porque está hecha de fuego',
        'Porque gira muy rápido',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Sí: en su núcleo el hidrógeno se fusiona en helio y libera la energía que vemos como luz y calor.',
      feedbackIncorrecto: 'Una estrella brilla por la fusión nuclear de su núcleo, no por reflejo, fuego ni rotación. La Luna sí refleja; una estrella produce su propia luz.',
    },
    {
      enunciado: 'Tienes dos estrellas: una azul y una roja. ¿Qué puedes afirmar?',
      opciones: [
        'La roja es más caliente que la azul',
        'La azul es más caliente que la roja',
        'Tienen exactamente la misma temperatura',
        'El color no dice nada de la temperatura',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Exacto: el color delata la temperatura. Azul = más caliente; rojo = más frío; el Sol, amarillo, está en medio.',
      feedbackIncorrecto: 'Al revés: el azul indica MÁS temperatura y el rojo MENOS. Por eso una fogata azul quema más que una roja.',
    },
    {
      enunciado: 'Próxima Centauri está a 4,5 años luz. Cuando la observas esta noche, ves…',
      opciones: [
        'Cómo es en este preciso instante',
        'Cómo era hace 4,5 años',
        'Una estrella que con seguridad ya no existe',
        'Su aspecto dentro de 4,5 años',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: '¡Eso es! Su luz tardó 4,5 años en llegar, así que la ves tal como era hace 4,5 años: mirar lejos es mirar al pasado.',
      feedbackIncorrecto: 'Su luz tarda 4,5 años en llegar, así que la ves como era hace 4,5 años. No necesariamente desapareció: 4,5 años es poco para una estrella.',
    },
    {
      enunciado: 'En el diagrama HR, ¿dónde se ubica Betelgeuse (supergigante roja)?',
      opciones: [
        'Entre las estrellas frías pero muy luminosas',
        'Entre las enanas blancas',
        'Justo donde está el Sol',
        'Entre las más calientes y azules',
      ],
      respuestaIndex: 0,
      feedbackCorrecto: 'Correcto: es fría (roja) pero enorme y brillante, así que va arriba (muy luminosa) a la derecha (fría).',
      feedbackIncorrecto: 'Betelgeuse es fría (roja) pero muy luminosa por su tamaño: va arriba a la derecha, no entre las calientes ni las enanas.',
    },
    {
      enunciado: '¿Qué clasifica el diagrama HR?',
      opciones: [
        'El tamaño y la edad de los planetas',
        'La temperatura y la luminosidad de las estrellas',
        'La distancia y la masa de las galaxias',
        'El color y la forma de las nebulosas',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Sí: el diagrama HR ordena las estrellas según su temperatura (eje horizontal) y su luminosidad (eje vertical).',
      feedbackIncorrecto: 'El diagrama HR clasifica ESTRELLAS por dos rasgos: su temperatura y su luminosidad. No es de planetas ni galaxias.',
    },
  ],
};

const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'La ciencia también se piensa desde el Sur: nombrar el cielo desde nuestra tierra es un acto de dignidad.',
    preguntaEspejo:
      'La astronomía que aprendo casi siempre se cuenta desde Europa. ¿Qué cambiaría si también la contáramos desde Cartago?',
  },
  estoico: {
    autor: 'Marco Aurelio',
    lente: 'lente del cuidado interior',
    cita: 'Observa el curso de los astros como si giraras con ellos.',
    preguntaEspejo:
      'Cuando contemplo algo tan inmenso y antiguo como una estrella, ¿qué preocupaciones mías se vuelven más pequeñas?',
  },
  floridi: {
    autor: 'Luciano Floridi',
    lente: 'lente de la infoesfera',
    cita: 'Somos inforgs: organismos hechos de información que habitan la infoesfera.',
    preguntaEspejo:
      'La luz de una estrella es información que viajó años hasta mí. ¿Qué otra información del pasado uso sin darme cuenta?',
  },
};

const cincoDimensiones: CincoDimensiones = {
  personal:
    'Ahora sabes que cada punto del cielo es un sol gigante de gas que brilla por fusión nuclear. Ya no miras el cielo igual.',
  emocional:
    'Lo inmenso y lo lejano puede asombrar o intimidar. Ponerle nombre a lo que ves convierte el vértigo en curiosidad.',
  ciudadana:
    'Los datos de las estrellas son abiertos y se construyen entre muchos países. Compartir y cuidar el conocimiento también es ciudadanía.',
  local:
    'Desde Cartago también se hace astronomía. El Semillero Betelgeuse de tu colegio es parte de la red científica colombiana.',
  intergeneracional:
    'Tus abuelos leían «las Cabrillas» para sembrar; tú lees el diagrama HR. Es el mismo gesto humano de mirar arriba para entender, a través de las generaciones.',
};
---

<BaseLayout
  title="Estación 1 · Con la cabeza en las estrellas — Salomé · ConectaTE"
  description="Qué es una estrella, por qué brilla y cómo se clasifican en el diagrama HR. Estación del programa Salomé adaptada al modelo MILC, con ejercicios para relacionar, ordenar y calcular."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-3xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <a href={`${base}/explora/salome`} class="hover:opacity-60 transition-opacity">Salomé</a>
        <span>/</span>
        <span style="color: var(--fg);">Estación 1</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-blue text-white mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Estación 1 · Tomo 1</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Estrellas</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">~75 min</span>
        </div>
        <h1 class="heading-giant text-balance mb-3">Con la cabeza en las estrellas</h1>
        <p class="text-base md:text-lg font-semibold opacity-95 leading-relaxed">
          Qué es una estrella, por qué brilla y cómo las clasificamos —
          empezando por el cielo que leían nuestros abuelos.
        </p>
      </div>

      <!-- 🌱 Saber ancestral -->
      <SaberAncestralBlock data={saberAncestral} />

      <!-- 🗺 Ruta -->
      <MapaRutaBlock estaciones={mapaRuta} />

      <!-- Propósito -->
      <div class="bento-card mb-6">
        <span class="chip-bento mb-4">🎯 Lo que vas a poder hacer</span>
        <ul class="space-y-3 mt-3">
          {[
            'IDENTIFICAR de qué está hecha una estrella y por qué brilla.',
            'EXPLICAR cómo el color de una estrella revela su temperatura.',
            'RELACIONAR conceptos y ORDENAR el proceso de la fusión nuclear.',
            'APLICAR un cálculo real para dimensionar el tamaño del Sol.',
            'CREAR un puente entre la ciencia de hoy y el saber del cielo de tu familia.',
          ].map((d) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">✓</span>
              <span class="text-sm md:text-base leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Pregunta detonante -->
      <div class="bento-card-color bg-bento-cyan mb-10">
        <span class="chip-bento mb-3 bg-black/10">💡 La pregunta que abre todo</span>
        <p class="text-lg md:text-xl font-black leading-snug">
          Una estrella es una explosión nuclear del tamaño de un millón de Tierras.
          Entonces, ¿por qué la ves como un punto quieto y silencioso en el cielo?
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          Guarda esa pregunta. Al terminar la estación vas a poder responderla con
          tres ideas: tamaño, temperatura y distancia.
        </p>
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Hasta aquí miraste el cielo como tus abuelos. Ahora vas a mirarlo como la
        ciencia: ¿qué es, en realidad, ese punto que brilla?
      </p>

      <!-- 📖 Marco conceptual · qué es una estrella -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · ¿Qué es una estrella?</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
          {conceptosQueEs.map((c) => (
            <article class="p-4 rounded-bento-sm" style="background: var(--bg);">
              <div class="text-3xl mb-2" aria-hidden="true">{c.emoji}</div>
              <h3 class="font-black text-base leading-tight mb-1">{c.termino}</h3>
              <p class="text-sm leading-relaxed">{c.definicion}</p>
              <p class="text-xs leading-relaxed mt-2 pt-2 border-t" style="border-color: var(--border); color: var(--fg-muted);">
                <strong>Ejemplo:</strong> {c.ejemplo}
              </p>
            </article>
          ))}
        </div>

        <!-- Proporción del universo -->
        <div class="mt-5 p-4 rounded-bento-sm" style="background: var(--bg);">
          <h3 class="font-black text-sm mb-3">De qué está hecho el universo</h3>
          <div class="flex w-full h-9 rounded-full overflow-hidden text-[11px] font-black" role="img" aria-label="92 por ciento hidrógeno, 7 por ciento helio, 1 por ciento otros elementos">
            <div class="bg-bento-blue text-white flex items-center justify-center" style="width: 92%;">92% H</div>
            <div class="bg-bento-cyan text-neutral-950 flex items-center justify-center" style="width: 7%;">7%</div>
            <div class="bg-bento-pink" style="width: 1%;" title="1% otros"></div>
          </div>
          <p class="text-xs leading-relaxed mt-2" style="color: var(--fg-muted);">
            <strong style="color: var(--fg);">92%</strong> hidrógeno ·
            <strong style="color: var(--fg);">7%</strong> helio ·
            <strong style="color: var(--fg);">1%</strong> todo lo demás (carbono, hierro, oxígeno…). Tú y todo lo que te rodea estáis hechos de ese 1%.
          </p>
        </div>
      </section>

      <!-- 🔎 Relaciona conceptos -->
      <div class="mb-6">
        <LabEmparejar data={emparejarConceptos} id="empareja-conceptos" />
      </div>

      <!-- 🔎 Ordena la fusión -->
      <div class="mb-6">
        <LabOrdenar data={ordenarFusion} id="ordena-fusion" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Ya sabes qué es una estrella y por qué brilla. Ahora, ¿por qué no todas son iguales?
      </p>

      <!-- 📖 Marco conceptual · color, tamaño y distancia -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · Color, tamaño y distancia</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-3">
          {conceptosColor.map((c) => (
            <article class="p-4 rounded-bento-sm" style="background: var(--bg);">
              <div class="text-3xl mb-2" aria-hidden="true">{c.emoji}</div>
              <h3 class="font-black text-base leading-tight mb-1">{c.termino}</h3>
              <p class="text-sm leading-relaxed">{c.definicion}</p>
              <p class="text-xs leading-relaxed mt-2 pt-2 border-t" style="border-color: var(--border); color: var(--fg-muted);">
                <strong>Ejemplo:</strong> {c.ejemplo}
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- 🔎 Relaciona estrellas -->
      <div class="mb-6">
        <LabEmparejar data={emparejarEstrellas} id="empareja-estrellas" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Hablamos de tamaños «gigantes». Comprobémoslo tú mismo con números reales.
      </p>

      <!-- ✏️ Actividad de cálculo -->
      <ActividadBlock data={actividadCalculo} />

      <!-- ✅ Quiz -->
      <div class="mb-6">
        <LabQuiz data={quiz} id="salome-estrellas-quiz" />
      </div>

      <!-- ✏️ Actividad CREA -->
      <ActividadBlock data={actividadFamilia} />

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Aprendiste qué es una estrella. Cerremos pensando qué significa, para ti, mirar el cielo.
      </p>

      <!-- 💭 Triángulo -->
      <TrianguloBlock data={triangulo} />

      <!-- 🌱 Cinco dimensiones -->
      <CincoDimensionesBlock data={cincoDimensiones} />

      <!-- Créditos -->
      <div class="bento-card mb-10 border-l-4 border-bento-purple">
        <span class="chip-bento mb-3">🛰 Créditos</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          Esta estación adapta al modelo MILC los conceptos del Módulo 1 («¿Qué es una
          estrella?») del proyecto <strong style="color: var(--fg);">Salomé: investigación de exoplanetas</strong>, de la
          Association Ágora de Hipatia (Suiza), ejecutado en Colombia por
          <strong style="color: var(--fg);">RECA</strong>. El cómic y las fichas originales son de sus autores.
        </p>
        <a href={recursosOficiales} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 font-black text-sm text-bento-blue hover:opacity-70 transition-opacity">
          Leer el cómic y ver el material oficial
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora/salome`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al programa</div>
          <div class="font-black text-lg">Salomé</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

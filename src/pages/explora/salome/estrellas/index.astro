};

const ordenarFusion: DataOrdenar = {
  titulo: 'Ordena la cadena que hace brillar una estrella',
  instrucciones: 'Usa las flechas para poner los pasos de la fusión nuclear del primero al último.',
  pasos: [
    'En el núcleo se acumulan núcleos de hidrógeno y la presión es enorme.',
    'La temperatura llega a millones de grados y las partículas se mueven muy rápido.',
    'Los núcleos de hidrógeno chocan con más fuerza y más frecuencia.',
    'Varios núcleos de hidrógeno se fusionan y forman helio.',
    'La fusión libera una enorme cantidad de energía.',
    'Esa energía mantiene caliente a la estrella y la hace brillar.',

const emparejarEstrellas: DataEmparejar = {
  titulo: 'Relaciona cada estrella con cómo es',
  instrucciones: 'Conecta cada estrella real con su descripción. Apóyate en lo que acabas de leer.',
  etiquetaIzq: 'Estrella',
  etiquetaDer: 'Cómo es',
  pares: [
    { izquierda: 'El Sol', derecha: 'Tipo G, amarilla — la usamos como referencia' },
    { izquierda: 'Betelgeuse', derecha: 'Supergigante roja: fría pero enorme y muy brillante' },
    { izquierda: 'Vega', derecha: 'Blanca azulada: muy caliente' },
    { izquierda: 'Sirius B', derecha: 'Enana blanca: caliente pero poco luminosa' },
    { izquierda: 'Próxima Centauri', derecha: 'La más cercana al Sol: a 4,5 años luz' },

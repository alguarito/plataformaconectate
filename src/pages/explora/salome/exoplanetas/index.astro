---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabEmparejar from '../../../../components/LabEmparejar.astro';
import LabOrdenar from '../../../../components/LabOrdenar.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import VideoSesion from '../../../../components/VideoSesion.astro';
import GuiasRECA from '../../../../components/GuiasRECA.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataEmparejar } from '../../../../components/LabEmparejar.astro';
import type { DataOrdenar } from '../../../../components/LabOrdenar.astro';

const base = import.meta.env.BASE_URL;
const recursosOficiales = 'https://www.astroreca.org/educacion/salome-comic-exoplanetas/recursos';

const video = {
  youtubeId: '5q5LubyFEYY',
  titulo: '¿Qué es un exoplaneta? · Video del Módulo 3',
  descripcion:
    'RECA presenta el tema en pocos minutos. Míralo antes de leer: te da el panorama general que luego vas a profundizar.',
  credito: 'Video de RECA · Proyecto Salomé',
  resumenUrl: 'https://drive.google.com/file/d/1bJC5D89t_bAUa8wwNx0ImH82xaVV20LM/view?usp=drive_link',
};

const saberAncestral: SaberAncestral = {
  saber:
    'La idea de que existen «otros mundos» no nació con la ciencia. Los pueblos de la Sierra Nevada de Santa Marta —Kogui, Arhuacos, Wiwas— han contado durante siglos que el universo está hecho de varios mundos o niveles, unos arriba y otros abajo, y que la vida y el cosmos están entretejidos. Para los mamos, sus sabios, el cielo nunca fue un techo vacío: era parte de un todo vivo. Esa pregunta —¿hay más mundos que el nuestro?— es tan antigua como la humanidad. Lo nuevo es que, por primera vez en la historia, la ciencia ya no solo la imagina: la está respondiendo, mundo por mundo.',
  fuente: 'Cosmovisión de los pueblos de la Sierra Nevada · tradición indígena colombiana',
  preguntaPuente:
    'Durante milenios la humanidad imaginó otros mundos. ¿Cómo pasamos de imaginarlos a encontrarlos de verdad?',
};

const mapaRuta: EstacionMapa[] = [
  { numero: 1, iconos: ['🌱'], titulo: 'Los otros mundos de los abuelos', duracionMin: 5 },
  { numero: 2, iconos: ['📖'], titulo: 'El primer exoplaneta: 1995', duracionMin: 10 },
  { numero: 3, iconos: ['📖', '🔎'], titulo: 'De 8 a más de 6.000: ordena la historia', duracionMin: 12 },
  { numero: 4, iconos: ['📖', '🔎'], titulo: 'Mundos extraños y la exo-Tierra', duracionMin: 12 },
  { numero: 5, iconos: ['✏️'], titulo: 'El ritmo de los descubrimientos', duracionMin: 15 },
  { numero: 6, iconos: ['✅'], titulo: 'Pon a prueba lo que sabes', duracionMin: 8 },
  { numero: 7, iconos: ['✏️', '💭'], titulo: 'El titular del siglo + cierre', duracionMin: 13 },
];

const ordenarHistoria: DataOrdenar = {
  titulo: 'Ordena la historia del descubrimiento, del pasado al presente',
  instrucciones: 'Coloca los cinco hitos en orden cronológico, del más antiguo al más reciente.',
  pasos: [
    'Durante toda la historia, solo conocíamos los 8 planetas del Sistema Solar.',
    '1995: Michel Mayor y Didier Queloz descubren 51 Peg b, el primer exoplaneta.',
    'Año tras año, el conteo de exoplanetas crece sin parar.',
    '2019: Mayor y Queloz reciben el Premio Nobel de Física por ese descubrimiento.',
    'Hoy: se han hallado más de 6.000 exoplanetas, y siguen apareciendo.',
  ],
};

const emparejarMundos: DataEmparejar = {
  titulo: 'Relaciona cada mundo con lo que es',
  instrucciones: 'Conecta cada término con su descripción. Apóyate en lo que acabas de leer.',
  etiquetaIzq: 'Término',
  etiquetaDer: 'Qué es',
  pares: [
    { izquierda: 'Exoplaneta', derecha: 'Un planeta que orbita otra estrella, no el Sol' },
    { izquierda: '51 Peg b', derecha: 'El primer exoplaneta descubierto (1995)' },
    { izquierda: 'Júpiter caliente', derecha: 'Gigante gaseoso pegado a su estrella, abrasador' },
    { izquierda: 'Super-Tierra', derecha: 'Planeta rocoso mucho más grande que la Tierra' },
    { izquierda: 'Exo-Tierra', derecha: 'El gemelo ideal de la Tierra, aún no encontrado' },
  ],
};

const emparejarCriterios: DataEmparejar = {
  titulo: 'Los cuatro criterios de una exo-Tierra',
  instrucciones: 'Para ser un gemelo de la Tierra, un exoplaneta debe cumplir cuatro condiciones. Relaciona cada una con lo que asegura.',
  etiquetaIzq: 'Criterio',
  etiquetaDer: 'Qué garantiza',
  pares: [
    { izquierda: 'Orbita una estrella tipo G (como el Sol)', derecha: 'Una temperatura ni muy caliente ni muy fría' },
    { izquierda: 'Orbita a ~1 unidad astronómica', derecha: 'Una cantidad de luz parecida a la de la Tierra' },
    { izquierda: 'Radio parecido al de la Tierra (~6.400 km)', derecha: 'Un tamaño similar al de nuestro planeta' },
    { izquierda: 'Masa parecida a la de la Tierra', derecha: 'Una gravedad y densidad como las nuestras' },
  ],
};

const actividadCalculo: Actividad = {
  numero: 1,
  verbo: 'APLICA',
  titulo: 'Calcula el ritmo de los descubrimientos',
  tiempoMin: 15,
  modalidad: 'individual',
  pasos: [
    'En 1995 conocíamos 1 exoplaneta; hoy hay más de 6.000. Calcula cuántos años han pasado desde 1995 (usa el año actual).',
    'Saca el promedio de exoplanetas descubiertos por año: 6.000 ÷ esos años.',
    'Pasa ese número a por mes (÷ 12) y, aproximadamente, por semana (÷ 52).',
    'Escribe una frase: ¿qué dice ese ritmo sobre lo común que es que las estrellas tengan planetas?',
  ],
  cuaderno: {
    titulo: 'El ritmo de los descubrimientos',
    formato: 'tres operaciones + una frase de conclusión',
    extension: 'los 3 cálculos y la conclusión',
  },
  criterios: [
    'Te da alrededor de 200 exoplanetas por año.',
    'Eso son varios cada semana, de forma constante.',
    'Tu frase reconoce que tener planetas parece ser la norma de las estrellas, no la excepción.',
  ],
};

const actividadTitular: Actividad = {
  numero: 2,
  verbo: 'CREA',
  titulo: 'Escribe el titular del siglo',
  tiempoMin: 13,
  modalidad: 'individual',
  pasos: [
    'Imagina que mañana se anuncia el hallazgo de la primera exo-Tierra: un gemelo de nuestro planeta.',
    'Escribe el titular de prensa (una sola línea, potente y clara) y un primer párrafo de la noticia.',
    'Incluye en el párrafo al menos dos de los cuatro criterios que la convierten en exo-Tierra.',
  ],
  cuaderno: {
    titulo: 'El titular del siglo',
    formato: 'titular en una línea + un párrafo de noticia',
    extension: 'titular + 4 a 6 renglones',
  },
  criterios: [
    'El titular es claro y haría que cualquiera quiera leer la noticia.',
    'El párrafo menciona al menos 2 de los 4 criterios de exo-Tierra.',
    'Se entiende por qué ese descubrimiento sería histórico.',
  ],
};

const quiz: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Pon a prueba lo que sabes',
  instrucciones: 'Seis preguntas sobre lo que leíste. Recibirás una explicación en cada una.',
  preguntas: [
    {
      enunciado: '¿Qué es un exoplaneta?',
      opciones: [
        'Un planeta enano del Sistema Solar',
        'Un planeta que orbita una estrella distinta del Sol',
        'Una estrella muy pequeña y fría',
        'Un cometa con cola',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto: «exo» significa «fuera». Es un planeta de otro sistema, en torno a otra estrella.',
      feedbackIncorrecto: 'Un exoplaneta es un planeta que orbita OTRA estrella, fuera de nuestro Sistema Solar.',
    },
    {
      enunciado: '¿Quiénes descubrieron el primer exoplaneta y en qué año?',
      opciones: [
        'Galileo, en 1610',
        'Mayor y Queloz, en 1995',
        'Michel Mayor, en 2019',
        'La NASA, en 1969',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Exacto: Michel Mayor y Didier Queloz hallaron 51 Peg b en 1995.',
      feedbackIncorrecto: 'Fueron los suizos Michel Mayor y Didier Queloz, en 1995 (51 Peg b). El Nobel les llegó después, en 2019.',
    },
    {
      enunciado: '¿Por qué fue tan importante ese descubrimiento (Nobel 2019)?',
      opciones: [
        'Fue el primer planeta confirmado fuera del Sistema Solar',
        'Fue el planeta más grande jamás visto',
        'Demostró que el Sol tiene nueve planetas',
        'Encontró vida en otro planeta',
      ],
      respuestaIndex: 0,
      feedbackCorrecto: 'Sí: por primera vez se confirmó un planeta orbitando otra estrella como el Sol. Abrió toda una ciencia nueva.',
      feedbackIncorrecto: 'Su importancia es que fue el PRIMER exoplaneta confirmado en torno a una estrella como el Sol; por eso el Nobel de 2019.',
    },
    {
      enunciado: 'Un «Júpiter caliente» es…',
      opciones: [
        'Una estrella del tamaño de Júpiter',
        'Un gigante gaseoso muy cerca de su estrella, por eso abrasador',
        'Un planeta rocoso muy pequeño',
        'La luna más grande de Júpiter',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto: gigantes gaseosos pegados a su estrella. En nuestro Sistema Solar, en cambio, los gigantes están lejos y fríos.',
      feedbackIncorrecto: 'Es un gigante gaseoso (como Júpiter) pero pegadito a su estrella, así que es abrasador. No existe nada igual en nuestro sistema.',
    },
    {
      enunciado: '¿Qué es una «exo-Tierra»?',
      opciones: [
        'Cualquier exoplaneta rocoso',
        'Un exoplaneta gemelo de la Tierra que cumpla cuatro criterios (aún no hallado)',
        'La Tierra vista desde el espacio',
        'Una super-Tierra muy caliente',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Sí: es el gran objetivo. Debe cumplir 4 criterios (estrella tipo G, ~1 UA, radio y masa como la Tierra). Todavía no se ha encontrado ninguna.',
      feedbackIncorrecto: 'Es un exoplaneta que cumpliría los 4 criterios para ser gemelo de la Tierra (estrella, distancia, radio y masa). Aún no se ha hallado ninguna.',
    },
    {
      enunciado: 'Aproximadamente, ¿cuántos exoplanetas se han descubierto desde 1995?',
      opciones: ['Unos 50', 'Unos 500', 'Más de 6.000', 'Exactamente 8'],
      respuestaIndex: 2,
      feedbackCorrecto: 'Correcto: más de 6.000, y cada día aparecen más. Casi cada estrella parece tener planetas.',
      feedbackIncorrecto: 'Van más de 6.000, y siguen apareciendo. Es probable que casi todas las estrellas tengan su propio sistema planetario.',
    },
  ],
};

const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'Buscar otros mundos es, en el fondo, preguntarnos por el otro: por lo distinto a nosotros.',
    preguntaEspejo:
      'Si encontráramos vida muy distinta a la nuestra, ¿la respetaríamos como diferente, o querríamos que se pareciera a nosotros?',
  },
  estoico: {
    autor: 'Marco Aurelio',
    lente: 'lente del cuidado interior',
    cita: 'Todas las cosas están entretejidas unas con otras, y el lazo que las une es sagrado.',
    preguntaEspejo:
      'Si hay miles de millones de mundos, ¿eso me hace insignificante, o me hace parte de algo inmenso?',
  },
  floridi: {
    autor: 'Luciano Floridi',
    lente: 'lente de la infoesfera',
    cita: 'Cada mundo nuevo que nombramos amplía la información con la que entendemos quiénes somos.',
    preguntaEspejo:
      'Descubrir 6.000 mundos cambió nuestra idea de estar solos. ¿Qué otra información nueva podría cambiar lo que creo de mí?',
  },
};

const cincoDimensiones: CincoDimensiones = {
  personal:
    'Antes pensabas en 8 planetas; ahora sabes que hay miles de mundos y que buscar otra Tierra es una de las grandes aventuras de la ciencia actual.',
  emocional:
    'Saber que quizá no estamos solos puede emocionar o inquietar. La ciencia toma esa pregunta enorme y la convierte en una búsqueda paciente y rigurosa.',
  ciudadana:
    'Descubrir exoplanetas es trabajo de equipos de muchos países que comparten datos abiertos. La gran ciencia se construye en común.',
  local:
    'Colombia también participa en esa búsqueda: estudiantes y astrónomos del país —y tu Semillero Betelgeuse— miran el mismo cielo que Mayor y Queloz.',
  intergeneracional:
    'Tus abuelos imaginaban otros mundos; tu generación los está encontrando. La siguiente, quizá, encuentre vida en alguno de ellos.',
};
---

<BaseLayout
  title="Estación 3 · El descubrimiento del primer exoplaneta — Salomé · ConectaTE"
  description="Qué es un exoplaneta, cómo Mayor y Queloz descubrieron el primero (51 Peg b, 1995, Nobel 2019), la diversidad de mundos y los cuatro criterios de una exo-Tierra. Estación del programa Salomé adaptada al modelo MILC."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <div class="max-w-3xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <a href={`${base}/explora/salome`} class="hover:opacity-60 transition-opacity">Salomé</a>
        <span>/</span>
        <span style="color: var(--fg);">Estación 3</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-pink text-white mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">Estación 3 · Tomo 1</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">Exoplanetas</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">~75 min</span>
        </div>
        <h1 class="heading-giant text-balance mb-3">El descubrimiento del primer exoplaneta</h1>
        <p class="text-base md:text-lg font-semibold opacity-95 leading-relaxed">
          Cómo la humanidad pasó de imaginar otros mundos a encontrarlos — más de
          6.000 y contando — y qué haría falta para hallar una segunda Tierra.
        </p>
      </div>

      <!-- 🌱 Saber ancestral -->
      <SaberAncestralBlock data={saberAncestral} />

      <!-- 🗺 Ruta -->
      <MapaRutaBlock estaciones={mapaRuta} />

      <!-- Propósito -->
      <div class="bento-card mb-6">
        <span class="chip-bento mb-4">🎯 Lo que vas a poder hacer</span>
        <ul class="space-y-3 mt-3">
          {[
            'IDENTIFICAR qué es un exoplaneta y cuál fue el primero descubierto.',
            'EXPLICAR por qué el hallazgo de Mayor y Queloz mereció el Nobel.',
            'RELACIONAR los tipos de mundos y ORDENAR la historia del descubrimiento.',
            'APLICAR un cálculo para medir el ritmo al que hallamos nuevos mundos.',
            'CREAR la noticia del día que se descubra una segunda Tierra.',
          ].map((d) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">✓</span>
              <span class="text-sm md:text-base leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Pregunta detonante -->
      <div class="bento-card-color bg-bento-cyan mb-10">
        <span class="chip-bento mb-3 bg-black/10">💡 La pregunta que abre todo</span>
        <p class="text-lg md:text-xl font-black leading-snug">
          Durante toda la historia humana solo conocíamos 8 planetas. En 1995
          encontramos el primero alrededor de otra estrella. Hoy van más de 6.000.
          ¿Y si cada estrella que ves tuviera sus propios mundos?
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          Guarda la pregunta. Al terminar vas a entender cómo los encontramos y qué
          buscamos de verdad: otra Tierra.
        </p>
      </div>

      <!-- 👁 Observa · video de RECA -->
      <VideoSesion data={video} />
      <GuiasRECA modulo={3} />

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        El video te dio el panorama. Ahora vas a entenderlo con calma, empezando por
        el momento que lo cambió todo: 1995.
      </p>

      <!-- 📖 LEE 1 · El primer exoplaneta -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · El primer exoplaneta</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            Hasta hace muy poco, la humanidad solo conocía los <strong>ocho planetas</strong> de
            nuestro Sistema Solar. Eso cambió en <strong>1995</strong>: dos investigadores suizos,
            <strong>Michel Mayor y Didier Queloz</strong>, descubrieron el primer planeta que orbita
            <strong>otra estrella</strong>, distinta del Sol. A un planeta así lo llamamos
            <strong>exoplaneta</strong> («exo» significa «fuera»).
          </p>
          <p>
            Ese primer exoplaneta se llama <strong>51 Peg b</strong>, porque gira alrededor de la
            estrella 51 Peg (la misma que conociste en la Ficha 2 y su nomenclatura «b»). El
            hallazgo fue tan importante —abrió toda una ciencia nueva— que en <strong>2019</strong> Mayor
            y Queloz recibieron el <strong>Premio Nobel de Física</strong>.
          </p>
        </div>
      </section>

      <!-- 📖 LEE 2 · La explosión de descubrimientos -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · De ocho a más de seis mil</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            Desde aquel 1995, los descubrimientos no han parado: hoy se han hallado
            <strong>más de 6.000 exoplanetas</strong>, y cada día aparecen nuevos. Todo indica que
            <strong>casi cada estrella del cielo tiene su propio sistema planetario</strong>. En un
            momento vas a ordenar esa historia, desde los 8 planetas de siempre hasta hoy.
          </p>
        </div>
      </section>

      <!-- 🔎 Ordena la historia -->
      <div class="mb-6">
        <LabOrdenar data={ordenarHistoria} id="ordena-historia" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        No solo son muchos: son rarísimos. Y entre tanta variedad, buscamos uno muy especial.
      </p>

      <!-- 📖 LEE 3 · Mundos extraños y la exo-Tierra -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · Mundos extraños… y la exo-Tierra</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            Estos mundos nuevos rebosan de variedad. Hay <strong>Júpiteres calientes</strong>:
            gigantes gaseosos pegaditos a su estrella, abrasadores —al revés de nuestro
            sistema, donde los gigantes están lejos y fríos—. Hay <strong>super-Tierras</strong>:
            planetas rocosos mucho más grandes que la Tierra, algo que aquí no existe. Y los
            hay aún más extraños: tan calientes que podría «llover hierro».
          </p>
          <p>
            Pero el gran objetivo es encontrar una <strong>exo-Tierra</strong>: un gemelo de nuestro
            planeta. Para serlo debe cumplir <strong>cuatro criterios</strong>: orbitar una estrella tipo
            G (como el Sol), estar a una distancia de <strong>1 unidad astronómica</strong> (la que hay
            entre la Tierra y el Sol), tener un <strong>radio</strong> parecido al de la Tierra (~6.400 km)
            y una <strong>masa</strong> parecida. <strong>Hasta hoy, ningún exoplaneta cumple los cuatro.</strong>
          </p>
        </div>
      </section>

      <!-- 🔎 Relaciona mundos -->
      <div class="mb-6">
        <LabEmparejar data={emparejarMundos} id="empareja-mundos" />
      </div>

      <!-- 🔎 Relaciona los criterios -->
      <div class="mb-6">
        <LabEmparejar data={emparejarCriterios} id="empareja-criterios" />
      </div>

      <!-- ✅ Quiz -->
      <div class="mb-6">
        <LabQuiz data={quiz} id="salome-exoplanetas-quiz" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Dijimos «más de 6.000 desde 1995». ¿Es eso mucho o poco? Mídelo tú.
      </p>

      <!-- ✏️ Actividad de cálculo -->
      <ActividadBlock data={actividadCalculo} />

      <!-- ✏️ Actividad CREA -->
      <ActividadBlock data={actividadTitular} />

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Encontramos miles de mundos. Cerremos pensando qué significa, para nosotros, no estar solos.
      </p>
      </div>

      <!-- 💭 Triángulo (ancho completo) -->
      <TrianguloBlock data={triangulo} />

      <!-- 🌱 Cinco dimensiones (ancho completo) -->
      <CincoDimensionesBlock data={cincoDimensiones} />

      <div class="max-w-3xl mx-auto">
      <!-- Créditos -->
      <div class="bento-card mb-10 border-l-4 border-bento-purple">
        <span class="chip-bento mb-3">🛰 Créditos</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          Esta estación adapta al modelo MILC los conceptos del Módulo 3 («¿Qué es un
          exoplaneta?») del proyecto <strong style="color: var(--fg);">Salomé: investigación de exoplanetas</strong>, de la
          Association Ágora de Hipatia (Suiza), ejecutado en Colombia por
          <strong style="color: var(--fg);">RECA</strong>. El cómic y las fichas originales son de sus autores.
        </p>
        <a href={recursosOficiales} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 font-black text-sm text-bento-blue hover:opacity-70 transition-opacity">
          Leer el cómic y ver el material oficial
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Navegación entre estaciones -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

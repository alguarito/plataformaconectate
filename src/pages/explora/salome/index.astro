---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

// Enlaces oficiales del proyecto (RECA / Ágora de Hipatia)
const ENLACES = {
  recursos: 'https://www.astroreca.org/educacion/salome-comic-exoplanetas/recursos',
  sitio: 'https://www.astroreca.org',
  charlas: 'https://forms.gle/4sv9DMmoGCDxsEP58',
};

// Ruta del programa: 2 tomos × 4 módulos. El módulo "estrellas" es el piloto activo.
const tomos = [
  {
    numero: 1,
    titulo: 'Tomo 1 · El cielo y los primeros mundos',
    modulos: [
      { n: 1, nombre: 'Con la cabeza en las estrellas', tema: 'Estrellas', estado: 'activo', href: `${base}/explora/salome/estrellas` },
      { n: 2, nombre: 'Descubramos otros mundos', tema: 'Planetas', estado: 'activo', href: `${base}/explora/salome/planetas` },
      { n: 3, nombre: 'El descubrimiento del primer exoplaneta', tema: 'Exoplanetas', estado: 'activo', href: `${base}/explora/salome/exoplanetas` },
      { n: 4, nombre: 'Instrumentos', tema: 'Métodos de detección', estado: 'activo', href: `${base}/explora/salome/metodos` },
      { n: 5, nombre: 'Laboratorio: caza tu exoplaneta', tema: 'Práctica integradora + examen', estado: 'activo', href: `${base}/explora/salome/laboratorio`, laboratorio: true },
    ],
  },
  {
    numero: 2,
    titulo: 'Tomo 2 · La luz y la vida',
    modulos: [
      { n: 1, nombre: 'Una perspectiva diferente sobre la luz', tema: 'Naturaleza de la luz', estado: 'activo', href: `${base}/explora/salome/luz` },
      { n: 2, nombre: 'Los colores del arcoíris', tema: 'Espectro y color', estado: 'activo', href: `${base}/explora/salome/colores` },
      { n: 3, nombre: 'Señales de vida en la atmósfera', tema: 'Atmósferas planetarias', estado: 'activo', href: `${base}/explora/salome/atmosfera` },
      { n: 4, nombre: 'El viaje de un rayo de luz', tema: 'La luz como mensajera', estado: 'activo', href: `${base}/explora/salome/viaje-luz` },
      { n: 5, nombre: '#YoSoyPegasus', tema: 'Ciencia y comunidad', estado: 'proximamente' },
    ],
  },
];
---

<BaseLayout
  title="Salomé · Investigación de exoplanetas — Explora · ConectaTE"
  description="Salomé es un cómic científico de Ágora de Hipatia, ejecutado en Colombia por RECA, para descubrir estrellas, planetas y exoplanetas. Adaptado al modelo MILC con saberes del cielo colombiano."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <span style="color: var(--fg);">Salomé</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-purple text-white mb-10 min-h-[340px] flex flex-col justify-between">
        <div class="flex items-start justify-between flex-wrap gap-3">
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">🪐 Astronomía</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Exoplanetas</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Piloto 2026</span>
          </div>
          <span class="text-8xl md:text-9xl leading-none" aria-hidden="true">🪐</span>
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">Programa · Explora</span>
          <h1 class="heading-giant text-balance mt-2 mb-4">Salomé: investigación de exoplanetas</h1>
          <p class="text-base md:text-lg font-semibold opacity-95 max-w-3xl leading-relaxed">
            Acompaña a Salomé en una historieta que te lleva del Observatorio de
            Ginebra a los confines de la galaxia, mientras aprendes a pensar como
            un científico — y a mirar el cielo desde Colombia.
          </p>
        </div>
      </div>

      <!-- CTA principal -->
      <a
        href={`${base}/explora/salome/estrellas`}
        class="bento-card-color bg-bento-lime flex items-center gap-4 mb-10 hover:scale-[1.01] transition-transform group"
      >
        <div class="text-5xl shrink-0" aria-hidden="true">✨</div>
        <div class="flex-1">
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">Estación 1 · Disponible</span>
          <div class="font-black text-xl leading-tight mt-1">Con la cabeza en las estrellas</div>
          <div class="text-sm opacity-80 mt-1">Saber ancestral · conceptos · laboratorio · cierre filosófico</div>
        </div>
        <svg class="w-7 h-7 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>

      <!-- Qué es el programa -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-4">De qué se trata</span>
        <p class="text-base md:text-lg leading-relaxed mb-5">
          <strong>Salomé</strong> es un cómic científico que usa la aventura de un
          grupo de niños para explicar, página a página, cómo funciona el universo:
          qué es una estrella, cómo se descubren planetas alrededor de otros soles y
          cómo sabríamos si alguno se parece a la Tierra. No es solo lectura: cada
          módulo se acompaña de actividades para pensar como investigador.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-2">
          {[
            { i: '🔬', t: 'Iniciar en el método científico de forma lúdica.' },
            { i: '🌍', t: 'Tender puentes entre la escuela y la comunidad científica.' },
            { i: '👩‍🚀', t: 'Reducir la brecha de género: protagonistas mayoritariamente femeninas.' },
            { i: '🇨🇴', t: 'Visibilizar la astronomía colombiana, desde Cartago al país.' },
          ].map((o) => (
            <div class="flex items-start gap-3 p-3 rounded-bento-sm" style="background: var(--bg);">
              <span class="text-2xl shrink-0" aria-hidden="true">{o.i}</span>
              <span class="text-sm leading-relaxed">{o.t}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Ruta del programa: 2 tomos × 4 módulos -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge">La ruta del programa</h2>
          <span class="chip-bento">2 tomos · módulos + laboratorio</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          {tomos.map((tomo) => (
            <div class="bento-card">
              <h3 class="font-black text-lg leading-tight mb-4">{tomo.titulo}</h3>
              <ol class="space-y-2">
                {tomo.modulos.map((m) => {
                  const activo = m.estado === 'activo';
                  const esLab = !!(m as any).laboratorio;
                  const Inner = (
                    <div class="flex items-center gap-3 p-3 rounded-bento-sm border-2" style={`border-color: ${esLab ? '#A3FF12' : 'var(--border)'}; ${activo ? 'background: var(--bg);' : ''}`}>
                      <span class:list={['w-8 h-8 rounded-full flex items-center justify-center text-xs font-black shrink-0', activo ? 'bg-bento-lime text-neutral-950' : '']} style={!activo ? 'background: var(--bg); color: var(--fg-muted); border: 1px solid var(--border);' : ''}>
                        {m.n}
                      </span>
                      <div class="flex-1 min-w-0">
                        <div class="font-bold text-sm leading-tight">{m.nombre}</div>
                        <div class="text-xs mt-0.5" style="color: var(--fg-muted);">{m.tema}</div>
                      </div>
                      {activo ? (
                        <span class="text-[10px] font-black uppercase tracking-widest px-2 py-1 rounded-full bg-bento-lime text-neutral-950 shrink-0">{esLab ? 'Laboratorio' : 'Abrir'}</span>
                      ) : (
                        <span class="text-[10px] font-black uppercase tracking-widest shrink-0" style="color: var(--fg-muted);">Pronto</span>
                      )}
                    </div>
                  );
                  return (
                    <li>
                      {activo ? (
                        <a href={m.href} class="block hover:opacity-80 transition-opacity">{Inner}</a>
                      ) : (
                        Inner
                      )}
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
        </div>
      </section>

      <!-- Créditos / aliados -->
      <div class="bento-card mb-10 border-l-4 border-bento-purple">
        <span class="chip-bento mb-4">🛰 Quién hace Salomé</span>
        <div class="space-y-4 mt-2">
          <div>
            <h3 class="font-black text-base">Association Ágora de Hipatia <span class="font-semibold" style="color: var(--fg-muted);">· Suiza</span></h3>
            <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
              Asociación de divulgación científica que crea el cómic <em>Salomé</em> y su material pedagógico.
            </p>
          </div>
          <div>
            <h3 class="font-black text-base">RECA <span class="font-semibold" style="color: var(--fg-muted);">· Red de Estudiantes Colombianos en Astronomía</span></h3>
            <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
              Adapta el contenido al español y coordina la ejecución del proyecto en colegios de Colombia.
            </p>
          </div>
          <div>
            <h3 class="font-black text-base">Aval científico</h3>
            <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
              Contenido validado por astrofísicos, entre ellos <strong style="color: var(--fg);">Michel Mayor</strong>, Premio Nobel de Física y descubridor del primer exoplaneta. Con apoyo de Europlanet, PlanetS y el Observatorio de Ginebra.
            </p>
          </div>
        </div>
        <p class="text-xs leading-relaxed mt-5 pt-4 border-t" style="border-color: var(--border); color: var(--fg-muted);">
          El cómic y las fichas originales son propiedad de sus autores. En ConectaTE
          adaptamos los <strong style="color: var(--fg);">conceptos científicos</strong> al modelo pedagógico MILC, con
          crédito a RECA y a Ágora de Hipatia, y enlace al material oficial.
        </p>
      </div>

      <!-- Recursos oficiales + semillero -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
        <a href={ENLACES.recursos} target="_blank" rel="noopener" class="bento-card-hover flex flex-col gap-2">
          <span class="text-3xl" aria-hidden="true">📚</span>
          <span class="font-black leading-tight">Recursos oficiales RECA</span>
          <span class="text-xs leading-relaxed" style="color: var(--fg-muted);">Guías, videos y material para docentes en astroreca.org</span>
        </a>
        <a href={ENLACES.charlas} target="_blank" rel="noopener" class="bento-card-hover flex flex-col gap-2">
          <span class="text-3xl" aria-hidden="true">🎓</span>
          <span class="font-black leading-tight">Astronomía va a tu colegio</span>
          <span class="text-xs leading-relaxed" style="color: var(--fg-muted);">Invita a un astrofísico a dar una charla en tu clase</span>
        </a>
        <div class="bento-card-color bg-bento-orange flex flex-col gap-2">
          <span class="text-3xl" aria-hidden="true">⭐</span>
          <span class="font-black leading-tight">Semillero Betelgeuse</span>
          <span class="text-xs leading-relaxed opacity-90">El semillero de astronomía de tu colegio. Pregúntale al profe Álvaro cómo unirte.</span>
        </div>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver a</div>
          <div class="font-black text-lg">Explora</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabEspectroscopio from '../../../../components/LabEspectroscopio.astro';
import LabBiofirmas from '../../../../components/LabBiofirmas.astro';
import LabCieloCartago from '../../../../components/LabCieloCartago.astro';
import LabCorrimientoRojo from '../../../../components/LabCorrimientoRojo.astro';
import type { Actividad } from '../../../../data/guiasContenido/_schema';
import type { DataEspectroscopio } from '../../../../components/LabEspectroscopio.astro';
import type { DataBiofirmas } from '../../../../components/LabBiofirmas.astro';
import type { DataCieloCartago } from '../../../../components/LabCieloCartago.astro';
import type { DataCorrimientoRojo } from '../../../../components/LabCorrimientoRojo.astro';

const base = import.meta.env.BASE_URL;
const recursosOficiales = 'https://www.astroreca.org/educacion/salome-comic-exoplanetas/recursos';

const espectroscopio: DataEspectroscopio = {
  titulo: 'Descubre de qué están hechas dos estrellas',
  instrucciones:
    'Cada estrella esconde su receta en la luz. Superpón la huella de cada elemento: si TODAS sus líneas punteadas caen sobre líneas negras, ese elemento está en la estrella. Luego marca tu dictamen y comprueba. Analiza las dos estrellas.',
};

const biofirmas: DataBiofirmas = {
  titulo: 'Caza biofirmas en tres mundos lejanos',
  instrucciones:
    'Tres exoplanetas transitaron frente a su estrella y el telescopio registró su espectro de transmisión. Superpón las bandas de cada molécula: si caen sobre picos, esa molécula está en la atmósfera. Detecta las moléculas, emite tu dictamen de habitabilidad y comprueba. Analiza los tres planetas.',
};

const corrimiento: DataCorrimientoRojo = {
  titulo: 'Mide la expansión del universo',
  instrucciones:
    'El espectro de esta galaxia trae la huella del hidrógeno —la misma que ya conoces—, pero corrida hacia el rojo. Aleja la galaxia con el control y observa: cuanto más lejos, más rápido huye y más se estira su luz. Lleva Hα hasta la frontera del infrarrojo.',
};

const cieloCartago: DataCieloCartago = {
  titulo: 'Enciende los arreboles del Valle',
  instrucciones:
    'Mueve el sol del mediodía al atardecer y observa el cielo: mientras más bajo está el sol, más aire cruza su luz y más azul se pierde por el camino. Encuentra a qué altura del sol se encienden los arreboles que leían los abuelos.',
};

const actividadInforme: Actividad = {
  numero: 1,
  verbo: 'ANALIZA',
  titulo: 'Escribe tu informe de espectroscopista',
  tiempoMin: 12,
  modalidad: 'individual',
  pasos: [
    'Analiza la Estrella A en el espectroscopio: prueba los cinco elementos, uno por uno.',
    'Registra en una tabla qué elementos están presentes y cuáles ausentes, con su evidencia (qué líneas, en nm, coinciden o no).',
    'Repite el análisis completo con la Estrella B.',
    'Cierra con una conclusión: ¿en qué se diferencian las dos estrellas y qué tipo de estrella crees que es cada una?',
  ],
  cuaderno: {
    titulo: 'Informe de espectroscopista',
    formato: 'tabla 5×3 por estrella (elemento · presente/ausente · evidencia en nm) + conclusión',
    extension: 'las 2 tablas y 3 a 4 renglones de conclusión',
  },
  criterios: [
    'Tu tabla de la Estrella A reporta presentes el hidrógeno, el sodio y el calcio.',
    'Tu tabla de la Estrella B reporta presentes el hidrógeno y el helio.',
    'Cada dictamen tiene su evidencia: las líneas (en nm) que coinciden o no.',
    'Tu conclusión compara las dos estrellas con tus palabras.',
  ],
};

const actividadInventa: Actividad = {
  numero: 2,
  verbo: 'CREA',
  titulo: 'Inventa una estrella y cifra su mensaje',
  tiempoMin: 14,
  modalidad: 'parejas',
  pasos: [
    'Inventa una estrella: ponle nombre y elige en secreto 2 o 3 elementos de los del laboratorio (H, He, Na, Ca, Mg).',
    'Dibuja en tu cuaderno su espectro: una banda del violeta al rojo con el eje en nm (380 a 700), y traza las líneas negras de TUS elementos en sus posiciones correctas.',
    'Intercambia el dibujo con tu pareja: cada uno decodifica la estrella del otro usando las huellas del laboratorio.',
    'Verifiquen juntos: ¿acertaron? ¿Qué línea fue la más difícil de leer?',
  ],
  cuaderno: {
    titulo: 'Mi estrella cifrada',
    formato: 'dibujo del espectro con eje en nm + composición secreta + decodificación de la estrella de tu pareja',
    extension: 'el dibujo y 3 a 4 renglones',
  },
  criterios: [
    'Las líneas de tu espectro están en las posiciones correctas (±10 nm).',
    'Tu pareja pudo decodificar tu estrella solo con el dibujo.',
    'Decodificaste la estrella de tu pareja citando la evidencia.',
  ],
};

const microCierre = [
  'La luz de una estrella, abierta en su espectro, trae líneas negras: los colores que sus gases absorbieron.',
  'Cada elemento químico deja siempre las mismas líneas: su huella digital.',
  'Si todas las líneas de un elemento aparecen en el espectro, ese elemento está en la estrella.',
  'Cuando un planeta transita, su atmósfera deja picos en el espectro de transmisión: así se leen sus gases a contraluz.',
  'O₂ y CH₄ juntos se destruyen entre sí: si coexisten, algo los repone. Esa es la biofirma que caza el James Webb.',
  'Las líneas de una galaxia lejana llegan corridas al rojo: cuanto más lejos, más rápido huye — el universo se expande, y por eso el Webb mira en infrarrojo.',
  'El cielo azul y los arreboles son la misma física: el aire dispersa el azul, y al atardecer la luz cruza tanto aire que solo sobreviven los rojos.',
  'Así supimos de qué está hecho el universo sin viajar a ninguna estrella — y así se buscan señales de vida en otros mundos.',
];
---

<BaseLayout
  title="Tomo 2 · Laboratorio · Descifra la luz de las estrellas — Salomé · ConectaTE"
  description="Laboratorio interactivo de la luz: descubre la composición de dos estrellas, caza biofirmas en tres exoplanetas, mide la expansión del universo con el corrimiento al rojo y enciende los arreboles del Valle. Cierre práctico del Tomo 2 del programa Salomé."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <div class="max-w-3xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <a href={`${base}/explora/salome`} class="hover:opacity-60 transition-opacity">Salomé</a>
        <span>/</span>
        <span style="color: var(--fg);">Tomo 2 · Laboratorio</span>
      </nav>

      <!-- Hero (lime: la firma visual de los laboratorios) -->
      <div class="bento-card-color bg-bento-lime mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/10" style="color: #1a1a1a;">🔬 Laboratorio · Tomo 2</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/10" style="color: #1a1a1a;">Espectroscopía</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/10" style="color: #1a1a1a;">~100 min</span>
        </div>
        <h1 class="heading-giant text-balance mb-3" style="color: #1a1a1a;">Descifra la luz de las estrellas</h1>
        <p class="text-base md:text-lg font-semibold leading-relaxed" style="color: #1a1a1a; opacity: 0.85;">
          En el Tomo 2 aprendiste que la luz trae un mensaje cifrado. Hoy lo vas a
          leer tú mismo: descubrirás de qué están hechas dos estrellas, cazarás
          señales de vida en tres mundos lejanos, medirás la expansión del universo
          y encenderás los arreboles del Valle — todo con la misma herramienta: la luz.
        </p>
      </div>

      <!-- Propósito -->
      <div class="bento-card mb-6">
        <span class="chip-bento mb-4">🎯 Lo que vas a poder hacer</span>
        <ul class="space-y-3 mt-3">
          {[
            'IDENTIFICAR las líneas de absorción en el espectro de una estrella.',
            'ANALIZAR la composición de dos estrellas comparando huellas de elementos.',
            'APLICAR el criterio del astrónomo: un elemento está si TODAS sus líneas coinciden.',
            'EVALUAR si la atmósfera de un exoplaneta trae señales de vida (biofirmas).',
            'INTERPRETAR el corrimiento al rojo como la huella de un universo en expansión.',
            'EXPLICAR por qué el cielo es azul al mediodía y rojo al atardecer — los arreboles.',
            'CREAR tu propia estrella cifrada para que otro la decodifique.',
          ].map((d) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">✓</span>
              <span class="text-sm md:text-base leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- 📖 Recuerda -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Recuerda · Las huellas en la luz</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            Esto lo aprendiste en las estaciones 2 y 3; aquí está el resumen que
            necesitas para trabajar. La luz blanca de una estrella, abierta con un
            prisma, muestra su <strong>espectro</strong>: el arcoíris completo del violeta
            (380 nm, más energía) al rojo (700 nm, menos energía). Pero los
            <strong>gases</strong> de la estrella absorben colores muy precisos, y donde falta
            un color queda una <strong>línea negra</strong>.
          </p>
          <p>
            La clave es que cada elemento químico absorbe <strong>siempre los mismos
            colores</strong>: el hidrógeno deja sus líneas en 656, 486 y 434 nm; el sodio en
            589; el helio en 668 y 447. Son su <strong>huella digital</strong>. El criterio del
            astrónomo es estricto: un elemento está presente solo si
            <strong>todas</strong> sus líneas aparecen en el espectro — con una sola no basta,
            porque podría ser de otro gas.
          </p>
        </div>
      </section>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Tienes el método. Ahora, el cielo: dos estrellas esperan tu análisis.
      </p>

      <!-- 🔬 El laboratorio -->
      <div class="mb-6">
        <LabEspectroscopio data={espectroscopio} id="lab-espectro-tomo2" />
      </div>

      <!-- ✏️ Actividad ANALIZA -->
      <ActividadBlock data={actividadInforme} />

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Ya lees estrellas como un espectroscopista. Sube la apuesta: ahora el
        objetivo no es saber de qué está hecho un sol… sino si un planeta respira.
      </p>

      <!-- 📖 Recuerda · biofirmas -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Recuerda · El aire de un mundo, leído a contraluz</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            Esto viene de la estación 3. Cuando un exoplaneta <strong>transita</strong>, una
            pizca de la luz de su estrella atraviesa su atmósfera, y los gases le
            roban colores. El telescopio registra el <strong>espectro de transmisión</strong>:
            una curva que muestra cuánta luz se bloquea en cada longitud de onda. Donde
            un gas absorbe, la curva forma un <strong>pico</strong>. El James Webb mira en el
            <strong>infrarrojo</strong> (la luz invisible del módulo 1), porque ahí dejan sus
            bandas el agua, el CO₂ y el metano.
          </p>
          <p>
            Y el criterio de la cacería: el <strong>O₂ y el CH₄ se destruyen entre sí</strong>.
            Si aparecen <strong>juntos</strong> en una atmósfera, algo los está reponiendo —
            quizá vida. Eso es una <strong>biofirma</strong>: un indicio serio, nunca una prueba.
            Agua sola = quizá habitable. Solo CO₂ = un Venus. O₂ + CH₄ + agua = candidato
            para mirar con lupa.
          </p>
        </div>
      </section>

      <!-- 🛰 El laboratorio de biofirmas -->
      <div class="mb-6">
        <LabBiofirmas data={biofirmas} id="lab-biofirmas-tomo2" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Queda una pregunta de fondo: ¿qué le pasa a la luz cuando su viaje dura
        millones de años? La respuesta es el descubrimiento más grande de la
        astronomía del siglo XX.
      </p>

      <!-- 📖 Recuerda · corrimiento al rojo -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Recuerda · La luz que viaja en un universo que se estira</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            En la estación 4 viste que la luz de las galaxias más lejanas llega un poco
            <strong>estirada hacia el rojo</strong>. Aquí está la historia completa: en 1929,
            <strong>Edwin Hubble</strong> comparó los espectros de muchas galaxias y notó que la
            huella del hidrógeno —las mismas líneas que tú ya sabes leer— aparecía
            <strong>corrida hacia el rojo</strong> en todas… y más corrida cuanto más lejana la galaxia.
          </p>
          <p>
            La explicación cambió la ciencia: <strong>el espacio mismo se está expandiendo</strong>,
            y al estirarse, estira la luz que viaja por él. Medir ese corrimiento
            (la letra <strong>z</strong>) es medir a qué velocidad huye la galaxia y, con la ley
            de Hubble, qué tan lejos está. Compruébalo tú mismo.
          </p>
        </div>
      </section>

      <!-- 🌌 El laboratorio de corrimiento al rojo -->
      <div class="mb-6">
        <LabCorrimientoRojo data={corrimiento} id="lab-corrimiento-tomo2" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Del espacio profundo, vuelve al patio de tu casa: la última prueba de todo lo
        que aprendiste está en el cielo que ves todas las tardes.
      </p>

      <!-- 📖 Recuerda · por qué el cielo es azul -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Recuerda · Por qué el cielo es azul (y los atardeceres rojos)</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            Esto cierra el círculo con el saber ancestral del tomo. Las moléculas del
            aire <strong>dispersan</strong> la luz del sol, pero no a todos los colores por
            igual: <strong>desvían mucho más las ondas cortas (el azul)</strong> que las largas
            (el rojo). Al mediodía, ese azul desviado rebota por toda la bóveda — por
            eso el cielo entero se ve <strong>azul</strong>.
          </p>
          <p>
            Al atardecer, el sol entra de lado y su luz cruza <strong>muchísimo más
            aire</strong> —hasta <strong>38 veces más</strong> que al mediodía—. En un camino tan
            largo, el azul se dispersa casi por completo antes de llegar a tus ojos, y
            solo sobreviven los <strong>naranjas y rojos</strong>: los <strong>arreboles</strong> que los
            abuelos del Valle leían para anticipar el clima. El mismo principio con el
            que acabas de cazar biofirmas: la luz que cruza un aire sale contando lo
            que encontró en el camino.
          </p>
        </div>
      </section>

      <!-- 🌇 El laboratorio del cielo -->
      <div class="mb-6">
        <LabCieloCartago data={cieloCartago} id="lab-cielo-tomo2" />
      </div>

      <!-- ✏️ Actividad CREA -->
      <ActividadBlock data={actividadInventa} />

      <!-- Micro-cierre -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-4">🎒 Lo que te llevas de este laboratorio</span>
        <ul class="space-y-3 mt-3">
          {microCierre.map((c) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">★</span>
              <span class="text-sm md:text-base leading-relaxed">{c}</span>
            </li>
          ))}
        </ul>
      </div>
      </div>

      <div class="max-w-3xl mx-auto">
      <!-- Créditos -->
      <div class="bento-card mb-10 border-l-4 border-bento-purple">
        <span class="chip-bento mb-3">🛰 Sobre este laboratorio</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          Práctica integradora del <strong style="color: var(--fg);">Tomo 2</strong> del programa
          <strong style="color: var(--fg);">Salomé: investigación de exoplanetas</strong> (Association Ágora de
          Hipatia · ejecutado en Colombia por <strong style="color: var(--fg);">RECA</strong>), adaptado al modelo
          MILC. Las longitudes de onda de las huellas son las reales de cada elemento.
        </p>
        <a href={recursosOficiales} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 font-black text-sm text-bento-blue hover:opacity-70 transition-opacity">
          Leer el cómic y ver el material oficial
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora/salome`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al programa</div>
          <div class="font-black text-lg">Salomé</div>
        </div>
      </a>
      </div>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabCurvaLuz from '../../../../components/LabCurvaLuz.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataCurvaLuz } from '../../../../components/LabCurvaLuz.astro';

const base = import.meta.env.BASE_URL;

const saberAncestral: SaberAncestral = {
  saber:
    'Mucho antes de las hojas de cálculo, los campesinos llevaban la cuenta de todo: cuántas lunas faltaban para sembrar, qué días llovió, cuánto rindió cada cosecha. Algunos lo anotaban en una libreta gastada; otros lo guardaban en la memoria y en los refranes. Esa costumbre de registrar, comparar y sacar conclusiones a partir de los números es la raíz de lo que hoy llamamos análisis de datos. No hacía falta un laboratorio: hacía falta paciencia y método. Hoy te toca hacer exactamente eso, pero con la luz de una estrella.',
  fuente: 'Saber campesino del registro · tradición popular',
  preguntaPuente:
    'Los abuelos sacaban conclusiones de sus cuentas. ¿Qué le puedes sacar tú a la cuenta del brillo de una estrella?',
};

const mapaRuta: EstacionMapa[] = [
  { numero: 1, iconos: ['🌱'], titulo: 'La cuenta de los abuelos', duracionMin: 5 },
  { numero: 2, iconos: ['📖'], titulo: 'Recuerda: el método de tránsito', duracionMin: 5 },
  { numero: 3, iconos: ['🔎'], titulo: 'Explora la curva de luz', duracionMin: 12 },
  { numero: 4, iconos: ['✏️'], titulo: 'Mide el planeta escondido', duracionMin: 20 },
  { numero: 5, iconos: ['✏️'], titulo: 'Tu informe de descubrimiento', duracionMin: 15 },
  { numero: 6, iconos: ['✅'], titulo: 'Evalúate: banco de práctica del Tomo', duracionMin: 15 },
  { numero: 7, iconos: ['💭'], titulo: 'Cierre del Tomo 1', duracionMin: 8 },

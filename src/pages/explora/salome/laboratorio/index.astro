const curvaLuz: DataCurvaLuz = {
  titulo: 'Simulador: caza tu exoplaneta',
  instrucciones:
    'Esto es lo que mide un telescopio: el brillo de una estrella, día tras día. Mueve los controles —el tamaño del planeta y su distancia— y observa cómo cambian los bajones. ¿Logras reproducir la curva de la «estrella misteriosa»?',
  objeto: 'una estrella parecida al Sol',
};

const actividadMide: Actividad = {
  numero: 1,
  verbo: 'APLICA',
  titulo: 'Descubre las reglas del tránsito',
  tiempoMin: 20,
  modalidad: 'parejas',
  pasos: [
    'Mueve SOLO el control de tamaño del planeta. ¿Qué le pasa a la profundidad del bajón? Escribe la relación que descubres.',
    'Mueve SOLO el control de distancia. ¿Qué le pasa al período (la separación entre bajones)? Escribe la relación.',
    'Resuelve el reto: ajusta los controles hasta igualar la curva de la «estrella misteriosa». Anota del panel la profundidad, el período, el tamaño y el tipo de planeta.',
    'Concluye: ¿por qué a ese planeta lo llamamos «Júpiter caliente»? Pista: mira su tamaño y su período.',
  ],
  cuaderno: {
    titulo: 'Las reglas del tránsito',
    formato: 'dos relaciones + los 4 datos del reto + conclusión',
    extension: 'las dos relaciones, los cuatro datos y la conclusión',
  },
  criterios: [
    'Descubriste que un planeta más grande hace un bajón más profundo.',
    'Descubriste que más distancia significa un período más largo (bajones más separados).',
    'Lograste el reto: un planeta de ~12 × la Tierra con período de ~8 días, un gigante gaseoso.',
  ],
};

const actividadInforme: Actividad = {
  numero: 2,
  verbo: 'CREA',
  titulo: 'Redacta tu informe de descubrimiento',
  tiempoMin: 15,
  modalidad: 'individual',
  pasos: [
    'Ponle nombre a tu estrella y a su planeta con la nomenclatura real (nombre de la estrella + «b»).',
    'Escribe un informe corto de astrónomo: qué método usaste, qué mediste (tamaño y período) y qué tipo de planeta encontraste.',
    'Cierra con una frase: ¿por qué este planeta no podría tener vida como la conocemos?',
  ],
  cuaderno: {
    titulo: 'Informe de descubrimiento',
    formato: 'informe breve de astrónomo',
    extension: '6 a 8 renglones',
  },
  criterios: [
    'Usaste la nomenclatura correcta (estrella + «b»).',
    'Tu informe menciona el método de tránsito, el tamaño y el período.',
    'Explicas por qué un «Júpiter caliente» no sería habitable (demasiado caliente y gaseoso).',
  ],
};

const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'Los números no son neutrales: detrás de cada dato hay alguien que decidió medirlo y para qué.',
    preguntaEspejo:
      'Aprendí a sacar un planeta de una curva de luz. ¿Qué otras realidades entendería mejor si me atreviera a mirar sus datos?',
  },
  estoico: {
    autor: 'Marco Aurelio',
    lente: 'lente del cuidado interior',
    cita: 'La verdad no se grita: se revela a quien observa con paciencia y método.',
    preguntaEspejo:
      'Medir el mismo brillo muchas veces reveló un mundo entero. ¿Dónde me falta paciencia para ver lo que ya está frente a mí?',
  },
  floridi: {
    autor: 'Luciano Floridi',
    lente: 'lente de la infoesfera',
    cita: 'Un dato en bruto no dice nada; convertirlo en conocimiento es un acto humano.',
    preguntaEspejo:
      'Tengo más datos que nunca (mensajes, notas, pasos). ¿Cuáles convierto en conocimiento y cuáles solo acumulo?',
  },
};

const cincoDimensiones: CincoDimensiones = {
  personal:
    'Hiciste lo que hace un astrónomo profesional: sacar un planeta real de una gráfica de datos. Ahora sabes que puedes.',
  emocional:
    'Resolver algo con tus propios cálculos da una confianza distinta a la de memorizar. Ese es el placer de la ciencia.',
  ciudadana:
    'Los datos de telescopios como Kepler o TESS son públicos: cualquiera puede analizarlos. La ciencia de datos también es una herramienta de ciudadanía.',
  local:
    'Leer datos y sacar conclusiones sirve para tu colegio, tu barrio y tu futuro trabajo, aquí mismo en Cartago.',
  intergeneracional:
    'El campesino llevaba la cuenta en una libreta; tú la lees en una pantalla. Cambia la herramienta, no la inteligencia.',
};

const examenTomo1: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Banco de práctica · Tomo 1 completo',
  instrucciones: 'Diez preguntas que integran los cuatro módulos. Elige una respuesta; recibirás la explicación al instante.',
  preguntas: [
    {
      enunciado: 'Camila ve dos estrellas, una azul y una roja, y afirma: «la roja está más caliente, porque el rojo es el color del fuego». ¿Tiene razón?',
      opciones: ['Sí, el rojo siempre indica más calor', 'No, la azul es la más caliente', 'No se puede saber por el color', 'Las dos tienen la misma temperatura'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto: en las estrellas el azul indica MÁS temperatura que el rojo. El color sí delata el calor, pero al revés de lo que sugiere una fogata.',
      feedbackIncorrecto: 'El color indica temperatura, pero la AZUL es más caliente que la roja. Camila se equivoca.',
    },
    {
      enunciado: '¿Qué proceso mantiene encendida a una estrella durante miles de millones de años?',
      opciones: ['La combustión, como una fogata', 'La fusión nuclear de hidrógeno en helio', 'El reflejo de otras estrellas', 'La electricidad de su núcleo'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Exacto: la fusión de hidrógeno en helio libera la energía que la hace brillar.',
      feedbackIncorrecto: 'No es combustión ni reflejo: es la fusión nuclear (hidrógeno → helio) en su núcleo.',
    },
    {
      enunciado: 'En 2006 Plutón pasó de planeta a «planeta enano» sin moverse ni cambiar de tamaño. ¿Qué criterio no cumple?',
      opciones: ['Girar alrededor del Sol', 'Tener forma esférica', 'Despejar (controlar) su órbita', 'Tener atmósfera'],
      respuestaIndex: 2,
      feedbackCorrecto: 'Correcto: comparte su órbita con otros cuerpos, así que no la «despeja». Por eso se reclasificó.',
      feedbackIncorrecto: 'Plutón gira alrededor del Sol y es esférico; lo que NO cumple es despejar su órbita.',
    },
    {
      enunciado: 'Júpiter mide 11 veces la Tierra y está hecho sobre todo de hidrógeno y helio. ¿Cómo se clasifica?',
      opciones: ['Planeta telúrico (rocoso)', 'Planeta gaseoso (gigante)', 'Planeta enano', 'Estrella fallida'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Sí: es un gigante gaseoso, enorme y de poca densidad, como Saturno, Urano y Neptuno.',
      feedbackIncorrecto: 'Por su tamaño y composición (H y He), Júpiter es un planeta GASEOSO (gigante), no rocoso.',
    },
    {
      enunciado: 'Mercurio tarda 88 días en orbitar el Sol y Neptuno, 165 años. ¿Qué explica mejor esa diferencia?',
      opciones: ['Neptuno es más pesado', 'Mercurio gira más rápido sobre sí mismo', 'Mercurio está mucho más cerca del Sol', 'Neptuno tiene más lunas'],
      respuestaIndex: 2,
      feedbackCorrecto: 'Correcto: cuanto más cerca está un planeta del Sol, menos recorrido tiene y menos tarda en dar la vuelta.',
      feedbackIncorrecto: 'La clave es la distancia: Mercurio está cerquísima (vuelta corta), Neptuno lejísimos (vuelta larga).',
    },
    {
      enunciado: 'Un astrónomo halla un planeta orbitando la estrella Kepler-22. ¿Cómo se llama ese tipo de planeta?',
      opciones: ['Planeta enano', 'Exoplaneta', 'Asteroide', 'Cometa'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Sí: un planeta que orbita una estrella distinta del Sol es un exoplaneta.',
      feedbackIncorrecto: 'Si orbita otra estrella (no el Sol), es un exoplaneta.',
    },
    {
      enunciado: '¿Por qué 51 Peg b ocupa un lugar especial en la historia de la ciencia?',
      opciones: ['Es el planeta más grande conocido', 'Fue el primer exoplaneta hallado en torno a una estrella como el Sol (Nobel 2019)', 'Tiene vida confirmada', 'Está dentro del Sistema Solar'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto: Mayor y Queloz lo descubrieron en 1995 y recibieron el Nobel en 2019.',
      feedbackIncorrecto: 'Fue el PRIMER exoplaneta confirmado en torno a una estrella tipo Sol (Mayor y Queloz, 1995).',
    },
    {
      enunciado: 'Una «exo-Tierra» sería un hallazgo histórico. ¿Qué la definiría?',
      opciones: ['Cualquier planeta rocoso', 'Un exoplaneta gemelo de la Tierra (4 criterios), aún no encontrado', 'La Tierra vista de noche', 'Un Júpiter caliente'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Sí: debe cumplir 4 criterios (estrella tipo G, ~1 UA, radio y masa como la Tierra). Aún no se ha hallado ninguna.',
      feedbackIncorrecto: 'Una exo-Tierra es un gemelo de la Tierra que cumple 4 criterios; todavía no se ha encontrado.',
    },
    {
      enunciado: 'Un telescopio registra que el brillo de una estrella baja un poquito, de forma regular, cada 4 días. ¿Qué es lo más probable?',
      opciones: ['La estrella se está apagando', 'Un planeta pasa por delante (tránsito) cada 4 días', 'La estrella cambia de color', 'Hay una nube de polvo fija'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto: un bajón regular de brillo indica un planeta en tránsito; los 4 días son su período orbital.',
      feedbackIncorrecto: 'Un bajón de brillo regular es la firma de un tránsito: un planeta que pasa por delante cada 4 días.',
    },
    {
      enunciado: 'En esa misma estrella, el bajón de brillo es muy profundo. ¿Qué deduces del planeta?',
      opciones: ['Que es muy pequeño', 'Que es grande (tapa mucha luz)', 'Que es muy frío', 'Que no tiene atmósfera'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Exacto: cuanto más grande el planeta, más luz bloquea y más profundo el bajón. Con período corto y bajón profundo, suena a «Júpiter caliente».',
      feedbackIncorrecto: 'Un bajón profundo significa que el planeta tapa mucha luz: es grande.',
    },
  ],
};
---

<BaseLayout
  title="Laboratorio del Tomo 1 · Caza tu exoplaneta — Salomé · ConectaTE"
  description="Guía práctica integradora del Tomo 1 de Salomé: analiza una curva de luz real, detecta el tránsito, mide la profundidad y el período, y estima el tamaño del planeta. Astronomía computacional con el modelo MILC."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <div class="max-w-3xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <a href={`${base}/explora/salome`} class="hover:opacity-60 transition-opacity">Salomé</a>
        <span>/</span>
        <span style="color: var(--fg);">Laboratorio · Tomo 1</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-lime mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">Momento 5 · Laboratorio del Tomo 1</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">Práctica con datos</span>
        </div>
        <h1 class="heading-giant text-balance mb-3" style="color: #1a1a1a;">Caza tu propio exoplaneta</h1>
        <p class="text-base md:text-lg font-semibold leading-relaxed" style="color: #1a1a1a;">
          Ya conoces el método. Ahora te toca a ti: analiza la luz de una estrella
          real, encuentra el planeta que esconde y mídelo, como un astrónomo.
        </p>
      </div>

      <!-- 🌱 Saber ancestral -->
      <SaberAncestralBlock data={saberAncestral} />

      <!-- 🗺 Ruta -->
      <MapaRutaBlock estaciones={mapaRuta} />

      <!-- Propósito -->
      <div class="bento-card mb-6">
        <span class="chip-bento mb-4">🎯 Lo que vas a poder hacer</span>
        <ul class="space-y-3 mt-3">
          {[
            'EXPLORAR una curva de luz real e identificar los tránsitos.',
            'APLICAR la profundidad del tránsito para estimar el tamaño del planeta.',
            'APLICAR el tiempo entre tránsitos para hallar su período orbital.',
            'CREAR el informe de tu propio descubrimiento, integrando todo el Tomo 1.',
          ].map((d) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">✓</span>
              <span class="text-sm md:text-base leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- 📖 Recuerda el método -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Recuerda · El método de tránsito</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            En el módulo anterior aprendiste que, cuando un planeta pasa por delante de su
            estrella (un <strong>tránsito</strong>), bloquea un poquito de su luz y el <strong>brillo baja</strong>. Si
            medimos ese brillo día tras día, obtenemos una <strong>curva de luz</strong>: los bajones
            marcan los tránsitos.
          </p>
          <p>
            Dos números lo dicen todo: la <strong>profundidad</strong> del bajón revela el <strong>tamaño</strong> del
            planeta (cuanto más grande, más luz tapa), y el <strong>tiempo entre dos bajones</strong> es su
            <strong>período orbital</strong>. Eso es justo lo que vas a medir ahora, con datos de verdad.
          </p>
        </div>
      </section>

      <!-- 🔎 Laboratorio: curva de luz -->
      <div class="mb-6">
        <LabCurvaLuz data={curvaLuz} id="lab-curva-tomo1" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Ya viste los tránsitos. Ahora conviértelos en números: ¿qué tan grande es el planeta?
      </p>

      <!-- ✏️ Actividad medir -->
      <ActividadBlock data={actividadMide} />

      <!-- ✏️ Actividad informe -->
      <ActividadBlock data={actividadInforme} />

      <!-- ✅ Evaluación del Tomo · banco de práctica -->
      <div class="bento-card-color bg-bento-blue text-white mb-6">
        <span class="chip-bento mb-2 bg-white/15">📝 Evaluación del Tomo 1</span>
        <p class="text-sm leading-relaxed opacity-95 mt-1">
          Pon a prueba todo lo que aprendiste en los cuatro módulos. Este es un banco
          de práctica para autoevaluarte; el examen calificable formal lo aplica tu
          profe aparte.
        </p>
      </div>
      <div class="mb-6">
        <LabQuiz data={examenTomo1} id="examen-tomo1" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Descubriste un planeta con tus propias manos. Cerremos el Tomo pensando qué significa leer la realidad en números.
      </p>
      </div>

      <!-- 💭 Triángulo (ancho completo) -->
      <TrianguloBlock data={triangulo} />

      <!-- 🌱 Cinco dimensiones (ancho completo) -->
      <CincoDimensionesBlock data={cincoDimensiones} />

      <div class="max-w-3xl mx-auto">
      <!-- Créditos -->
      <div class="bento-card mb-10 border-l-4 border-bento-lime">
        <span class="chip-bento mb-3">🛰 Sobre este laboratorio</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          Este Momento 5 es <strong style="color: var(--fg);">material propio de ConectaTE</strong>, creado para integrar desde la
          práctica los cuatro módulos del Tomo 1 del programa <strong style="color: var(--fg);">Salomé</strong> (Ágora de Hipatia ·
          RECA). Los datos de la curva de luz son ilustrativos, inspirados en tránsitos reales
          como el de HD 209458 b, el primer exoplaneta observado en tránsito.
        </p>
      </div>

      <!-- Navegación -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href={`${base}/explora/salome/metodos`} class="bento-card-hover flex items-center gap-4">
          <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="m12 19-7-7 7-7"></path>
          </svg>
          <div>
            <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Módulo 4</div>
            <div class="font-black text-base">Cómo se detecta un exoplaneta</div>
          </div>
        </a>
        <a href={`${base}/explora/salome`} class="bento-card-hover flex items-center justify-end gap-4 text-right">
          <div>
            <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al programa</div>
            <div class="font-black text-base">Salomé</div>
          </div>
          <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
      </div>
    </div>
  </article>
</BaseLayout>

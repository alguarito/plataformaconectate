};

const emparejarPrograma: DataEmparejar = {
  titulo: 'Repaso final: el viaje completo de Salomé',
  instrucciones: 'Cierra el programa conectando lo esencial de cada parte del camino.',
  etiquetaIzq: 'Lo que aprendiste',
  etiquetaDer: 'Para qué sirve',
  pares: [
    { izquierda: 'La fusión de las estrellas (Tomo 1)', derecha: 'Explica por qué brillan los soles' },
    { izquierda: 'El método de tránsito (Tomo 1)', derecha: 'Detecta exoplanetas por su sombra periódica' },
    { izquierda: 'El bamboleo (Tomo 1)', derecha: 'Así se descubrió 51 Pegasi b' },
    { izquierda: 'La espectroscopía (Tomo 2)', derecha: 'Revela de qué está hecho lo que brilla' },
    { izquierda: 'Las biofirmas (Tomo 2)', derecha: 'Buscan señales de vida en otros aires' },

    'Tu frase conecta con algo que aprendiste de verdad en el programa.',
    'Tu compromiso es concreto, pequeño y posible esta misma semana.',
  ],
};

const quiz: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Pon a prueba lo que sabes',
  instrucciones: 'Seis preguntas para cerrar el programa. Recibirás una explicación en cada una.',

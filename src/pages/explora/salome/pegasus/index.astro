const emparejarComunidad: DataEmparejar = {
  titulo: 'Relaciona cada actor de la minga del conocimiento con su aporte',
  instrucciones: 'La astronomía es una minga con muchos participantes. Conecta cada uno con lo que aporta.',
  etiquetaIzq: 'Actor',
  etiquetaDer: 'Su aporte',
  pares: [
    { izquierda: 'Ágora de Hipatia', derecha: 'Crea el cómic Salomé para acercar la ciencia' },
    { izquierda: 'RECA', derecha: 'Red de estudiantes que lleva la astronomía a los colegios de Colombia' },
    { izquierda: 'Semillero Betelgeuse', derecha: 'El grupo de astronomía de tu propio colegio' },
    { izquierda: 'Ciencia ciudadana', derecha: 'Personas comunes que analizan datos reales desde casa' },
    { izquierda: 'Tú, al terminar Salomé', derecha: 'Alguien que ya sabe leer la luz y puede enseñarlo' },

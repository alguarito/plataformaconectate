const actividadMito: Actividad = {
  numero: 1,
  verbo: 'EVALÚA',
  titulo: 'Juzga el mito del genio solitario',
  tiempoMin: 10,
  modalidad: 'individual',
  pasos: [
    'Lee la frase: «La ciencia la hacen genios solitarios, en países ricos, con aparatos carísimos».',

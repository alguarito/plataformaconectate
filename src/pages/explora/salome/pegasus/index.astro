---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabEmparejar from '../../../../components/LabEmparejar.astro';
import LabOrdenar from '../../../../components/LabOrdenar.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import GuiasRECA from '../../../../components/GuiasRECA.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataEmparejar } from '../../../../components/LabEmparejar.astro';
import type { DataOrdenar } from '../../../../components/LabOrdenar.astro';

const base = import.meta.env.BASE_URL;
const recursosOficiales = 'https://www.astroreca.org/educacion/salome-comic-exoplanetas/recursos';

const saberAncestral: SaberAncestral = {
  saber:
    'Cuando en una vereda del Valle había que recoger una cosecha grande, levantar una escuela o arreglar el camino, nadie esperaba que un héroe lo hiciera solo. Se convocaba la minga —los pueblos andinos la llaman así desde antes de la Colonia; en otras partes le dicen convite—: cada familia ponía manos, herramientas y algo para la olla común, y el trabajo de todos se volvía de todos. En la minga no solo se construía: se enseñaba. El niño aprendía a techar viendo al mayor, la receta del sancocho pasaba de olla en olla, y al final nadie podía decir «esto lo hice yo»: se decía «esto lo hicimos». Ese saber —que lo grande se construye en comunidad y que el conocimiento se comparte mientras se trabaja— es exactamente como funciona la ciencia de verdad.',
  fuente: 'Tradición de la minga y el convite · pueblos andinos y campesinos de Colombia',
  preguntaPuente:
    'Si un camino se construye en minga, ¿cómo se construye el conocimiento del cielo? ¿Puede un descubrimiento ser de una sola persona… o siempre es de muchas?',
};

const mapaRuta: EstacionMapa[] = [
  { numero: 1, iconos: ['🌱'], titulo: 'La minga: lo grande se hace entre todos', duracionMin: 5 },
  { numero: 2, iconos: ['📖'], titulo: 'Pegasus: el descubrimiento que abrió la puerta', duracionMin: 12 },
  { numero: 3, iconos: ['🔎'], titulo: 'Ordena la historia de 51 Pegasi b', duracionMin: 6 },
  { numero: 4, iconos: ['📖', '👁'], titulo: '¿Quién puede hacer ciencia?', duracionMin: 12 },
  { numero: 5, iconos: ['🔎'], titulo: 'Relaciona la minga del conocimiento', duracionMin: 7 },
  { numero: 6, iconos: ['✅'], titulo: 'Pon a prueba lo que sabes', duracionMin: 8 },
  { numero: 7, iconos: ['✏️'], titulo: 'Evalúa un mito y escribe tu manifiesto', duracionMin: 20 },
  { numero: 8, iconos: ['💭'], titulo: 'Tres voces para cerrar el programa', duracionMin: 8 },
];


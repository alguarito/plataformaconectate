const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'La comunidad es el sujeto de la historia: nadie se libera solo, y nadie descubre solo.',
    preguntaEspejo:
      '¿Quiénes han quedado por fuera de la minga de la ciencia —por género, por plata, por geografía— y qué puedo hacer yo para abrirles la puerta?',
  },
  estoico: {
    autor: 'Marco Aurelio',
    lente: 'lente del cuidado interior',
    cita: 'Lo que no beneficia a la colmena, tampoco beneficia a la abeja.',
    preguntaEspejo:
      'Aprendí a leer la luz de las estrellas. ¿De qué me sirve ese saber si lo guardo solo para mí?',
  },
  floridi: {
    autor: 'Luciano Floridi',
    lente: 'lente de la infoesfera',
    cita: 'La infoesfera es un ecosistema que construimos entre todos; compartir conocimiento de calidad es cuidarlo.',
    preguntaEspejo:
      'Cada cosa que comparto —un dato, una explicación, un manifiesto— queda en el entorno de otros. ¿Qué clase de información estoy sembrando?',
  },
};

const cincoDimensiones: CincoDimensiones = {
  personal:
    'Terminaste Salomé: sabes qué es una estrella, cómo se caza un exoplaneta y cómo se lee la luz. Ya no eres espectador del cielo: eres alguien que lo entiende.',
  emocional:
    'Pertenecer a algo más grande —un semillero, una red, una generación que busca otros mundos— da un orgullo sereno. Ese sentimiento también es un motor: cuídalo.',
  ciudadana:
    'La ciencia es un bien común que se construye en minga: datos abiertos, nombres votados por la gente, redes de estudiantes. Participar en ella también es ejercer ciudadanía.',
  local:
    'Desde Cartago, el Semillero Betelgeuse es tu puerta de entrada a esa minga. La astronomía colombiana no está lejos: empieza en tu colegio.',
  intergeneracional:
    'Tus abuelos leían las Cabrillas para sembrar; tú terminas un programa leyendo la luz de otros soles. La minga del conocimiento sigue viva: ahora te toca pasarla.',
};

// Hitos para la lectura de "¿Quién puede hacer ciencia?".
const actores = [
  { emoji: '🤝', nombre: 'Un equipo, no un genio', texto: 'Mayor y Queloz trabajaron juntos, sobre instrumentos construidos por décadas de colegas. El Nobel fue de dos, y detrás había cientos.' },
  { emoji: '🗳', nombre: 'El mundo votó un nombre', texto: 'En 2015, la Unión Astronómica Internacional invitó al público a nombrar mundos: 51 Pegasi b se llama «Dimidium» por votación ciudadana global.' },
  { emoji: '🏠', nombre: 'Ciencia desde la casa', texto: 'En proyectos de ciencia ciudadana, personas comunes clasifican galaxias y revisan curvas de luz reales. Varios exoplanetas se han hallado así.' },
  { emoji: '🇨🇴', nombre: 'La minga colombiana', texto: 'RECA conecta a estudiantes colombianos de astronomía y lleva programas como Salomé a los colegios. Tu Semillero Betelgeuse es parte de esa red.' },
  { emoji: '👩‍🚀', nombre: 'Todas las manos', texto: 'Salomé pone a niñas como protagonistas a propósito: la brecha de género en ciencia se cierra mostrando que el cielo es de todas y de todos.' },
];
---

<BaseLayout
  title="Tomo 2 · Estación 5 · #YoSoyPegasus — Salomé · ConectaTE"
  description="El cierre del programa Salomé: la historia de 51 Pegasi b, la ciencia como minga —equipos, ciencia ciudadana, redes de estudiantes— y tu propio manifiesto #YoSoy. Estación final adaptada al modelo MILC."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <div class="max-w-3xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <a href={`${base}/explora/salome`} class="hover:opacity-60 transition-opacity">Salomé</a>
        <span>/</span>
        <span style="color: var(--fg);">Tomo 2 · Estación 5</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-purple text-white mb-10">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">🚀 Estación 5 · Tomo 2</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Ciencia y comunidad</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Cierre del programa</span>
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">~75 min</span>
        </div>
        <h1 class="heading-giant text-balance mb-3">#YoSoyPegasus</h1>
        <p class="text-base md:text-lg font-semibold opacity-95 leading-relaxed">
          La última estación no es sobre un astro: es sobre las personas. Quién
          descubrió el primer mundo alrededor de otro sol, quién puede hacer ciencia
          —espóiler: tú— y qué te llevas de todo este viaje.
        </p>
      </div>

      <!-- 🌱 Saber ancestral -->
      <SaberAncestralBlock data={saberAncestral} />

      <!-- 🗺 Ruta -->
      <MapaRutaBlock estaciones={mapaRuta} />

      <!-- Propósito -->
      <div class="bento-card mb-6">
        <span class="chip-bento mb-4">🎯 Lo que vas a poder hacer</span>
        <ul class="space-y-3 mt-3">
          {[
            'IDENTIFICAR el descubrimiento de 51 Pegasi b y por qué abrió un campo entero.',
            'EXPLICAR cómo participa la gente común en la ciencia (ciencia ciudadana).',
            'ORDENAR la historia del primer exoplaneta y RELACIONAR a los actores de la minga del conocimiento.',
            'EVALUAR con evidencias el mito del «genio solitario».',
            'CREAR tu manifiesto #YoSoy: tu identidad y tu compromiso frente al cielo.',
          ].map((d) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">✓</span>
              <span class="text-sm md:text-base leading-relaxed">{d}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Pregunta detonante -->
      <div class="bento-card-color bg-bento-cyan mb-10">
        <span class="chip-bento mb-3 bg-black/10">💡 La pregunta que abre todo</span>
        <p class="text-lg md:text-xl font-black leading-snug">
          Recorriste estrellas, planetas, atmósferas y rayos de luz. Queda la pregunta
          más importante del programa: ¿y tú qué tienes que ver con todo esto?
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          La respuesta empieza con un caballo alado: Pegasus.
        </p>
      </div>

      <!-- 👁 Observa · video en proceso en RECA -->
      <div class="bento-card mb-6 flex items-start gap-3">
        <span class="text-2xl shrink-0" aria-hidden="true">🎬</span>
        <div>
          <div class="font-black text-sm">El video de este módulo está en camino</div>
          <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
            RECA aún está produciendo los videos del Tomo 2. Mientras llega, esta
            estación es autosuficiente: tienes toda la lectura que necesitas. Y aquí
            abajo está la guía oficial para profundizar.
          </p>
        </div>
      </div>
      <GuiasRECA tomo={2} modulo={5} />

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        La minga te enseñó que lo grande se hace entre todos. Ahora conoce la historia
        que le da nombre a este módulo, porque con ella resolverás lo que sigue.
      </p>

      <!-- 📖 LEE 1 · 51 Pegasi b -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · Pegasus: el descubrimiento que abrió la puerta</span>
        <div class="space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            En el cielo del norte hay una constelación con forma de caballo alado:
            <strong>Pegaso</strong> (Pegasus). En 1995, los astrónomos suizos
            <strong>Michel Mayor</strong> y <strong>Didier Queloz</strong> estudiaban desde un
            observatorio en Francia una de sus estrellas, la <strong>51 Pegasi</strong>, parecida
            a nuestro Sol. Y notaron algo extraño: la estrella <strong>se bamboleaba</strong>,
            acercándose y alejándose de nosotros con un ritmo de pocos días. Ya sabes
            leer esa señal —la simulaste en el laboratorio del Tomo 1—: algo grande
            tiraba de ella. Era un planeta: <strong>51 Pegasi b</strong>, un gigante pegado a su
            estrella, un «Júpiter caliente». El <strong>primer mundo</strong> descubierto alrededor
            de una estrella como el Sol.
          </p>
          <p>
            Lo que vino después fue una avalancha: astrónomos de todo el mundo
            confirmaron el hallazgo y salieron a buscar más. Hoy se conocen <strong>miles
            de exoplanetas</strong>, y en 2019 Mayor y Queloz recibieron el
            <strong>Premio Nobel de Física</strong>. ¿Y sabes quién avala el cómic Salomé que
            acabas de estudiar? El propio <strong>Michel Mayor</strong>. No estudiaste un cuento
            lejano: estudiaste la ciencia de sus protagonistas vivos.
          </p>
        </div>
      </section>

      <!-- 🔎 Ordena la historia -->
      <div class="mb-6">
        <LabOrdenar data={ordenarPegasi} id="ordena-pegasi" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Dos nombres se llevaron el Nobel. Pero mira de cerca y verás a la minga entera.
      </p>

      <!-- 📖 LEE 2 · Quién puede hacer ciencia -->
      <section class="bento-card mb-6">
        <span class="chip-bento mb-4">📖 Lee · ¿Quién puede hacer ciencia?</span>
        <p class="text-sm md:text-base leading-relaxed mb-4">
          El mito dice que la ciencia la hacen genios solitarios. La realidad se parece
          mucho más a una minga. Mira las evidencias:
        </p>
        <ul class="space-y-3">
          {actores.map((a) => (
            <li class="flex items-start gap-3 p-3 rounded-bento-sm" style="background: var(--bg);">
              <span class="text-2xl shrink-0" aria-hidden="true">{a.emoji}</span>
              <span class="text-sm md:text-base leading-relaxed"><strong>{a.nombre}:</strong> {a.texto}</span>
            </li>
          ))}
        </ul>
        <p class="text-sm md:text-base leading-relaxed mt-4">
          Por eso este módulo se llama <strong>#YoSoyPegasus</strong>: no porque seas un caballo
          alado, sino porque la búsqueda que empezó en esa constelación <strong>sigue
          abierta y te incluye</strong>. Quien aprende a leer la luz ya está adentro de la minga.
        </p>
      </section>

      <!-- 🔎 Relaciona la comunidad -->
      <div class="mb-6">
        <LabEmparejar data={emparejarComunidad} id="empareja-comunidad" />
      </div>

      <!-- 🔎 Repaso del programa -->
      <div class="mb-6">
        <LabEmparejar data={emparejarPrograma} id="empareja-programa" />
      </div>

      <!-- ✅ Quiz -->
      <div class="mb-6">
        <LabQuiz data={quiz} id="salome-pegasus-quiz" />
      </div>

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Tienes la historia y las evidencias. Ahora úsalas: primero para juzgar un mito,
        después para escribir el cierre que es solo tuyo.
      </p>

      <!-- ✏️ Actividad EVALÚA -->
      <ActividadBlock data={actividadMito} />

      <!-- ✏️ Actividad CREA -->
      <ActividadBlock data={actividadManifiesto} />

      <!-- Puente -->
      <p class="text-base md:text-lg font-bold leading-relaxed mb-6 px-1">
        Tu manifiesto cierra tu viaje por Salomé. Las últimas tres voces te acompañan a
        ponerle el punto final.
      </p>
      </div>

      <!-- 💭 Triángulo (ancho completo) -->
      <TrianguloBlock data={triangulo} />

      <!-- 🌱 Cinco dimensiones (ancho completo) -->
      <CincoDimensionesBlock data={cincoDimensiones} />

      <div class="max-w-3xl mx-auto">
      <!-- Créditos -->
      <div class="bento-card mb-10 border-l-4 border-bento-purple">
        <span class="chip-bento mb-3">🛰 Créditos</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          Esta estación adapta al modelo MILC los conceptos del Módulo 5
          («#YoSoyPegasus») del <strong style="color: var(--fg);">Tomo 2</strong> del proyecto
          <strong style="color: var(--fg);">Salomé: investigación de exoplanetas</strong>, de la Association Ágora de
          Hipatia (Suiza), ejecutado en Colombia por <strong style="color: var(--fg);">RECA</strong>, con el aval del
          Nobel de Física <strong style="color: var(--fg);">Michel Mayor</strong>, descubridor de 51 Pegasi b. El cómic
          y las fichas originales son de sus autores.
        </p>
        <a href={recursosOficiales} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-4 font-black text-sm text-bento-blue hover:opacity-70 transition-opacity">
          Leer el cómic y ver el material oficial
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora/salome`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al programa</div>
          <div class="font-black text-lg">Salomé</div>
        </div>
      </a>
      </div>
    </div>
  </article>
</BaseLayout>

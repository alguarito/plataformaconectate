const triangulo: Triangulo = {
  dussel: {
    autor: 'Enrique Dussel',
    lente: 'lente del nosotros',
    cita: 'Clasificar es ejercer poder: quien define las categorías, ordena el mundo.',
    preguntaEspejo:
      'Plutón cambió de categoría por una votación de científicos. ¿Quién decide las categorías con las que nombro el mundo, y desde dónde lo hacen?',
  },
  estoico: {
    autor: 'Marco Aurelio',
    lente: 'lente del cuidado interior',
    cita: 'Mira las cosas desde lo alto: la Tierra entera no es más que un punto.',

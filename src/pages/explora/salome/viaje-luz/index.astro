  ],
};

const actividadCarta: Actividad = {
  numero: 2,
  verbo: 'CREA',
  titulo: 'Escribe un mensaje a 50 años luz',
  tiempoMin: 12,
  modalidad: 'individual',
  pasos: [
    'Imagina que envías un mensaje de luz (un láser) a una civilización en una estrella a 50 años luz.',
    'Tu mensaje tardará 50 años en llegar, y su respuesta otros 50: cien años de ida y vuelta.',
    'Escribe el mensaje corto que enviarías y una reflexión: ¿cómo cambia una conversación cuando cada respuesta tarda medio siglo?',
  ],
  cuaderno: {
    titulo: 'Mensaje a 50 años luz',
    formato: 'mensaje breve + reflexión',
    extension: '4 a 6 renglones en total',
  },
  criterios: [
    'Tu mensaje está pensado para alguien lejanísimo, que no te conoce.',
    'Reconoces que quizá no vivirías para escuchar la respuesta.',
    'Reflexionas sobre lo que significa comunicarse a la escala del cosmos.',
  ],
};

const quiz: LabQuizData = {
  tipo: 'quiz',
  titulo: 'Pon a prueba lo que sabes',
  instrucciones: 'Seis preguntas sobre lo que leíste. Recibirás una explicación en cada una.',
  preguntas: [
    {
      enunciado: '¿Dónde nace un rayo de luz de una estrella?',
      opciones: ['En su superficie', 'En su núcleo, por la fusión nuclear', 'En el espacio que la rodea', 'En los planetas que la orbitan'],
      respuestaIndex: 1,
      feedbackCorrecto: 'Correcto: nace en el núcleo, donde la fusión nuclear libera energía. Es la misma fusión que viste en el Tomo 1.',
      feedbackIncorrecto: 'Nace en el núcleo, por la fusión nuclear (la misma del Tomo 1). Desde ahí empieza su largo viaje hacia afuera.',
    },
    {
      enunciado: '¿Por qué un rayo de luz tarda tanto en SALIR de la estrella?',
      opciones: [
        'Porque viaja muy despacio dentro de ella',
        'Porque rebota millones de veces en su interior tan denso',
        'Porque se detiene a descansar',
        'Porque la estrella lo retiene a propósito',
      ],
      respuestaIndex: 1,
      feedbackCorrecto: 'Exacto: el interior es tan denso que el rayo rebota sin parar y puede tardar miles de años en llegar a la superficie.',

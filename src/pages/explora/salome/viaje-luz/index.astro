---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SaberAncestralBlock from '../../../../components/SaberAncestralBlock.astro';
import MapaRutaBlock from '../../../../components/MapaRutaBlock.astro';
import ActividadBlock from '../../../../components/ActividadBlock.astro';
import LabEmparejar from '../../../../components/LabEmparejar.astro';
import LabOrdenar from '../../../../components/LabOrdenar.astro';
import LabQuiz from '../../../../components/LabQuiz.astro';
import TrianguloBlock from '../../../../components/TrianguloBlock.astro';
import CincoDimensionesBlock from '../../../../components/CincoDimensionesBlock.astro';
import GuiasRECA from '../../../../components/GuiasRECA.astro';
import type {
  SaberAncestral,
  EstacionMapa,
  Actividad,
  LabQuiz as LabQuizData,
  Triangulo,
  CincoDimensiones,
} from '../../../../data/guiasContenido/_schema';
import type { DataEmparejar } from '../../../../components/LabEmparejar.astro';
import type { DataOrdenar } from '../../../../components/LabOrdenar.astro';

const base = import.meta.env.BASE_URL;
const recursosOficiales = 'https://www.astroreca.org/educacion/salome-comic-exoplanetas/recursos';

const saberAncestral: SaberAncestral = {
  saber:
    'Mucho antes del teléfono y del internet, los pueblos de los Andes y de las montañas del mundo ya enviaban mensajes a la velocidad de la luz. En lo alto de los cerros encendían fogatas en la noche o levantaban columnas de humo de día, y un vecino a kilómetros de distancia las veía y entendía el aviso: hay peligro, reúnanse, llegó la noticia. La luz del fuego cruzaba el valle en un instante y llevaba el mensaje sin que nadie tuviera que caminar. Sin escribirlo en fórmulas, sabían algo profundo: la luz puede viajar lejos y llegar cargada de significado. La astronomía lleva esa misma idea al extremo — la luz de una estrella también es un mensaje que viaja, solo que su viaje no dura un instante: dura años, siglos o millones de años antes de tocar nuestros ojos.',
  fuente: 'Saberes andinos y de montaña · señales de fuego y humo',
  preguntaPuente:
    'Una fogata en el cerro cruza el valle en un instante. Pero la luz de una estrella tarda años en llegar: ¿qué le pasa —o qué NO le pasa— a su mensaje durante un viaje tan largo?',
};

const mapaRuta: EstacionMapa[] = [
  { numero: 1, iconos: ['🌱'], titulo: 'Mensajes de fuego en los cerros', duracionMin: 5 },
  { numero: 2, iconos: ['📖'], titulo: 'El nacimiento y la fuga de un rayo de luz', duracionMin: 12 },
  { numero: 3, iconos: ['🔎'], titulo: 'Ordena el viaje de un fotón', duracionMin: 6 },
  { numero: 4, iconos: ['📖', '👁'], titulo: 'La luz, una cápsula del tiempo', duracionMin: 12 },
  { numero: 5, iconos: ['🔎'], titulo: 'Relaciona distancias con el pasado que ves', duracionMin: 8 },
  { numero: 6, iconos: ['✅'], titulo: 'Pon a prueba lo que sabes', duracionMin: 8 },
  { numero: 7, iconos: ['✏️'], titulo: 'Calcula viajes de luz y escribe al cosmos', duracionMin: 16 },
  { numero: 8, iconos: ['💭'], titulo: 'Tres voces para cerrar', duracionMin: 8 },
];

const ordenarViaje: DataOrdenar = {
  titulo: 'Ordena el viaje de un rayo de luz',
  instrucciones: 'Acabas de leer el recorrido completo. Usa las flechas para ordenar los seis pasos, desde que nace la luz hasta que la captamos.',
  pasos: [
    'En el núcleo de la estrella, la fusión nuclear crea un rayo de luz.',
    'El rayo rebota millones de veces dentro de la estrella y tarda muchísimo en salir.',
    'Por fin escapa de la superficie de la estrella hacia el espacio.',
    'Viaja en línea recta por el vacío a 300.000 km/s.',
    'Cruza años o millones de años de distancia sin perder su mensaje.',
    'Entra en un telescopio (o en tus ojos) y entrega su información.',
  ],
};

const emparejarPasado: DataEmparejar = {
  titulo: 'Relaciona cada objeto con el pasado que ves al mirarlo',
  instrucciones: 'Cuanto más lejos está algo, más antiguo es lo que ves. Conecta cada objeto con «cuándo» salió su luz.',
  etiquetaIzq: 'Objeto del cielo',
  etiquetaDer: 'Lo ves como era hace…',
  pares: [
    { izquierda: 'La Luna', derecha: 'Poco más de 1 segundo' },
    { izquierda: 'El Sol', derecha: '8 minutos' },
    { izquierda: 'Próxima Centauri', derecha: '4 años' },
    { izquierda: 'La galaxia de Andrómeda', derecha: '2,5 millones de años' },
    { izquierda: 'Las galaxias del James Webb', derecha: 'Más de 13.000 millones de años' },
  ],
};

const emparejarConceptos: DataEmparejar = {
  titulo: 'Repaso: relaciona cada concepto con su significado',
  instrucciones: 'Cierra la lectura conectando los cinco conceptos clave de la estación con su definición.',
  etiquetaIzq: 'Concepto',
  etiquetaDer: 'Significado',
  pares: [
    { izquierda: 'Fotón', derecha: 'Un paquete de luz que viaja por el espacio' },
    { izquierda: 'Año luz', derecha: 'La distancia que la luz recorre en un año' },
    { izquierda: 'Cápsula del tiempo', derecha: 'La luz que nos muestra cómo era el pasado' },
    { izquierda: 'Máquina del tiempo', derecha: 'Lo que es un telescopio al mirar muy lejos' },
    { izquierda: 'Corrimiento al rojo', derecha: 'La luz estirada por la expansión del universo' },

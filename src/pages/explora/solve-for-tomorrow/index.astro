---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const sitioOficial = 'https://www.samsung.com/co/campaign/solvefortomorrow/';
const guiaPdf = `${base}/explora/solve-for-tomorrow/guia-propuestas-alto-valor.pdf`;

// Requisitos verificados (edición 2026, fuentes oficiales).
const requisitos = [
  { i: '🏫', t: 'Colegios públicos', d: 'El programa es exclusivo para estudiantes de instituciones públicas.' },
  { i: '🎓', t: 'Grados 8.º a 12.º', d: 'Con edades entre 13 y 19 años cumplidos.' },
  { i: '👥', t: 'Equipo de 2 a 4', d: 'Acompañados por un docente guía del mismo colegio (revisa la exigencia de equipos mixtos en las bases).' },
  { i: '🔬', t: 'Enfoque STEM', d: 'Ciencia, tecnología, ingeniería y matemática, con metodología Design Thinking.' },
];

// Fases del concurso (sin fechas: cambian por edición; consulta el sitio oficial).
const fases = [
  { n: 1, t: 'Inscripción y talleres', d: 'El equipo se inscribe y recibe talleres de Design Thinking para formular su proyecto.' },
  { n: 2, t: 'Top 100 equipos', d: 'Se seleccionan los 100 mejores proyectos para continuar el proceso.' },
  { n: 3, t: 'Top 50 · mentoría', d: 'Los 50 mejores reciben acompañamiento y mentoría para fortalecer su solución.' },
  { n: 4, t: 'Semifinal', d: 'Acompañamiento a los equipos destacados rumbo a la final.' },
  { n: 5, t: 'Evento Final', d: 'Cinco equipos presentan su pitch ante el jurado y se anuncia al ganador.' },
];

const stats = [
  { n: '48.000+', l: 'estudiantes' },
  { n: '2.353', l: 'colegios' },
  { n: '14.200', l: 'proyectos' },
  { n: '32', l: 'departamentos' },
];

// Las 5 etapas del Design Thinking (las que evalúa el formulario).
const etapas = [
  { n: 1, t: 'Empatizar', d: 'Entiende de verdad a tu comunidad: sus necesidades, deseos y desafíos.' },
  { n: 2, t: 'Definir', d: 'Plantea con claridad el problema concreto que vas a resolver.' },
  { n: 3, t: 'Idear', d: 'Propón una solución diferenciada y explica por qué resuelve el problema.' },
  { n: 4, t: 'Prototipar', d: 'Describe cómo funciona y dónde actúa la ciencia, tecnología, ingeniería y matemática.' },
  { n: 5, t: 'Validar', d: 'Proyecta el impacto y cómo lo medirás con la comunidad.' },
];

const areas = [
  { t: 'Sostenibilidad ambiental', ods: 'ODS 6, 7, 12, 13, 14, 15' },
  { t: 'Salud y bienestar', ods: 'ODS 2, 3, 6' },
  { t: 'Apoyo a la comunidad local', ods: 'ODS 1, 4, 5, 10, 11, 16, 17' },
  { t: 'Deportes', ods: 'ODS 3, 4, 10, 11' },
];
---

<BaseLayout
  title="Solve for Tomorrow · Innovación social STEM — Explora · ConectaTE"
  description="Solve for Tomorrow es el concurso de Samsung donde estudiantes de colegios públicos resuelven un problema real de su comunidad con tecnología. Aquí encuentras la guía de preparación ConectaTE para construir una propuesta de alto valor."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <span style="color: var(--fg);">Solve for Tomorrow</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-orange text-white mb-10 min-h-[320px] flex flex-col justify-between">
        <div class="flex items-start justify-between flex-wrap gap-3">
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">💡 Innovación social STEM</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Aliado: Samsung</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">10.ª edición · 2026</span>
          </div>
          <span class="text-8xl md:text-9xl leading-none" aria-hidden="true">💡</span>
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">Programa · Explora</span>
          <h1 class="heading-giant text-balance mt-2 mb-4">Solve for Tomorrow</h1>
          <p class="text-base md:text-lg font-semibold opacity-95 max-w-3xl leading-relaxed">
            El concurso de Samsung donde estudiantes de colegios públicos diseñan
            una solución tecnológica a un problema real de su comunidad. Aquí te
            preparamos para que tu equipo presente una propuesta de alto valor.
          </p>
        </div>
      </div>

      <!-- CTA principal · guía de preparación -->
      <a
        href={guiaPdf}
        download
        class="bento-card-color bg-bento-lime flex items-center gap-4 mb-10 hover:scale-[1.01] transition-transform group"
      >
        <div class="text-5xl shrink-0" aria-hidden="true">📘</div>
        <div class="flex-1">
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">Guía ConectaTE · PDF</span>
          <div class="font-black text-xl leading-tight mt-1">Construye una propuesta de alto valor</div>
          <div class="text-sm opacity-80 mt-1">10 páginas mapeadas al formulario oficial: las 5 etapas, ejemplos y rúbrica.</div>
        </div>
        <svg class="w-7 h-7 shrink-0 group-hover:translate-y-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </a>

      <!-- Qué es -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-4">De qué se trata</span>
        <p class="text-base md:text-lg leading-relaxed mb-2">
          <strong>Solve for Tomorrow</strong> es el programa de ciudadanía corporativa de
          Samsung que reta a los jóvenes a mirar su entorno, encontrar un problema que
          de verdad importe y diseñar una solución con <strong>ciencia y tecnología</strong>.
          No premia la idea más vistosa, sino la que <strong>entiende su comunidad</strong> y
          propone un cambio aplicable. Es, en esencia, el modelo <strong>MILC</strong> en
          acción: investigar el territorio y crear tecnología con sentido.
        </p>
      </div>

      <!-- Requisitos -->
      <section class="mb-10">
        <h2 class="heading-huge mb-6">¿Quién puede participar?</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {requisitos.map((r) => (
            <div class="bento-card flex items-start gap-3">
              <span class="text-3xl shrink-0" aria-hidden="true">{r.i}</span>
              <div>
                <h3 class="font-black text-base leading-tight">{r.t}</h3>
                <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">{r.d}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Impacto -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge">Diez años transformando comunidades</h2>
          <span class="chip-bento">en Colombia</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {stats.map((s) => (
            <div class="bento-card text-center">
              <div class="text-3xl md:text-4xl font-black tracking-tight text-bento-orange">{s.n}</div>
              <div class="text-xs font-bold uppercase tracking-widest mt-1" style="color: var(--fg-muted);">{s.l}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Fases -->
      <section class="mb-10">
        <h2 class="heading-huge mb-6">Cómo es el camino</h2>
        <ol class="space-y-3">
          {fases.map((f) => (
            <li class="bento-card flex items-start gap-4">
              <span class="w-9 h-9 rounded-full bg-bento-orange text-white flex items-center justify-center font-black shrink-0">{f.n}</span>
              <div>
                <h3 class="font-black text-base leading-tight">{f.t}</h3>
                <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">{f.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="text-xs leading-relaxed mt-4" style="color: var(--fg-muted);">
          Las fechas exactas cambian cada edición. Consúltalas siempre en el sitio oficial.
        </p>
      </section>

      <!-- Prepárate con ConectaTE -->
      <section class="mb-10">
        <div class="bento-card-color bg-bento-black grid-pattern text-white py-10 px-6 md:px-10">
          <div class="text-center mb-8 max-w-2xl mx-auto">
            <span class="chip-bento mb-3 bg-white/10 text-white">Tu ventaja</span>
            <h2 class="heading-huge mb-3 leading-tight">Prepárate con ConectaTE.</h2>
            <p class="text-base md:text-lg opacity-80 leading-relaxed">
              La sección <strong>«Propuesta»</strong> del formulario es Design Thinking en cinco
              etapas. Domínalas y tu proyecto se separa del montón.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mb-8">
            {etapas.map((e) => (
              <div class="rounded-bento p-4 bg-white/10">
                <span class="w-7 h-7 rounded-full bg-bento-lime text-neutral-950 flex items-center justify-center text-xs font-black mb-2">{e.n}</span>
                <h3 class="font-black text-sm leading-tight mb-1">{e.t}</h3>
                <p class="text-xs leading-relaxed opacity-80">{e.d}</p>
              </div>
            ))}
          </div>

          <div class="text-center">
            <a href={guiaPdf} download class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-bento-lime text-neutral-950 font-black hover:opacity-90 transition-opacity">
              Descargar la guía completa (PDF)
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <p class="text-xs opacity-70 mt-3">Incluye ejemplos contextualizados a Cartago, claves de alto valor y rúbrica de autoevaluación.</p>
          </div>
        </div>
      </section>

      <!-- Áreas de impacto -->
      <section class="mb-10">
        <h2 class="heading-huge mb-6">Áreas de impacto y ODS</h2>
        <p class="text-sm md:text-base leading-relaxed mb-5" style="color: var(--fg-muted);">
          Tu proyecto elige hasta <strong style="color: var(--fg);">dos áreas</strong>, y de ellas se
          desprenden los Objetivos de Desarrollo Sostenible que aborda. Elige los que tu
          idea trabaja de verdad.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {areas.map((a) => (
            <div class="bento-card">
              <h3 class="font-black text-base leading-tight">{a.t}</h3>
              <p class="text-sm mt-1" style="color: var(--fg-muted);">{a.ods}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA oficial -->
      <a
        href={sitioOficial}
        target="_blank"
        rel="noopener"
        class="bento-card-color bg-bento-orange text-white flex items-center gap-4 mb-10 hover:scale-[1.01] transition-transform group"
      >
        <div class="text-5xl shrink-0" aria-hidden="true">🚀</div>
        <div class="flex-1">
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">Inscripción oficial</span>
          <div class="font-black text-xl leading-tight mt-1">Inscribe tu proyecto en Samsung</div>
          <div class="text-sm opacity-90 mt-1">La inscripción es exclusivamente en el sitio oficial, en las fechas vigentes. El docente registra el equipo.</div>
        </div>
        <svg class="w-7 h-7 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>

      <!-- Créditos / atribución -->
      <div class="bento-card mb-10 border-l-4 border-bento-orange">
        <span class="chip-bento mb-3">🤝 Créditos y aclaración</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          <strong style="color: var(--fg);">Solve for Tomorrow</strong> es un programa y marca de
          <strong style="color: var(--fg);">Samsung Electronics</strong>. Este espacio es un material de
          <strong style="color: var(--fg);">preparación pedagógica independiente</strong> de la I.E. Sor María
          Juliana, en su plataforma ConectaTE, <strong style="color: var(--fg);">sin afiliación ni respaldo
          oficial</strong> de Samsung. La inscripción y las bases son exclusivamente las del
          <a href={sitioOficial} target="_blank" rel="noopener" class="underline hover:opacity-70">sitio oficial</a>.
        </p>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver a</div>
          <div class="font-black text-lg">Explora</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

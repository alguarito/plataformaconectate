---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VisorPdf from '../../../components/VisorPdf.astro';
import SlidesViewer from '../../../components/SlidesViewer.astro';
import VideoSesion from '../../../components/VideoSesion.astro';
import AudioPodcast from '../../../components/AudioPodcast.astro';
import { presentacionSft, slidesSft } from '../../../data/presentacionSft';

const base = import.meta.env.BASE_URL;
const sitioOficial = 'https://www.samsung.com/co/campaign/solvefortomorrow/';
const guiaPdf = `${base}/explora/solve-for-tomorrow/guia-propuestas-alto-valor.pdf`;
const infografia = `${base}/explora/solve-for-tomorrow/infografia-ruta.webp`;
const podcast = `${base}/explora/solve-for-tomorrow/podcast-propuesta.m4a`;
const video = {
  youtubeId: 'TeoktbvqWfc',
  titulo: 'Construye una propuesta de alto valor · resumen en video',
  descripcion: 'Un recorrido breve por la ruta completa: del problema de tu comunidad a una solución STEM ganadora.',
  credito: 'Resumen en video · generado con NotebookLM',
};

// Por qué vale la pena meterse: lo que el estudiante gana.
const razones = [
  { i: '🎤', t: 'Pasas de espectador a autor', d: 'En vez de solo consumir tecnología, la creas para resolver algo que te importa. Ese giro te cambia la forma de mirar el mundo.' },
  { i: '🌱', t: 'Tu proyecto puede cambiar tu barrio', d: 'No es un trabajo de clase para una nota: es una solución real para una necesidad real de tu comunidad en Cartago.' },
  { i: '🤝', t: 'Entras a una red nacional', d: 'Talleres, mentores y miles de jóvenes de todo el país que, como tú, creen que la ciencia transforma. No vas solo.' },
  { i: '🏆', t: 'Ganas experiencia (y premios)', d: 'Aprendes a investigar, trabajar en equipo y defender tus ideas; los equipos destacados reciben premios tecnológicos. Todo suma a tu futuro.' },
];

// Requisitos, en versión compacta.
const requisitos = [
  { i: '🏫', t: 'Colegio público' },
  { i: '🎓', t: 'Grados 8.º a 12.º · 13 a 19 años' },
  { i: '👥', t: 'Equipo de 2 a 4 + un docente' },
  { i: '🔬', t: 'Ganas de resolver con STEM' },
];

const stats = [
  { n: '48.000+', l: 'estudiantes' },
  { n: '2.353', l: 'colegios' },
  { n: '14.200', l: 'proyectos' },
  { n: '32', l: 'departamentos' },
];

// Las 5 etapas del Design Thinking (las que evalúa el formulario).
const etapas = [
  { n: 1, t: 'Empatizar', d: 'Entiende de verdad a tu comunidad: sus necesidades y desafíos.' },
  { n: 2, t: 'Definir', d: 'Plantea con claridad el problema concreto que vas a resolver.' },
  { n: 3, t: 'Idear', d: 'Propón una solución distinta y di por qué resuelve el problema.' },
  { n: 4, t: 'Prototipar', d: 'Explica cómo funciona y dónde actúa el STEM.' },
  { n: 5, t: 'Validar', d: 'Proyecta el impacto y cómo lo medirás con la comunidad.' },
];
---

<BaseLayout
  title="Solve for Tomorrow · Innovación social STEM — Explora · ConectaTE"
  description="Solve for Tomorrow es el concurso de Samsung donde estudiantes de colegios públicos convierten un problema real de su comunidad en una solución con tecnología. Descubre por qué participar y prepárate con la guía ConectaTE."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <span style="color: var(--fg);">Solve for Tomorrow</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-orange text-white mb-10 min-h-[340px] flex flex-col justify-between">
        <div class="flex items-start justify-between flex-wrap gap-3">
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">💡 Innovación social STEM</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Aliado: Samsung</span>
          </div>
          <span class="text-8xl md:text-9xl leading-none" aria-hidden="true">💡</span>
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">Programa · Explora</span>
          <h1 class="heading-giant text-balance mt-2 mb-3">Solve for Tomorrow</h1>
          <p class="text-xl md:text-2xl font-black leading-tight mb-3">
            Tu comunidad tiene un problema. Tú tienes con qué resolverlo.
          </p>
          <p class="text-base md:text-lg font-semibold opacity-95 max-w-3xl leading-relaxed">
            El concurso de Samsung donde estudiantes de colegios públicos convierten un
            problema real de su barrio en una solución con tecnología. Y aquí te
            preparamos para lograrlo.
          </p>
        </div>
      </div>

      <!-- ¿Por qué participar? -->
      <section class="mb-12">
        <h2 class="heading-huge mb-2">¿Por qué meterte en esto?</h2>
        <p class="text-base md:text-lg leading-relaxed mb-6" style="color: var(--fg-muted);">
          Porque te llevas mucho más que un concurso.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {razones.map((r) => (
            <div class="bento-card flex items-start gap-4">
              <span class="text-4xl shrink-0" aria-hidden="true">{r.i}</span>
              <div>
                <h3 class="font-black text-base md:text-lg leading-tight">{r.t}</h3>
                <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">{r.d}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Qué es (breve) -->
      <div class="bento-card-color bg-bento-cyan mb-12">
        <span class="chip-bento mb-3 bg-black/10">En una frase</span>
        <p class="text-lg md:text-xl font-black leading-snug">
          Mira tu entorno, encuentra un problema que de verdad importe y resuélvelo con
          ciencia y tecnología.
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          Es el modelo <strong>MILC</strong> en acción: investigar tu territorio y crear
          tecnología con sentido. Tu proyecto puede ir sobre medio ambiente, salud, tu
          comunidad o el deporte — lo que te mueva.
        </p>
      </div>

      <!-- ¿Es para ti? -->
      <section class="mb-12">
        <h2 class="heading-huge mb-3">¿Esto es para ti?</h2>
        <p class="text-base md:text-lg leading-relaxed mb-6">
          No necesitas ser un genio ni tener un laboratorio carísimo. Necesitas
          <strong>mirar tu barrio con atención y atreverte a proponer</strong>. Si te suena,
          esto es para ti:
        </p>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
          {requisitos.map((r) => (
            <div class="bento-card flex items-center gap-3 py-4">
              <span class="text-2xl shrink-0" aria-hidden="true">{r.i}</span>
              <span class="font-bold text-sm leading-tight">{r.t}</span>
            </div>
          ))}
        </div>
        <div class="bento-card border-l-4 border-bento-orange">
          <p class="text-sm md:text-base leading-relaxed">
            <strong>Y desde Cartago tienes una ventaja:</strong> nadie entiende los problemas de tu
            territorio mejor que quien vive en él. Esa cercanía es justo lo que hace
            ganadora a una propuesta.
          </p>
        </div>
      </section>

      <!-- Impacto -->
      <section class="mb-12">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge leading-tight">No empiezas de cero.</h2>
          <span class="chip-bento">10 años en Colombia</span>
        </div>
        <p class="text-base leading-relaxed mb-6" style="color: var(--fg-muted);">
          Te sumas a una historia que ya transformó comunidades en todo el país.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {stats.map((s) => (
            <div class="bento-card text-center">
              <div class="text-3xl md:text-4xl font-black tracking-tight text-bento-orange">{s.n}</div>
              <div class="text-xs font-bold uppercase tracking-widest mt-1" style="color: var(--fg-muted);">{s.l}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Prepárate con ConectaTE -->
      <section class="mb-12">
        <div class="bento-card-color bg-bento-black grid-pattern text-white py-10 px-6 md:px-10">
          <div class="text-center mb-8 max-w-2xl mx-auto">
            <span class="chip-bento mb-3 bg-white/10 text-white">Tu ventaja para ganar</span>
            <h2 class="heading-huge mb-3 leading-tight">Prepárate con ConectaTE.</h2>
            <p class="text-base md:text-lg opacity-80 leading-relaxed">
              La parte que decide el concurso es la <strong>propuesta</strong>: cinco pasos para
              pasar de una idea suelta a una solución sólida. Te armamos una guía para
              dominarlos.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 mb-8">
            {etapas.map((e) => (
              <div class="rounded-bento p-4 bg-white/10">
                <span class="w-7 h-7 rounded-full bg-bento-lime text-neutral-950 flex items-center justify-center text-xs font-black mb-2">{e.n}</span>
                <h3 class="font-black text-sm leading-tight mb-1">{e.t}</h3>
                <p class="text-xs leading-relaxed opacity-80">{e.d}</p>
              </div>
            ))}
          </div>

          <div class="text-center">
            <a href={guiaPdf} download class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-bento-lime text-neutral-950 font-black hover:opacity-90 transition-opacity">
              Descargar la guía completa (PDF)
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <p class="text-xs opacity-70 mt-3">10 páginas con ejemplos de Cartago, claves de alto valor y rúbrica de autoevaluación.</p>
          </div>
        </div>
      </section>

      <!-- La guía en 5 formatos -->
      <section class="mb-12">
        <h2 class="heading-huge mb-3">La guía, como mejor se te grabe</h2>
        <p class="text-base md:text-lg leading-relaxed mb-6" style="color: var(--fg-muted);">
          El mismo contenido en cinco formatos: míralo de un vistazo, recórrelo en
          slides, velo en video, escúchalo como pódcast o léelo completo.
        </p>

        <!-- Infografía · resumen visual -->
        <figure class="bento-card mb-6">
          <img
            src={infografia}
            alt="Resumen visual de la ruta hacia una propuesta de alto valor: las etapas del Design Thinking, el sello de «alto valor» y los requisitos de participación."
            loading="lazy"
            decoding="async"
            width="1760"
            height="982"
            class="w-full h-auto rounded-bento-sm"
          />
          <figcaption class="text-xs mt-3" style="color: var(--fg-muted);">🖼️ La ruta completa de un vistazo.</figcaption>
        </figure>

        <!-- Presentación · slides -->
        <div class="mb-6">
          <h3 class="font-black text-lg mb-3">🎞️ La presentación, en 15 slides</h3>
          <SlidesViewer presentacion={presentacionSft} slides={slidesSft} dirNombre="sft-propuesta" />
        </div>

        <!-- Video -->
        <div class="mb-6">
          <h3 class="font-black text-lg mb-3">▶️ El video</h3>
          <VideoSesion data={video} />
        </div>

        <!-- Pódcast -->
        <div class="mb-6">
          <h3 class="font-black text-lg mb-3">🎧 El pódcast</h3>
          <AudioPodcast
            src={podcast}
            titulo="Construye una propuesta de alto valor"
            descripcion="Escucha la guía como un pódcast, de camino al colegio o mientras dibujas tu prototipo."
            meta="≈ 8 min · 32 MB"
          />
        </div>

        <!-- PDF completo · visor -->
        <div>
          <h3 class="font-black text-lg mb-3">📄 La guía completa, para leer o descargar</h3>
          <VisorPdf
            src={guiaPdf}
            titulo="Construye una propuesta de alto valor"
            etiqueta="📘 Guía ConectaTE"
            altura="82vh"
          />
        </div>
      </section>

      <!-- CTA oficial -->
      <a
        href={sitioOficial}
        target="_blank"
        rel="noopener"
        class="bento-card-color bg-bento-orange text-white flex items-center gap-4 mb-10 hover:scale-[1.01] transition-transform group"
      >
        <div class="text-5xl shrink-0" aria-hidden="true">🚀</div>
        <div class="flex-1">
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">¿Listos? Inscripción oficial</span>
          <div class="font-black text-xl leading-tight mt-1">Inscribe tu proyecto en Samsung</div>
          <div class="text-sm opacity-90 mt-1">La inscripción es exclusivamente en el sitio oficial, en las fechas vigentes. El docente registra el equipo.</div>
        </div>
        <svg class="w-7 h-7 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>

      <!-- Créditos / aclaración -->
      <div class="bento-card mb-10 border-l-4 border-bento-orange">
        <span class="chip-bento mb-3">🤝 Créditos y aclaración</span>
        <p class="text-sm leading-relaxed mt-2" style="color: var(--fg-muted);">
          <strong style="color: var(--fg);">Solve for Tomorrow</strong> es un programa y marca de
          <strong style="color: var(--fg);">Samsung Electronics</strong>. Este espacio es material de
          <strong style="color: var(--fg);">preparación pedagógica independiente</strong> de la I.E. Sor María
          Juliana, en su plataforma ConectaTE, <strong style="color: var(--fg);">sin afiliación ni respaldo
          oficial</strong> de Samsung. La inscripción y las bases son exclusivamente las del
          <a href={sitioOficial} target="_blank" rel="noopener" class="underline hover:opacity-70">sitio oficial</a>.
        </p>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver a</div>
          <div class="font-black text-lg">Explora</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

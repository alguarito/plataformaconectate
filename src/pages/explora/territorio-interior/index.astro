---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categorias, getMomentosActivos, TOTAL_MOMENTOS } from '../../../data/territorioInterior';

const base = import.meta.env.BASE_URL;
const primerActivo = getMomentosActivos()[0];

// Para qué existe el programa (espeja el bloque de objetivos de Salomé).
const OBJETIVOS = [
  { i: '🧭', t: 'Comprender los fenómenos que nos afectan, en vez de temerlos a ciegas.' },
  { i: '🫁', t: 'Regular el propio miedo con técnicas que se practican, no con consejos.' },
  { i: '🤝', t: 'Acompañar a otro sin interrogarlo ni apurarle el dolor.' },
  { i: '🪢', t: 'Devolverle al territorio lo que sostiene: la minga como forma de aprender.' },
];
---

<BaseLayout
  title="Territorio interior · Educación socioemocional — Explora · ConectaTE"
  description="Programa de educación socioemocional de 6.º a 11.º: comprender lo que sentimos, sostener el miedo y acompañar a otro. Dos bloques, seis niveles, sesenta guías, con la minga y los saberes del suroccidente colombiano como raíz."
  ogType="article"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/explora`} class="hover:opacity-60 transition-opacity">Explora</a>
        <span>/</span>
        <span style="color: var(--fg);">Territorio interior</span>
      </nav>

      <!-- Hero -->
      <div class="bento-card-color bg-bento-teal text-white mb-10 min-h-[340px] flex flex-col justify-between">
        <div class="flex items-start justify-between flex-wrap gap-3">
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">🫂 Educación socioemocional</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">6.º a 11.º</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">{TOTAL_MOMENTOS} guías</span>
          </div>
          <span class="text-8xl md:text-9xl leading-none" aria-hidden="true">🫂</span>
        </div>
        <div>
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">Programa · Explora</span>
          <h1 class="heading-giant text-balance mt-2 mb-4">Territorio interior</h1>
          <p class="text-base md:text-lg font-semibold opacity-95 max-w-3xl leading-relaxed">
            Para el pueblo nasa, <em>kiwe</em> nombra a la vez el territorio, el mundo
            y el cosmos; por eso el terremoto de 1994 no se leyó como desastre natural
            sino como una desarmonía del territorio. Este programa extiende esa idea
            hacia adentro: comprender lo que sentimos, sostener el miedo y aprender a
            acompañar a otro sin hacerle daño.
          </p>
        </div>
      </div>

      <!-- CTA de la guía disponible -->
      {primerActivo && (
        <a
          href={`${base}/explora/territorio-interior/${primerActivo.nivel.slug}/${primerActivo.momento.slug}`}
          class="bento-card-color bg-bento-blue text-white flex items-center gap-4 mb-10 hover:scale-[1.01] transition-transform group"
        >
          <div class="text-5xl shrink-0" aria-hidden="true">🌍</div>
          <div class="flex-1">
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">
              Grado {primerActivo.nivel.grado}.º · Momento {primerActivo.momento.numero} · Disponible
            </span>
            <div class="font-black text-xl leading-tight mt-1">{primerActivo.momento.nombre}</div>
            <div class="text-sm opacity-80 mt-1">{primerActivo.momento.foco}</div>
          </div>
          <svg class="w-7 h-7 shrink-0 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      )}

      <!-- Qué es el programa -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-4">De qué se trata</span>
        <p class="text-base md:text-lg leading-relaxed mb-5">
          <strong>Territorio interior</strong> es el espacio donde se trabaja lo que
          casi nunca cabe en una clase: el miedo, la rabia, el duelo, la exclusión y
          el cuidado. No es una charla ni una campaña: son guías con la misma
          estructura MILC de siempre — saber ancestral, saber de hoy, pregunta puente
          y un producto que se entrega. Aquí se escucha; no se interroga.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-2">
          {OBJETIVOS.map((o) => (
            <div class="flex items-start gap-3 p-3 rounded-bento-sm" style="background: var(--bg);">
              <span class="text-2xl shrink-0" aria-hidden="true">{o.i}</span>
              <span class="text-sm leading-relaxed">{o.t}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- La ruta del programa: 2 bloques × 3 niveles -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge">La ruta del programa</h2>
          <span class="chip-bento">2 bloques · 6 niveles · 10 guías cada uno</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          {categorias.map((cat) => (
            <div class="bento-card">
              <div class="flex items-baseline justify-between gap-2 flex-wrap mb-1">
                <h3 class="font-black text-lg leading-tight">{cat.nombre}</h3>
                <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">
                  {cat.verbo} · {cat.rango}
                </span>
              </div>
              <p class="text-sm leading-relaxed mb-4" style="color: var(--fg-muted);">{cat.descripcion}</p>
              <ol class="space-y-2">
                {cat.niveles.map((nivel) => {
                  const listas = nivel.momentos.filter((m) => m.estado === 'activo').length;
                  return (
                    <li>
                      <a
                        href={`${base}/explora/territorio-interior/${nivel.slug}`}
                        class="block hover:opacity-80 transition-opacity"
                        aria-label={`Abrir el nivel de grado ${nivel.grado}: ${nivel.nombre}`}
                      >
                        <div
                          class="flex items-center gap-3 p-3 rounded-bento-sm border-2"
                          style="border-color: var(--border); background: var(--bg);"
                        >
                          <span class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-black shrink-0 bg-bento-teal text-white">
                            {nivel.grado}
                          </span>
                          <div class="flex-1 min-w-0">
                            <div class="font-bold text-sm leading-tight">{nivel.nombre}</div>
                            <div class="text-xs mt-0.5" style="color: var(--fg-muted);">{nivel.enunciado}</div>
                          </div>
                          {listas > 0 ? (
                            <span class="text-[10px] font-black uppercase tracking-widest px-2 py-1 rounded-full bg-bento-teal text-white shrink-0">
                              {listas} de 10
                            </span>
                          ) : (
                            <span class="text-[10px] font-black uppercase tracking-widest shrink-0" style="color: var(--fg-muted);">
                              Ver ruta
                            </span>
                          )}
                        </div>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
        </div>
      </section>

      <!-- Cómo se trabaja aquí -->
      <div class="bento-card mb-10 border-l-4 border-bento-teal">
        <span class="chip-bento mb-4">🧭 Tres reglas de este espacio</span>
        <p class="text-sm leading-relaxed mb-4" style="color: var(--fg-muted);">
          No son de estilo: salen de la evidencia disponible y valen para las {TOTAL_MOMENTOS} guías.
        </p>
        <div class="space-y-4 mt-2">
          <div>
            <h3 class="font-black text-base">Nadie tiene que revivir lo que vivió</h3>
            <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
              En 2009 un grupo de trabajo de la OMS concluyó que a quien está muy
              angustiado por un hecho reciente hay que ofrecerle primera ayuda
              psicológica y no el llamado <em>debriefing</em> psicológico. Aquí se
              escucha; no se interroga.
            </p>
          </div>
          <div>
            <h3 class="font-black text-base">Nadie tiene que encontrarle el lado bueno</h3>
            <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
              El crecimiento postraumático autoinformado se asocia con más malestar,
              no con menos (Frazier et al., 2009). No se enseña, no se pide y no se evalúa.
            </p>
          </div>
          <div>
            <h3 class="font-black text-base">La escuela acompaña, no trata</h3>
            <p class="text-sm leading-relaxed mt-1" style="color: var(--fg-muted);">
              En la pirámide del IASC (2007) el colegio es el nivel 2: sostiene rutina,
              vínculo e información veraz. Cada guía trae su ruta de derivación.
            </p>
          </div>
        </div>
        <p class="text-xs leading-relaxed mt-5 pt-4 border-t" style="border-color: var(--border); color: var(--fg-muted);">
          Respaldo normativo: Ministerio de Educación Nacional (2025),
          <strong style="color: var(--fg);">Escuela, territorio de vida</strong> — Política de Gestión
          Integral del Riesgo Escolar y Educación en Emergencias, adoptada por la
          Resolución 006519 del 1 de abril de 2025, que sitúa la atención psicosocial
          como primera acción en la respuesta.
        </p>
      </div>

      <!-- Volver -->
      <a href={`${base}/explora`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver a</div>
          <div class="font-black text-lg">Explora</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

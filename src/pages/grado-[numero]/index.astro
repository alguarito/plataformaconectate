---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PeriodoCard from '../../components/PeriodoCard.astro';
import OnboardingGrado from '../../components/OnboardingGrado.astro';
import { grados } from '../../data/grados';

export function getStaticPaths() {
  return grados.map((g) => ({
    params: { numero: String(g.numero) },
    props: { grado: g },
  }));
}

const { grado } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`Grado ${grado.numero}° — ${grado.titulo} · ConectaTE`}
  description={`${grado.descripcion} · 30 guías + 3 proyectos integradores en 3 períodos.`}
  imagen={`/og/grado-${grado.numero}.png`}
>
  <!-- Header del grado -->
  <section class="pt-12 pb-12">
    <div class="bento-container">
      <a
        href={base || '/'}
        class="inline-flex items-center gap-2 text-sm font-semibold mb-8 hover:opacity-60 transition-opacity"
        style="color: var(--fg-muted);"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
        Inicio
      </a>

      <!-- Hero del grado: card grande de color + info al lado -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
        <!-- Card grande de color con número -->
        <div class={`bento-card-color ${grado.bgClass} md:col-span-5 flex flex-col justify-between min-h-[320px]`}>
          <div class="flex items-start justify-between">
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Grado</span>
            <span class="text-7xl">{grado.icono}</span>
          </div>
          <div class="text-[12rem] md:text-[14rem] font-black tracking-tighter leading-none -mb-4">
            {grado.numero}°
          </div>
        </div>

        <!-- Info -->
        <div class="md:col-span-7 flex flex-col justify-center">
          <span class="chip-bento mb-4 self-start">Tecnología e Informática</span>
          <h1 class="heading-giant text-balance mb-4">{grado.titulo}</h1>
          <p class="text-lg md:text-xl text-balance leading-relaxed" style="color: var(--fg-muted);">
            {grado.descripcion}
          </p>
        </div>
      </div>
    </div>
  </section>

  {grado.enConstruccion ? (
    <section class="pb-24">
      <div class="bento-container">
        <div class="bento-card relative overflow-hidden">
          <div class="flex flex-col items-start gap-5 max-w-2xl">
            <span class="chip-bento bg-bento-yellow text-neutral-950">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
                <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
              </svg>
              En construcción
            </span>
            <h2 class="heading-huge">
              El currículum de {grado.numero}° aún se está afinando.
            </h2>
            <p class="text-lg md:text-xl leading-relaxed" style="color: var(--fg-muted);">
              Por ahora el trabajo de aula se concentra en los grados <strong>8°, 9°, 10° y 11°</strong>,
              donde el contrato editorial MILC v3 ya está consolidado.
              El plan de {grado.numero}° se libera cuando alcance la misma profundidad
              (saber ancestral, triángulo de pensamiento, evaluación liberadora, contenido
              web enriquecido).
            </p>
            <p class="text-base leading-relaxed" style="color: var(--fg-muted);">
              Mientras tanto, puedes consultar la propuesta general del año en el
              <a href={`${base}/plan-de-area`} class="font-bold underline underline-offset-4 hover:opacity-80">Plan de Área 2025</a>.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a href={base || '/'} class="btn-bento px-6 py-3">Volver al inicio</a>
              <a
                href={`${base}/grado-8`}
                class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-bold ring-1 hover:bg-[var(--border)] transition-colors"
                style="color: var(--fg); border-color: var(--border);"
              >
                Explorar grado 8°
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <!-- Períodos -->
    <section class="pb-24">
      <div class="bento-container">
        <div class="mb-8">
          <span class="chip-bento mb-3">3 Períodos</span>
          <h2 class="heading-huge">Estructura del año.</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
          {
            grado.periodos.map((p) => (
              <PeriodoCard
                numero={p.numero}
                titulo={p.titulo}
                descripcion={p.descripcion}
                bgClass={p.bgClass}
                totalGuias={p.totalGuias}
                grado={grado.numero}
                href={`${base}/grado-${grado.numero}/periodo-${p.numero}`}
              />
            ))
          }
        </div>
      </div>
    </section>

    <OnboardingGrado
      grado={grado.numero}
      periodoHref={`${base}/grado-${grado.numero}/periodo-1`}
    />
  )}
</BaseLayout>

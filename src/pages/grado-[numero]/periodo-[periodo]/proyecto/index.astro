---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CompletarBoton from '../../../../components/CompletarBoton.astro';
import CompartirWhatsApp from '../../../../components/CompartirWhatsApp.astro';
import { grados } from '../../../../data/grados';
import { getContenidoProyecto, type LenteTriangulo } from '../../../../data/proyectosContenido/_index';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const g of grados) {
    if (g.enConstruccion) continue;
    for (const p of g.periodos) {
      paths.push({
        params: { numero: String(g.numero), periodo: String(p.numero) },
        props: { grado: g, periodo: p },
      });
    }
  }
  return paths;
}

const { grado, periodo } = Astro.props;
const base = import.meta.env.BASE_URL;

const proyecto = getContenidoProyecto(grado.numero, periodo.numero);
const pdfHref = proyecto ? `${base}/proyectos/${proyecto.pdf}` : '';

// Estética del triángulo: una clase de color por lente.
const lenteStyles: Record<LenteTriangulo, { chip: string; ring: string; label: string }> = {
  dussel:  { chip: 'bg-bento-purple text-white',  ring: 'ring-bento-purple/40',  label: 'Dussel · voz reconocida' },
  estoico: { chip: 'bg-bento-cyan text-white',    ring: 'ring-bento-cyan/40',    label: 'Estoico · disciplina del tiempo' },
  floridi: { chip: 'bg-bento-orange text-white',  ring: 'ring-bento-orange/40',  label: 'Floridi · infoesfera' },
};
---

<BaseLayout
  title={`Proyecto Integrador · Grado ${grado.numero}° P${periodo.numero}: ${periodo.titulo} — ConectaTE`}
  description={(() => {
    if (!proyecto) {
      return `Proyecto integrador del Período ${periodo.numero}: ${periodo.titulo}. Grado ${grado.numero}° · I.E. Sor María Juliana.`;
    }
    const partes: string[] = [];
    if (proyecto.titulo) partes.push(proyecto.titulo + '.');
    if (proyecto.reto) partes.push(proyecto.reto.trim());
    const entregables = (proyecto.entregables ?? []).slice(0, 2).map((e) => e.titulo).filter(Boolean);
    if (entregables.length > 0) partes.push(`Entregables: ${entregables.join(' · ')}.`);
    if (proyecto.duracionSemanas) partes.push(`${proyecto.duracionSemanas} semanas · modalidad ${proyecto.modalidad}.`);
    let d = partes.join(' ').replace(/\s+/g, ' ').trim();
    if (d.length > 160) d = d.slice(0, 157).trimEnd() + '…';
    return d;
  })()}
  ogType="article"
  imagen={`/og/grado-${grado.numero}-periodo-${periodo.numero}.png`}
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/grado-${grado.numero}`} class="hover:opacity-60 transition-opacity">
          Grado {grado.numero}°
        </a>
        <span>/</span>
        <a href={`${base}/grado-${grado.numero}/periodo-${periodo.numero}`} class="hover:opacity-60 transition-opacity">
          Período {periodo.numero}
        </a>
        <span>/</span>
        <span style="color: var(--fg);">Proyecto integrador</span>
      </nav>

      <!-- Hero card -->
      <div class={`bento-card-color ${periodo.bgClass} mb-10 min-h-[360px] flex flex-col justify-between`}>
        <div class="flex items-start justify-between flex-wrap gap-3">
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              Grado {grado.numero}°
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              Período {periodo.numero}
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              🎯 Proyecto integrador
            </span>
            {proyecto && (
              <>
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
                  {proyecto.duracionSemanas} semanas
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
                  {proyecto.modalidad}
                </span>
              </>
            )}
          </div>
          <span class="text-9xl">🎯</span>
        </div>

        <div>
          <span class="text-xs font-bold uppercase tracking-widest opacity-80">
            Proyecto Integrador · {periodo.titulo}
          </span>
          <h1 class="heading-giant text-balance mt-2 mb-4">
            {proyecto?.titulo ?? 'Aplica todo lo aprendido.'}
          </h1>
          {proyecto?.reto && (
            <p class="text-sm md:text-base font-semibold opacity-95 max-w-3xl leading-relaxed">
              <strong>Reto:</strong> {proyecto.reto}
            </p>
          )}
        </div>
      </div>

      {proyecto && (
        <>
          <!-- Acciones rápidas: descargar PDF -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 mb-10">
            <a
              href={pdfHref}
              download
              class="bento-card-color bg-bento-lime flex items-center gap-4 hover:scale-[1.01] transition-transform group"
            >
              <div class="text-5xl">📄</div>
              <div class="flex-1">
                <span class="text-xs font-bold uppercase tracking-widest opacity-80">PDF imprimible</span>
                <div class="font-black text-xl leading-tight mt-1">Descargar proyecto</div>
                <div class="text-sm opacity-80 mt-1">Brief completo · entregables · rúbrica</div>
              </div>
              <svg class="w-7 h-7 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>

            <a
              href={pdfHref}
              target="_blank"
              rel="noopener"
              class="bento-card-hover flex items-center gap-4"
            >
              <div class="text-5xl">👁️</div>
              <div class="flex-1">
                <span class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Vista previa</span>
                <div class="font-black text-xl leading-tight mt-1">Abrir en pestaña nueva</div>
                <div class="text-sm mt-1" style="color: var(--fg-muted);">Para revisarlo antes de descargar</div>
              </div>
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

          <!-- Visor PDF embebido -->
          <div class="bento-card mb-10 p-0 overflow-hidden">
            <div class="px-6 py-4 border-b" style="border-color: var(--border);">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div>
                  <span class="chip-bento">Proyecto completo · PDF</span>
                </div>
                <div class="text-sm font-semibold" style="color: var(--fg-muted);">
                  {proyecto.pdf.replace('.pdf', '')}
                </div>
              </div>
            </div>
            <div class="hidden md:block md:aspect-[3/4] w-full bg-black/5">
              <iframe
                src={pdfHref}
                class="w-full h-full"
                loading="lazy"
                title={`Proyecto integrador · Grado ${grado.numero}° P${periodo.numero}`}
              ></iframe>
            </div>
            <a
              href={pdfHref}
              target="_blank"
              rel="noopener"
              class="md:hidden flex items-center gap-3 px-6 py-8 bg-bento-blue text-white hover:opacity-90 transition-opacity"
            >
              <div class="text-5xl shrink-0">🎯</div>
              <div class="flex-1 min-w-0">
                <div class="text-xs font-bold uppercase tracking-widest opacity-80">Proyecto · PDF</div>
                <div class="font-black text-lg leading-tight mt-1">Toca para abrir en pestaña nueva</div>
                <div class="text-xs opacity-80 mt-1">Se ve mejor en tu visor PDF del celular</div>
              </div>
              <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>

          <!-- Anclaje ancestral -->
          {proyecto.anclaje && (
            <div class="bento-card-color bg-bento-yellow mb-10">
              <span class="chip-bento mb-4 bg-black/15">🌱 Anclaje ancestral</span>
              <p class="text-base md:text-lg leading-relaxed mt-3">
                {proyecto.anclaje}
              </p>
            </div>
          )}

          <!-- DBA + estrategia -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
            <div class="bento-card-color bg-bento-purple md:col-span-7 min-h-[160px] flex flex-col justify-between">
              <span class="text-xs font-bold uppercase tracking-widest opacity-80">DBA del periodo</span>
              <div class="text-base md:text-lg font-bold leading-relaxed mt-3">
                {proyecto.dba}
              </div>
            </div>
            <div class="bento-card-color bg-bento-cyan md:col-span-5 min-h-[160px] flex flex-col justify-between">
              <span class="text-xs font-bold uppercase tracking-widest opacity-80">Estrategia</span>
              <div class="text-base md:text-lg font-bold leading-relaxed mt-3">
                {proyecto.estrategia}
              </div>
            </div>
          </div>

          <!-- Insumos -->
          {proyecto.insumos.length > 0 && (
            <div class="bento-card mb-10">
              <span class="chip-bento mb-4">Insumos · qué necesita el equipo para arrancar</span>
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-5">
                {proyecto.insumos.map((insumo) => (
                  <li class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-md bg-bento-lime/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">
                      📦
                    </span>
                    <span class="text-sm leading-relaxed">{insumo}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Aprendizajes que integra -->
          {proyecto.aprendizajes.length > 0 && (
            <div class="bento-card mb-10">
              <span class="chip-bento mb-4">Aprendizajes del periodo que se ponen a prueba</span>
              <p class="text-sm mt-3 mb-5" style="color: var(--fg-muted);">
                Las 10 sesiones del período cuyas competencias se ponen en juego en este proyecto.
              </p>
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4">
                {proyecto.aprendizajes.map((a) => (
                  <li class="flex items-start gap-3">
                    <span class="w-7 h-7 rounded-bento-sm bg-bento-blue text-white flex items-center justify-center text-xs font-black shrink-0 mt-0.5">
                      {a.sesion}
                    </span>
                    <span class="text-sm leading-relaxed">{a.titulo}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Entregables -->
          {proyecto.entregables.length > 0 && (
            <section class="mb-10">
              <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
                <h2 class="heading-huge">Entregables del proyecto</h2>
                <span class="chip-bento">{proyecto.entregables.length} entregables</span>
              </div>
              <p class="text-sm mb-6" style="color: var(--fg-muted);">
                Cada entregable es una unidad cerrada: qué se entrega, cómo se hace, reflexión incrustada del triángulo (Dussel · Estoico · Floridi), y criterios observables.
              </p>

              <div class="space-y-6">
                {proyecto.entregables.map((e) => {
                  const lente = lenteStyles[e.reflexion.lente];
                  return (
                    <article class={`bento-card ring-1 ${lente.ring}`}>
                      <header class="flex items-start gap-4 mb-4 flex-wrap">
                        <span class="w-12 h-12 rounded-bento-sm bg-bento-blue text-white flex items-center justify-center text-xl font-black shrink-0">
                          {e.numero}
                        </span>
                        <div class="flex-1 min-w-[200px]">
                          <h3 class="text-xl md:text-2xl font-black leading-tight">
                            {e.titulo}
                          </h3>
                          <span class={`inline-block mt-2 px-3 py-1 rounded-full text-xs font-black uppercase tracking-widest ${lente.chip}`}>
                            {lente.label}
                          </span>
                        </div>
                      </header>

                      <div class="space-y-5 mt-5">
                        <div>
                          <h4 class="text-sm font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Qué entregas</h4>
                          <p class="text-sm md:text-base leading-relaxed">{e.queEntregas}</p>
                        </div>

                        {e.comoSeHace.length > 0 && (
                          <div>
                            <h4 class="text-sm font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Cómo se hace</h4>
                            <ol class="space-y-2 mt-2">
                              {e.comoSeHace.map((paso, i) => (
                                <li class="flex items-start gap-3">
                                  <span class="w-6 h-6 rounded-md bg-bento-yellow/30 text-black flex items-center justify-center text-xs font-black shrink-0 mt-0.5">
                                    {i + 1}
                                  </span>
                                  <span class="text-sm leading-relaxed">{paso}</span>
                                </li>
                              ))}
                            </ol>
                          </div>
                        )}

                        {e.reflexion.consigna && (
                          <div class="bg-black/[0.03] dark:bg-white/[0.03] rounded-bento-sm p-4">
                            <h4 class="text-sm font-black uppercase tracking-widest mb-2">
                              💭 {e.reflexion.titulo || 'Reflexión incrustada'}
                            </h4>
                            <p class="text-sm md:text-base leading-relaxed italic">
                              {e.reflexion.consigna}
                            </p>
                          </div>
                        )}

                        {e.criterios.length > 0 && (
                          <div>
                            <h4 class="text-sm font-black uppercase tracking-widest mb-2" style="color: var(--fg-muted);">Criterios observables</h4>
                            <ul class="space-y-2 mt-2">
                              {e.criterios.map((c) => (
                                <li class="flex items-start gap-3">
                                  <span class="w-5 h-5 rounded-md border-2 border-current flex items-center justify-center shrink-0 mt-0.5">
                                    <span class="text-[10px] font-black">✓</span>
                                  </span>
                                  <span class="text-sm leading-relaxed">{c}</span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          )}

          <!-- Rúbrica -->
          {proyecto.rubrica.length > 0 && (
            <div class="bento-card mb-10">
              <span class="chip-bento mb-4">Rúbrica de evaluación</span>
              <p class="text-sm mt-2 mb-5" style="color: var(--fg-muted);">
                Un criterio por entregable + uno transversal de comunicación/triángulo. Niveles: Excelente (5) · Aceptable (3) · Por mejorar (1).
              </p>
              <div class="overflow-x-auto -mx-6 md:mx-0">
                <table class="w-full text-sm border-separate border-spacing-0 min-w-[640px] md:min-w-0">
                  <thead>
                    <tr>
                      <th class="text-left p-3 align-top font-black uppercase tracking-widest text-xs" style="color: var(--fg-muted);">Criterio</th>
                      <th class="text-left p-3 align-top">
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-bento-lime text-black text-xs font-black">5 Excelente</span>
                      </th>
                      <th class="text-left p-3 align-top">
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-bento-yellow text-black text-xs font-black">3 Aceptable</span>
                      </th>
                      <th class="text-left p-3 align-top">
                        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-bento-pink text-white text-xs font-black">1 Por mejorar</span>
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {proyecto.rubrica.map((r, i) => {
                      const isGlobal = r.entregable === 'global';
                      const etiqueta = isGlobal
                        ? (r.titulo ?? 'Comunicación e integración del triángulo')
                        : `Entregable ${r.entregable}`;
                      return (
                        <tr class={i % 2 === 1 ? 'bg-black/[0.02] dark:bg-white/[0.02]' : ''}>
                          <td class="p-3 align-top font-bold border-t" style="border-color: var(--border);">
                            {etiqueta}
                          </td>
                          <td class="p-3 align-top leading-relaxed border-t" style="border-color: var(--border);">{r.nivel5}</td>
                          <td class="p-3 align-top leading-relaxed border-t" style="border-color: var(--border);">{r.nivel3}</td>
                          <td class="p-3 align-top leading-relaxed border-t" style="border-color: var(--border);">{r.nivel1}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          <!-- Sustentación -->
          {proyecto.sustentacion.guionSugerido.length > 0 && (
            <div class="bento-card-color bg-bento-orange mb-10">
              <div class="flex items-center justify-between flex-wrap gap-3 mb-4">
                <span class="chip-bento bg-black/15">🎤 Sustentación final</span>
                <span class="text-xs font-black uppercase tracking-widest opacity-90">
                  {proyecto.sustentacion.duracionMin} min
                </span>
              </div>
              <p class="text-sm opacity-90 mb-4">
                Guion sugerido para la presentación final ante el grupo y la profe/el profe.
              </p>
              <ol class="space-y-3 mt-4">
                {proyecto.sustentacion.guionSugerido.map((p, i) => (
                  <li class="flex items-start gap-3">
                    <span class="w-7 h-7 rounded-bento-sm bg-black/15 flex items-center justify-center text-xs font-black shrink-0 mt-0.5">
                      {i + 1}
                    </span>
                    <span class="text-sm md:text-base leading-relaxed">{p}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          <!-- Declaración de IA -->
          {proyecto.declaracionIa && (
            <div class="bento-card mb-10 border-l-4 border-bento-pink">
              <span class="chip-bento mb-3">🤖 Declaración honesta de IA</span>
              <p class="text-sm md:text-base leading-relaxed mt-3">
                {proyecto.declaracionIa}
              </p>
            </div>
          )}

          <!-- Cierre -->
          {proyecto.cierre && (
            <div class="text-center mb-10 px-4">
              <p class="text-base md:text-lg italic leading-relaxed max-w-2xl mx-auto" style="color: var(--fg-muted);">
                {proyecto.cierre}
              </p>
            </div>
          )}

          <CompletarBoton tipo="proyecto" grado={grado.numero} periodo={periodo.numero} />

          <CompartirWhatsApp
            titulo={`Proyecto Integrador · ${periodo.titulo}`}
            contexto={`Grado ${grado.numero}° · Período ${periodo.numero}`}
          />

          <div class="text-center text-sm mt-10 mb-6" style="color: var(--fg-muted);">
            Autor: <strong style="color: var(--fg);">{proyecto.autor}</strong>
          </div>
        </>
      )}

      <!-- Volver -->
      <a
        href={`${base}/grado-${grado.numero}/periodo-${periodo.numero}`}
        class="bento-card-hover flex items-center gap-4"
      >
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al</div>
          <div class="font-black text-lg">Período {periodo.numero}</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

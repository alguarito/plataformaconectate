---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import GradoCard from '../components/GradoCard.astro';
import ProgresoCard from '../components/ProgresoCard.astro';
import { grados } from '../data/grados';
import { programas, fgSobreBento } from '../data/explora';

const base = import.meta.env.BASE_URL;

const gradosConTotales = grados.map((g) => ({
  ...g,
  totalGuias: g.periodos.reduce((sum, p) => sum + p.totalGuias, 0),
  totalPeriodos: g.periodos.length,
}));

// Grados activos primero (enConstruccion al fondo), luego orden numérico.
gradosConTotales.sort((a, b) => {
  const aDisp = a.enConstruccion ? 1 : 0;
  const bDisp = b.enConstruccion ? 1 : 0;
  if (aDisp !== bDisp) return aDisp - bDisp;
  return a.numero - b.numero;
});
---

<BaseLayout imagen="/og/home.png">
  <Hero />

  <ProgresoCard />

  <!-- Bento Grid Asimétrico de Grados -->
  <section id="grados" class="pb-20">
    <div class="bento-container">
      <div class="flex items-end justify-between mb-10 flex-wrap gap-4">
        <div>
          <span class="chip-bento mb-4">Por grados</span>
          <h2 class="heading-huge text-balance max-w-2xl">
            Elige tu grado y empieza a aprender.
          </h2>
        </div>
      </div>

      {/* Chip de filtro activo (solo móvil, oculto por defecto) */}
      <div
        id="grado-filter-chip"
        class="hidden mb-6 md:hidden"
      >
        <button
          type="button"
          data-clear-grado-filter
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full font-bold text-sm bg-bento-blue text-white hover:opacity-90 transition-opacity"
        >
          <span>Filtro: Grado <span data-filter-grado-num>—</span>°</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Grid Bento asimétrico: 6° destaca como LARGE, el resto normal -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 auto-rows-min">
        {gradosConTotales.map((g, i) => (
          <GradoCard
            numero={g.numero}
            titulo={g.titulo}
            descripcion={g.descripcion}
            bgClass={g.bgClass}
            icono={g.icono}
            href={`${base}/grado-${g.numero}`}
            size={i === 0 ? 'large' : 'normal'}
            totalGuias={g.totalGuias}
            totalPeriodos={g.totalPeriodos}
            enConstruccion={g.enConstruccion}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Espacio Explora -->
  <section class="pb-20">
    <div class="bento-container">
      <div class="flex items-end justify-between mb-10 flex-wrap gap-4">
        <div>
          <span class="chip-bento mb-4">Espacio Explora</span>
          <h2 class="heading-huge text-balance max-w-2xl">
            Más allá del currículo.
          </h2>
        </div>
        <a href={`${base}/explora`} class="btn-bento-outline shrink-0 hidden md:inline-flex">
          Ver todos los programas
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
        {programas.map((p, i) => {
          const fgClass = fgSobreBento(p.bgClass);
          const isActivo = p.estado === 'activo';
          const colSpan =
            i === 0 ? 'md:col-span-5' :
            i === 1 ? 'md:col-span-4' :
            i === 2 ? 'md:col-span-3' :
            'md:col-span-6';
          const minH = i < 3 ? 'min-h-[280px]' : 'min-h-[200px]';
          const Wrapper = isActivo ? 'a' : 'div';
          return (
            <Wrapper
              href={isActivo ? `${base}/explora/${p.slug}` : undefined}
              class:list={[
                'bento-card-color flex flex-col justify-between relative',
                p.bgClass, colSpan, minH,
                isActivo && 'group hover:shadow-bento-hover transition-shadow motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/40',
                !isActivo && 'opacity-75 cursor-default',
              ]}
            >
              {!isActivo && (
                <span class="absolute top-4 right-4 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide bg-black/25 text-white">
                  Próximamente
                </span>
              )}
              <div class="text-5xl mb-4" aria-hidden="true">{p.icono}</div>
              <div>
                {p.aliado && (
                  <p class:list={['text-[11px] font-bold uppercase tracking-widest mb-1 opacity-70', fgClass]}>
                    {p.aliado}
                  </p>
                )}
                <h3 class:list={[
                  'font-black tracking-tight mb-1',
                  i < 3 ? 'text-xl md:text-2xl' : 'text-lg md:text-xl',
                  fgClass,
                ]}>{p.nombre}</h3>
                <p class:list={['text-sm opacity-80 leading-snug', fgClass]}>{p.descripcion}</p>
              </div>
            </Wrapper>
          );
        })}
      </div>

      <div class="mt-6 flex justify-center md:hidden">
        <a href={`${base}/explora`} class="btn-bento-outline">
          Ver todos los programas
        </a>
      </div>
    </div>
  </section>

  <!-- Colección MILC -->
  <section class="pb-20">
    <div class="bento-container">
      <div class="flex items-end justify-between mb-10 flex-wrap gap-4">
        <div>
          <span class="chip-bento mb-4">Colección MILC</span>
          <h2 class="heading-huge text-balance max-w-2xl">
            Investigación que enseña.
          </h2>
        </div>
        <a href={`${base}/modelo-milc`} class="btn-bento-outline shrink-0 hidden md:inline-flex">
          Ver colección completa
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
        <!-- Libro principal -->
        <div class="bento-card-color bg-bento-black md:col-span-7 min-h-[320px] flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest opacity-50 mb-5 block">Libro MILC · 226 páginas · 2026</span>
            <svg class="w-10 h-10 mb-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
            <h3 class="text-2xl md:text-3xl font-black tracking-tight mb-2">Educación en la Era Onlife</h3>
            <p class="text-sm opacity-70 leading-snug max-w-sm">
              MILC: Modelo de Investigación Liberadora y Científica. Edición ampliada 2026.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3 mt-6">
            <a
              href={`${base}/modelo-milc`}
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full text-sm font-bold bg-white text-black hover:bg-bento-lime transition-colors"
            >
              Abrir en ConectaTE
            </a>
            <a
              href="https://doi.org/10.5281/zenodo.20518085"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full text-sm font-bold border border-white/30 text-white hover:border-white transition-colors"
              aria-label="Libro MILC en Zenodo (abre en pestaña nueva)"
            >
              DOI · Zenodo
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Tomo I -->
        <div class="bento-card-color bg-bento-purple md:col-span-5 min-h-[320px] flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest opacity-50 mb-5 block">Tomo I · 118 páginas · 2026</span>
            <svg class="w-10 h-10 mb-4 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
            <h3 class="text-2xl font-black tracking-tight mb-2">El Mercado de la Atención</h3>
            <p class="text-sm opacity-70 leading-snug">
              Cómo se disputa la atención de los jóvenes y cómo educar el criterio en la era onlife.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-3 mt-6">
            <a
              href={`${base}/modelo-milc/mercado-atencion`}
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full text-sm font-bold bg-white text-black hover:bg-bento-lime transition-colors"
            >
              Abrir en ConectaTE
            </a>
            <a
              href="https://doi.org/10.5281/zenodo.20644820"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full text-sm font-bold border border-white/30 text-white hover:border-white transition-colors"
              aria-label="Tomo I en Zenodo (abre en pestaña nueva)"
            >
              DOI · Zenodo
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-center md:hidden">
        <a href={`${base}/modelo-milc`} class="btn-bento-outline">
          Ver colección completa
        </a>
      </div>
    </div>
  </section>

  <!-- Sección de Características - Bento -->
  <section class="pb-20">
    <div class="bento-container">
      <div class="mb-10">
        <span class="chip-bento mb-4">¿Qué ofrece?</span>
        <h2 class="heading-huge text-balance max-w-2xl">
          Todo lo que necesitas para aprender.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
        <!-- 190 Guías - Card grande negra -->
        <div class="bento-card-color bg-bento-black md:col-span-6 min-h-[300px] flex flex-col justify-between">
          <div class="text-9xl font-black tracking-tighter leading-none">190</div>
          <div>
            <h3 class="text-3xl md:text-4xl font-black tracking-tight mb-2">Guías de aprendizaje</h3>
            <p class="opacity-70">180 MILC + 10 Bebras · 3 períodos × 6 grados</p>
          </div>
        </div>

        <!-- 18 Proyectos - Lima -->
        <div class="bento-card-color bg-bento-lime md:col-span-3 min-h-[300px] flex flex-col justify-between">
          <div class="text-8xl font-black tracking-tighter leading-none">18</div>
          <div>
            <h3 class="text-2xl font-black tracking-tight mb-1">Proyectos integradores</h3>
            <p class="opacity-80 text-sm">Uno por período</p>
          </div>
        </div>

        <!-- 18 Exámenes - Cyan -->
        <div class="bento-card-color bg-bento-cyan md:col-span-3 min-h-[300px] flex flex-col justify-between">
          <div class="text-8xl font-black tracking-tighter leading-none">18</div>
          <div>
            <h3 class="text-2xl font-black tracking-tight mb-1">Exámenes finales</h3>
            <p class="opacity-80 text-sm">Síntesis y aplicación</p>
          </div>
        </div>

        <!-- Simulaciones - Naranja -->
        <div class="bento-card-color bg-bento-orange md:col-span-4 min-h-[240px] flex flex-col justify-between">
          <div class="text-6xl">🧪</div>
          <div>
            <h3 class="text-2xl font-black tracking-tight mb-1">Simulaciones</h3>
            <p class="opacity-80 text-sm">GeoGebra, Scratch, Tinkercad</p>
          </div>
        </div>

        <!-- Progreso - Pink -->
        <div class="bento-card-color bg-bento-pink md:col-span-4 min-h-[240px] flex flex-col justify-between">
          <div class="text-6xl">📊</div>
          <div>
            <h3 class="text-2xl font-black tracking-tight mb-1">Sigue tu progreso</h3>
            <p class="opacity-80 text-sm">Regístrate y guarda avances</p>
          </div>
        </div>

        <!-- Responsive - Yellow -->
        <div class="bento-card-color bg-bento-yellow md:col-span-4 min-h-[240px] flex flex-col justify-between">
          <div class="text-6xl">📱</div>
          <div>
            <h3 class="text-2xl font-black tracking-tight mb-1">Cualquier dispositivo</h3>
            <p class="opacity-80 text-sm">Móvil, tablet o computador</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Bottom sheet selector de grado (solo móvil) */}
  <dialog
    id="grado-picker-dialog"
    class="md:hidden bg-transparent p-0 m-0 max-w-none w-full max-h-none h-full backdrop:bg-black/60"
  >
    <div class="fixed inset-x-0 bottom-0 max-h-[85vh] overflow-y-auto rounded-t-3xl shadow-2xl" style="background: var(--bg);">
      <div class="p-6">
        {/* Drag handle visual */}
        <div class="w-12 h-1.5 rounded-full mx-auto mb-6" style="background: var(--border);"></div>

        <div class="flex items-start justify-between mb-6">
          <div>
            <span class="chip-bento mb-2">Selecciona</span>
            <h2 class="text-2xl font-black tracking-tight">Tu grado</h2>
          </div>
          <button
            type="button"
            data-close-grado-picker
            aria-label="Cerrar"
            class="w-10 h-10 rounded-full flex items-center justify-center hover:opacity-70 transition-opacity"
            style="background: var(--border);"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6 6 18"></path>
              <path d="m6 6 12 12"></path>
            </svg>
          </button>
        </div>

        <div class="grid grid-cols-2 gap-3 mb-3">
          {grados.map((g) => (
            <button
              type="button"
              data-pick-grado={g.numero}
              class={`bento-card-color ${g.bgClass} text-left p-5 active:scale-95 transition-transform`}
            >
              <div class="text-4xl font-black tracking-tighter leading-none mb-2">
                {g.numero}°
              </div>
              <div class="text-xs font-bold opacity-80 line-clamp-2 leading-tight">
                {g.titulo}
              </div>
            </button>
          ))}
        </div>

        <button
          type="button"
          data-pick-grado="all"
          class="w-full mt-3 py-4 rounded-bento-sm font-bold text-sm border-2 hover:opacity-70 transition-opacity"
          style="border-color: var(--border); color: var(--fg);"
        >
          Ver todos los grados
        </button>
      </div>
    </div>
  </dialog>

  <!-- CTA Final -->
  <section class="pb-24">
    <div class="bento-container">
      <div class="bento-card-color bg-bento-black text-center py-20 px-6 grid-pattern">
        <h2 class="heading-giant text-balance mb-6">
          ¿Listo para empezar?
        </h2>
        <p class="text-lg md:text-xl opacity-70 max-w-xl mx-auto mb-10 text-balance">
          Regístrate gratis y guarda tu progreso. O explora todo el contenido sin cuenta.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href={`${base}/cuenta/unirme`} class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full font-semibold text-sm bg-bento-lime text-black hover:scale-105 transition-transform">
            Unirme con código de aula
          </a>
          <a href="#grados" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full font-semibold text-sm border-2 border-white/30 text-white hover:border-white transition-colors">
            Explorar sin cuenta
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Selector de grado en móvil — filtra la home a un grado o vuelve a "todos"
    const dialog = document.getElementById('grado-picker-dialog') as HTMLDialogElement | null;
    const chip = document.getElementById('grado-filter-chip');
    const chipNum = document.querySelector<HTMLElement>('[data-filter-grado-num]');
    const cards = document.querySelectorAll<HTMLElement>('[data-grado-card]');

    function applyFilter(grado: string | null) {
      if (!grado || grado === 'all') {
        // Mostrar todas
        cards.forEach((c) => c.removeAttribute('data-grado-hidden'));
        chip?.classList.add('hidden');
      } else {
        cards.forEach((c) => {
          if (c.dataset.gradoCard === grado) {
            c.removeAttribute('data-grado-hidden');
          } else {
            c.setAttribute('data-grado-hidden', '');
          }
        });
        if (chip && chipNum) {
          chipNum.textContent = grado;
          chip.classList.remove('hidden');
        }
      }
    }

    // Abrir dialog
    document.querySelectorAll('[data-open-grado-picker]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (typeof dialog?.showModal === 'function') {
          dialog.showModal();
        }
      });
    });

    // Cerrar dialog (botón X)
    document.querySelectorAll('[data-close-grado-picker]').forEach((btn) => {
      btn.addEventListener('click', () => dialog?.close());
    });

    // Cerrar al tocar fuera del contenido (en el backdrop)
    dialog?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog) dialog.close();
    });

    // Seleccionar grado
    document.querySelectorAll<HTMLButtonElement>('[data-pick-grado]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const grado = btn.dataset.pickGrado || null;
        applyFilter(grado);
        dialog?.close();
        // Scroll suave a la sección de grados
        document.getElementById('grados')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // Limpiar filtro desde el chip
    document.querySelectorAll('[data-clear-grado-filter]').forEach((btn) => {
      btn.addEventListener('click', () => applyFilter('all'));
    });
  </script>

  <style is:global>
    /* Oculta tarjetas de grado filtradas (solo aplica si tienen el atributo) */
    [data-grado-card][data-grado-hidden] {
      display: none !important;
    }

    /* Animación suave del bottom sheet al abrir */
    #grado-picker-dialog[open] > div {
      animation: slide-up 0.25s ease-out;
    }
    @keyframes slide-up {
      from { transform: translateY(100%); }
      to { transform: translateY(0); }
    }
  </style>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { libros, tomo, coleccion, listaCapitulos, peso, type Romano } from '../../../data/coleccion';
// Los seis libros salen de src/data/coleccion.json (fuente única, vía coleccion.ts): títulos,
// síntesis, DOI de concepto, capítulos del Tomo 0 que profundiza cada tomo y archivos.
// Tomo 0 = obra matriz (vive en /modelo-milc) · Tomos I–V con ficha propia.

const base = import.meta.env.BASE_URL;

const origen = (Astro.site ?? new URL('https://alguarito.github.io')).toString().replace(/\/$/, '');
const inicio = `${origen}${base.replace(/\/$/, '')}`;

// ─── «Por dónde empezar según…» ───────────────────────────────────────────
const necesidades: { necesidad: string; romano: Romano }[] = [
  { necesidad: 'Mis estudiantes viven distraídos y no logro su atención', romano: 'I' },
  { necesidad: 'Quiero que lo que enseño dialogue con su territorio y su historia', romano: 'II' },
  { necesidad: 'Quiero llevar a mis estudiantes a investigar de verdad', romano: 'III' },
  { necesidad: 'La IA entró a mi aula y no sé con qué criterio usarla', romano: 'IV' },
  { necesidad: 'Quiero fundar un semillero o cambiar el ambiente de mi aula', romano: 'V' },
  { necesidad: 'Quiero entender el modelo completo antes de empezar', romano: '0' },
];
const rutas = necesidades.map((r) => ({ ...r, libro: tomo(r.romano) }));

// ─── Descargas: todos los archivos de cada libro ──────────────────────────
// El Tomo 0 trae cuatro (libro, cuaderno y hojas F01–F16 en Carta y A4).
// download = nombre EXACTO: los enlaces entre libro y cuaderno dependen de él.
const descargas = libros.flatMap((l) =>
  l.archivos.map((a) => {
    const hojas = a.rol === 'hojas-carta' || a.rol === 'hojas-a4';
    const titulo =
      a.rol === 'cuaderno' ? 'Cuaderno de trabajo MILC' : hojas ? `Hojas F01–F16 · ${a.formato}` : l.titulo;
    const detalle = [
      a.paginas ? `${a.paginas} ${hojas ? 'hojas' : 'págs.'}` : '',
      hojas ? '' : (a.formato ?? ''),
      peso(a.bytes),
    ]
      .filter(Boolean)
      .join(' · ');
    return { libro: l, archivo: a, titulo, detalle };
  }),
);

// ─── Cita de la colección completa ────────────────────────────────────────
// La colección no tiene DOI propio: se cita con la URL de su comunidad en Zenodo.
// Cada tomo se cita por su DOI de concepto (bloque «Cómo citar» de su ficha).
const { autor } = coleccion;
const citaTitulo = `${coleccion.titulo}: ${coleccion.subtitulo}`;
const citaAntes = `${autor.apa} (2026). `;
const citaDespues = ` (Tomos 0–V). ${coleccion.sello}. ${coleccion.comunidad_zenodo}`;
const citaApa = `${citaAntes}${citaTitulo}${citaDespues}`;

const citaBibtex = `@collection{cardenas2026coleccion,
  author    = {${autor.bib}},
  title     = {${citaTitulo} (Tomos 0--V)},
  publisher = {${coleccion.sello}},
  address   = {${coleccion.lugar}},
  year      = {2026},
  url       = {${coleccion.comunidad_zenodo}},
  note      = {Obra completa en acceso abierto. DOI de concepto de cada tomo:
               ${libros.map((l) => `${l.etiqueta}: ${l.doi}`).join(';\n               ')}}
}`;

// ─── Schema.org · CollectionPage (referencia los nodos ya definidos) ──────
const jsonLdExtra = [
  {
    '@type': 'CollectionPage',
    '@id': `${inicio}/modelo-milc/coleccion`,
    name: 'La Colección MILC',
    headline: 'Seis libros, una sola pregunta',
    description:
      'Guía de lectura de la Colección MILC: seis libros en acceso abierto, del Tomo 0 al Tomo V, que recorren el arco del acto de aprender (el yo, el nosotros, el cómo, la herramienta y el lugar). Cada tomo con su DOI en Zenodo.',
    inLanguage: 'es-CO',
    url: `${inicio}/modelo-milc/coleccion`,
    isPartOf: { '@id': `${inicio}#website` },
    about: { '@id': `${inicio}/modelo-milc#coleccion` },
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#organization` },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Los seis libros de la Colección MILC',
      numberOfItems: libros.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: libros.map((l, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@id': `${inicio}/modelo-milc#${l.id}` },
      })),
    },
  },
];
---

<BaseLayout
  title="La Colección MILC · seis libros y cómo leerlos — ConectaTE"
  description="Guía de lectura de la Colección MILC: seis libros en acceso abierto, del Tomo 0 al Tomo V. El arco completo (el yo, el nosotros, el cómo, la herramienta y el lugar), la síntesis de cada tomo, por dónde empezar según lo que necesita, y la descarga y cita de la obra entera. Dr. Álvaro Cárdenas Orozco."
  ogType="website"
  imagen="/og/coleccion-milc.png"
  jsonLd={jsonLdExtra}
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/modelo-milc`} class="hover:opacity-60 transition-opacity">Modelo MILC</a>
        <span>/</span>
        <span style="color: var(--fg);">La Colección</span>
      </nav>

      <!-- HERO · invitación a leer la obra -->
      <div class="bento-card-color bg-bento-black grid-pattern text-white mb-10 py-12 md:py-16 px-6 md:px-10">
        <div class="max-w-3xl">
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Colección MILC</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">6 libros · del Tomo 0 al V</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Acceso abierto</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Obra completa 2026</span>
          </div>
          <h1 class="heading-giant text-balance leading-[0.95] mb-4">
            Seis libros,<br />una sola pregunta
          </h1>
          <p class="text-base md:text-lg font-semibold opacity-90 leading-relaxed mb-3">
            La Colección MILC no son seis textos sueltos: es un solo recorrido. Cada tomo toma
            una dimensión del acto de aprender y le hace una pregunta distinta, hasta completar
            las condiciones de un mismo estudiante que aprende.
          </p>
          <p class="text-sm opacity-70 mb-8">
            Dr. Álvaro Cárdenas Orozco · Sor María Juliana Ediciones · I.E. Sor María Juliana,
            Cartago (Valle del Cauca) · Todos los tomos con DOI en Zenodo
          </p>
          <div class="flex items-center gap-2.5 flex-wrap">
            <a href="#libros" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Ver los seis libros ↓
            </a>
            <a href="#empezar" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors">
              ¿Por dónde empiezo?
            </a>
            <a href="#descargas" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-sm font-black opacity-80 hover:opacity-100 transition-opacity">
              Descargar y citar ↓
            </a>
          </div>
        </div>
      </div>

      <!-- EL ARCO · línea visual -->
      <section class="mb-12">
        <span class="chip-bento mb-3">🧭 El arco de la colección</span>
        <h2 class="heading-huge mb-3 leading-tight">De quién aprende, hasta dónde llega a ser.</h2>
        <p class="text-sm md:text-base leading-relaxed mb-6 max-w-3xl" style="color: var(--fg-muted);">
          El orden no es cronológico ni caprichoso: es un arco. El Tomo 0 traza el mapa; los cinco
          siguientes recorren, uno a uno, las condiciones de un mismo sujeto que aprende. El último
          responde la pregunta que las otras cuatro dejaron abierta.
        </p>

        <div class="bento-card">
          <ol class="relative grid grid-cols-1 md:grid-cols-6 gap-5 md:gap-2">
            <!-- Conector: horizontal en escritorio, vertical en móvil -->
            <div
              class="hidden md:block absolute left-[8.33%] right-[8.33%] top-6 h-[2px] -translate-y-1/2"
              style="background: linear-gradient(to right, var(--border), var(--fg-muted));"
              aria-hidden="true"
            >
            </div>
            <div
              class="md:hidden absolute left-6 top-6 bottom-6 w-[2px] -translate-x-1/2"
              style="background: linear-gradient(to bottom, var(--border), var(--fg-muted));"
              aria-hidden="true"
            >
            </div>

            {libros.map((l, i) => {
              const ultimo = i === libros.length - 1;
              return (
                <li class="relative flex md:flex-col items-center md:text-center gap-4 md:gap-0">
                  <span
                    class={`relative z-10 shrink-0 grid place-items-center w-12 h-12 rounded-full text-sm font-black md:mb-3 ${ultimo ? 'text-white' : ''}`}
                    style={
                      ultimo
                        ? 'background: var(--fg); border: 2px solid var(--fg);'
                        : 'background: var(--bg-card); border: 2px solid var(--border); color: var(--fg);'
                    }
                  >
                    {l.romano}
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-black leading-tight md:whitespace-nowrap">{l.dimension}</span>
                    <span class="block text-xs mt-0.5 leading-snug" style="color: var(--fg-muted);">
                      {l.pregunta_corta}
                    </span>
                  </span>
                </li>
              );
            })}
          </ol>
        </div>
      </section>

      <!-- LOS SEIS LIBROS -->
      <section id="libros" class="mb-12 scroll-mt-24">
        <span class="chip-bento mb-3">📚 La obra completa</span>
        <h2 class="heading-huge mb-3 leading-tight">Los seis libros.</h2>
        <p class="text-sm md:text-base leading-relaxed mb-6 max-w-3xl" style="color: var(--fg-muted);">
          Todos en acceso abierto, con DOI propio en Zenodo. Se citan siempre por su
          <em>DOI de concepto</em>, que resuelve a la última versión.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {libros.map((l) => (
            <a href={l.href} class={`bento-card-color ${l.color} ${l.color === 'bg-bento-black' ? 'text-white' : ''} flex flex-col justify-between min-h-[240px] hover:scale-[1.01] transition-transform group`}>
              <div>
                <div class="flex items-start justify-between gap-3 mb-3">
                  <span class="text-xs font-black uppercase tracking-widest opacity-75">
                    Tomo {l.romano} · {l.dimension}
                  </span>
                  <span class="text-3xl leading-none">{l.emoji}</span>
                </div>
                <h3 class="text-xl md:text-2xl font-black leading-tight mb-1">{l.titulo}</h3>
                <p class="text-xs font-bold italic opacity-70 mb-3">{l.pregunta}</p>
                <p class="text-sm leading-relaxed opacity-85">{l.sintesis}</p>
                {l.profundiza.length > 0 && (
                  <p class="text-xs font-bold mt-3 opacity-80">
                    Profundiza los capítulos {listaCapitulos(l.profundiza)} del Tomo 0
                  </p>
                )}
              </div>
              <div class="mt-4 pt-3 border-t border-current/15 flex items-center justify-between gap-2 flex-wrap">
                <span class="text-[11px] font-semibold opacity-70">DOI {l.doi}</span>
                <span class="text-xs font-black group-hover:translate-x-0.5 transition-transform">Ver la ficha →</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- CÓMO LEERLA -->
      <section class="mb-12">
        <span class="chip-bento mb-3">🗺️ Cómo leerla</span>
        <h2 class="heading-huge mb-3 leading-tight">Dos maneras de recorrerla.</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bento-card">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Ruta 1</span>
            <h3 class="text-lg font-black mt-1 mb-2">De corrido</h3>
            <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">
              Del Tomo 0 al V, en orden. Es como fue pensada: se ve el arco completo, cómo cada
              pieza prepara la siguiente y por qué el lugar tenía que ir al final. La lectura más
              exigente y la que más devuelve.
            </p>
          </div>
          <div class="bento-card">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Ruta 2</span>
            <h3 class="text-lg font-black mt-1 mb-2">Por necesidad</h3>
            <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">
              Entrar por el tomo que responde la pregunta que usted tiene hoy. Cada libro se
              sostiene solo: tiene su tesis, su método y sus Ventanas al Aula, y no exige haber
              leído los anteriores.
            </p>
          </div>
        </div>
      </section>

      <!-- POR DÓNDE EMPEZAR -->
      <section id="empezar" class="mb-12 scroll-mt-24">
        <span class="chip-bento mb-3">🎯 Por dónde empezar</span>
        <h2 class="heading-huge mb-3 leading-tight">Según lo que le preocupa hoy.</h2>
        <p class="text-sm md:text-base leading-relaxed mb-6 max-w-3xl" style="color: var(--fg-muted);">
          Si llega sin saber por dónde entrar, busque abajo la frase que más se parezca a lo que
          está viviendo en su aula.
        </p>
        <div class="bento-card divide-y" style="border-color: var(--border);">
          {rutas.map((r) => (
            <a href={r.libro.href} class="flex items-start md:items-center justify-between gap-4 py-4 first:pt-0 last:pb-0 group flex-col md:flex-row">
              <p class="text-sm md:text-base font-semibold leading-snug">«{r.necesidad}»</p>
              <span class="shrink-0 text-xs md:text-sm font-black whitespace-nowrap group-hover:translate-x-0.5 transition-transform" style="color: var(--fg-muted);">
                → {r.libro.etiqueta} · {r.libro.titulo}
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- DESCARGA Y CITA -->
      <section id="descargas" class="mb-10 scroll-mt-24">
        <span class="chip-bento mb-3">⬇️ Descargar y citar</span>
        <h2 class="heading-huge mb-3 leading-tight">La obra entera, gratis.</h2>
        <p class="text-sm md:text-base leading-relaxed mb-6 max-w-3xl" style="color: var(--fg-muted);">
          Los seis libros son de acceso abierto y se pueden descargar, compartir y usar en el aula.
          El Tomo 0 trae, además, su cuaderno de trabajo y las hojas F01–F16 en Carta y en A4.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 mb-3">
          {descargas.map(({ libro: l, archivo: a, titulo, detalle }) => (
            <a href={a.url} download={a.nombre} class="bento-card-hover flex items-center gap-3">
              <span class="text-2xl shrink-0" aria-hidden="true">{l.emoji}</span>
              <span class="min-w-0">
                <span class="block text-[11px] font-black uppercase tracking-widest" style="color: var(--fg-muted);">{l.etiqueta} · PDF</span>
                <span class="block text-sm font-bold leading-tight truncate">{titulo}</span>
                <span class="block text-xs mt-0.5" style="color: var(--fg-muted);">{detalle}</span>
              </span>
            </a>
          ))}
        </div>
        <p class="text-xs leading-relaxed mb-8 max-w-3xl" style="color: var(--fg-muted);">
          Guarde el libro y el cuaderno del Tomo 0 en la misma carpeta y sin cambiarles el nombre:
          así funcionan los enlaces entre los dos.
        </p>

        <div class="bento-card">
          <h3 class="text-lg font-black mb-1">Citar la colección completa</h3>
          <p class="text-xs mb-4" style="color: var(--fg-muted);">
            Para citar un tomo en particular, use el bloque «Cómo citar» de su ficha.
          </p>

          <div class="mb-4">
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">APA 7.ª</span>
              <button type="button" data-copiar={citaApa} class="text-xs font-black px-4 min-h-[44px] inline-flex items-center rounded-full border transition-colors hover:opacity-70" style="border-color: var(--border);">Copiar</button>
            </div>
            <p class="text-sm leading-relaxed p-3 rounded-xl" style="background: var(--bg); color: var(--fg-muted);">{citaAntes}<em>{citaTitulo}</em>{citaDespues}</p>
          </div>

          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">BibTeX</span>
              <button type="button" data-copiar={citaBibtex} class="text-xs font-black px-4 min-h-[44px] inline-flex items-center rounded-full border transition-colors hover:opacity-70" style="border-color: var(--border);">Copiar</button>
            </div>
            <pre class="text-[11px] leading-relaxed p-3 rounded-xl overflow-x-auto" style="background: var(--bg); color: var(--fg-muted);"><code>{citaBibtex}</code></pre>
          </div>
        </div>
      </section>

      <!-- CIERRE -->
      <section>
        <div class="bento-card-color bg-bento-lime">
          <span class="chip-bento mb-3 bg-black/10">🏁 Obra completa</span>
          <p class="text-lg md:text-2xl font-black leading-snug mb-3">
            «El lugar donde alguien llega a ser no lo decreta el sistema: lo funda un maestro que se atreve.»
          </p>
          <p class="text-sm leading-relaxed opacity-80">
            Los seis libros se escribieron desde un colegio público de Cartago, y se publican en
            acceso abierto para que otros maestros los usen, los discutan y los superen.
          </p>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  // Copiar al portapapeles las citas de la colección.
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((boton) => {
    boton.addEventListener('click', async () => {
      const texto = boton.dataset.copiar ?? '';
      try {
        await navigator.clipboard.writeText(texto);
        const original = boton.textContent;
        boton.textContent = '¡Copiado!';
        window.setTimeout(() => {
          boton.textContent = original;
        }, 1600);
      } catch {
        /* Si el navegador bloquea el portapapeles, el texto sigue visible para copiar a mano. */
      }
    });
  });
</script>

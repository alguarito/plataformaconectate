---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CitaLibro from '../../../components/CitaLibro.astro';
import Tomo0DeQueTrata from '../../../components/Tomo0DeQueTrata.astro';
import Tomo0Estructura from '../../../components/Tomo0Estructura.astro';
import { coleccion, tomo, peso } from '../../../data/coleccion';
import { tituloCompletoTomo0, descargasTomo0 } from '../../../data/tomo0';

// Ficha del libro del Tomo 0 (obra matriz). /modelo-milc presenta el modelo; esta página es la
// del libro, con los meta citation_* que lee Google Scholar. Scholar solo liga el PDF si está en
// la misma carpeta que esta página: los archivos viven en public/modelo-milc/educacion-en-la-era-onlife/.
const base = import.meta.env.BASE_URL;
const t0 = tomo('0');
const libroArchivo = t0.archivos.find((a) => a.rol === 'libro')!;
const cuadernoArchivo = t0.archivos.find((a) => a.rol === 'cuaderno')!;
const version = t0.version ?? '3.0';

// ─── Schema.org · Book (mismo @id que en /modelo-milc) ───────────────────
const origen = (Astro.site ?? new URL('https://alguarito.github.io')).toString().replace(/\/$/, '');
const inicio = `${origen}${base.replace(/\/$/, '')}`;
const fichaUrl = `${origen}${t0.ficha}`;
const pdfUrl = `${origen}${t0.pdf}`;

const jsonLdExtra = [
  {
    '@type': 'Book',
    '@id': `${inicio}/modelo-milc#libro`,
    name: t0.titulo,
    alternateName: [t0.subtitulo, tituloCompletoTomo0],
    bookEdition: `Versión ${version} (edición revisada, octubre de 2026)`,
    version,
    bookFormat: 'EBook',
    inLanguage: 'es-CO',
    numberOfPages: libroArchivo.paginas,
    datePublished: t0.fecha,
    license: t0.licencia_url,
    // Solo el DOI de concepto: nunca el DOI ni el registro de una versión.
    identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: t0.doi, url: t0.doiUrl },
    sameAs: t0.doiUrl,
    url: fichaUrl,
    mainEntityOfPage: fichaUrl,
    encodingFormat: 'application/pdf',
    position: 0,
    isPartOf: { '@type': 'BookSeries', '@id': `${inicio}/modelo-milc#coleccion`, name: 'Colección MILC' },
    hasPart: { '@id': `${inicio}/modelo-milc#cuaderno` },
    associatedMedia: [
      {
        '@type': 'MediaObject',
        name: libroArchivo.nombre,
        description: `Libro · ${libroArchivo.paginas} páginas · ${libroArchivo.formato}`,
        contentUrl: pdfUrl,
        encodingFormat: 'application/pdf',
      },
      {
        '@type': 'MediaObject',
        name: cuadernoArchivo.nombre,
        description: `Cuaderno de trabajo MILC · ${cuadernoArchivo.paginas} páginas · ${cuadernoArchivo.formato}`,
        contentUrl: `${origen}${cuadernoArchivo.url}`,
        encodingFormat: 'application/pdf',
      },
    ],
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#sello` },
    about: [
      'Modelo MILC',
      'Pedagogía liberadora',
      'Tecnología educativa',
      'Filosofía de la información',
      'Inteligencia artificial en el aula',
    ],
  },
];
---

<BaseLayout
  title={`${t0.titulo} · Tomo 0 — Colección MILC · ConectaTE`}
  description={`Tomo 0 y obra matriz de la Colección MILC: ${t0.sintesis} Libro en acceso abierto (${t0.licencia}, DOI en Zenodo), con cuaderno de trabajo y hojas F01–F16.`}
  ogType="article"
  imagen="/og/libro-onlife.png"
  jsonLd={jsonLdExtra}
  citation={{
    title: tituloCompletoTomo0,
    authors: [coleccion.autor.bib],
    date: t0.fecha.replace(/-/g, '/'),
    pdfUrl,
    doi: t0.doi,
    publisher: coleccion.sello,
    language: 'es',
  }}
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/modelo-milc`} class="hover:opacity-60 transition-opacity">Modelo MILC</a>
        <span>/</span>
        <span style="color: var(--fg);">Tomo 0 · {t0.titulo}</span>
      </nav>

      <!-- HERO editorial -->
      <div class={`bento-card-color ${t0.color} grid-pattern mb-10 py-12 md:py-16 px-6 md:px-10`}>
        <div class="max-w-3xl">
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">Colección MILC · Tomo 0</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">Obra matriz</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">Versión {version}</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">{libroArchivo.paginas} páginas</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">{t0.licencia}</span>
          </div>
          <h1 class="heading-giant text-balance leading-[0.95] mb-4">
            {t0.titulo}
          </h1>
          <p class="text-base md:text-lg font-semibold opacity-90 leading-relaxed mb-3">
            {t0.subtitulo}.
          </p>
          <p class="text-sm opacity-80 mb-8">
            Dr. Alvaro Cardenas Orozco · {coleccion.sello} · {t0.edicion} · DOI {t0.doi}
          </p>

          <div class="flex items-center gap-2.5 flex-wrap">
            <a href={t0.pdf} download={libroArchivo.nombre} class="inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-full bg-black text-white text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={t0.doiUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 min-h-[44px] px-5 py-2.5 rounded-full border-2 border-black/30 text-sm font-black hover:border-black transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              DOI · Zenodo
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- DESCARGAS · un botón por archivo, con su nombre exacto -->
      <section id="descargar" class="mb-10 scroll-mt-24" aria-labelledby="descargar-titulo">
        <h2 id="descargar-titulo" class="chip-bento mb-4">Descargas · PDF</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
          {descargasTomo0.map((a) => (
            <li>
              <a href={a.url} download={a.nombre} type="application/pdf" class="bento-card-hover flex items-center justify-between gap-3 min-h-[44px]">
                <span class="flex flex-col leading-tight">
                  <span class="font-black"><span class="sr-only">Descargar </span>{a.etiqueta}</span>
                  <span class="text-xs font-semibold mt-1" style="color: var(--fg-muted);">{a.detalle}<span class="sr-only"> (PDF)</span></span>
                </span>
                <svg class="w-5 h-5 shrink-0 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>
            </li>
          ))}
        </ul>
        <p class="text-xs font-semibold leading-relaxed mt-3" style="color: var(--fg-muted);">
          Guarda el libro y el cuaderno en la misma carpeta y sin cambiarles el nombre: así funcionan los enlaces entre los dos.
          El PDF del libro es una copia web con las imágenes aligeradas ({peso(libroArchivo.bytes)}); el texto es el mismo
          del depósito en Zenodo.
        </p>
      </section>

      <Tomo0DeQueTrata />

      <Tomo0Estructura />

      <!-- Cómo citar -->
      <CitaLibro
        titulo={t0.titulo}
        subtitulo={t0.subtitulo}
        tomo={t0.etiqueta}
        volumen={t0.numero}
        version={version}
        ano={2026}
        editorial={coleccion.sello}
        doi={t0.doi}
        citeKey={t0.cita_key}
        licencia={t0.licencia}
        notaObraMatriz={false}
      />

      <!-- Enlaces internos -->
      <section class="mb-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href={`${base}/modelo-milc`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">El modelo</span>
            <h3 class="font-black text-lg leading-tight mt-1">Modelo MILC en ConectaTE</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">El ciclo de investigación liberadora y cómo opera en las guías.</p>
          </a>
          <a href={`${base}/modelo-milc/coleccion`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Colección MILC</span>
            <h3 class="font-black text-lg leading-tight mt-1">Los seis libros</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">Del Tomo 0, la obra matriz, al Tomo V.</p>
          </a>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

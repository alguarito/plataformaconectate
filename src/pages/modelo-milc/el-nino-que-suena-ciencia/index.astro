---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CitaLibro from '../../../components/CitaLibro.astro';

const base = import.meta.env.BASE_URL;

const libroHref = `${base}/libro-milc/tomo-3-el-nino-que-suena-ciencia.pdf`;
const libroPaginas = 138;
const subtitulo =
  'La curiosidad es natural; la escuela debe darle método al sueño (sin apagarlo)';
// DOI del Tomo III (registro citable en Zenodo).
// TODO: confirmar si 21360911 es el DOI de concepto (resuelve siempre a la última
// versión) o el DOI de versión. Si Zenodo asignó un concept DOI distinto, añadirlo
// aquí y en sameAs junto al enlace al record de versión (no inventar el número de record).
const doiConcepto = '10.5281/zenodo.21360911';
const doi = `https://doi.org/${doiConcepto}`;

// ─── Schema.org · Book (mismo @id que en /modelo-milc) ───────────────────
const origen = (Astro.site ?? new URL('https://alguarito.github.io')).toString().replace(/\/$/, '');
const inicio = `${origen}${base.replace(/\/$/, '')}`;
const pdfUrl = `${origen}${libroHref}`;

const jsonLdExtra = [
  {
    '@type': 'Book',
    '@id': `${inicio}/modelo-milc#tomo3`,
    name: 'El niño que sueña ciencia',
    alternateName: subtitulo,
    bookEdition: 'Primera edición 2026',
    bookFormat: 'EBook',
    inLanguage: 'es-CO',
    numberOfPages: libroPaginas,
    datePublished: '2026-07-14',
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    identifier: doi,
    sameAs: [
      'https://zenodo.org/doi/10.5281/zenodo.21360911',
    ],
    url: `${inicio}/modelo-milc/el-nino-que-suena-ciencia`,
    mainEntityOfPage: `${inicio}/modelo-milc/el-nino-que-suena-ciencia`,
    encodingFormat: 'application/pdf',
    position: 3,
    isPartOf: { '@type': 'BookSeries', '@id': `${inicio}/modelo-milc#coleccion`, name: 'Colección MILC' },
    associatedMedia: {
      '@type': 'MediaObject',
      contentUrl: pdfUrl,
      encodingFormat: 'application/pdf',
    },
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#organization` },
    about: [
      'Curiosidad y asombro',
      'Investigación escolar',
      'Método científico',
      'Ciencia ciudadana',
      'Ferias de ciencia',
    ],
  },
];

// Estructura real del tomo: 19 capítulos en 6 partes (+ preliminares y cierre).
const partes = [
  {
    parte: 'Parte I',
    titulo: 'El niño que sueña ciencia',
    desc: 'La curiosidad como sentido natural del ser.',
    caps: [
      '1. El asombro originario',
      '2. Nacidos preguntando',
      '3. La curiosidad ingenua (Freire)',
    ],
  },
  {
    parte: 'Parte II',
    titulo: 'Lo que apaga el sueño',
    desc: 'La atrofia de la curiosidad.',
    caps: [
      '4. La escuela bancaria',
      '5. El mercado de la atención en el aula',
      '6. El «¿por qué?» corregido',
    ],
  },
  {
    parte: 'Parte III',
    titulo: 'Dar método sin domar',
    desc: 'De la curiosidad ingenua a la epistemológica.',
    caps: [
      '7. De la curiosidad ingenua a la epistemológica',
      '8. El método como alcance',
      '9. El maestro que no apaga',
    ],
  },
  {
    parte: 'Parte IV',
    titulo: 'El ciclo del asombro',
    desc: 'Las 4 fases MILC como ritmo natural.',
    caps: [
      '10. Escucha',
      '11. Sistematización',
      '12. Proyección',
      '13. Liberación',
    ],
  },
  {
    parte: 'Parte V',
    titulo: 'Las arenas de la ciencia real',
    desc: 'El sueño que sale al mundo y gana su rigor.',
    caps: [
      '14. Ciencia ciudadana: el rigor prestado',
      '15. Convocatorias: el molde que da forma',
      '16. Ferias de ciencia: la libertad orientada',
      '17. Publicaciones: la autoría y la difusión',
    ],
  },
  {
    parte: 'Parte VI',
    titulo: 'El aula que sueña ciencia',
    desc: 'Manual del ciclo y las arenas.',
    caps: [
      '18. Instrumentos del oficio',
      '19. Programa por etapas (6.º–11.º)',
    ],
  },
];

// Las ideas más relevantes del tomo (fieles a la obra).
const ideas = [
  {
    emoji: '🌱',
    titulo: 'El asombro originario',
    texto: 'Investigar no es una técnica que la escuela enseñe: es un sentido natural del ser. El niño llega al aula ya investigando (pregunta, desarma, se asombra de su patio y de su gente). «Todos los hombres desean por naturaleza saber».',
  },
  {
    emoji: '🧒',
    titulo: 'Nacidos preguntando',
    texto: 'Antes de la primera clase, el niño ya es un investigador: explora, arriesga hipótesis y las pone a prueba. La curiosidad ingenua (Freire) es el deseo de saber que precede a todo método.',
  },
  {
    emoji: '🏦',
    titulo: 'Lo que apaga el sueño',
    texto: 'La escuela bancaria da respuestas sin preguntas; el mercado de la atención distrae; la prisa y la evaluación corrigen el «¿por qué?» hasta domesticar el asombro. Así se atrofia el sentido investigador.',
  },
  {
    emoji: '🔎',
    titulo: 'Dar método sin domar',
    texto: 'El corazón del tomo: el giro freireano de la curiosidad ingenua a la epistemológica. El método no disciplina la maravilla, le da alcance y rigor para volverla capaz, sin cambiar el asombro por el procedimiento.',
  },
  {
    emoji: '🌀',
    titulo: 'El ciclo del asombro',
    texto: 'Las cuatro fases del MILC (Escucha, Sistematización, Proyección y Liberación) leídas como un ritmo natural, no como un checklist: del asombro que parte del territorio a devolver el saber a la comunidad.',
  },
  {
    emoji: '🏟️',
    titulo: 'Las arenas de la ciencia real',
    texto: 'Ciencia ciudadana (el rigor prestado), convocatorias (el molde que da forma), ferias (la libertad orientada) y publicaciones (la autoría). El estudiante desea el rigor porque es el precio de entrada a una comunidad real.',
  },
];
---

<BaseLayout
  title="El niño que sueña ciencia · Tomo III — Colección MILC · ConectaTE"
  description="Tomo III de la Colección MILC: la curiosidad es un sentido natural del ser y la escuela no la enseña, le da método sin apagar el asombro. Ensayo pedagógico situado sobre la investigación como sentido natural. Libro en acceso abierto (CC BY-SA 4.0, DOI en Zenodo)."
  ogType="article"
  imagen="/og/libro-el-nino-que-suena-ciencia.png"
  jsonLd={jsonLdExtra}
  citation={{
    title: 'El niño que sueña ciencia',
    authors: ['Álvaro Cárdenas Orozco'],
    date: '2026/07/14',
    pdfUrl,
    doi: doiConcepto,
    publisher: 'Sor María Juliana Ediciones',
    language: 'es',
  }}
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/modelo-milc`} class="hover:opacity-60 transition-opacity">Modelo MILC</a>
        <span>/</span>
        <span style="color: var(--fg);">Tomo III · El niño que sueña ciencia</span>
      </nav>

      <!-- HERO editorial -->
      <div class="bento-card-color bg-bento-black grid-pattern text-white mb-10 py-12 md:py-16 px-6 md:px-10">
        <div class="max-w-3xl">
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Colección MILC · Tomo III</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Ensayo pedagógico situado</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">{libroPaginas} páginas</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">CC BY-SA 4.0</span>
          </div>
          <p class="text-base md:text-lg italic opacity-80 mb-2">
            Porque todo niño llega al aula <strong>ya investigando</strong>.
          </p>
          <h1 class="heading-giant text-balance leading-[0.95] mb-4">
            El niño que sueña ciencia
          </h1>
          <p class="text-base md:text-lg font-semibold opacity-90 leading-relaxed mb-3">
            {subtitulo}.
          </p>
          <p class="text-sm opacity-70 mb-8">
            Dr. Álvaro Cárdenas Orozco · Sor María Juliana Ediciones · 2026 ·
            DOI {doiConcepto}
          </p>

          <div class="flex items-center gap-2.5 flex-wrap">
            <a href={libroHref} download class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={doi} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              DOI · Zenodo
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- La tesis -->
      <div class="bento-card-color bg-bento-lime mb-10">
        <span class="chip-bento mb-3 bg-black/10">💡 La tesis, en una línea</span>
        <p class="text-lg md:text-2xl font-black leading-snug">
          «La curiosidad es un sentido natural del ser (el niño ya venía investigando): la escuela no la crea ni la enseña, su única tarea honesta es darle método sin apagar el asombro.»
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          <em>Sentido</em> dice dos cosas a la vez: la investigación como <strong>facultad</strong>
          (con la que palpamos lo real, junto a la vista y el oído) y como <strong>rumbo</strong>
          (lo que le da significado a existir). Se atrofia una y se pierde el otro.
        </p>
      </div>

      <!-- DE QUÉ TRATA -->
      <section class="mb-10">
        <span class="chip-bento mb-4">De qué trata</span>
        <div class="bento-card">
          <p class="text-base md:text-lg leading-relaxed mb-4">
            <em>El niño que sueña ciencia</em> parte de una convicción: el niño llega al aula
            <strong>ya investigando</strong> (pregunta, desarma, se asombra de su patio y de su
            gente). Frente a ese asombro originario la escuela puede hacer dos cosas: <strong>apagarlo
            o darle forma</strong>.
          </p>
          <p class="text-base md:text-lg leading-relaxed mb-4">
            El tomo sostiene que la única tarea honesta del aula es <strong>convertir ese sueño en
            método</strong>: darle rigor, alcance y verdad a la curiosidad sin cambiar la maravilla
            por el procedimiento. Toma el giro freireano de la <strong>curiosidad ingenua a la
            epistemológica</strong> y lo lleva al ciclo MILC (Escucha, Sistematización, Proyección
            y Liberación), leído como un <strong>ritmo natural</strong> y no como un checklist.
          </p>
          <p class="text-base md:text-lg leading-relaxed">
            Su aporte propio son las <strong>arenas de la ciencia real</strong> (ciencia ciudadana,
            convocatorias, ferias y publicaciones): los lugares donde la curiosidad gana su método
            sin que el maestro tenga que imponerlo, porque el rigor se vuelve <strong>el precio de
            entrada a una comunidad que el estudiante quiere integrar</strong>.
          </p>
          <p class="text-base md:text-lg leading-relaxed mt-4">
            Es el <strong>Tomo III de la Colección MILC</strong>. Si el Tomo I formó el criterio del
            <em>yo</em> frente a la pantalla y el Tomo II arraigó al <em>nosotros</em> en el
            territorio, este recupera y da método al <strong>sentido investigador</strong> con que
            nacimos: es el tomo del <em>cómo</em>, el que vuelve capaz el asombro.
          </p>
        </div>
      </section>

      <!-- LA ESTRUCTURA DEL TOMO -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
          <h2 class="heading-huge">Cómo está armado el tomo.</h2>
          <span class="chip-bento">19 capítulos · 6 partes</span>
        </div>
        <p class="text-sm leading-relaxed mb-6 max-w-2xl" style="color: var(--fg-muted);">
          Un recorrido que va de <strong style="color: var(--fg);">reconocer el asombro</strong>
          a <strong style="color: var(--fg);">darle método</strong> con el ciclo MILC y a
          <strong style="color: var(--fg);">sacarlo al mundo</strong> por las arenas de la ciencia
          real. Abre con Prólogo, Introducción y «Cómo leer»; cierra con la Conclusión
          («Volver a soñar ciencia») y las Referencias.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {partes.map((p, i) => (
            <div class="bento-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-8 h-8 rounded-full bg-bento-lime text-black flex items-center justify-center text-sm font-black shrink-0">{i + 1}</span>
                <div>
                  <span class="text-[11px] font-black uppercase tracking-widest block" style="color: var(--fg-muted);">{p.parte}</span>
                  <h3 class="font-black text-lg leading-tight">{p.titulo}</h3>
                </div>
              </div>
              <p class="text-sm font-semibold mb-3" style="color: var(--fg-muted);">{p.desc}</p>
              <ul class="space-y-1.5">
                {p.caps.map((c) => (
                  <li class="text-sm leading-snug flex gap-2">
                    <span class="text-bento-blue font-black shrink-0">›</span>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- LAS IDEAS MÁS RELEVANTES -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge">Las ideas más relevantes.</h2>
          <span class="chip-bento">6 claves</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {ideas.map((r, i) => (
            <div class="bento-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-3xl" aria-hidden="true">{r.emoji}</span>
                <span class="w-7 h-7 rounded-full bg-bento-blue text-white flex items-center justify-center text-xs font-black shrink-0">{i + 1}</span>
              </div>
              <h3 class="font-black text-base leading-tight mb-2">{r.titulo}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{r.texto}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- INVITACIÓN A LEERLO -->
      <section class="mb-10">
        <div class="bento-card-color bg-bento-black grid-pattern text-white py-10 md:py-14 px-6 md:px-10 text-center">
          <span class="text-5xl block mb-4">📙</span>
          <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-4 max-w-2xl mx-auto">
            Léelo completo. {libroPaginas} páginas para volver a soñar ciencia.
          </h2>
          <p class="text-base md:text-lg opacity-85 leading-relaxed max-w-2xl mx-auto mb-8">
            Un ensayo para docentes que quieren un aula donde el «¿por qué?» espontáneo no se
            corrige, sino que se cultiva hasta volverse investigación situada. Acceso abierto,
            gratuito y con licencia para compartir y adaptar en tu aula.
          </p>
          <div class="flex items-center justify-center gap-2.5 flex-wrap">
            <a href={libroHref} download class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro (PDF)
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={doi} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-6 py-3 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              Ver en Zenodo
            </a>
          </div>
        </div>
      </section>

      <!-- Cómo citar -->
      <CitaLibro
        titulo="El niño que sueña ciencia"
        tomo="Tomo III"
        volumen={3}
        ano={2026}
        editorial="Sor María Juliana Ediciones"
        doi={doiConcepto}
        citeKey="cardenas2026ciencia"
        licencia="CC BY-SA 4.0"
      />

      <!-- Sigue en la colección · enlaces internos -->
      <section class="mb-10">
        <span class="chip-bento mb-4">Sigue en la Colección MILC</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href={`${base}/modelo-milc/querencia`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Tomo II</span>
            <h3 class="font-black text-lg leading-tight mt-1">Pedagogía de la Querencia</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">Arraigar al estudiante en su territorio y saberes ancestrales.</p>
          </a>
          <a href={`${base}/modelo-milc`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Obra matriz</span>
            <h3 class="font-black text-lg leading-tight mt-1">Educación en la Era Onlife</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">El modelo MILC completo, del que nace esta colección.</p>
          </a>
        </div>
      </section>

      <!-- Volver -->
      <a href={`${base}/modelo-milc`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al</div>
          <div class="font-black text-lg">Modelo MILC</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

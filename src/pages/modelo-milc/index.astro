// Anclajes agrupados por grado para grid 6×3
const anclajesPorGrado: Record<number, typeof anclajesAncestrales> = {};
for (const a of anclajesAncestrales) {
  if (!anclajesPorGrado[a.grado]) anclajesPorGrado[a.grado] = [];
  anclajesPorGrado[a.grado].push(a);
}

const colorLente: Record<string, string> = {
  'Enrique Dussel': 'bg-bento-purple text-white',
  'Marco Aurelio (Estoicismo)': 'bg-bento-cyan text-black',
  'Luciano Floridi': 'bg-bento-orange text-white',
};

const seccionesMilc = [
  { id: 'presentacion',    titulo: 'Presentación · 13 slides',         emoji: '🎞' },
  { id: 'fases',           titulo: 'Las 4 fases en las guías (contrato v3)', emoji: '🌀' },
  { id: 'diagrama',        titulo: 'Diagrama del ciclo en las guías',  emoji: '🗺' },
  { id: 'triangulo',       titulo: 'Triángulo de pensamiento en las guías', emoji: '🔺' },
  { id: 'anclajes',        titulo: 'Saberes locales por periodo',      emoji: '🌱' },
  { id: 'politica-ia',     titulo: 'Política de IA responsable',       emoji: '🤖' },
  { id: 'valoracion',      titulo: 'Sistema de valoración de guías',   emoji: '⭐' },
  { id: 'pipeline',        titulo: 'Pipeline editorial · YAML SSOT',   emoji: '⚙️' },
  { id: 'estrategias',     titulo: 'Estrategias activas de aula',      emoji: '🛠' },
  { id: 'componentes-men', titulo: 'Articulación con el marco oficial', emoji: '📐' },
  { id: 'referentes',      titulo: 'Marco teórico · 7 referentes',     emoji: '📚' },
  { id: 'profundiza',      titulo: 'Profundiza · libros y documentos', emoji: '📖' },
];
---

<BaseLayout
  title={`Modelo MILC · ${planArea.area} — ConectaTE`}
  description="Modelo MILC: el ciclo de investigación liberadora en cinco momentos (Tomo 0, versión 3.0) y cómo opera en las guías de ConectaTE con el contrato MILC v3: 4 fases, 18 anclajes ancestrales e IA responsable."
  ogType="article"
  imagen="/og/modelo-milc.png"
  jsonLd={jsonLdExtra}
  citation={{
    title: libroMilcTituloCompleto,
    authors: ['Álvaro Cárdenas Orozco'],
    date: t0.fecha.replace(/-/g, '/'),
    pdfUrl: `${origen}${libroMilcHref}`,
    doi: t0.doi,
    publisher: coleccion.sello,
    language: 'es',
  }}
>
  <article class="pt-8 md:pt-12 pb-20">
    <div class="bento-container max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-6 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <span style="color: var(--fg);">Modelo MILC</span>
      </nav>

      <!-- HERO -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
        <div class="bento-card-color bg-bento-purple md:col-span-8 min-h-[420px] flex flex-col justify-between">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              🌱 Pedagogía propia · {planArea.ano}
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              MILC v3 · liberador
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              📕 Tomo 0 · obra matriz
            </span>
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Modelo · Tomo 0 de la Colección MILC</span>
            <h1 class="heading-giant text-balance leading-[0.95] mt-1 mb-3">
              MILC.
            </h1>
            <p class="text-base md:text-lg font-semibold opacity-90 leading-snug max-w-xl">
              Modelo de <strong>Investigación Liberadora y Científica</strong>. Una pedagogía
              propia que articula técnica con ética, saberes ancestrales con tecnología
              contemporánea, y autonomía del estudiante con responsabilidad social.
            </p>
          </div>
        </div>

        <!-- DESCARGAS DEL TOMO 0 · un botón por archivo, con su nombre exacto -->
        <section
          id="descargar"
          aria-labelledby="descargar-titulo"
          class="bento-card-color bg-bento-lime text-black dark:bg-bento-lime dark:text-black md:col-span-4 flex flex-col justify-between gap-6 min-h-[420px] scroll-mt-24"
        >
          <div>
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Tomo 0 · obra matriz · PDF</span>
            <h2 id="descargar-titulo" class="text-xl md:text-2xl font-black tracking-tight leading-tight mt-3 mb-2">
              {t0.titulo}
            </h2>
            <p class="text-sm font-semibold opacity-90 mb-2 leading-snug">
              {libroMilcSubtitulo}
            </p>
            <p class="text-xs opacity-80 mb-1 leading-relaxed">
              {libroMilcEdicion} · libro y cuaderno de trabajo
            </p>
            <p class="text-[11px] opacity-75 leading-relaxed">
              Dr. Álvaro Cárdenas Orozco · acceso abierto · {t0.licencia} · DOI {t0.doi}
            </p>
          </div>
          <div>
            <ul class="flex flex-col gap-2" role="list">
              {descargasTomo0.map((a) => (
                <li>
                  <a
                    href={a.url}
                    download={a.nombre}
                    type="application/pdf"
                    class={`flex items-center justify-between gap-3 min-h-[44px] w-full px-4 py-2 rounded-bento-sm text-sm font-black transition-colors motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-black focus-visible:ring-offset-bento-lime dark:focus-visible:ring-black dark:focus-visible:ring-offset-bento-lime ${
                      a.principal
                        ? 'bg-black text-white hover:bg-neutral-800 dark:bg-black dark:text-white dark:hover:bg-neutral-800'
                        : 'border-2 border-black/40 text-black hover:border-black dark:border-black/40 dark:text-black dark:hover:border-black'
                    }`}
                  >
                    <span class="flex flex-col leading-tight">
                      <span><span class="sr-only">Descargar </span>{a.etiqueta}</span>
                      <span class="text-[11px] font-semibold opacity-80">{a.detalle}<span class="sr-only"> (PDF)</span></span>
                    </span>
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
            <p class="text-xs font-semibold leading-relaxed mt-3 opacity-80">
              Guarda el libro y el cuaderno en la misma carpeta y sin cambiarles el nombre: así funcionan los enlaces entre los dos.
            </p>
          </div>
        </section>
      </div>

      <!-- DE QUÉ TRATA EL LIBRO (obra matriz) -->
      <section class="mb-10">
        <span class="chip-bento mb-4">De qué trata el libro</span>
        <div class="bento-card">
          <p class="text-base md:text-lg leading-relaxed mb-4">
            <em>Educación en la Era Onlife</em> es la <strong>obra que funda el modelo MILC</strong>.
            Parte de una denuncia: la economía de la atención ha secuestrado la formación humana,
            convirtiendo al estudiante en producto antes que en autor. Frente a eso propone una
            pedagogía transmoderna para <strong>recuperar la mirada, investigar el territorio y crear
            tecnología con sentido</strong>.
          </p>
          <p class="text-base md:text-lg leading-relaxed mb-4">
            Articula pedagogía crítica, ciencia ciudadana, pensamiento computacional, robótica,
            astronomía, escritura académica y memoria institucional, y nace de una experiencia real:
            la I.E. Sor María Juliana (Cartago) y el ecosistema ConectaTE. Se apoya en cuatro pilares:
            <strong>Freire</strong> (pedagogía crítica frente al algoritmo), <strong>Floridi</strong>
            (la infoesfera y el sujeto como <em>inforg</em>), el <strong>estoicismo crítico</strong>
            (la ciudadela interior) y <strong>Dussel</strong> (la filosofía de la liberación).
          </p>
          <p class="text-base md:text-lg leading-relaxed italic" style="color: var(--fg-muted);">
            «La educación no cambia al mundo: cambia a las personas que van a cambiar el mundo.»
            — Paulo Freire
          </p>
        </div>
      </section>

      <!-- CÓMO ESTÁ ARMADO EL LIBRO · 11 capítulos en 5 partes (versión 3.0) -->
      <section id="estructura" class="mb-10 scroll-mt-24" aria-labelledby="estructura-titulo">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
          <h2 id="estructura-titulo" class="heading-huge">Cómo está armado el libro.</h2>
          <span class="chip-bento">{totalCapitulos} capítulos en {libroEstructura.length} partes · {libroMilcPaginas} páginas</span>
        </div>
        <p class="text-sm leading-relaxed mb-6 max-w-2xl text-neutral-600 dark:text-neutral-400">
          La <strong class="text-neutral-950 dark:text-neutral-50">Parte I, Crisis onlife</strong>, plantea la
          atención como territorio en disputa. La <strong class="text-neutral-950 dark:text-neutral-50">Parte II,
          Genealogía y sujeto</strong>, reúne las raíces críticas del modelo y el sujeto que habita la infoesfera.
          La <strong class="text-neutral-950 dark:text-neutral-50">Parte III, Espacio y método</strong>, presenta
          la arquitectura del encuentro y el ciclo de investigación liberadora en cinco momentos. La
          <strong class="text-neutral-950 dark:text-neutral-50">Parte IV, Herramientas y tiempo</strong>, trata el
          oficio de investigar y sus ritmos. La <strong class="text-neutral-950 dark:text-neutral-50">Parte V,
          Escalamiento, comunidad y movimiento</strong>, lleva la experiencia del aula a la Red MILC. Cierra con
          el epílogo «La clase que viene».
        </p>
        <div class="space-y-8">
          {libroEstructura.map((p) => (
            <div>
              <h3 class="text-xs font-black uppercase tracking-widest mb-3 text-neutral-600 dark:text-neutral-400">
                Parte {p.parte} · {p.titulo}
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                {p.capitulos.map((c) => (
                  <div id={`capitulo-${c.n}`} class="bento-card flex gap-4 scroll-mt-24">
                    <span class="w-9 h-9 rounded-full bg-bento-black text-white dark:bg-neutral-50 dark:text-neutral-950 flex items-center justify-center text-sm font-black shrink-0" aria-hidden="true">{c.n}</span>
                    <div class="min-w-0">
                      <h4 class="font-black text-lg leading-tight mb-1">
                        <span class="sr-only">Capítulo {c.n}. </span>{c.titulo}
                      </h4>
                      <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">{c.desc}</p>
                      <p class="text-[11px] font-bold uppercase tracking-widest leading-relaxed mt-2 text-neutral-600 dark:text-neutral-400">
                        <span class="text-neutral-950 dark:text-neutral-50">{c.n === 5 ? 'Cinco momentos' : c.n === 1 ? 'Mapa de lectura' : 'Ruta'}:</span>
                        {' '}{c.ruta.join(' · ')}
                      </p>
                      {c.profundiza && (
                        <a
                          href={c.profundiza.href}
                          class="mt-3 flex items-center gap-3 min-h-[44px] px-3 py-2 rounded-bento-sm border-2 border-neutral-300 dark:border-neutral-600 hover:border-neutral-950 dark:hover:border-neutral-50 transition-colors motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bento-blue dark:focus-visible:ring-bento-blue"
                        >
                          <span class={`w-2.5 h-2.5 rounded-full shrink-0 ring-1 ring-black/10 dark:ring-white/40 ${c.profundiza.color}`} aria-hidden="true"></span>
                          <span class="flex flex-col leading-tight">
                            <span class="text-[11px] font-bold uppercase tracking-widest text-neutral-600 dark:text-neutral-400">Para profundizar →</span>
                            <span class="text-sm font-black text-neutral-950 dark:text-neutral-50">{c.profundiza.etiqueta} · {c.profundiza.titulo}</span>
                          </span>
                        </a>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- PUBLICACIÓN ARBITRADA · ancla de autoridad del modelo -->
      <section id="articulo" class="mb-10 scroll-mt-24">
        <div class="bento-card-color bg-bento-blue text-white py-8 md:py-10 px-6 md:px-9">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-widest bg-white/20">Publicación arbitrada · peer-reviewed</span>
            <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-widest bg-white/15">CC BY 4.0</span>
          </div>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight leading-tight mb-2 max-w-3xl">
            El modelo MILC, ahora con revisión por pares.
          </h2>
          <p class="text-sm md:text-base opacity-90 leading-relaxed max-w-2xl mb-2">
            «{articuloTitulo}».
          </p>
          <p class="text-xs opacity-75 mb-6">
            Cárdenas Orozco, Á. &amp; Restrepo Ortiz, J. A. (2026) · <em>Revista Hambatu Science</em> (Ecuador) · Vol. 1, Núm. 3 · pp. 56-77 · DOI {articuloDoi}
          </p>
          <div class="flex items-center gap-2.5 flex-wrap">
            <a href={articuloUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-black text-sm font-black hover:bg-bento-lime transition-colors" aria-label="Artículo en Revista Hambatu Science (se abre en una pestaña nueva)">
              Leer el artículo
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
            <a href={articuloDoiUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full border-2 border-white/40 text-sm font-black hover:border-white transition-colors" aria-label="DOI del artículo (se abre en una pestaña nueva)">
              DOI · Crossref
            </a>
          </div>
        </div>
      </section>

      <!-- CÓMO CITAR EL MODELO · cita canónica del artículo arbitrado -->
      <CitaArticulo
        titulo={articuloTitulo}
        autores={[
          { apa: 'Cárdenas Orozco, Á.', full: 'Cárdenas Orozco, Álvaro' },
          { apa: 'Restrepo Ortiz, J. A.', full: 'Restrepo Ortiz, Jheison Alexander' },
        ]}
        revista="Revista Hambatu Science"
        volumen={1}
        numero={3}
        paginas="56-77"
        ano={2026}
        doi={articuloDoi}
        issn="3151-815X"
        citeKey="cardenas2026milc"
      />

      <!-- ÍNDICE DEL DOCUMENTO -->
      <IndiceDocumento
        secciones={seccionesMilc}
        titulo="Recorre el modelo a tu ritmo."
        introduccion="12 estaciones del modelo MILC, desde la presentación visual hasta el pipeline editorial. Toca cualquiera para saltar."
      />

      <!-- PRESENTACIÓN DEL MODELO · 13 slides -->
      <div id="presentacion" class="mb-10 scroll-mt-24">
        <SlidesViewer />
      </div>

      <!-- IDEA FUERZA -->
      <div class="bento-card-color bg-bento-yellow mb-10 py-12 px-6 md:py-16 md:px-10 text-center">
        <span class="chip-bento mb-4 bg-black/10" style="color: rgba(0,0,0,0.7);">Idea fuerza</span>
        <p class="text-2xl md:text-3xl font-black tracking-tight leading-tight max-w-3xl mx-auto">
          "{planArea.ideaFuerza}"
        </p>
      </div>

      <!-- 4 FASES MILC · contrato de guías v3 (D10: se rotula y remite a los cinco momentos del libro) -->
      <div id="fases" class="bento-card mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="chip-bento">Cómo opera MILC en las guías de ConectaTE (contrato MILC v3)</span>
          <span class="chip-bento">4 fases</span>
        </div>
        <h2 class="heading-huge mb-2 leading-tight">
          Escucha · Sistematización · Praxis · Evaluación.
        </h2>
        <p class="text-sm md:text-base mb-3 leading-relaxed" style="color: var(--fg-muted);">
          Cada clase MILC convierte la sesión en un proceso de investigación escolar.
          El estudiante escucha el contexto, organiza lo que encuentra, actúa con productos
          o prototipos, y evalúa críticamente el sentido de lo realizado.
        </p>
        <p class="text-sm md:text-base mb-8 leading-relaxed text-neutral-600 dark:text-neutral-400">
          Estas fases son la forma operativa de las guías. El libro (Tomo 0) desarrolla el
          ciclo completo en cinco momentos —Escucha, Sistematización, Praxis, Evaluación liberadora
          y Devolución— en el <a href="#capitulo-5" class="font-bold underline underline-offset-2 text-neutral-950 dark:text-neutral-50 hover:opacity-70">capítulo 5</a>.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          {fasesMILC.map((f, i) => (
            <div class={`bento-card-color ${f.bgClass} flex gap-4 items-start min-h-[180px]`}>
              <div class="text-5xl shrink-0">{f.emoji}</div>
              <div>
                <span class="text-xs font-bold uppercase tracking-widest opacity-80">
                  Fase {i + 1}
                </span>
                <h3 class="text-xl md:text-2xl font-black tracking-tight leading-tight mt-1 mb-2">
                  {f.nombre}
                </h3>
                <p class="text-sm leading-relaxed opacity-90">
                  {f.descripcion}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- DIAGRAMA CICLO · contrato de guías v3 (D10) -->
      <div id="diagrama" class="bento-card mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="chip-bento">Cómo opera MILC en las guías de ConectaTE (contrato MILC v3)</span>
          <span class="chip-bento">Diagrama del ciclo</span>
        </div>
        <h2 class="heading-huge mb-2 leading-tight">El recorrido visual.</h2>
        <p class="text-sm md:text-base mb-6 leading-relaxed" style="color: var(--fg-muted);">
          Las 4 fases circulan: cada cierre alimenta la apertura siguiente. En el centro,
          el triángulo de pensamiento articula la dimensión filosófica. En el libro, el ciclo
          tiene cinco momentos: la Devolución cierra cada vuelta y abre una pregunta nueva (<a href="#capitulo-5" class="font-bold underline underline-offset-2 text-neutral-950 dark:text-neutral-50 hover:opacity-70">capítulo 5</a>).
        </p>
        <DiagramaCicloMILC />
      </div>

      <!-- TRIÁNGULO DE PENSAMIENTO · contrato de guías v3 (D10) -->
      <div id="triangulo" class="bento-card mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-3">
          <span class="chip-bento">Cómo opera MILC en las guías de ConectaTE (contrato MILC v3)</span>
          <span class="chip-bento">Triángulo de pensamiento</span>
        </div>
        <h2 class="heading-huge mb-2 leading-tight">3 voces que dialogan al cierre.</h2>
        <p class="text-sm md:text-base mb-8 leading-relaxed" style="color: var(--fg-muted);">
          MILC integra tres lentes filosóficas distintas en el cierre de cada guía. La
          dimensión liberadora (Dussel), el dominio de sí (estoicismo) y la habitabilidad
          ética de la infoesfera (Floridi). Es un recurso de cierre de las guías; el libro
          organiza el método en el ciclo de cinco momentos del <a href="#capitulo-5" class="font-bold underline underline-offset-2 text-neutral-950 dark:text-neutral-50 hover:opacity-70">capítulo 5</a>.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
          {trianguloPensamiento.map((l) => (
            <div class={`bento-card-color ${l.bgClass} flex flex-col gap-3 min-h-[260px]`}>
              <div class="text-5xl">{l.emoji}</div>
              <div>
                <h3 class="text-lg md:text-xl font-black tracking-tight leading-tight">
                  {l.nombre}
                </h3>
                <span class="text-xs font-bold uppercase tracking-widest opacity-80 mt-1 block">
                  {l.obra}
                </span>
              </div>
              <p class="text-sm leading-relaxed opacity-90 mt-auto">
                {l.aporte}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- 18 ANCLAJES ANCESTRALES -->
      <div id="anclajes" class="bento-card mb-10">
        <span class="chip-bento mb-3">18 anclajes ancestrales</span>
        <h2 class="heading-huge mb-2 leading-tight">Saberes locales que vertebran cada periodo.</h2>
        <p class="text-sm md:text-base mb-8 leading-relaxed" style="color: var(--fg-muted);">
          Cada periodo abre con un saber del Valle del Cauca, el Pacífico o el campo
          colombiano. El anclaje aparece en la guía de apertura (S1), regresa en el examen
          formal (pregunta contexto) y vertebra el reto del proyecto integrador.
          <strong style="color: var(--fg);"> No es decoración: es continuidad cultural con identidad digital.</strong>
        </p>

        <div class="space-y-5">
          {grados.map((g) => (
            <div>
              <h3 class="text-base md:text-lg font-black mb-3 leading-tight flex items-center gap-3">
                <span class={`w-10 h-10 rounded-bento-sm ${g.bgClass} flex items-center justify-center text-white text-sm font-black shrink-0`}>
                  {g.numero}°
                </span>
                Grado {g.numero}°
              </h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
                {(anclajesPorGrado[g.numero] ?? []).map((a) => (
                  <div class="p-4 rounded-bento-sm border-2" style="border-color: var(--border);">
                    <div class="text-xs font-bold uppercase tracking-widest mb-1" style="color: var(--fg-muted);">
                      Período {a.periodo}
                    </div>
                    <div class="font-black leading-tight mb-2 text-sm md:text-base">
                      🌱 {a.oficio}
                    </div>
                    <p class="text-xs leading-relaxed" style="color: var(--fg-muted);">
                      {a.resumen}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- POLÍTICA DE IA -->
      <div id="politica-ia" class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
        <div class="bento-card md:col-span-7">

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndiceDocumento from '../../components/IndiceDocumento.astro';
import CitaLibro from '../../components/CitaLibro.astro';
import CitaArticulo from '../../components/CitaArticulo.astro';
import DiagramaCicloMILC from '../../components/DiagramaCicloMILC.astro';
import DiagramaPipeline from '../../components/DiagramaPipeline.astro';
import SlidesViewer from '../../components/SlidesViewer.astro';
import { presentacionMilc, slidesMilc } from '../../data/presentacionMilc';
import { grados } from '../../data/grados';
import {
  planArea,
  fasesMILC,
  trianguloPensamiento,
  anclajesAncestrales,
  referentes,
  estrategias,
  componentesMEN,
  politicaIa,
  principiosIa,
  pipelineMilc,
  valoracionPorContrato,
  valoracionPorDensidad,
} from '../../data/planArea';
import { coleccion, tomo, tomoQueProfundiza, peso } from '../../data/coleccion';

const base = import.meta.env.BASE_URL;
const planAreaHref = `${base}/plan-de-area/${planArea.pdf}`;

// Colección MILC: todos los datos editoriales salen de src/data/coleccion.json (fuente única).
// Se cita y se enlaza solo por DOI de concepto (doi.org), que siempre lleva a la versión vigente.

// Tomo 0 · obra matriz · versión 3.0 (libro, cuaderno de trabajo y hojas F01–F16).
const t0 = tomo('0');
const libroMilcHref = t0.pdf;
const libroMilcPaginas = t0.paginas;
const libroMilcSubtitulo = t0.subtitulo;
const libroMilcDoi = t0.doiUrl;
const libroMilcVersion = t0.version ?? '3.0';
const libroMilcEdicion = t0.edicion;
// En la cita y en Zenodo el subtítulo va con coma: «…Onlife: MILC, Modelo de…».
const libroMilcSubtituloCita = t0.subtitulo.replace(/^MILC: /, 'MILC, ');
const libroMilcTituloCompleto = `${t0.titulo}: ${libroMilcSubtituloCita}`;
const libroMilcArchivo = t0.archivos.find((a) => a.rol === 'libro')!;
const cuadernoMilc = t0.archivos.find((a) => a.rol === 'cuaderno')!;

// Botones de descarga del Tomo 0: uno por archivo, con su nombre exacto.
const etiquetaArchivo: Record<string, string> = {
  libro: 'Libro',
  cuaderno: 'Cuaderno de trabajo',
  'hojas-carta': 'Hojas F01–F16 · Carta',
  'hojas-a4': 'Hojas F01–F16 · A4',
};
const descargasTomo0 = t0.archivos.map((a) => {
  const esHoja = a.rol === 'hojas-carta' || a.rol === 'hojas-a4';
  return {
    ...a,
    etiqueta: etiquetaArchivo[a.rol],
    detalle: `${a.paginas} ${esHoja ? 'hojas' : 'págs.'} · ${peso(a.bytes)}`,
    principal: !esHoja,
  };
});

// Colección MILC · Tomo I (ensayo de divulgación derivado de la obra matriz).
const t1 = tomo('I');
const tomo1Href = t1.pdf;
const tomo1Paginas = t1.paginas;
const tomo1Subtitulo = t1.subtitulo;
const tomo1Doi = t1.doiUrl;

// Colección MILC · Tomo II (ensayo pedagógico situado desde la filosofía de la liberación).
const t2 = tomo('II');
const tomo2Href = t2.pdf;
const tomo2Paginas = t2.paginas;
const tomo2Subtitulo = t2.subtitulo;
const tomo2Doi = t2.doiUrl;

// Colección MILC · Tomo III (ensayo pedagógico situado sobre la investigación como sentido natural).
const t3 = tomo('III');
const tomo3Href = t3.pdf;
const tomo3Paginas = t3.paginas;
const tomo3Subtitulo = t3.subtitulo;
const tomo3Doi = t3.doiUrl;

// Colección MILC · Tomo IV (IA, datos y soberanía tecnológica: el criterio frente a la máquina).
const t4 = tomo('IV');
const tomo4Href = t4.pdf;
const tomo4Paginas = t4.paginas;
const tomo4Subtitulo = t4.subtitulo;
const tomo4Doi = t4.doiUrl;

// Colección MILC · Tomo V (el espacio como agente: fundar el lugar donde se llega a ser · cierre de la colección).
const t5 = tomo('V');
const tomo5Href = t5.pdf;
const tomo5Paginas = t5.paginas;
const tomo5Subtitulo = t5.subtitulo;
const tomo5Doi = t5.doiUrl;

const presentacionDir = `${base}/presentaciones/milc-onlife`;
const presentacionPdfHref = `${presentacionDir}/${presentacionMilc.archivoPdf}`;
const presentacionPptxHref = `${presentacionDir}/${presentacionMilc.archivoPptx}`;

// Artículo arbitrado del modelo MILC · Revista Hambatu Science (Ecuador).
// Referencia académica canónica del modelo (revisión por pares + DOI de revista).
const articuloDoi = '10.63862/rhs-v1n3-56-77-2026';
const articuloDoiUrl = `https://doi.org/${articuloDoi}`;
const articuloUrl = 'https://revistahambatuscience.org/index.php/ojs/es/article/view/34';
const articuloTitulo = 'Modelo de investigación liberadora y científica (MILC): una propuesta para la educación en la era onlife';

// Estructura real de la obra matriz (versión 3.0 · 11 capítulos en 5 partes + epílogo).
// `ruta` = la «Ruta del capítulo» que abre cada capítulo en el libro (en el 1, su mapa de lectura).
// «Para profundizar» sale de coleccion.json (tomoQueProfundiza); el capítulo 9 no tiene tomo.
const momentosCiclo = ['Escucha', 'Sistematización', 'Praxis', 'Evaluación liberadora', 'Devolución'];
const libroEstructura = [
  {
    parte: 'I',
    titulo: 'Crisis onlife',
    capitulos: [
      { n: 1, titulo: 'El Mercado de la Mirada', ruta: ['Atención', 'Biografía', 'Curiosidad', 'Escuela', 'Autoría', 'Comunidad', 'Docencia'], desc: 'La atención como territorio en disputa: la escuela recupera la mirada antes de pretender educar con tecnología.' },
    ],
  },
  {
    parte: 'II',
    titulo: 'Genealogía y sujeto',
    capitulos: [
      { n: 2, titulo: 'Genealogía del Futuro', ruta: ['Palabra', 'Infoesfera', 'Ética', 'Territorio'], desc: 'Las raíces críticas del modelo: Freire, Floridi, el estoicismo crítico y Dussel.' },
      { n: 3, titulo: 'La Re-ontologización del Sujeto', ruta: ['Información', 'Sentido', 'Carácter', 'Territorio'], desc: 'Un sujeto capaz de habitar la infoesfera sin renunciar a juicio, autoría ni dignidad.' },
    ],
  },
  {
    parte: 'III',
    titulo: 'Espacio y método',
    capitulos: [
      { n: 4, titulo: 'La Arquitectura del Encuentro', ruta: ['Espacio', 'Materia', 'Error', 'Comunidad'], desc: 'El Laboratorio-Ágora: un espacio que educa antes de que alguien pronuncie la primera palabra.' },
      { n: 5, titulo: 'El Ciclo de la Investigación Liberadora', ruta: momentosCiclo, desc: 'Un ciclo abierto de cinco momentos: se puede volver a cualquiera cuando la evidencia exige revisar el camino.' },
    ],
  },
  {
    parte: 'IV',
    titulo: 'Herramientas y tiempo',
    capitulos: [
      { n: 6, titulo: 'Las herramientas del oficio', ruta: ['Cartografía', 'Portafolio', 'IA', 'Mantenimiento'], desc: 'Cartografía social, portafolio de investigación e inteligencia artificial con criterio.' },
      { n: 7, titulo: 'Cronotopos de la práctica', ruta: ['Lentitud', 'Retorno', 'Urgencia', 'Memoria'], desc: 'Los tiempos de la investigación escolar: lo que una pregunta necesita para madurar.' },
    ],
  },
  {
    parte: 'V',
    titulo: 'Escalamiento, comunidad y movimiento',
    capitulos: [
      { n: 8, titulo: 'Escalando esperanzas', ruta: ['Incubar', 'Instituir', 'Formar', 'Federar'], desc: 'Una pedagogía crece cuando otras comunidades la apropian, la cuidan y la vuelven suya.' },
      { n: 9, titulo: 'ConectaTE como caso vivo', ruta: ['Memoria', 'Liderazgo', 'Producción', 'Cultura'], desc: 'La experiencia de la plataforma y su semillero, abierta a la discusión y a la verificación.' },
      { n: 10, titulo: 'Sostenibilidad y evidencia', ruta: ['Archivo', 'Evidencia', 'Cuidado', 'Relevo'], desc: 'Documentar con cuidado para que la experiencia dure y pueda pasar a otras manos.' },
      { n: 11, titulo: 'Red MILC y expansión territorial', ruta: ['Red', 'Mentoría', 'Apertura', 'Territorio'], desc: 'Una red para multiplicar la capacidad de aprender juntos, no para multiplicar una marca.' },
    ],
  },
].map((p) => ({
  ...p,
  capitulos: p.capitulos.map((c) => ({ ...c, profundiza: tomoQueProfundiza(c.n) })),
}));
const totalCapitulos = libroEstructura.reduce((s, p) => s + p.capitulos.length, 0);

// ─── Schema.org · Book + Article ─────────────────────────────────────────

<BaseLayout
  title={`Modelo MILC · ${planArea.area} — ConectaTE`}
  description="Modelo de Investigación Liberadora y Científica (MILC v3): 4 fases, triángulo de pensamiento, 5 dimensiones, 18 anclajes ancestrales, política de IA responsable y pipeline editorial reproducible."
  ogType="article"
  imagen="/og/modelo-milc.png"
  jsonLd={jsonLdExtra}
  citation={{
    title: 'Educación en la Era Onlife',
    authors: ['Álvaro Cárdenas Orozco'],
    date: '2026/05/26',
    pdfUrl: `${origen}${libroMilcHref}`,
    doi: '10.5281/zenodo.20517707',
    publisher: 'Sor María Juliana Ediciones',
    language: 'es',
  }}
>
  <article class="pt-8 md:pt-12 pb-20">
    <div class="bento-container max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-6 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <span style="color: var(--fg);">Modelo MILC</span>
      </nav>

      <!-- HERO -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
        <div class="bento-card-color bg-bento-purple md:col-span-8 min-h-[420px] flex flex-col justify-between">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              🌱 Pedagogía propia · {planArea.ano}
            </span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/15">
              MILC v3 · liberador
            </span>
          </div>
          <div>
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Modelo</span>
            <h1 class="heading-giant text-balance leading-[0.95] mt-1 mb-3">
              MILC.
            </h1>
            <p class="text-base md:text-lg font-semibold opacity-90 leading-snug max-w-xl">
              Modelo de <strong>Investigación Liberadora y Científica</strong>. Una pedagogía
              propia que articula técnica con ética, saberes ancestrales con tecnología
              contemporánea, y autonomía del estudiante con responsabilidad social.
            </p>
          </div>
        </div>

        <a
          href={libroMilcHref}
          download
          class="bento-card-color bg-bento-lime md:col-span-4 flex flex-col justify-between min-h-[420px] hover:scale-[1.01] transition-transform group"
        >
          <div>
            <span class="text-xs font-bold uppercase tracking-widest opacity-80">Tomo 0 · obra matriz · PDF</span>
            <div class="text-6xl mt-3">📖</div>
          </div>
          <div>
            <h3 class="text-xl md:text-2xl font-black tracking-tight leading-tight mb-2">
              Educación en la Era Onlife
            </h3>
            <p class="text-sm font-semibold opacity-90 mb-2 leading-snug">
              {libroMilcSubtitulo}
            </p>
            <p class="text-xs opacity-75 mb-1 leading-relaxed">
              Edición ampliada 2026 · {libroMilcPaginas} páginas · Dr. Álvaro Cárdenas Orozco.
            </p>
            <p class="text-[11px] opacity-60 mb-3 leading-relaxed">
              Acceso abierto · DOI 10.5281/zenodo.20517707

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SlidesViewer from '../../../components/SlidesViewer.astro';
import CitaLibro from '../../../components/CitaLibro.astro';
import { presentacionMercado, slidesMercado } from '../../../data/presentacionMercado';

const base = import.meta.env.BASE_URL;

const libroHref = `${base}/libro-milc/tomo-1-mercado-de-la-atencion.pdf`;
const libroPaginas = 118;
const doi = 'https://doi.org/10.5281/zenodo.20644819';
const subtitulo = 'Cómo se disputa la atención de los jóvenes y cómo educar el criterio en la era onlife';

const presentacionDir = `${base}/presentaciones/mercado-atencion`;
const presentacionPdfHref = `${presentacionDir}/${presentacionMercado.archivoPdf}`;
const presentacionPptxHref = `${presentacionDir}/${presentacionMercado.archivoPptx}`;

// ─── Schema.org · Book (mismo @id que en /modelo-milc) + Presentación ─────
const origen = (Astro.site ?? new URL('https://alguarito.github.io')).toString().replace(/\/$/, '');
const inicio = `${origen}${base.replace(/\/$/, '')}`;
const jsonLdExtra = [
  {
    '@type': 'Book',
    '@id': `${inicio}/modelo-milc#tomo1`,
    name: 'El Mercado de la Atención',
    alternateName: subtitulo,
    bookEdition: 'Primera edición 2026',
    bookFormat: 'EBook',
    inLanguage: 'es-CO',
    numberOfPages: libroPaginas,
    datePublished: '2026-06-11',
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    identifier: doi,
    sameAs: ['https://zenodo.org/doi/10.5281/zenodo.20644819', 'https://zenodo.org/records/20644820'],
    url: `${inicio}/modelo-milc/mercado-atencion`,
    mainEntityOfPage: `${inicio}/modelo-milc/mercado-atencion`,
    encodingFormat: 'application/pdf',
    position: 1,
    isPartOf: { '@type': 'BookSeries', '@id': `${inicio}/modelo-milc#coleccion`, name: 'Colección MILC' },
    associatedMedia: {
      '@type': 'MediaObject',
      contentUrl: `${origen}${libroHref}`,
      encodingFormat: 'application/pdf',
    },
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#organization` },
    about: [
      'Economía de la atención',
      'Educación mediática',
      'Era onlife',
      'Pedagogía crítica',
    ],
  },
  {
    '@type': 'PresentationDigitalDocument',
    '@id': `${inicio}/modelo-milc/mercado-atencion#presentacion`,
    name: presentacionMercado.titulo,
    alternateName: presentacionMercado.subtitulo,
    description:
      'Presentación de 12 slides del Tomo I: la premisa de Herbert Simon, la arquitectura de la captura, el semáforo de la evidencia, los costos cognitivo e identitario, la soberanía atencional del MILC, el aula como gimnasio y la justicia atencional.',
    inLanguage: 'es-CO',
    datePublished: '2026-06-11',
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    url: `${inicio}/modelo-milc/mercado-atencion#presentacion`,
    associatedMedia: [
      {
        '@type': 'MediaObject',
        contentUrl: `${origen}${presentacionPdfHref}`,
        encodingFormat: 'application/pdf',
      },
      {
        '@type': 'MediaObject',
        contentUrl: `${origen}${presentacionPptxHref}`,
        encodingFormat:
          'application/vnd.openxmlformats-officedocument.presentationml.presentation',
      },
    ],
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#organization` },
  },
];

// Estructura real del tomo: 15 capítulos en 4 partes (+ preliminares y cierre).
const partes = [
  {
    parte: 'Parte I',
    titulo: 'La máquina',
    desc: 'Cómo se disputa la mirada.',
    caps: ['1. La economía de la atención', '2. La arquitectura de la captura'],
  },
  {
    parte: 'Parte II',
    titulo: 'Los efectos, por dimensión',
    desc: 'Qué le pasa a quien mira.',
    caps: [
      '3. Atención y desarrollo cognitivo',
      '4. Emoción y bienestar',
      '5. Ego, identidad y reconocimiento',
      '6. Conducta y hábito de consumo',
    ],
  },
  {
    parte: 'Parte III',
    titulo: 'Educar el criterio',
    desc: 'La respuesta de la escuela.',
    caps: [
      '7. La soberanía atencional como competencia',
      '8. De consumidor a autor: el semillero y CosmoTEC',
      '9. Evaluar sin pánico',
      '10. La política de la mirada en la escuela pública',
    ],
  },
  {
    parte: 'Parte IV',
    titulo: 'Manual metodológico',
    desc: 'Cómo formarla en el aula.',
    caps: [
      '11. El cerebro que atiende: neurociencia de la atención',
      '12. Qué funciona (y qué no)',
      '13. Cómo formar la atención en el aula',
      '14. Un programa por etapas',
      '15. Las mejores prácticas del mundo, situadas',
    ],
  },
];

// Las ideas más relevantes del tomo (fieles al contenido y a la presentación).
const ideas = [
  {
    emoji: '💎',
    titulo: 'La atención es la mercancía',
    texto: 'Herbert Simon lo advirtió en 1971: si la información es infinita y la atención finita, la mirada se vuelve el bien más disputado. Sobre esa escasez se montó una industria.',
  },
  {
    emoji: '🎰',
    titulo: 'La captura es ingeniería, no accidente',
    texto: 'El diseño persuasivo tiene fórmula: un disparador, una acción fácil (el scroll infinito) y una recompensa variable de tragamonedas. No es falta de voluntad del joven: es conducta diseñada.',
  },
  {
    emoji: '🚦',
    titulo: 'Evaluar sin pánico',
    texto: 'El «semáforo de la evidencia» separa lo robusto (la fragmentación del foco, el costo de la interrupción) de lo aún en disputa (mitos como el del «pez dorado»). Ni alarmismo ni negación.',
  },
  {
    emoji: '🧠',
    titulo: 'Dos formas de mirar',
    texto: 'Hiperatención (saltos veloces, intolerancia al tedio) frente a atención profunda (foco sostenido), que es la base de la libertad interior y del pensamiento complejo.',
  },
  {
    emoji: '🪞',
    titulo: 'El yo espejo onlife',
    texto: 'La necesidad de reconocimiento no es nueva; el espejo sí: una audiencia numérica (los likes), permanente (viaja en el bolsillo) y pública. Reconfigura la identidad adolescente.',
  },
  {
    emoji: '🧭',
    titulo: 'La soberanía atencional',
    texto: 'La respuesta del MILC: no fuerza de voluntad ni desintoxicación, sino una competencia entrenable (metacognición, autorregulación, intencionalidad). El giro clave: de consumidor a autor.',
  },
];
---

<BaseLayout
  title="El Mercado de la Atención · Tomo I — Colección MILC · ConectaTE"
  description="Tomo I de la Colección MILC: cómo se disputa la atención de los jóvenes y cómo educar el criterio en la era onlife. Libro en acceso abierto (CC BY-SA 4.0, DOI en Zenodo) y presentación de 12 slides."
  ogType="article"
  imagen="/og/libro-mercado-atencion.png"
  jsonLd={jsonLdExtra}
  citation={{
    title: 'El Mercado de la Atención',
    authors: ['Álvaro Cárdenas Orozco'],
    date: '2026/06/11',
    pdfUrl: `${origen}${libroHref}`,
    doi: '10.5281/zenodo.20644819',
    publisher: 'Sor María Juliana Ediciones',
    language: 'es',
  }}
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/modelo-milc`} class="hover:opacity-60 transition-opacity">Modelo MILC</a>
        <span>/</span>
        <span style="color: var(--fg);">Tomo I · El Mercado de la Atención</span>
      </nav>

      <!-- HERO editorial -->
      <div class="bento-card-color bg-bento-black grid-pattern text-white mb-10 py-12 md:py-16 px-6 md:px-10">
        <div class="max-w-3xl">
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Colección MILC · Tomo I</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Ensayo pedagógico situado</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">{libroPaginas} páginas</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">CC BY-SA 4.0</span>
          </div>
          <p class="text-base md:text-lg italic opacity-80 mb-2">
            Porque la escuela pública aún puede formar <strong>sujetos libres</strong>.
          </p>
          <h1 class="heading-giant text-balance leading-[0.95] mb-4">
            El Mercado de la Atención
          </h1>
          <p class="text-base md:text-lg font-semibold opacity-90 leading-relaxed mb-3">
            {subtitulo}.
          </p>
          <p class="text-sm opacity-70 mb-8">
            Dr. Álvaro Cárdenas Orozco · Sor María Juliana Ediciones · 2026 ·
            DOI 10.5281/zenodo.20644819
          </p>

          <div class="flex items-center gap-2.5 flex-wrap">
            <a href={libroHref} download class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={doi} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              DOI · Zenodo
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
            <a href="#presentacion" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-sm font-black opacity-80 hover:opacity-100 transition-opacity">
              Ver la presentación ↓
            </a>
          </div>
        </div>
      </div>

      <!-- La tesis -->
      <div class="bento-card-color bg-bento-cyan mb-10">
        <span class="chip-bento mb-3 bg-black/10">💡 La tesis, en una línea</span>
        <p class="text-lg md:text-2xl font-black leading-snug">
          «Una riqueza de información crea una pobreza de atención.»
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          Herbert Simon lo advirtió en 1971. Este tomo recorre cómo esa premisa se
          volvió industria sobre la mirada de los jóvenes — y cómo la escuela pública
          puede responder: no con pánico, sino formando la <strong>soberanía atencional</strong>.
        </p>
      </div>

      <!-- DE QUÉ TRATA -->
      <section class="mb-10">
        <span class="chip-bento mb-4">De qué trata</span>
        <div class="bento-card">
          <p class="text-base md:text-lg leading-relaxed mb-4">
            <em>El Mercado de la Atención</em> parte de una premisa incómoda: en un mundo de
            información infinita, lo escaso (y por tanto lo valioso) es la <strong>atención</strong>.
            Alrededor de esa escasez se ha montado una industria que disputa comercialmente la
            mirada de los adolescentes.
          </p>
          <p class="text-base md:text-lg leading-relaxed mb-4">
            El libro hace dos cosas. Primero, <strong>desarma la máquina</strong>: cómo funciona el
            diseño persuasivo de las plataformas y qué dice de verdad la evidencia sobre sus efectos,
            sin caer en el pánico moral ni en la negación. Segundo, propone una <strong>salida
            educativa concreta</strong>: la soberanía atencional, entendida no como fuerza de voluntad
            ni desintoxicación, sino como una competencia que la escuela puede formar.
          </p>
          <p class="text-base md:text-lg leading-relaxed">
            Es un <strong>ensayo pedagógico situado</strong>, escrito desde y para la escuela pública
            latinoamericana: no un manual técnico ni un panfleto contra las pantallas, sino una guía
            para recuperar la mirada con criterio.
          </p>
        </div>
      </section>

      <!-- LA ESTRUCTURA DEL TOMO -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
          <h2 class="heading-huge">Cómo está armado el tomo.</h2>
          <span class="chip-bento">15 capítulos · 4 partes</span>
        </div>
        <p class="text-sm leading-relaxed mb-6 max-w-2xl" style="color: var(--fg-muted);">
          Un recorrido que va de <strong style="color: var(--fg);">diagnosticar la máquina</strong>
          a <strong style="color: var(--fg);">formar el criterio</strong>, y termina en un manual
          práctico para el aula. Abre con Prólogo, Introducción y «Cómo leer»; cierra con la
          Conclusión («recuperar la mirada») y las Referencias.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {partes.map((p, i) => (
            <div class="bento-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-8 h-8 rounded-full bg-bento-cyan text-black flex items-center justify-center text-sm font-black shrink-0">{i + 1}</span>
                <div>
                  <span class="text-[11px] font-black uppercase tracking-widest block" style="color: var(--fg-muted);">{p.parte}</span>
                  <h3 class="font-black text-lg leading-tight">{p.titulo}</h3>
                </div>
              </div>
              <p class="text-sm font-semibold mb-3" style="color: var(--fg-muted);">{p.desc}</p>
              <ul class="space-y-1.5">
                {p.caps.map((c) => (
                  <li class="text-sm leading-snug flex gap-2">
                    <span class="text-bento-blue font-black shrink-0">›</span>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- PRESENTACIÓN · 12 slides -->
      <div id="presentacion" class="mb-10 scroll-mt-24">
        <SlidesViewer
          presentacion={presentacionMercado}
          slides={slidesMercado}
          dirNombre="mercado-atencion"
        />
      </div>

      <!-- LAS IDEAS MÁS RELEVANTES -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge">Las ideas más relevantes.</h2>
          <span class="chip-bento">6 claves</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {ideas.map((r, i) => (
            <div class="bento-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-3xl" aria-hidden="true">{r.emoji}</span>
                <span class="w-7 h-7 rounded-full bg-bento-blue text-white flex items-center justify-center text-xs font-black shrink-0">{i + 1}</span>
              </div>
              <h3 class="font-black text-base leading-tight mb-2">{r.titulo}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{r.texto}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- INVITACIÓN A LEERLO -->
      <section class="mb-10">
        <div class="bento-card-color bg-bento-black grid-pattern text-white py-10 md:py-14 px-6 md:px-10 text-center">
          <span class="text-5xl block mb-4">📗</span>
          <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-4 max-w-2xl mx-auto">
            Léelo completo. Son 118 páginas para recuperar la mirada.
          </h2>
          <p class="text-base md:text-lg opacity-85 leading-relaxed max-w-2xl mx-auto mb-8">
            Si te preocupa cómo la atención de los jóvenes se volvió un mercado (y qué puede hacer
            la escuela al respecto), este tomo es para ti. Acceso abierto, gratuito y con licencia
            para compartir y adaptar en tu aula.
          </p>
          <div class="flex items-center justify-center gap-2.5 flex-wrap">
            <a href={libroHref} download class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro (PDF)
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={doi} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-6 py-3 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              Ver en Zenodo
            </a>
          </div>
        </div>
      </section>

      <!-- Cómo citar -->
      <CitaLibro
        titulo="El Mercado de la Atención"
        tomo="Tomo I"
        volumen={1}
        ano={2026}
        editorial="Sor María Juliana Ediciones"
        doi="10.5281/zenodo.20644819"
        citeKey="cardenas2026mercado"
        licencia="CC BY-SA 4.0"
      />

      <!-- Sigue en la colección · enlaces internos -->
      <section class="mb-10">
        <span class="chip-bento mb-4">Sigue en la Colección MILC</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href={`${base}/modelo-milc/querencia`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Tomo II</span>
            <h3 class="font-black text-lg leading-tight mt-1">Pedagogía de la Querencia</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">Arraigar al estudiante en su territorio y saberes ancestrales.</p>
          </a>
          <a href={`${base}/modelo-milc`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Obra matriz</span>
            <h3 class="font-black text-lg leading-tight mt-1">Educación en la Era Onlife</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">El modelo MILC completo, del que nace esta colección.</p>
          </a>
        </div>
      </section>

      <!-- Volver -->
      <a href={`${base}/modelo-milc`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al</div>
          <div class="font-black text-lg">Modelo MILC</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

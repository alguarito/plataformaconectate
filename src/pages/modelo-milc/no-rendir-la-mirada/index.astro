---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CitaLibro from '../../../components/CitaLibro.astro';
import SlidesViewer from '../../../components/SlidesViewer.astro';
import { presentacionNoRendir, slidesNoRendir } from '../../../data/presentacionNoRendir';

const base = import.meta.env.BASE_URL;

const libroHref = `${base}/libro-milc/tomo-4-no-rendir-la-mirada.pdf`;
const libroPaginas = 142;
const subtitulo =
  'Inteligencia artificial, datos y soberanía tecnológica: usar la herramienta con criterio, autoría y cuidado';
// DOI del Tomo IV. Verificado contra la API de Zenodo el 2026-07-23:
//   concept DOI = 21517630  ·  version DOI = 21517631
// Se cita SIEMPRE por concept DOI (resuelve a la última versión).
const doiConcepto = '10.5281/zenodo.21517630';
const doi = `https://doi.org/${doiConcepto}`;

// ─── Schema.org · Book (mismo @id que en /modelo-milc) ───────────────────
const origen = (Astro.site ?? new URL('https://alguarito.github.io')).toString().replace(/\/$/, '');
const inicio = `${origen}${base.replace(/\/$/, '')}`;
const pdfUrl = `${origen}${libroHref}`;

const presentacionDir = `${base}/presentaciones/no-rendir-la-mirada`;
const presentacionPdfHref = `${presentacionDir}/${presentacionNoRendir.archivoPdf}`;

const jsonLdExtra = [
  {
    '@type': 'Book',
    '@id': `${inicio}/modelo-milc#tomo4`,
    name: 'No rendir la mirada',
    alternateName: subtitulo,
    bookEdition: 'Primera edición 2026',
    bookFormat: 'EBook',
    inLanguage: 'es-CO',
    numberOfPages: libroPaginas,
    datePublished: '2026-07-23',
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    identifier: doi,
    sameAs: [
      'https://zenodo.org/doi/10.5281/zenodo.21517630',
      'https://zenodo.org/doi/10.5281/zenodo.21517631',
    ],
    url: `${inicio}/modelo-milc/no-rendir-la-mirada`,
    mainEntityOfPage: `${inicio}/modelo-milc/no-rendir-la-mirada`,
    encodingFormat: 'application/pdf',
    position: 4,
    isPartOf: { '@type': 'BookSeries', '@id': `${inicio}/modelo-milc#coleccion`, name: 'Colección MILC' },
    associatedMedia: {
      '@type': 'MediaObject',
      contentUrl: pdfUrl,
      encodingFormat: 'application/pdf',
    },
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#organization` },
    about: [
      'Inteligencia artificial en educación',
      'Alfabetización en inteligencia artificial',
      'Soberanía tecnológica',
      'Protección de datos de menores',
      'Autoría estudiantil',
      'Pensamiento computacional',
    ],
  },
  {
    '@type': 'PresentationDigitalDocument',
    '@id': `${inicio}/modelo-milc/no-rendir-la-mirada#presentacion`,
    name: presentacionNoRendir.titulo,
    alternateName: presentacionNoRendir.subtitulo,
    description:
      'Presentación de 12 slides del Tomo IV: la ilusión del pensamiento (la IA predice, no comprende), el dato como huella inevitable en sus tres capas, las cuatro heridas de la rendición, la anatomía de la brecha, el paso del oráculo a la mediación, los tres hábitos (declarar, verificar, ser autor) sostenidos por la postura de la soberanía informacional situada, y el cuaderno de prompts como herramienta de trazabilidad.',
    inLanguage: 'es-CO',
    datePublished: '2026-07-23',
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    url: `${inicio}/modelo-milc/no-rendir-la-mirada#presentacion`,
    associatedMedia: {
      '@type': 'MediaObject',
      contentUrl: `${origen}${presentacionPdfHref}`,
      encodingFormat: 'application/pdf',
    },
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#organization` },
  },
];

// Estructura real del tomo: 15 capítulos en 4 partes (+ preliminares y cierre).
const partes = [
  {
    parte: 'Parte I',
    titulo: 'La máquina',
    desc: 'Nombrar la fuerza: qué son de verdad la IA y los datos.',
    caps: [
      '1. La herramienta que parece pensar',
      '2. El dato como huella',
      '3. El aula ya es digital',
    ],
  },
  {
    parte: 'Parte II',
    titulo: 'Los efectos, por dimensión',
    desc: 'Lo que la herramienta le hace al que aprende cuando lo sustituye.',
    caps: [
      '4. La dependencia: cuando la máquina piensa por mí',
      '5. La autoría rendida: volverse invisible en el propio trabajo',
      '6. La extracción: los datos del estudiante como mercancía',
      '7. La brecha: acceso desigual a la herramienta',
    ],
  },
  {
    parte: 'Parte III',
    titulo: 'Educar el criterio',
    desc: 'Tres hábitos y una postura que le devuelven el mando al estudiante.',
    caps: [
      '8. Declaración: decir cuándo y cómo se usó la IA',
      '9. Verificación: desconfiar de la respuesta fluida',
      '10. Autoría: el estudiante que explica, decide y responde',
      '11. Soberanía: dueño de mi juicio, mis datos y mi territorio',
    ],
  },
  {
    parte: 'Parte IV',
    titulo: 'Manual metodológico',
    desc: 'La herramienta con sentido en el aula, de sexto a once.',
    caps: [
      '12. De la caja negra al criterio: IA y datos por grados',
      '13. El laboratorio de datos: sensores, medición y cartografía',
      '14. El taller de producción con IA: trazabilidad y autoría',
      '15. Programa por etapas (6.º–11.º): del bit a la soberanía',
    ],
  },
];

// Las ideas más relevantes del tomo (fieles a la obra).
const ideas = [
  {
    emoji: '🎭',
    titulo: 'Parece pensar, y no piensa',
    texto: 'Un modelo de lenguaje predice la siguiente palabra: está optimizado para sonar plausible, no para ser veraz. Distinguir el parecer del ser es el primer acto de soberanía, y el que decide todo lo demás.',
  },
  {
    emoji: '🩼',
    titulo: 'Andamio o muleta',
    texto: 'La misma IA puede instalar capacidad o instalar dependencia. La pregunta que las distingue no es cuánto esfuerzo ahorra, sino qué queda cuando se retira: el andamio deja una capacidad; la muleta, una deuda cognitiva.',
  },
  {
    emoji: '✍️',
    titulo: 'Declarar no es confesar',
    texto: 'Usar la herramienta puede ser legítimo; esconderla, casi nunca. Quien no declara no engaña sobre todo al profesor: se borra a sí mismo de lo que firma. Declarar el proceso es firmar una autoría.',
  },
  {
    emoji: '🔍',
    titulo: 'Verificar es donde vive el pensamiento',
    texto: 'Los modelos llegan a inventar las fuentes que citan. Contra lo que convence sin probar, el escudo es una virtud antigua: no dar el asentimiento hasta haber mirado la fuente.',
  },
  {
    emoji: '👤',
    titulo: 'El Inforg Resiliente',
    texto: 'Habitamos una infoesfera donde lo físico y lo informacional se entrelazan. La pregunta no es si somos inforgs, sino cuál: el que se disuelve, o el que puede explicar, decidir y responder por lo que hace con la máquina.',
  },
  {
    emoji: '🌱',
    titulo: 'Frugalidad y territorio',
    texto: 'Con 41,9 % de conexión en el campo colombiano, el manual se escribe en versión de un solo dispositivo. Y usar la máquina desde la exterioridad (Dussel) es aportarle la mirada que al centro le falta.',
  },
];
---

<BaseLayout
  title="No rendir la mirada · Tomo IV — Colección MILC · ConectaTE"
  description="Tomo IV de la Colección MILC: la herramienta no piensa por el estudiante, le presta capacidad. Ensayo pedagógico situado sobre inteligencia artificial, datos y soberanía tecnológica en la escuela, con manual de aula de sexto a once. Libro en acceso abierto (CC BY-SA 4.0, DOI en Zenodo)."
  ogType="article"
  imagen="/og/libro-no-rendir-la-mirada.png"
  jsonLd={jsonLdExtra}
  citation={{
    title: 'No rendir la mirada',
    authors: ['Álvaro Cárdenas Orozco'],
    date: '2026/07/23',
    pdfUrl,
    doi: doiConcepto,
    publisher: 'Sor María Juliana Ediciones',
    language: 'es',
  }}
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/modelo-milc`} class="hover:opacity-60 transition-opacity">Modelo MILC</a>
        <span>/</span>
        <span style="color: var(--fg);">Tomo IV · No rendir la mirada</span>
      </nav>

      <!-- HERO editorial -->
      <div class="bento-card-color bg-bento-black grid-pattern text-white mb-10 py-12 md:py-16 px-6 md:px-10">
        <div class="max-w-3xl">
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Colección MILC · Tomo IV</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Ensayo pedagógico situado</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">{libroPaginas} páginas</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">CC BY-SA 4.0</span>
          </div>
          <p class="text-base md:text-lg italic opacity-80 mb-2">
            Porque la herramienta más poderosa <strong>no debería pensar por nosotros</strong>.
          </p>
          <h1 class="heading-giant text-balance leading-[0.95] mb-4">
            No rendir la mirada
          </h1>
          <p class="text-base md:text-lg font-semibold opacity-90 leading-relaxed mb-3">
            {subtitulo}.
          </p>
          <p class="text-sm opacity-70 mb-8">
            Dr. Álvaro Cárdenas Orozco · Sor María Juliana Ediciones · 2026 ·
            DOI {doiConcepto}
          </p>

          <div class="flex items-center gap-2.5 flex-wrap">
            <a href={libroHref} download class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={doi} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              DOI · Zenodo
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
            <a href="#presentacion" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-sm font-black opacity-80 hover:opacity-100 transition-opacity">
              Ver la presentación ↓
            </a>
          </div>
        </div>
      </div>

      <!-- La tesis -->
      <div class="bento-card-color bg-bento-lime mb-10">
        <span class="chip-bento mb-3 bg-black/10">💡 La tesis, en una línea</span>
        <p class="text-lg md:text-2xl font-black leading-snug">
          «La herramienta no piensa por el estudiante: le presta capacidad. Lo que decide su efecto no es la máquina, es el diseño pedagógico con que entra al aula.»
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          Por eso la escuela no puede ni <strong>prohibir</strong> (no se educa el criterio prohibiendo
          aquello frente a lo cual hay que tener criterio) ni <strong>rendirse</strong> (usar mucho una
          herramienta no es usarla bien). Queda una tercera vía, más difícil: el <strong>criterio</strong>.
        </p>
      </div>

      <!-- DE QUÉ TRATA -->
      <section class="mb-10">
        <span class="chip-bento mb-4">De qué trata</span>
        <div class="bento-card">
          <p class="text-base md:text-lg leading-relaxed mb-4">
            <em>No rendir la mirada</em> parte de un gesto que se repite cada mañana en cualquier
            salón: un estudiante escribe una pregunta, recibe un texto impecable y lo copia sin
            dudar. En ese instante mínimo se juega la batalla que el libro entero quiere nombrar,
            la que hay <strong>entre lo que parece y lo que es</strong>.
          </p>
          <p class="text-base md:text-lg leading-relaxed mb-4">
            El tomo mira de frente lo que la herramienta le hace al que aprende cuando lo sustituye
            en vez de acompañarlo: la <strong>dependencia</strong>, que atrofia el juicio; la
            <strong>autoría rendida</strong>, que vuelve invisible al estudiante en su propio
            trabajo; la <strong>extracción</strong>, que convierte su huella en mercancía; y la
            <strong>brecha</strong>, que ensancha la distancia entre los que pueden y los que no.
          </p>
          <p class="text-base md:text-lg leading-relaxed">
            Frente a eso propone <strong>tres hábitos y una postura</strong>: declarar (para no
            esconderse), verificar (para no creer a ciegas), ser autor (para responder por lo que se
            hace) y, enmarcándolos, ser <strong>soberano</strong>: no ceder el juicio, ni los datos,
            ni el lugar desde el cual se mira el mundo. La última parte lo baja al aula con un
            manual de sexto a once, laboratorio de datos, Política de IA del Aula y rúbrica de
            autoría, escrito en <strong>versión de un solo dispositivo</strong> para que ningún
            colegio quede fuera por falta de equipos.
          </p>
          <p class="text-base md:text-lg leading-relaxed mt-4">
            Es el <strong>Tomo IV de la Colección MILC</strong>. Si el Tomo I formó el
            <em>yo</em> frente a la pantalla, el Tomo II arraigó al <em>nosotros</em> en el
            territorio y el Tomo III dio método al asombro, este se ocupa de la
            <strong>herramienta</strong>: cómo sostener todo lo anterior frente a máquinas que, si
            uno se descuida, piensan por él, lo miden sin permiso y le imponen la mirada del centro.
          </p>
        </div>
      </section>

      <!-- LA ESTRUCTURA DEL TOMO -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
          <h2 class="heading-huge">Cómo está armado el tomo.</h2>
          <span class="chip-bento">15 capítulos · 4 partes</span>
        </div>
        <p class="text-sm leading-relaxed mb-6 max-w-2xl" style="color: var(--fg-muted);">
          Un recorrido que va de <strong style="color: var(--fg);">nombrar la fuerza</strong>
          a <strong style="color: var(--fg);">mirar sus efectos</strong>, de ahí a
          <strong style="color: var(--fg);">educar el criterio</strong> y por último al
          <strong style="color: var(--fg);">manual de aula</strong>. Abre con Prólogo, Introducción
          y «Cómo leer»; cierra con la Conclusión y las Referencias (50 fichas en APA 7.ª).
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {partes.map((p, i) => (
            <div class="bento-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-8 h-8 rounded-full bg-bento-lime text-black flex items-center justify-center text-sm font-black shrink-0">{i + 1}</span>
                <div>
                  <span class="text-[11px] font-black uppercase tracking-widest block" style="color: var(--fg-muted);">{p.parte}</span>
                  <h3 class="font-black text-lg leading-tight">{p.titulo}</h3>
                </div>
              </div>
              <p class="text-sm font-semibold mb-3" style="color: var(--fg-muted);">{p.desc}</p>
              <ul class="space-y-1.5">
                {p.caps.map((c) => (
                  <li class="text-sm leading-snug flex gap-2">
                    <span class="text-bento-blue font-black shrink-0">›</span>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- PRESENTACIÓN · 12 slides -->
      <div id="presentacion" class="mb-10 scroll-mt-24">
        <SlidesViewer
          presentacion={presentacionNoRendir}
          slides={slidesNoRendir}
          dirNombre="no-rendir-la-mirada"
        />
      </div>

      <!-- LAS IDEAS MÁS RELEVANTES -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge">Las ideas más relevantes.</h2>
          <span class="chip-bento">6 claves</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {ideas.map((r, i) => (
            <div class="bento-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-3xl" aria-hidden="true">{r.emoji}</span>
                <span class="w-7 h-7 rounded-full bg-bento-blue text-white flex items-center justify-center text-xs font-black shrink-0">{i + 1}</span>
              </div>
              <h3 class="font-black text-base leading-tight mb-2">{r.titulo}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{r.texto}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- INVITACIÓN A LEERLO -->
      <section class="mb-10">
        <div class="bento-card-color bg-bento-black grid-pattern text-white py-10 md:py-14 px-6 md:px-10 text-center">
          <span class="text-5xl block mb-4">📕</span>
          <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-4 max-w-2xl mx-auto">
            Léelo completo. {libroPaginas} páginas para no rendir la mirada.
          </h2>
          <p class="text-base md:text-lg opacity-85 leading-relaxed max-w-2xl mx-auto mb-8">
            Un ensayo para docentes que no quieren ni prohibir la inteligencia artificial ni
            rendirse a ella. Con instrumentos listos para el lunes: ficha de declaración, cuaderno
            de <em>prompts</em>, laboratorio de datos y rúbrica de autoría. Acceso abierto,
            gratuito y con licencia para compartir y adaptar en tu aula.
          </p>
          <div class="flex items-center justify-center gap-2.5 flex-wrap">
            <a href={libroHref} download class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro (PDF)
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={doi} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-6 py-3 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              Ver en Zenodo
            </a>
          </div>
        </div>
      </section>

      <!-- Cómo citar -->
      <CitaLibro
        titulo="No rendir la mirada"
        tomo="Tomo IV"
        volumen={4}
        ano={2026}
        editorial="Sor María Juliana Ediciones"
        doi={doiConcepto}
        citeKey="cardenas2026mirada"
        licencia="CC BY-SA 4.0"
      />

      <!-- Sigue en la colección · enlaces internos -->
      <section class="mb-10">
        <span class="chip-bento mb-4">Sigue en la Colección MILC</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href={`${base}/modelo-milc/el-nino-que-suena-ciencia`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Tomo III</span>
            <h3 class="font-black text-lg leading-tight mt-1">El niño que sueña ciencia</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">Darle método al asombro sin apagarlo.</p>
          </a>
          <a href={`${base}/modelo-milc`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Obra matriz</span>
            <h3 class="font-black text-lg leading-tight mt-1">Educación en la Era Onlife</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">El modelo MILC completo, del que nace esta colección.</p>
          </a>
        </div>
      </section>

      <!-- Volver -->
      <a href={`${base}/modelo-milc`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al</div>
          <div class="font-black text-lg">Modelo MILC</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CitaLibro from '../../../components/CitaLibro.astro';
import SlidesViewer from '../../../components/SlidesViewer.astro';
import { presentacionQuerencia, slidesQuerencia } from '../../../data/presentacionQuerencia';

const base = import.meta.env.BASE_URL;

const libroHref = `${base}/libro-milc/tomo-2-pedagogia-de-la-querencia.pdf`;
const libroPaginas = 144;
const subtitulo =
  'Reconstruir el aula desde la filosofía de la liberación para arraigar al estudiante en su territorio, su historia y sus saberes ancestrales';
// DOI de concepto (resuelve siempre a la última versión) · versión v1: 10.5281/zenodo.21176769
const doiConcepto = '10.5281/zenodo.21176768';
const doi = `https://doi.org/${doiConcepto}`;

// ─── Schema.org · Book (mismo @id que en /modelo-milc) ───────────────────
const origen = (Astro.site ?? new URL('https://alguarito.github.io')).toString().replace(/\/$/, '');
const inicio = `${origen}${base.replace(/\/$/, '')}`;
const pdfUrl = `${origen}${libroHref}`;

const presentacionDir = `${base}/presentaciones/querencia`;
const presentacionPdfHref = `${presentacionDir}/${presentacionQuerencia.archivoPdf}`;

const jsonLdExtra = [
  {
    '@type': 'Book',
    '@id': `${inicio}/modelo-milc#tomo2`,
    name: 'Pedagogía de la Querencia',
    alternateName: subtitulo,
    bookEdition: 'Primera edición 2026',
    bookFormat: 'EBook',
    inLanguage: 'es-CO',
    numberOfPages: libroPaginas,
    datePublished: '2026-07-03',
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    identifier: doi,
    sameAs: [
      'https://zenodo.org/doi/10.5281/zenodo.21176768',
      'https://zenodo.org/records/21176769',
    ],
    url: `${inicio}/modelo-milc/querencia`,
    mainEntityOfPage: `${inicio}/modelo-milc/querencia`,
    encodingFormat: 'application/pdf',
    position: 2,
    isPartOf: { '@type': 'BookSeries', '@id': `${inicio}/modelo-milc#coleccion`, name: 'Colección MILC' },
    associatedMedia: {
      '@type': 'MediaObject',
      contentUrl: pdfUrl,
      encodingFormat: 'application/pdf',
    },
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#organization` },
    about: [
      'Filosofía de la liberación',
      'Pedagogía decolonial',
      'Saberes ancestrales',
      'Educación situada',
      'Territorio y arraigo',
    ],
  },
  {
    '@type': 'PresentationDigitalDocument',
    '@id': `${inicio}/modelo-milc/querencia#presentacion`,
    name: presentacionQuerencia.titulo,
    alternateName: presentacionQuerencia.subtitulo,
    description:
      'Presentación de 15 slides del Tomo II: la paradoja de educar para la partida, la Totalidad y el Punto Cero, el aula como no-lugar, las tres heridas del desarraigo, el giro analéctico hacia la Exterioridad y la praxis de la querencia como alas y raíces.',
    inLanguage: 'es-CO',
    datePublished: '2026-07-03',
    license: 'https://creativecommons.org/licenses/by-sa/4.0/',
    url: `${inicio}/modelo-milc/querencia#presentacion`,
    associatedMedia: {
      '@type': 'MediaObject',
      contentUrl: `${origen}${presentacionPdfHref}`,
      encodingFormat: 'application/pdf',
    },
    author: { '@id': `${inicio}/acerca#person` },
    publisher: { '@id': `${inicio}#organization` },
  },
];

// Estructura real del tomo: 18 capítulos en 5 partes (+ preliminares y cierre).
const partes = [
  {
    parte: 'Parte I',
    titulo: 'La Totalidad',
    desc: 'La escuela que desarraiga.',
    caps: [
      '1. La Totalidad que educa',
      '2. La colonialidad del saber',
      '3. El no-lugar: formar para irse',
    ],
  },
  {
    parte: 'Parte II',
    titulo: 'Las caras del desarraigo',
    desc: 'Los efectos, por dimensión.',
    caps: [
      '4. Desarraigo epistémico',
      '5. Desarraigo territorial',
      '6. Desarraigo identitario',
    ],
  },
  {
    parte: 'Parte III',
    titulo: 'Del encubrimiento al des-cubrimiento',
    desc: 'La historia eurocéntrica y su redescripción.',
    caps: [
      '7. El mito de la modernidad',
      '8. 1492 en el tablero',
      '9. Redescribir desde Abya Yala',
      '10. La historia que se camina: los Quimbaya y Cartago',
    ],
  },
  {
    parte: 'Parte IV',
    titulo: 'La Exterioridad',
    desc: 'La pedagógica de la querencia.',
    caps: [
      '11. La pedagógica de la liberación',
      '12. La analéctica en el aula',
      '13. Pedagogía de la querencia',
      '14. El diálogo de saberes',
    ],
  },
  {
    parte: 'Parte V',
    titulo: 'Manual metodológico',
    desc: 'Reconstruir las prácticas del aula.',
    caps: [
      '15. Cartografía del lugar',
      '16. El aula como ágora',
      '17. Investigación situada',
      '18. Programa por etapas (6.º–11.º)',
    ],
  },
];

// Las ideas más relevantes del tomo (fieles a la obra y a la presentación).
const ideas = [
  {
    emoji: '✈️',
    titulo: 'Educamos para la partida',
    texto: 'El éxito escolar tiene una geografía implícita: felicitamos al que «llegó lejos» y graduamos estudiantes como extranjeros en su propia tierra. Dar alas sin dar raíces no es libertad.',
  },
  {
    emoji: '⭕',
    titulo: 'La Totalidad (Dussel)',
    texto: 'La escuela tradicional opera como un sistema cerrado que enseña el mundo entero… menos el pedazo de mundo que el estudiante pisa. El «Punto Cero» disfraza de universal un saber con domicilio.',
  },
  {
    emoji: '💔',
    titulo: 'Las tres heridas del desarraigo',
    texto: 'Epistémica (el saber propio devaluado), territorial (ceguera ante el entorno) e identitaria (la vergüenza del origen). Tres fracturas que deja el currículo invisible.',
  },
  {
    emoji: '🗺️',
    titulo: 'Espacio vs. Lugar',
    texto: 'El Espacio son coordenadas sin rostro; el Lugar es memoria, afecto, nombres. Un territorio que la escuela nunca nombra se apaga hasta volverse paisaje, y a un paisaje nadie lo defiende.',
  },
  {
    emoji: '🚪',
    titulo: 'El giro analéctico: la Exterioridad',
    texto: 'El antídoto es lo que «sobra del molde»: la pregunta del barrio, la técnica de la partera, el dato de la abuela. De la jerarquía colonial a una ecología de saberes que dialogan de igual a igual.',
  },
  {
    emoji: '🌱',
    titulo: 'La querencia, competencia educable',
    texto: 'Alas y raíces: reparar las tres heridas (reparación epistémica, reterritorialización, pertenencia). El estudiante con querencia no es el que se queda porque no pudo irse, sino el que, pudiendo irse, sabe que tiene un lugar al cual volver.',
  },
];
---

<BaseLayout
  title="Pedagogía de la Querencia · Tomo II — Colección MILC · ConectaTE"
  description="Tomo II de la Colección MILC: reconstruir el aula desde la filosofía de la liberación para arraigar al estudiante en su territorio, su historia y sus saberes ancestrales. Libro en acceso abierto (CC BY-SA 4.0, DOI en Zenodo)."
  ogType="article"
  imagen="/og/libro-querencia.png"
  jsonLd={jsonLdExtra}
  citation={{
    title: 'Pedagogía de la Querencia',
    authors: ['Álvaro Cárdenas Orozco'],
    date: '2026/07/03',
    pdfUrl,
    doi: doiConcepto,
    publisher: 'Sor María Juliana Ediciones',
    language: 'es',
  }}
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/modelo-milc`} class="hover:opacity-60 transition-opacity">Modelo MILC</a>
        <span>/</span>
        <span style="color: var(--fg);">Tomo II · Pedagogía de la Querencia</span>
      </nav>

      <!-- HERO editorial -->
      <div class="bento-card-color bg-bento-black grid-pattern text-white mb-10 py-12 md:py-16 px-6 md:px-10">
        <div class="max-w-3xl">
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Colección MILC · Tomo II</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">Ensayo pedagógico situado</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">{libroPaginas} páginas</span>
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">CC BY-SA 4.0</span>
          </div>
          <p class="text-base md:text-lg italic opacity-80 mb-2">
            Porque el estudiante aprende mejor desde <strong>el lugar que habita</strong>.
          </p>
          <h1 class="heading-giant text-balance leading-[0.95] mb-4">
            Pedagogía de la Querencia
          </h1>
          <p class="text-base md:text-lg font-semibold opacity-90 leading-relaxed mb-3">
            {subtitulo}.
          </p>
          <p class="text-sm opacity-70 mb-8">
            Dr. Álvaro Cárdenas Orozco · Sor María Juliana Ediciones · 2026 ·
            DOI {doiConcepto}
          </p>

          <div class="flex items-center gap-2.5 flex-wrap">
            <a href={libroHref} download class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={doi} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              DOI · Zenodo
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
            <a href="#presentacion" class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-full text-sm font-black opacity-80 hover:opacity-100 transition-opacity">
              Ver la presentación ↓
            </a>
          </div>
        </div>
      </div>

      <!-- La tesis -->
      <div class="bento-card-color bg-bento-lime mb-10">
        <span class="chip-bento mb-3 bg-black/10">💡 La tesis, en una línea</span>
        <p class="text-lg md:text-2xl font-black leading-snug">
          «La querencia (el arraigo al territorio, la historia y los saberes propios) es una competencia que se puede educar.»
        </p>
        <p class="text-sm leading-relaxed mt-3 opacity-90">
          Este tomo reconstruye la pedagogía desde la <strong>filosofía de la liberación</strong>:
          en vez de importar el currículo, parte del estudiante situado (su lugar, su comunidad,
          sus saberes ancestrales) para abrirlo al mundo sin desarraigarlo.
        </p>
      </div>

      <!-- DE QUÉ TRATA -->
      <section class="mb-10">
        <span class="chip-bento mb-4">De qué trata</span>
        <div class="bento-card">
          <p class="text-base md:text-lg leading-relaxed mb-4">
            <em>Pedagogía de la Querencia</em> parte de una paradoja incómoda: casi sin decirlo,
            la escuela <strong>educa para la partida</strong>. Premia al que «llega lejos» y trata el
            lugar de origen como algo que hay que superar, formando estudiantes que terminan siendo
            <strong>extranjeros en su propia tierra</strong>.
          </p>
          <p class="text-base md:text-lg leading-relaxed mb-4">
            Frente a eso, el tomo toma la <strong>filosofía de la liberación de Enrique Dussel</strong>
            (la Totalidad que encubre al Otro y la Exterioridad que la transforma) y la pone a trabajar
            en el aula. Nombra las <strong>tres heridas del desarraigo</strong> (epistémica, territorial
            e identitaria) y propone la <strong>querencia</strong> (el amor y la pertenencia al lugar)
            no como nostalgia, sino como una <strong>competencia que se puede educar</strong>.
          </p>
          <p class="text-base md:text-lg leading-relaxed">
            Es el <strong>Tomo II de la Colección MILC</strong>. Si el Tomo I formó el criterio del
            <em>yo</em> frente a la pantalla, este forma el arraigo del <em>nosotros</em> en el
            territorio. No busca encerrar al estudiante en lo suyo, sino darle <strong>alas y
            raíces</strong>: un lugar al cual volver.
          </p>
        </div>
      </section>

      <!-- LA ESTRUCTURA DEL TOMO -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-2">
          <h2 class="heading-huge">Cómo está armado el tomo.</h2>
          <span class="chip-bento">18 capítulos · 5 partes</span>
        </div>
        <p class="text-sm leading-relaxed mb-6 max-w-2xl" style="color: var(--fg-muted);">
          Un recorrido que va de <strong style="color: var(--fg);">diagnosticar el desarraigo</strong>
          a <strong style="color: var(--fg);">reescribir la historia</strong> y
          <strong style="color: var(--fg);">reconstruir las prácticas</strong> del aula. Abre con
          Prólogo, Introducción y «Cómo leer»; cierra con la Conclusión («Habitar la Exterioridad»)
          y las Referencias.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {partes.map((p, i) => (
            <div class="bento-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="w-8 h-8 rounded-full bg-bento-lime text-black flex items-center justify-center text-sm font-black shrink-0">{i + 1}</span>
                <div>
                  <span class="text-[11px] font-black uppercase tracking-widest block" style="color: var(--fg-muted);">{p.parte}</span>
                  <h3 class="font-black text-lg leading-tight">{p.titulo}</h3>
                </div>
              </div>
              <p class="text-sm font-semibold mb-3" style="color: var(--fg-muted);">{p.desc}</p>
              <ul class="space-y-1.5">
                {p.caps.map((c) => (
                  <li class="text-sm leading-snug flex gap-2">
                    <span class="text-bento-blue font-black shrink-0">›</span>
                    <span>{c}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- PRESENTACIÓN · 15 slides -->
      <div id="presentacion" class="mb-10 scroll-mt-24">
        <SlidesViewer
          presentacion={presentacionQuerencia}
          slides={slidesQuerencia}
          dirNombre="querencia"
        />
      </div>

      <!-- LAS IDEAS MÁS RELEVANTES -->
      <section class="mb-10">
        <div class="flex items-center justify-between flex-wrap gap-3 mb-6">
          <h2 class="heading-huge">Las ideas más relevantes.</h2>
          <span class="chip-bento">6 claves</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {ideas.map((r, i) => (
            <div class="bento-card">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-3xl" aria-hidden="true">{r.emoji}</span>
                <span class="w-7 h-7 rounded-full bg-bento-blue text-white flex items-center justify-center text-xs font-black shrink-0">{i + 1}</span>
              </div>
              <h3 class="font-black text-base leading-tight mb-2">{r.titulo}</h3>
              <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{r.texto}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- INVITACIÓN A LEERLO -->
      <section class="mb-10">
        <div class="bento-card-color bg-bento-black grid-pattern text-white py-10 md:py-14 px-6 md:px-10 text-center">
          <span class="text-5xl block mb-4">🌱</span>
          <h2 class="text-2xl md:text-4xl font-black tracking-tight leading-tight mb-4 max-w-2xl mx-auto">
            Léelo completo. {libroPaginas} páginas para volver al lugar.
          </h2>
          <p class="text-base md:text-lg opacity-85 leading-relaxed max-w-2xl mx-auto mb-8">
            Un ensayo para docentes que quieren un aula capaz de partir del territorio (no del
            currículo importado) y de poner a dialogar el saber escolar con los sabedores de la
            comunidad. Acceso abierto, gratuito y con licencia para compartir y adaptar en tu aula.
          </p>
          <div class="flex items-center justify-center gap-2.5 flex-wrap">
            <a href={libroHref} download class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-bento-lime text-neutral-950 text-sm font-black hover:opacity-85 transition-opacity">
              Descargar el libro (PDF)
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </a>
            <a href={doi} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-6 py-3 rounded-full border-2 border-white/30 text-sm font-black hover:border-white transition-colors" aria-label="Registro citable en Zenodo (se abre en una pestaña nueva)">
              Ver en Zenodo
            </a>
          </div>
        </div>
      </section>

      <!-- Cómo citar -->
      <CitaLibro
        titulo="Pedagogía de la Querencia"
        tomo="Tomo II"
        volumen={2}
        ano={2026}
        editorial="Sor María Juliana Ediciones"
        doi={doiConcepto}
        citeKey="cardenas2026querencia"
        licencia="CC BY-SA 4.0"
      />

      <!-- Sigue en la colección · enlaces internos -->
      <section class="mb-10">
        <span class="chip-bento mb-4">Sigue en la Colección MILC</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href={`${base}/modelo-milc/mercado-atencion`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Tomo I</span>
            <h3 class="font-black text-lg leading-tight mt-1">El Mercado de la Atención</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">Educar el criterio de los jóvenes en la era onlife.</p>
          </a>
          <a href={`${base}/modelo-milc`} class="bento-card-hover">
            <span class="text-xs font-black uppercase tracking-widest" style="color: var(--fg-muted);">Obra matriz</span>
            <h3 class="font-black text-lg leading-tight mt-1">Educación en la Era Onlife</h3>
            <p class="text-sm mt-1" style="color: var(--fg-muted);">El modelo MILC completo, del que nace esta colección.</p>
          </a>
        </div>
      </section>

      <!-- Volver -->
      <a href={`${base}/modelo-milc`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al</div>
          <div class="font-black text-lg">Modelo MILC</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

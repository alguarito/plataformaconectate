---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  semillero,
  sellos,
  lineas,
  fases,
  participar,
} from '../../data/semillero';
import { fgSobreBento } from '../../data/explora';

const base = import.meta.env.BASE_URL;

// Mensaje pre-llenado para sumarse al semillero (usa el buscador de contacto
// existente en /acerca; aquí enlazamos a esa página como punto de contacto).
const contactoHref = `${base}/acerca`;
---

<BaseLayout
  title="Semillero de Investigación ConectaTE — Investigación estudiantil STEM"
  description="El Semillero de Investigación ConectaTE: estudiantes de 6° a 11° de la I.E. Sor María Juliana investigan astronomía, pensamiento computacional, IA, robótica e innovación social bajo el modelo MILC. Ciencia real, con método y aliados como NASA-IASC, Samsung y RECA."
  imagen="/og/home.png"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <span style="color: var(--fg);">Semillero de Investigación</span>
      </nav>

      <!-- HERO -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 mb-10">
        <div class="bento-card-color bg-bento-purple text-white md:col-span-8 min-h-[420px] flex flex-col justify-between">
          <div class="flex items-start justify-between flex-wrap gap-3">
            <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-white/15">
              🔬 Investigación estudiantil STEM
            </span>
            <span class="text-8xl md:text-9xl leading-none" aria-hidden="true">🔬</span>
          </div>
          <div>
            <h1 class="heading-giant text-balance leading-[0.95] mt-2 mb-4">
              Semillero de Investigación
            </h1>
            <p class="text-lg md:text-2xl font-black tracking-tight leading-tight opacity-95 mb-3">
              {semillero.lema}
            </p>
            <p class="text-sm md:text-base font-semibold opacity-90 max-w-2xl leading-relaxed">
              {semillero.intro}
            </p>
          </div>
        </div>

        <!-- Sellos verificables -->
        <div class="md:col-span-4 grid grid-cols-2 gap-4 md:gap-6">
          {
            sellos.map((s) => {
              const fg = fgSobreBento(s.bgClass);
              return (
                <div class:list={['bento-card-color', s.bgClass, fg, 'flex flex-col justify-between min-h-[130px]']}>
                  <div class="text-3xl md:text-4xl font-black tracking-tighter leading-none break-words">{s.valor}</div>
                  <div class="text-xs font-bold mt-2 leading-snug opacity-90">{s.etiqueta}</div>
                </div>
              );
            })
          }
        </div>
      </div>

      <!-- QUÉ ES / LIDERAZGO -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-4">Qué es el semillero</span>
        <p class="text-base md:text-lg leading-relaxed mt-2">
          Un semillero de investigación es un grupo de estudiantes que, acompañados por un
          docente, sostienen una pregunta en el tiempo y la convierten en un pequeño proyecto
          de ciencia. En ConectaTE, ese trabajo se organiza con el modelo
          <strong> MILC</strong> y se conecta con los programas del hub
          <a href={`${base}/explora`} class="underline decoration-2 underline-offset-2" style="text-decoration-color: var(--bento-purple, #7C3AED);">Explora</a>,
          que funcionan como sus canteras de talento.
        </p>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mt-6 text-sm" style="color: var(--fg-muted);">
          <span class="inline-flex items-center gap-2">
            <span class="text-lg">👨‍🏫</span>
            <strong style="color: var(--fg);">Lidera:</strong> {semillero.liderazgo}
          </span>
          <span class="inline-flex items-center gap-2">
            <span class="text-lg">🏫</span>
            {semillero.institucion}
          </span>
        </div>
      </div>

      <!-- LÍNEAS DE INVESTIGACIÓN -->
      <div class="mb-10">
        <div class="flex items-end justify-between flex-wrap gap-3 mb-6">
          <div>
            <span class="chip-bento mb-3">Líneas de investigación</span>
            <h2 class="heading-huge leading-tight mt-2">Cinco caminos para investigar.</h2>
          </div>
          <p class="text-sm max-w-md" style="color: var(--fg-muted);">
            Elige la que encienda tu curiosidad —o propón una nueva si tu pregunta
            abre camino propio.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          {
            lineas.map((l) => {
              const fg = fgSobreBento(l.bgClass);
              return (
                <div class:list={['bento-card-color', l.bgClass, fg, 'flex flex-col justify-between min-h-[300px]']}>
                  <div class="flex items-start justify-between gap-3">
                    <span class="text-6xl leading-none" aria-hidden="true">{l.icono}</span>
                    {l.articulaCon && (
                      <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest bg-black/15 text-right leading-tight">
                        {l.articulaCon}
                      </span>
                    )}
                  </div>
                  <div class="mt-5">
                    <h3 class="text-2xl font-black tracking-tight leading-tight mb-2">{l.nombre}</h3>
                    <p class="text-sm leading-relaxed opacity-95 mb-4">{l.descripcion}</p>
                    <ul class="space-y-1.5">
                      {l.ejemplos.map((e) => (
                        <li class="flex items-start gap-2 text-sm leading-snug opacity-90">
                          <span class="opacity-70 mt-0.5">·</span>
                          <span>{e}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>

      <!-- MÉTODO: CICLO DE INVESTIGACIÓN -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Nuestro método</span>
        <h2 class="heading-huge mb-2 leading-tight">De la pregunta a la ciencia.</h2>
        <p class="text-sm md:text-base mb-8 max-w-2xl" style="color: var(--fg-muted);">
          Un ciclo de investigación situado, en diálogo con las fases del modelo
          <strong style="color: var(--fg);">MILC</strong>. No es una fórmula rígida:
          es una brújula para que ninguna pregunta se quede sin respuesta.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          {
            fases.map((f) => (
              <div class="rounded-bento-sm p-5 flex flex-col gap-3 h-full" style="background: var(--bg); border: 1px solid var(--border);">
                <div class="flex items-center justify-between">
                  <span class="text-3xl">{f.icono}</span>
                  <span class="text-2xl font-black tracking-tighter" style="color: var(--fg-muted);">
                    {String(f.numero).padStart(2, '0')}
                  </span>
                </div>
                <h3 class="text-lg font-black tracking-tight leading-tight">{f.nombre}</h3>
                <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{f.descripcion}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- PLAN DE ESTUDIOS (CTA) -->
      <a
        href={`${base}/semillero/plan-de-estudios`}
        class="bento-card-color bg-bento-cyan text-neutral-950 flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 hover:scale-[1.01] transition-transform group"
      >
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest opacity-70">Itinerario formativo</span>
          <h2 class="text-2xl md:text-3xl font-black tracking-tight leading-tight mt-1 mb-2">
            Plan de estudios del semillero
          </h2>
          <p class="text-sm md:text-base opacity-90 leading-relaxed">
            Un itinerario por cada línea, con las cuatro fases MILC, resultados de aprendizaje,
            productos de investigación e indicadores de logro.
          </p>
        </div>
        <span class="inline-flex items-center gap-2 font-black text-base shrink-0">
          Ver el plan
          <svg class="w-6 h-6 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </a>

      <!-- CÓMO PARTICIPAR -->
      <div class="mb-10">
        <span class="chip-bento mb-3">Cómo participar</span>
        <h2 class="heading-huge leading-tight mt-2 mb-6">Sumarte es simple.</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
          {
            participar.map((p) => (
              <div class="bento-card flex items-start gap-4">
                <div class="text-4xl shrink-0">{p.icono}</div>
                <div>
                  <h3 class="font-black text-lg leading-tight mb-1">{p.titulo}</h3>
                  <p class="text-sm leading-relaxed" style="color: var(--fg-muted);">{p.descripcion}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- ARTICULACIÓN CON EXPLORA -->
      <div class="bento-card-color bg-bento-blue text-white grid-pattern py-10 md:py-14 px-6 md:px-10 mb-10">
        <div class="max-w-3xl">
          <span class="chip-bento mb-3 bg-white/10 text-white border-white/20">Canteras del semillero</span>
          <h2 class="heading-huge mb-3 leading-tight">Del programa a la investigación.</h2>
          <p class="text-base md:text-lg opacity-90 mb-6 leading-relaxed">
            Los programas de <strong>Explora</strong> son la puerta de entrada: allí despiertas
            la curiosidad; en el semillero la conviertes en un proyecto propio. Salomé,
            Bebras y Solve for Tomorrow ya están abiertos.
          </p>
          <a
            href={`${base}/explora`}
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full font-bold text-sm bg-white text-bento-blue hover:scale-105 active:scale-95 transition-transform"
          >
            🔭 Ver los programas Explora
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- CTA CONTACTO -->
      <div class="bento-card-color bg-bento-black grid-pattern py-12 md:py-16 px-6 md:px-10 mb-10">
        <div class="text-center max-w-2xl mx-auto">
          <span class="chip-bento mb-3 bg-white/10 text-white border-white/20">¿Te interesa?</span>
          <h2 class="heading-huge mb-3 leading-tight">Trae tu pregunta.</h2>
          <p class="text-base md:text-lg opacity-80 mb-8 leading-relaxed">
            Si algo del mundo te da vueltas en la cabeza y quieres investigarlo en serio,
            el semillero es tu lugar. Habla con el docente para dar el primer paso.
          </p>
          <a
            href={contactoHref}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full font-bold text-sm bg-bento-lime text-black hover:scale-105 active:scale-95 transition-transform"
          >
            👋 Contactar al docente
          </a>
        </div>
      </div>

      <!-- VOLVER -->
      <a href={base || '/'} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al</div>
          <div class="font-black text-lg">Inicio de ConectaTE</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>

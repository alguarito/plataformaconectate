---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  lineas,
  planEstudios,
  perfilEgreso,
  getPlanLinea,
} from '../../../data/semillero';
import { fasesMILC } from '../../../data/planArea';
import { fgSobreBento } from '../../../data/explora';

const base = import.meta.env.BASE_URL;

// Metadatos de cada fase MILC (emoji, color) desde la fuente de verdad.
const faseMeta = new Map(fasesMILC.map((f) => [f.nombre, f]));
---

<BaseLayout
  title="Plan de estudios — Semillero de Investigación ConectaTE"
  description="Plan de estudios del Semillero de Investigación ConectaTE: un itinerario por línea (astronomía, pensamiento computacional, IA, robótica e innovación social) que recorre las cuatro fases del modelo MILC, con resultados de aprendizaje, productos de investigación e indicadores de logro."
  imagen="/og/home.png"
>
  <article class="pt-12 pb-20">
    <div class="bento-container max-w-6xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm font-semibold mb-8 flex-wrap" style="color: var(--fg-muted);">
        <a href={base || '/'} class="hover:opacity-60 transition-opacity">Inicio</a>
        <span>/</span>
        <a href={`${base}/semillero`} class="hover:opacity-60 transition-opacity">Semillero de Investigación</a>
        <span>/</span>
        <span style="color: var(--fg);">Plan de estudios</span>
      </nav>

      <!-- HERO -->
      <div class="bento-card-color bg-bento-cyan text-neutral-950 mb-10 min-h-[280px] flex flex-col justify-between">
        <div class="flex items-start justify-between flex-wrap gap-3">
          <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-black/10">
            📋 Itinerario formativo
          </span>
          <span class="text-7xl md:text-8xl leading-none" aria-hidden="true">🎓</span>
        </div>
        <div>
          <h1 class="heading-giant text-balance mt-2 mb-3">Plan de estudios</h1>
          <p class="text-base md:text-lg font-semibold opacity-90 max-w-2xl leading-relaxed">
            Cada línea de investigación es un itinerario que recorre las cuatro fases del
            modelo <strong>MILC</strong>. En cada módulo declaramos qué se aprende
            (resultado de aprendizaje), qué se produce (evidencia real) y cómo se verifica
            (indicador de logro).
          </p>
        </div>
      </div>

      <!-- CÓMO SE LEE: LAS 4 FASES MILC -->
      <div class="bento-card mb-10">
        <span class="chip-bento mb-3">Cómo se recorre cada línea</span>
        <h2 class="heading-huge mb-2 leading-tight">Cuatro fases, un mismo camino.</h2>
        <p class="text-sm md:text-base mb-6 max-w-2xl" style="color: var(--fg-muted);">
          El modelo <strong style="color: var(--fg);">MILC</strong> (Modelo de Investigación
          Liberadora y Científica) estructura el aprendizaje investigativo en cuatro fases.
          Todas las líneas las recorren en orden.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {
            fasesMILC.map((f, i) => {
              const fg = fgSobreBento(f.bgClass);
              return (
                <div class:list={['bento-card-color', f.bgClass, fg, 'flex flex-col gap-2 min-h-[160px]']}>
                  <div class="flex items-center justify-between">
                    <span class="text-3xl">{f.emoji}</span>
                    <span class="text-xl font-black tracking-tighter opacity-70">0{i + 1}</span>
                  </div>
                  <h3 class="text-lg font-black tracking-tight leading-tight">{f.nombre}</h3>
                  <p class="text-xs leading-relaxed opacity-90">{f.descripcion}</p>
                </div>
              );
            })
          }
        </div>
      </div>

      <!-- PERFIL DE EGRESO -->
      <div class="bento-card-color bg-bento-black grid-pattern py-10 md:py-12 px-6 md:px-10 mb-12">
        <div class="max-w-3xl">
          <span class="chip-bento mb-3 bg-white/10 text-white border-white/20">Resultado global</span>
          <h2 class="heading-huge mb-2 leading-tight">{perfilEgreso.titulo}.</h2>
          <p class="text-base md:text-lg opacity-85 mb-6 leading-relaxed">{perfilEgreso.intro}</p>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
            {
              perfilEgreso.logros.map((l) => (
                <li class="flex items-start gap-3 text-sm md:text-base leading-relaxed opacity-95">
                  <span class="w-5 h-5 rounded-md bg-bento-lime flex items-center justify-center shrink-0 mt-0.5">
                    <span class="text-[10px] font-black text-black">✓</span>
                  </span>
                  <span>{l}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- ITINERARIOS POR LÍNEA -->
      {
        planEstudios.map((plan) => {
          const linea = lineas.find((l) => l.slug === plan.lineaSlug);
          if (!linea) return null;
          const fgLinea = fgSobreBento(linea.bgClass);
          return (
            <section class="mb-12">
              {/* Cabecera de la línea */}
              <div class:list={['bento-card-color', linea.bgClass, fgLinea, 'flex items-center gap-4 mb-5']}>
                <span class="text-5xl leading-none shrink-0" aria-hidden="true">{linea.icono}</span>
                <div>
                  <span class="text-xs font-bold uppercase tracking-widest opacity-80">Itinerario · {plan.modulos.length} módulos</span>
                  <h2 class="text-2xl md:text-3xl font-black tracking-tight leading-tight">{linea.nombre}</h2>
                </div>
              </div>

              {/* Módulos de la línea */}
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
                {
                  plan.modulos.map((m, i) => {
                    const meta = faseMeta.get(m.fase);
                    const faseBg = meta?.bgClass ?? 'bg-bento-blue';
                    const faseFg = fgSobreBento(faseBg);
                    return (
                      <div class="bento-card flex flex-col h-full">
                        {/* Encabezado del módulo: fase + número */}
                        <div class="flex items-center justify-between gap-2 mb-3">
                          <span class:list={['inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-widest', faseBg, faseFg]}>
                            <span aria-hidden="true">{meta?.emoji}</span>
                            {m.fase}
                          </span>
                          <span class="text-sm font-black tracking-tight" style="color: var(--fg-muted);">
                            Módulo {i + 1}
                          </span>
                        </div>

                        <h3 class="text-xl font-black tracking-tight leading-tight mb-4">{m.titulo}</h3>

                        {/* RAE */}
                        <div class="mb-4">
                          <span class="text-[11px] font-black uppercase tracking-widest" style="color: var(--fg-muted);">
                            Resultado de aprendizaje
                          </span>
                          <p class="text-sm leading-relaxed mt-1">{m.rae}</p>
                        </div>

                        {/* Productos */}
                        <div class="mb-4">
                          <span class="text-[11px] font-black uppercase tracking-widest" style="color: var(--fg-muted);">
                            Productos de investigación
                          </span>
                          <ul class="mt-1.5 space-y-1">
                            {m.productos.map((p) => (
                              <li class="flex items-start gap-2 text-sm leading-snug">
                                <span class="w-4 h-4 rounded bg-bento-blue/15 flex items-center justify-center shrink-0 mt-0.5">
                                  <span class="text-[9px] font-black text-bento-blue">◆</span>
                                </span>
                                <span>{p}</span>
                              </li>
                            ))}
                          </ul>
                        </div>

                        {/* Indicador */}
                        <div class="mt-auto pt-3 border-t" style="border-color: var(--border);">
                          <span class="text-[11px] font-black uppercase tracking-widest" style="color: var(--fg-muted);">
                            Indicador de logro
                          </span>
                          <p class="text-sm leading-relaxed mt-1 font-semibold">{m.indicador}</p>
                        </div>

                        {/* Guía publicada (si existe) */}
                        {m.guia && (
                          <a
                            href={`${base}/semillero/guia/${m.guia}`}
                            class="mt-3 inline-flex items-center justify-between gap-2 px-4 py-2.5 rounded-full text-sm font-black bg-bento-blue text-white hover:scale-[1.02] transition-transform group"
                            aria-label={`Abrir la guía del módulo: ${m.titulo}`}
                          >
                            <span>
                              📘 Abrir la guía
                              {m.duracionMin && (
                                <span class="font-bold opacity-80"> · {m.duracionMin / 60} h</span>
                              )}
                            </span>
                            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M5 12h14"></path>
                              <path d="m12 5 7 7-7 7"></path>
                            </svg>
                          </a>
                        )}
                      </div>
                    );
                  })
                }
              </div>
            </section>
          );
        })
      }

      <!-- CTA VOLVER AL SEMILLERO -->
      <a href={`${base}/semillero`} class="bento-card-hover flex items-center gap-4">
        <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        <div>
          <div class="text-xs font-bold uppercase tracking-widest" style="color: var(--fg-muted);">Volver al</div>
          <div class="font-black text-lg">Semillero de Investigación</div>
        </div>
      </a>
    </div>
  </article>
</BaseLayout>
